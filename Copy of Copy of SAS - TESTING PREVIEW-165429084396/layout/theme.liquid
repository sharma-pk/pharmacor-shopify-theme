<script>
/* ==============================
   GLOBALS
============================== */
window.CUSTOMER_ID = "{{ customer.id | default: '' }}";

window.INVENTORY_MAP = window.INVENTORY_MAP || {};
window.FETCHING_PRODUCTS = window.FETCHING_PRODUCTS || {};


/* ==============================
   BUILD INVENTORY MAP
============================== */
function buildInventoryMap(apiData) {



  if (!apiData || !apiData.products) return;

  apiData.products.forEach(product => {

    if (!product.variants) return;

    product.variants.forEach(variant => {

      if (!variant.variantId) return;

      const match = variant.variantId.toString().match(/(\d+)$/);
      if (!match) return;

      const variantId = String(match[1]);

      if (!INVENTORY_MAP[variantId]) {
        INVENTORY_MAP[variantId] = { locations: {} };
      }

      if (Array.isArray(variant.locations)) {
        variant.locations.forEach(loc => {

          INVENTORY_MAP[variantId].locations[loc.locationName] =
            parseInt(loc.stock) || 0;

        });
      }

    });

  });

  document.dispatchEvent(new Event("inventoryApiReady"));
}


/* ==============================
   FETCH INVENTORY
============================== */
function fetchInventoryForProduct(productId) {

  if (!productId) return;
  if (FETCHING_PRODUCTS[productId]) return;

  FETCHING_PRODUCTS[productId] = true;

  const apiUrl =
    `https://offer.pharmacor.com.au/api/proxy/inventory-by-location` +
    `?shop=${Shopify.shop}` +
    `&customerId=${window.CUSTOMER_ID || ''}` +
    `&productIds=${productId}`;


  fetch(apiUrl)
    .then(res => res.json())
    .then(data => {
      buildInventoryMap(data);
      FETCHING_PRODUCTS[productId] = false;
    })
    .catch(error => {
      console.error("Inventory API Error:", error);
      FETCHING_PRODUCTS[productId] = false;
    });
}


/* ==============================
   UPDATE STOCK
============================== */
function updateStock($dropdown) {

  const $productWrap = $dropdown.closest(".custom-main-inner-wrap");
  const $stockBox = $productWrap.find(".custom-quantity-items");

  if (!$productWrap.length) return;

  const productId = $productWrap.data("product-id");

  if (!productId) return;


  /* =========================
     MATCH VARIANT
  ========================== */

  let variantId = null;

  $productWrap.find("input[myvarientid]").each(function () {

    const inputClasses = $(this).attr("class") || "";
    let matchAll = true;

    $productWrap.find(".custom_dropdown").each(function () {

      const rawVal = $(this).val();
      if (!rawVal) {
        matchAll = false;
        return false;
      }

      const normalized = rawVal
        .toLowerCase()
        .replace(/\s+/g, "-")
        .replace(/[\/\.]/g, "-");

      if (!inputClasses.includes(normalized)) {
        matchAll = false;
        return false;
      }

    });

    if (matchAll) {
      variantId = String($(this).attr("myvarientid"));
      return false;
    }

  });


  if (!variantId) {
    $stockBox.html("Out of Stock");
    return;
  }

  /* =========================
     CHECK INVENTORY MAP
  ========================== */

  if (!INVENTORY_MAP[variantId]) {
    fetchInventoryForProduct(productId);
    $stockBox.html("Loading...");
    return;
  }

  const variantData = INVENTORY_MAP[variantId];


  /* =========================
     DETECT SUPPLIER
  ========================== */

  let supplier = "";
  let supplierRaw = "";

  $productWrap.find(".custom_dropdown").each(function () {

    const rawVal = $(this).val();
    if (!rawVal) return;

    const cleanVal = rawVal.toLowerCase().replace(/[^a-z0-9]/g, "");

    if (cleanVal.includes("api")) {
      supplier = "api";
      supplierRaw = rawVal;
    }
    else if (cleanVal.includes("sigma")) {
      supplier = "sigma";
      supplierRaw = rawVal;
    }
    else if (cleanVal.includes("symbion")) {
      supplier = "symbion";
      supplierRaw = rawVal;
    }
    else if (cleanVal.includes("ch2")) {
      supplier = "ch2";
      supplierRaw = rawVal;
    }

    if (supplier) return false;

  });

 

  if (!supplier) {
    $stockBox.html("");
    return;
  }

  /* =========================
     CALCULATE STOCK
  ========================== */

  let totalStock = 0;
  const cleanSupplier = supplier.toLowerCase();

  Object.keys(variantData.locations).forEach(loc => {

    const locationOriginal = loc;
    const locationClean = loc.toLowerCase().replace(/[^a-z0-9]/g, "");
    const stock = parseInt(variantData.locations[loc]) || 0;



    if (locationClean.includes(cleanSupplier)) {
  
      totalStock += stock;
    }

  });


  if (totalStock > 0) {
    $stockBox.html("Stock: " + totalStock);
  } else {
    $stockBox.html("Out of stock");
  }

}


