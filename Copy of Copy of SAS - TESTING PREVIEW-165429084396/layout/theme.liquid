		const day   = String(d.getDate()).padStart(2, "0");
		const month = String(d.getMonth() + 1).padStart(2, "0");
		const year  = d.getFullYear();

		return `${year}-${month}-${day}`; // yyyy-mm-dd
		}
 
    /* ---------------- DISPLAY ORDER DATE ---------------- */
    function displayCartOrderDate(date) {
      if (!date) return;
 
      const formatted = formatDateDMY(date);
 
      /* Update ALL cart row date values (class, not ID) */
      document.querySelectorAll(".cart-order-date-value").forEach(function (el) {
        el.innerText = formatted;
      });
 
      /* Also update any legacy .cart-item-order-date elements */
      document.querySelectorAll(".cart-item-order-date").forEach(function (el) {
        el.innerText = formatted;
      });
    }
 
    /* ---------------- APPLY DATE TO CART ITEMS ---------------- */
    function applyOrderDateToAllProducts(cart) {
      const savedDate = cart.attributes?.["Order Date"];
      if (!savedDate) return;
 
      const dateValue = savedDate.split("T")[0];
 
      displayCartOrderDate(dateValue);
 
      const input = document.querySelector("#delivery-date");
      if (input && input.value !== dateValue) {
        input.value = dateValue;
      }
    }
 
    /* ---------------- CLEAR ATTRIBUTE IF CART EMPTY ---------------- */
    function clearOrderDateValue() {
