<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('form[action="/account/login"]');
    if (form) {
      form.addEventListener('submit', function () {
        sessionStorage.setItem('redirectAfterLogin', 'yes');
      });
    }

    // jab user account page pe land kare login ke turant baad
    if (sessionStorage.getItem('redirectAfterLogin') === 'yes' && window.location.pathname === '/account') {
      sessionStorage.removeItem('redirectAfterLogin');
      window.location.href = '/'; // home page redirect
    }
  });
</script>





<script>
  // Save cart to localStorage whenever it's updated
  function saveCartToLocalStorage(cartItems) {
    localStorage.setItem('shopify_cart', JSON.stringify(cartItems));
  }

  // Load cart from localStorage
  function loadCartFromLocalStorage() {
    const savedCart = localStorage.getItem('shopify_cart');
    return savedCart ? JSON.parse(savedCart) : [];
  }

  // Example: Hook into Shopify Ajax cart
  document.addEventListener('DOMContentLoaded', () => {
    // Load saved cart on page load
    const savedItems = loadCartFromLocalStorage();
    if(savedItems.length) {
      savedItems.forEach(item => {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: item.id, quantity: item.quantity })
        });
      });
    }

    // Whenever cart is updated, save it
    document.addEventListener('cart:updated', (e) => {
      saveCartToLocalStorage(e.detail.items);
    });
  });
</script>


