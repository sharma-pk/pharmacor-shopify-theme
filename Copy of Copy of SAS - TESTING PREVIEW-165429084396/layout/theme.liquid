 <script>
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.cart-drawer-subscription-buttons button');
    if (!btn) return;

    var ui = btn.closest('.cart-subscription-ui');
    if (!ui) return;

    var itemKey = ui.dataset.itemKey;
    var isOneTime = btn.classList.contains('one_time');

    // Step 1: Update button appearance immediately (no waiting)
    ui.querySelectorAll('.cart-drawer-subscription-buttons button').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');

    // Step 2: Get fresh cart data from Shopify so we never touch other properties
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        // Find this specific cart item by its key
        var cartItem = cart.items.find(function(i) { return i.key === itemKey; });
        if (!cartItem) return;

        // Copy ALL existing properties exactly as they are (Wholesaler, Processed Date, etc.)
        var updatedProps = Object.assign({}, cartItem.properties || {});
        console.log(updatedProps,"updatedProps");
        // Only change the subscription property — nothing else
        if (isOneTime) {
          delete updatedProps['subscription'];  // remove subscription for one-time
        } else {
          updatedProps['subscription'] = '6 month + 1 month free';  // set for subscribe
        }

        // Step 3: Send updated properties back to Shopify
        return fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: itemKey, quantity: cartItem.quantity, properties: updatedProps })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          // Step 4: Tell the cart drawer to re-render immediately with updated data
          if (window.themeCore && window.themeCore.EventBus) {
            window.themeCore.EventBus.emit('cart:refresh');
          }
        });
      })
      .catch(function(err) { console.error('Cart subscription update failed:', err); });
  });
  </script>
