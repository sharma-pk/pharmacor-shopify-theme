/* ======================================
   VARIANT CHANGE
====================================== */
document.addEventListener('change', async (e) => {
  if (!e.target.matches('.cart-variant-select')) return;

  const select = e.target;
  const cartItemEl = select.closest('.cart-item');
  const itemKey = cartItemEl?.dataset.cartItem;
  if (!itemKey) return;

  // locked per-line, not globally — changing one line must not block another line mid-flight
  window.__variantChangeInProgressKeys = window.__variantChangeInProgressKeys || new Set();
  if (window.__variantChangeInProgressKeys.has(itemKey)) return;
  window.__variantChangeInProgressKeys.add(itemKey);

  try {
    const selectedText = (select.options[select.selectedIndex]?.text || '').trim();

    // Detect brand using word boundaries
    const brandMatch = selectedText.toUpperCase().match(/\b(API|SIGMA|SYMBION|CH2)\b/);
    const brandFromSelect = brandMatch ? brandMatch[0] : '';

    // Find brand mapping from wholesaleParsed if available
    const match = Array.isArray(window.wholesaleParsed)
      ? window.wholesaleParsed.find(item => item.brand?.toUpperCase() === brandFromSelect)
      : null;

    let wholesalerValue = '';

    // if the customer explicitly picked a specific number for this brand (multi-number brands like API), honor it first
    const chosenOverride = (typeof resolveSelectedWholesalerAccountOverride === 'function') ? resolveSelectedWholesalerAccountOverride() : null;
    if (chosenOverride && chosenOverride.brand.toUpperCase() === brandFromSelect) {
      wholesalerValue = chosenOverride.number;
    }

    // was pooling every "selected_*" localStorage key together (including unrelated ones like selected_wholeseller/selected_country) and matching on string content in unpredictable key order — getLiveWholesalerNumberForBrand resolves this brand's number precisely, same as every other add-to-cart path
    if (!wholesalerValue && brandFromSelect && typeof getLiveWholesalerNumberForBrand === 'function') {
      wholesalerValue = getLiveWholesalerNumberForBrand(brandFromSelect.toLowerCase());
    }

    if (!wholesalerValue && match?.value) {
      wholesalerValue = extractAccountNumber(match.value, brandFromSelect);
    }

    // Show preloader while updating
    showPreloader();

    // Get new variant ID and current cart item quantity
    const newVariantId = Number(select.value);
    const cartRes = await fetch('/cart.js', { cache: 'no-store' });
    if (!cartRes.ok) { showCartUpdateError(); return; }
    const cart = await cartRes.json();
    const currentItem = cart.items.find(i => i.key === itemKey);
    if (!currentItem) return;
    const qty = currentItem.quantity;

    // Set up properties with empty wholesaler accounts first
    let props = {
      ...currentItem.properties,
      'Wholesaler Account No.1': '',
      'Wholesaler Account No.2': '',
      'Wholesaler Account No.3': '',
      'Wholesaler Account No.4': ''
    };

    // Assign account number to correct wholesaler field
    switch (brandFromSelect) {
      case 'API':
        props['Wholesaler Account No.1'] = wholesalerValue;
        break;
      case 'SIGMA':
        props['Wholesaler Account No.2'] = wholesalerValue;
        break;
      case 'SYMBION':
        props['Wholesaler Account No.3'] = wholesalerValue;
        break;
      case 'CH2':
        props['Wholesaler Account No.4'] = wholesalerValue;
        break;
    }

    // recomputed regardless of merge state — fixes stale/blank Saving Per Item on its own
    if (currentItem.handle) {
      props['Saving Per Item'] = await computeSavingPercentForVariant(currentItem.handle, newVariantId);
    }

    // normalized + deterministic regardless of merge state — same variant+wholesaler always gets the same value
    props = normalizeLineProperties(props);
    props._line_uid = computeLineUid(newVariantId, brandFromSelect, wholesalerValue);

    // Add the new variant FIRST — if this fails (e.g. rate-limited), the original line is
    // still untouched, so the customer never loses their cart item to a failed request.
    const addRes = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: newVariantId, quantity: qty, properties: props })
    });
    if (!addRes.ok) { showCartUpdateError(); await refreshCartDrawer(); return; }
    const addResult = await addRes.json();
    if (addResult.status || addResult.errors) { showCartUpdateError(); await refreshCartDrawer(); return; }

    // Only now remove the old line
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: itemKey, quantity: 0 })
    });

    if (currentItem.handle) {
      const cartAfter = await fetch('/cart.js', { cache: 'no-store' }).then(r => r.json());
      const mergedLine = cartAfter.items.find(i => i.variant_id === newVariantId && i.properties?._line_uid === props._line_uid);
      if (mergedLine) {
        await recalculateSavingPerItemAfterMerge(mergedLine.key, currentItem.handle, newVariantId);
      }
    }

    // Refresh cart drawer
    await refreshCartDrawer();

  } catch (err) {
    showCartUpdateError();
    await refreshCartDrawer();
  } finally {
    hidePreloader();
    setTimeout(() => window.__variantChangeInProgressKeys.delete(itemKey), 300);
  }
});

/* ======================================
   COVERAGE RECONCILIATION
====================================== */
const BRAND_PROPERTY_KEYS = {
  'Wholesaler Account No.1': 'api',
  'Wholesaler Account No.2': 'sigma',
  'Wholesaler Account No.3': 'symbion',
  'Wholesaler Account No.4': 'ch2'
};

function findCoveredReplacementVariant(product, currentVariant, wholesalerOptionIndex, brandPriority) {
  for (const brand of brandPriority) {
    const candidate = product.variants.find((v) => {
      const val = (v.options[wholesalerOptionIndex] || '').toLowerCase();
      if (val.indexOf(brand) === -1) return false;
      return v.options.every((optVal, idx) => idx === wholesalerOptionIndex || optVal === currentVariant.options[idx]);
    });
    if (candidate) return { variant: candidate, brand: brand };
  }
  return null;
}

// brand still covered but the account number may have changed — refresh it on the same line, no variant switch needed
async function refreshStaleWholesalerNumber(item, brand, preferredOverride) {
  const brandPropKey = Object.keys(BRAND_PROPERTY_KEYS).find((k) => BRAND_PROPERTY_KEYS[k] === brand);
  const currentNumber = sanitizeWholesalerNumber(item.properties[brandPropKey]);

  let correctNumber;
  if (preferredOverride && preferredOverride.brand === brand) {
    correctNumber = preferredOverride.number;
  } else {
    const accountEntry = window.__wholesalerCoverage.filter((c) => c.indexOf(brand) !== -1)[0] || '';
    correctNumber = sanitizeWholesalerNumber(accountEntry.replace(new RegExp(brand, 'gi'), ''));
  }

  if (!correctNumber || currentNumber === correctNumber) return false; // nothing stale, or nothing to correct to

  let props = Object.assign({}, item.properties);
  props[brandPropKey] = correctNumber;
  props = normalizeLineProperties(props);
  props._line_uid = computeLineUid(item.variant_id, brand.toUpperCase(), correctNumber);

  await fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: item.key, quantity: item.quantity, properties: props })
  });
  return true;
}

async function reconcileCartLine(item, preferredOverride) {
  let currentBrand = null;
  for (const key in BRAND_PROPERTY_KEYS) {
    if (item.properties && item.properties[key]) { currentBrand = BRAND_PROPERTY_KEYS[key]; break; }
  }
  if (!currentBrand) return false;

  const stillCovered = window.__wholesalerCoverage.some((c) => c.indexOf(currentBrand) !== -1);
  if (stillCovered) {
    return await refreshStaleWholesalerNumber(item, currentBrand, preferredOverride);
  }

  if (!item.handle) return false;
  const product = await fetch('/products/' + item.handle + '.js').then((r) => r.json());
  const currentVariant = product.variants.find((v) => v.id === item.variant_id);
  if (!currentVariant) return false;

  const wholesalerOptionIndex = product.options.findIndex((o) => {
    const name = typeof o === 'string' ? o : (o && o.name) || '';
    return name.toLowerCase() === 'wholesaler';
  });
  if (wholesalerOptionIndex === -1) return false;

  let brandPriority = ['api', 'sigma', 'symbion', 'ch2'].filter((b) => window.__wholesalerCoverage.some((c) => c.indexOf(b) !== -1));
  if (preferredOverride && brandPriority.includes(preferredOverride.brand)) {
    brandPriority = [preferredOverride.brand].concat(brandPriority.filter((b) => b !== preferredOverride.brand));
  }

  const replacement = findCoveredReplacementVariant(product, currentVariant, wholesalerOptionIndex, brandPriority);

  if (!replacement) {
    await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.key, quantity: 0 }) });
    return true;
  }

  const accountEntry = window.__wholesalerCoverage.filter((c) => c.indexOf(replacement.brand) !== -1)[0] || '';
  const accountNumber = sanitizeWholesalerNumber(accountEntry.replace(new RegExp(replacement.brand, 'gi'), ''));
  const finalNumber = (preferredOverride && preferredOverride.brand === replacement.brand) ? preferredOverride.number : accountNumber;

  let props = Object.assign({}, item.properties, {
    'Wholesaler Account No.1': '', 'Wholesaler Account No.2': '', 'Wholesaler Account No.3': '', 'Wholesaler Account No.4': ''
  });
  const brandPropKey = Object.keys(BRAND_PROPERTY_KEYS).find((k) => BRAND_PROPERTY_KEYS[k] === replacement.brand);
  props[brandPropKey] = finalNumber;
  // compute Saving Per Item from the product data already fetched above instead of a second /products/{handle}.js call
  const rvPrice = replacement.variant.price / 100;
  const rvCompare = (replacement.variant.compare_at_price || 0) / 100;
  props['Saving Per Item'] = rvCompare > rvPrice ? (((rvCompare - rvPrice) / rvCompare) * 100).toFixed(2) + '%' : '';
  props = normalizeLineProperties(props);
  props._line_uid = computeLineUid(replacement.variant.id, replacement.brand.toUpperCase(), finalNumber);

  const addRes = await fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: replacement.variant.id, quantity: item.quantity, properties: props })
  });
  if (addRes.ok) {
    await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.key, quantity: 0 }) });
  }
  return true;
}

async function reconcileCartWholesalerCoverage() {
  if (!window.__wholesalerCoverage || window.__wholesalerCoverage.length === 0) return;

  try {
    const cart = await fetch('/cart.js', { cache: 'no-store' }).then((r) => r.json());
    const preferredOverride = (typeof resolveSelectedWholesalerAccountOverride === 'function') ? resolveSelectedWholesalerAccountOverride() : null;
    let anyChanged = false;

    for (const item of cart.items) {
      try {
        if (await reconcileCartLine(item, preferredOverride)) anyChanged = true;
      } catch (e) {
        // one line's failure shouldn't block the rest
      }
    }

    if (anyChanged) await refreshCartDrawer();
  } catch (e) {
    // best-effort — never block page load on this
  }
}

/* ======================================
   INIT
====================================== */
document.addEventListener('DOMContentLoaded', () => {
  unlockAllCartDrawerButtons();
  initCartDrawerObserver();
  reconcileCartWholesalerCoverage();
});

/* Prevent invalid quantity characters */
document.addEventListener('keydown', e => {
  if (e.target.matches('[data-quantity-input]') && ['e','E','-','+'].includes(e.key)) {
    e.preventDefault();
  }
});
