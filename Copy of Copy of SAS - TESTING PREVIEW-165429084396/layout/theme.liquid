  if (!el.matches('[data-option]')) return;
  if (!el.getAttribute('data-option').toLowerCase().includes('wholesaler')) return;
  if (el.type === 'radio' && !el.checked) return;

  if (typeof handleWholesalerSelectionChange === 'function') handleWholesalerSelectionChange(el);
});

