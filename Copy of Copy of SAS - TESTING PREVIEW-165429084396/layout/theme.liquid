<script>

(function() {

  // Prevent multiple simultaneous cart fetches
  let cartFetchInProgress = false;
  let pendingCartPromise = null;

  // Update cart count in DOM
  function updateCartCount(count) {
    document.querySelectorAll('.js-header-cart-item-count')
      .forEach(el => el.textContent = count);

    document.querySelectorAll('.header__cart-count')
      .forEach(el => el.setAttribute('data-cart-count', count));
  }

  // Fetch cart count safely using await + lock
  async function fetchCartCount() {
    // If a fetch is already running, return same promise
    if (cartFetchInProgress) {
      return pendingCartPromise;
    }

    cartFetchInProgress = true;

    pendingCartPromise = (async () => {
      try {
        const res = await fetch('/cart.js', { credentials: 'same-origin' });
        const cart = await res.json();
        updateCartCount(cart.item_count || 0);
      } catch(e) {
        // fail silently
      } finally {
        cartFetchInProgress = false;
        pendingCartPromise = null;
      }
    })();

    return pendingCartPromise;
  }

  // Initial load
  document.addEventListener('DOMContentLoaded', () => {
    fetchCartCount();
  });

  // Observe cart drawer changes
  const cartDrawer = document.querySelector('#CartDrawer');
  if (cartDrawer) {
    const observer = new MutationObserver(() => {
      fetchCartCount();
    });
    observer.observe(cartDrawer, { childList: true, subtree: true });
  }

  // Add-to-cart form submit hook
  document.querySelectorAll('form[action^="/cart/add"]').forEach(form => {
    form.addEventListener('submit', () => {
      setTimeout(fetchCartCount, 400);
    });
  });

})();

</script>

