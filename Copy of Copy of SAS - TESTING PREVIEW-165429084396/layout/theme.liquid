<script>
$(document).ready(function () {

  // ---- helper for number parsing ----
  function parseMoney(val) {
    return parseFloat((val || "0").replace(/[^0-9.]/g, "")) || 0;
  }

  function handleDropdownChange($dropdown) {

    const $parent = $dropdown.closest('.custom-main-inner-wrap');

    // ===============================
    // Build variant key
    // ===============================
    let combinedValue = [];
    $parent.find('.custom_dropdown').each(function () {
      combinedValue.push(this.value);
    });

    combinedValue = combinedValue.join("-")
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[\/\.]/g, "-");

    if (!combinedValue) return; // no .custom_dropdown found under this parent — nothing to look up

    const $variantElements = $parent.find("." + combinedValue);

    // ===============================
    // Variant Data
    // ===============================
    let variantId = null;
    let variantProfit = 0;
    let variantQty = 0;
    let variantPrice = 0;
    let variantComparePrice = 0;
    let tierPrice = 0;

    if ($variantElements.length) {
      const $baseEl = $variantElements.first();
      variantId = $baseEl.attr("myvarientid");
      variantProfit = $baseEl.attr("variantprofit");
      variantQty = parseInt($baseEl.attr("varientquentity") || "0", 10);
      variantPrice = parseMoney($baseEl.attr("varienrprice"));
      variantComparePrice = parseMoney($baseEl.attr("varienrcompprice"));
      tierPrice = parseMoney($baseEl.attr("customwholesaleprice"));
    }

    // ===============================
    // Determine Final Display Price
    // ===============================
    let displayPrice = variantPrice;
    if (tierPrice > 0) {
      displayPrice = tierPrice;
    }

    // Fallback if variant price is missing
    if ((!displayPrice || displayPrice <= 0) && $parent.attr("data-price")) {
      displayPrice = parseMoney($parent.attr("data-price"));
    }

    // ===============================
    // MOQ vs Tier Logic (Widget Control)
    // ===============================
    const $volumeBox = $parent.find("#variant-volume-discount");
    const $volumeText = $volumeBox.find(".volume-offer-text");
    $volumeText.empty();

    let lowestMOQPrice = null;
    let lowestMOQQty = null;

    // Find all available MOQ offers
    let moqTiers = [];
    $variantElements.each(function () {
      const qty = parseInt($(this).attr("volumeqty") || "0", 10);
      const moqPrice = parseMoney($(this).attr("volumediscountprice"));

      if (qty > 0 && moqPrice > 0) {
        moqTiers.push({ qty: qty, price: moqPrice });
      }
    });

    // Sort tiers by quantity ascending
    moqTiers.sort((a, b) => a.qty - b.qty);

    // ===============================
    // DECISION LOGIC (unchanged)
    // ===============================
    if (tierPrice > 0 && moqTiers.length > 0) {

      // If Tier better → hide MOQ widget
      if (tierPrice <= moqTiers[0].price) {
        $volumeBox.hide();
      } 
      // If MOQ better → show all MOQ tiers
      else {
        moqTiers.forEach(t => {
          const row = document.createElement("div");
          row.innerHTML = `
            <span class="volume-qty">Buy ${t.qty}+</span>
            <span class="volume-price">
              <span class="volumne-arrow">→</span> $${t.price.toFixed(2)}
            </span>
          `;
          $volumeText.append(row);
        });
        $volumeBox.show();
      }

    } 
    else if (tierPrice > 0) {
      // Only Tier exists
      $volumeBox.hide();
    } 
    else if (moqTiers.length > 0) {
      // Only MOQ exists → show all
      moqTiers.forEach(t => {
        const row = document.createElement("div");
        row.innerHTML = `
          <span class="volume-qty">Buy ${t.qty}+</span>
          <span class="volume-price">
            <span class="volumne-arrow">→</span> $${t.price.toFixed(2)}
          </span>
        `;
        $volumeText.append(row);
      });
      $volumeBox.show();
    } 
    else {
      // Neither exists
      $volumeBox.hide();
    }

    // ===============================
    // Saving Percentage
    // ===============================
    {% comment %}
    if (variantComparePrice > displayPrice && variantComparePrice > 0) {
      let savingPercent = Math.round(((variantComparePrice - displayPrice) / variantComparePrice) * 100);
      if (savingPercent <= 0) savingPercent = 1;

      $parent.find(".custom-sale-pricee").html("Saving: " + savingPercent + "%");

      $parent.find(".price__discount")
        .contents()
        .filter(function () { return this.nodeType === 3; })
        .first()
        .replaceWith(savingPercent + "% ");
    }
    {%endcomment %}

    // ===============================
    // Ultra Theme Price Update
    // ===============================
    $parent.find(".price-item.price-item--sale").html("$" + displayPrice.toFixed(2));
 {% comment %}
    if (variantComparePrice > displayPrice) {
      $parent.find(".price-item.price-item--regular").html("$" + variantComparePrice.toFixed(2)).show();
    } else {
      $parent.find(".price-item.price-item--regular").hide();
    }
 {%endcomment %}
    $parent.find(".discount-price-item")
      .attr("data-wpd-variant-id", variantId)
      .html("$" + displayPrice.toFixed(2));

        $parent.find(".loyalty-points-value").text(Math.round(displayPrice * 100));

    // ===============================
    // Hidden Inputs
    // ===============================
    $parent.find(".my-add-to-cart-value").val(variantId);
    $parent.find("#my-variant-profit").val(variantProfit);
  }

  // ===============================
  // Events
  // ===============================
  $(document).on('change', '.custom_dropdown', function () {
    handleDropdownChange($(this));
  });

  $('.custom_dropdown').each(function () {
    handleDropdownChange($(this));
  });

});
</script>


