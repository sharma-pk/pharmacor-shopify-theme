<script>
(function () {

  if (window.__orderDateGlobalInit) return;
  window.__orderDateGlobalInit = true;

  /* ─── FORMAT DATE ─── */
  function formatDateDMY(date) {
    var d     = new Date(date);
    var day   = String(d.getDate()).padStart(2, "0");
    var month = String(d.getMonth() + 1).padStart(2, "0");
    var year  = d.getFullYear();
    return year + "-" + month + "-" + day;
  }

  /* ─── WRITE DATE TO ALL SPANS + INPUT ─── */
  function displayCartOrderDate(date) {
    var formatted = date ? formatDateDMY(date) : "";
    document.querySelectorAll(".cart-order-date-value").forEach(function (el) {
      el.innerText = formatted;
    });
    document.querySelectorAll(".cart-item-order-date").forEach(function (el) {
      el.innerText = formatted;
    });
    var input = document.querySelector("#delivery-date");
    if (input) input.value = formatted;
  }

  /* ─── CLEAR ORDER DATE (cart empty or clear button) ─── */
  function clearOrderDate() {
    fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ attributes: { "Order Date": "" } })
    }).then(function () {
      displayCartOrderDate("");
      console.log("✔ Order Date cleared");
    });
  }

  /* ─── SAVE DATE TO CART ATTRIBUTE ─── */
  function saveOrderDate(date) {
    return fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ attributes: { "Order Date": date } })
    }).then(function (r) { return r.json(); });
  }

  /* ─── LOAD CART + APPLY / SAVE DATE ─── */
  function loadAndApplyOrderDate() {
    fetch("/cart.js")
      .then(function (r) { return r.json(); })
      .then(function (cart) {

        /* Cart is empty — clear date */
        if (cart.items.length === 0) {
          clearOrderDate();
          return;
        }

        var savedDate = cart.attributes && cart.attributes["Order Date"];

        /* No date saved but cart has items → auto-set today */
        if (!savedDate) {
          var today = formatDateDMY(new Date()); // local calendar, not UTC
          savedDate = today;
          saveOrderDate(today);
          console.log("📅 Order Date auto-set to today:", today);
        }

        var dateValue = savedDate.split("T")[0];

        /* Retry display a few times to handle slow drawer renders */
        var attempts = 0;
        var interval = setInterval(function () {
          attempts++;
          displayCartOrderDate(dateValue);
          var spans = document.querySelectorAll(".cart-order-date-value");
          var allFilled = spans.length > 0 && Array.from(spans).every(function (el) {
            return el.innerText.trim() !== "";
          });
          if (allFilled || attempts >= 5) clearInterval(interval);
        }, 500);

      });
  }

  /* ─── USER PICKS A NEW DATE ─── */
  document.addEventListener("change", function (e) {
    if (!e.target || e.target.id !== "delivery-date") return;
    var selectedDate = e.target.value;
    if (!selectedDate) return;
    displayCartOrderDate(selectedDate);
    saveOrderDate(selectedDate).then(function () {
      displayCartOrderDate(selectedDate);
      console.log("📅 Order Date updated to:", selectedDate);
    });
  });

  /* ─── CLEAR CART BUTTON ─── */
  document.addEventListener("click", function (e) {
    if (!e.target) return;
    var btn = e.target.closest("#clear-cart-btn");
    if (!btn) return;

    /* Clear all cart items then clear the date */
    fetch("/cart/clear.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" }
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      clearOrderDate();
      /* Let the theme re-render the empty cart */
      document.documentElement.dispatchEvent(
        new CustomEvent("cart:refresh", { bubbles: true })
      );
      console.log("🗑 Cart cleared");
    });
  });

  /* ─── INTERCEPT fetch() — catch /cart/add from product page ─── */
  var _origFetch = window.fetch;
  window.fetch = function () {
    var args = arguments;
    var url  = typeof args[0] === "string" ? args[0] : (args[0] && args[0].url) || "";
    return _origFetch.apply(window, args).then(function (response) {
      if (url.indexOf("/cart/add") !== -1) {
        console.log("🛒 /cart/add detected — applying Order Date");
        [300, 700, 1200, 2000].forEach(function (delay) {
          setTimeout(loadAndApplyOrderDate, delay);
        });
      }
      return response;
    });
  };

  /* ─── MUTATION OBSERVER — theme re-renders cart drawer HTML ─── */
  var debounce;
  var observer = new MutationObserver(function (mutations) {
    for (var i = 0; i < mutations.length; i++) {
      for (var j = 0; j < mutations[i].addedNodes.length; j++) {
        var node = mutations[i].addedNodes[j];
        if (node.nodeType !== 1) continue;
        if (
          node.classList.contains("cart-item") ||
          node.classList.contains("cart-items__body") ||
          (node.querySelector && node.querySelector(".cart-item"))
        ) {
          clearTimeout(debounce);
          debounce = setTimeout(loadAndApplyOrderDate, 200);
          return;
        }
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });

  /* ─── Theme cart events ─── */
  ["cart:updated", "cart:refresh", "cart-drawer:open"].forEach(function (evt) {
    document.addEventListener(evt, function () {
      setTimeout(loadAndApplyOrderDate, 300);
    });
  });

  /* ─── Run on page load ─── */
  document.addEventListener("DOMContentLoaded", loadAndApplyOrderDate);

  console.log("✅ Order Date Global Script ready");

})();
</script>
<script>
  window.wholesaleNumbersRaw = [];
window.wholesaleParsed = [];

/* ======================================
   PARSE WHOLESALE NUMBERS FROM METAFIELD
====================================== */
{% assign company = customer.current_company | default: customer.company %}
{% if company and company.metafields.custom.wholesale_account_numbers %}
  var raw = `{{ company.metafields.custom.wholesale_account_numbers.value | strip_newlines | raw }}`;
  try {
    window.wholesaleNumbersRaw = JSON.parse(raw);
  } catch (e) {
    console.error("Invalid JSON in metafield:", raw, e);
  }
{% endif %}

// Convert "Sigma 123456" → { brand: "Sigma", value: "123456" }
if (Array.isArray(window.wholesaleNumbersRaw)) {
  window.wholesaleNumbersRaw.forEach(entry => {
    if (typeof entry === 'string' && entry.trim() !== '') {
      const parts = entry.split(" ");
      const brand = parts[0];
      const number = parts.slice(1).join(" ");
      window.wholesaleParsed.push({
        brand: brand.trim(),
        value: number.trim()
      });
    }
  });
}
console.log("Parsed wholesale list:", window.wholesaleParsed);
window.getSafeWholesalerAccount = function (brand, rawValue) {
  var value = (rawValue || '').toString().trim();
  if (value.length >= 10) {
    var match = Array.isArray(window.wholesaleParsed)
      ? window.wholesaleParsed.find(function (p) {
          return p.brand && p.brand.toUpperCase() === brand.toUpperCase();
        })
      : null;
    return match ? match.value : '';
  }
  return value;
};
