    display: flex; align-items: center; gap: 12px; padding: 14px 16px; font-size: 16px; font-weight: 700;
    color: #fff; border-radius: 10px; cursor: pointer; margin-bottom: 6px;
  }
  .cart-sub-setup-radio.is-selected,
  .cart-sub-setup-radio:has(input:checked) { background: #14301d; }
  .cart-sub-setup-radio input[type="radio"] {
    appearance: none; -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid #fff; background: transparent; flex: 0 0 auto; margin: 0; cursor: pointer;
  }
  .cart-sub-setup-radio input[type="radio"]:checked {
    border-color: #f44e9b; background: #f44e9b; box-shadow: inset 0 0 0 3px #14301d;
  }
  .cart-sub-setup-modal__custom-date { margin: 0 16px 12px; }
  .cart-sub-setup-modal__custom-date input[type="date"] {
    width: 100%; padding: 10px 12px; border: 1px solid #fff; border-radius: 8px; font-size: 14px;
    background-image: url(https://cdn.shopify.com/s/files/1/0726/4249/4700/files/calendar_1.png?v=1786617913);
    background-repeat: no-repeat;
    color: #fff;
  }
  .cart-sub-setup-modal__custom-date input[type="date"]::-webkit-calendar-picker-indicator { cursor: pointer; }
  .cart-sub-setup-modal__note {
    background: #fff; border-radius: 12px; padding: 16px; font-size: 14px; color: #222;
    margin-top: 16px;
  }
  .cart-sub-setup-modal__note .sub-toggle-row { display: flex; gap: 8px; margin-top: 12px; }
  .cart-sub-setup-modal__note .sub-toggle-row button {
    flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #d7ded8; background: #fff;
    font-size: 13px; font-weight: 600; cursor: pointer; color: #222;
  }
  .cart-sub-setup-modal__note .sub-toggle-row button.is-active { background: #1f4a2c; color: #fff; border-color: #1f4a2c; }
  .cart-sub-setup-modal__confirm {
    width: 100%; margin-top: 20px; padding: 14px; border-radius: 10px; font-size: 15px;
    font-weight: 700; background: #fff; color: #1f4a2c; border: none; cursor: pointer;
  }
  .cart-sub-setup-modal__confirm[disabled] { opacity: .6; cursor: default; }
</style>

<div class="cart-sub-setup-overlay" id="cartSubSetupModal">
  <div class="cart-sub-setup-modal">
    <h3>Set up your subscription</h3>
    <p class="cart-sub-setup-modal__desc">When should it start?</p>

    <label class="cart-sub-setup-radio">
      <input type="radio" name="cartSubSetupStart" value="today" checked>
      Start today
    </label>
    <label class="cart-sub-setup-radio">
      <input type="radio" name="cartSubSetupStart" value="first_next_month">
      1st of next month
    </label>
    <label class="cart-sub-setup-radio">
      <input type="radio" name="cartSubSetupStart" value="custom">
      Select your own date
    </label>

    <div class="cart-sub-setup-modal__custom-date" id="cartSubSetupCustomDateWrap" style="display:none;">
      <input type="date" id="cartSubSetupCustomDate" min="{{ 'now' | date: '%Y-%m-%d' }}" value="{{ 'now' | date: '%Y-%m-%d' }}">
    </div>

    <div class="cart-sub-setup-modal__note" id="cartSubSetupAnchorNote" style="display:none;">
      Since you picked a custom date, should future orders repeat on this date, or reset to the 1st after the first order?
      <div class="sub-toggle-row">
        <button type="button" data-value="repeat">Repeat on this date</button>
        <button type="button" class="is-active" data-value="reset_to_1st">Reset to 1st</button>
      </div>
    </div>

    <button type="button" class="cart-sub-setup-modal__confirm" id="cartSubSetupConfirm">Continue</button>
  </div>
</div>

<script>
(function () {
  if (window.__cartSubSetupInit) {
    console.log('[cart-sub-setup] init skipped: already initialized on this page');
    return;
  }
  window.__cartSubSetupInit = true;

  console.log(
    '[cart-sub-setup] script initialized. #cartSubSetupModal in DOM right now:',
    !!document.getElementById('cartSubSetupModal'),
    '- Subscription_button count right now:',
    document.querySelectorAll('.cart-drawer-subscription-buttons button.Subscription_button').length
  );

  // catches the modal being closed/hidden by ANYTHING — including code
  // outside this file entirely (another script directly toggling the class,
  // wiping the modal's innerHTML, etc.) — not just our own closeModal()
  (function watchModalForExternalChanges() {
    var modalEl = document.getElementById('cartSubSetupModal');
    if (!modalEl) return;
    var wasOpen = modalEl.classList.contains('is-open');
    new MutationObserver(function () {
      var isOpenNow = modalEl.classList.contains('is-open');
      if (wasOpen && !isOpenNow) {
        console.trace('[cart-sub-setup] #cartSubSetupModal LOST "is-open" class — see stack above');
      }
      wasOpen = isOpenNow;
    }).observe(modalEl, { attributes: true, attributeFilter: ['class', 'style'] });
  })();

  document.addEventListener('focus', function (e) {
    if (e.target && e.target.id === 'cartSubSetupCustomDate') {
      console.log('[cart-sub-setup] date input FOCUSED');
    }
  }, true);

  document.addEventListener('blur', function (e) {
    if (e.target && e.target.id === 'cartSubSetupCustomDate') {
      console.log('[cart-sub-setup] date input BLURRED');
    }
  }, true);

  var pendingItemKey = null;
  var pendingVariantId = null;

  // Local calendar, not UTC — toISOString() recorded the chosen start date a day early.
  function formatDate(d) {
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
  }
  function firstOfNextMonth() {
    var d = new Date();
    return formatDate(new Date(d.getFullYear(), d.getMonth() + 1, 1));
  }

  // re-queried on every call rather than cached — the drawer re-renders this
  // markup from scratch on every cart refresh, so a cached reference would
  // silently go stale and point at a detached node
  function getModalEls() {
    var modal = document.getElementById('cartSubSetupModal');
    if (!modal) return null;
    return {
      modal: modal,
      anchorNote: document.getElementById('cartSubSetupAnchorNote'),
      customDateWrap: document.getElementById('cartSubSetupCustomDateWrap'),
      customDateInput: document.getElementById('cartSubSetupCustomDate'),
      startRadios: modal.querySelectorAll('input[name="cartSubSetupStart"]')
    };
  }

  function refreshSelectedRow(els) {
    els.startRadios.forEach(function (r) {
      r.closest('.cart-sub-setup-radio').classList.toggle('is-selected', r.checked);
    });
  }

  function resetModal(els) {
    els.startRadios.forEach(function (r) { r.checked = r.value === 'today'; });
    refreshSelectedRow(els);
    els.customDateWrap.style.display = 'none';
    els.anchorNote.style.display = 'none';
    if (els.customDateInput) els.customDateInput.value = formatDate(new Date());
    els.anchorNote.querySelectorAll('.sub-toggle-row button').forEach(function (b) {
      b.classList.toggle('is-active', b.dataset.value === 'reset_to_1st');
    });
  }

  function openModal(itemKey, variantId) {
    console.log('[cart-sub-setup] openModal called for item:', itemKey, '- variantId:', variantId);

    var els = getModalEls();

    if (!els) {
      console.warn('[cart-sub-setup] openModal aborted: #cartSubSetupModal not found in DOM');
      return;
    }

    pendingItemKey = itemKey;
    pendingVariantId = variantId;
    resetModal(els);
    els.modal.classList.add('is-open');

    // the cart drawer (#CartDrawer) is also position:fixed and stays open
    // underneath this modal — two stacked fixed-position full-screen layers
    // is a known source of native-picker positioning bugs on iOS Safari
    // (the product page's identical popup never has this problem, because
    // there the drawer is closed and only one fixed layer exists at a
    // time). Hiding the drawer purely visually — not touching its own
    // open/close state — removes the second layer while our modal is up.
    var drawerEl = document.getElementById('CartDrawer');
    if (drawerEl) drawerEl.style.display = 'none';

    console.log('[cart-sub-setup] modal opened, is-open class added:', els.modal.classList.contains('is-open'));
  }

  function closeModal() {
    console.trace('[cart-sub-setup] closeModal() called — see stack above for who called it');

    var els = getModalEls();
    if (els) els.modal.classList.remove('is-open');
    pendingItemKey = null;
    pendingVariantId = null;

    var drawerEl = document.getElementById('CartDrawer');
    if (drawerEl) drawerEl.style.display = '';
  }

  function dispatchCartRefresh() {
    document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    if (window.themeCore && window.themeCore.EventBus) {
      window.themeCore.EventBus.emit('cart:refresh');
    }

    // the events above don't actually re-render the drawer's own markup —
    // nothing was listening to them to re-fetch it, so a just-saved property
    // like Processed Date wouldn't show until something else (e.g. reopening
    // the drawer) happened to trigger a real refresh. refreshCartDrawer()
    // (defined elsewhere in this file) is the theme's actual drawer-content
    // refresh — call it directly so the change is visible immediately.
    //
    // it guards against overlapping refreshes via window.__refreshingCart and
    // silently no-ops if one is already running — which is exactly what
    // happens on a subscription's very first confirm: this page also runs a
    // wholesaler-reconciliation pass on DOMContentLoaded that calls this same
    // function, and on a slow connection that pass can still be in flight
    // when the customer finishes the popup. A single unchecked call would
    // silently do nothing then — the property saves fine server-side, but
    // the drawer never redraws to show it until something else triggers a
    // refresh later. Retrying while it's busy avoids that.
    function tryRefreshDrawer(attemptsLeft) {
      if (typeof window.refreshCartDrawer !== 'function') return;

      if (window.__refreshingCart) {
        if (attemptsLeft > 0) {
          setTimeout(function () { tryRefreshDrawer(attemptsLeft - 1); }, 300);
        }
        return;
      }

      window.refreshCartDrawer();
    }

    tryRefreshDrawer(6);
  }

  // updates just the one cart line's properties via the Ajax Cart API —
  // properties are always the full merged set (existing + changed), since
  // /cart/change.js replaces a line's properties rather than patching them
  function updateLineProperties(itemKey, properties, activeBtnSelector) {
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: itemKey, properties: properties })
    })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var ui = document.querySelector('.cart-subscription-ui[data-item-key="' + CSS.escape(itemKey) + '"]');
        if (ui) {
          ui.querySelectorAll('.Subscription_buttons button').forEach(function (b) { b.classList.remove('active'); });
          var activeBtn = activeBtnSelector ? ui.querySelector(activeBtnSelector) : null;
          if (activeBtn) activeBtn.classList.add('active');
        }
        dispatchCartRefresh();
        return cart;
      });
  }

  document.addEventListener('click', function (e) {
    var subBtn = e.target.closest('.cart-drawer-subscription-buttons button.Subscription_button');

    console.log('[cart-sub-setup] document click:', e.target, '-> Subscription_button match:', !!subBtn);

    if (subBtn) {
      var ui2 = subBtn.closest('.cart-subscription-ui');

      console.log('[cart-sub-setup] Subscription_button clicked, closest .cart-subscription-ui:', ui2);

      if (!ui2) {
        console.warn('[cart-sub-setup] aborted: no .cart-subscription-ui ancestor found for this button');
        return;
      }
      openModal(ui2.dataset.itemKey, ui2.dataset.variantId);
      return;
    }

    var anchorToggleBtn = e.target.closest('#cartSubSetupAnchorNote .sub-toggle-row button');
    if (anchorToggleBtn) {
      anchorToggleBtn.parentElement.querySelectorAll('button').forEach(function (b) { b.classList.remove('is-active'); });
      anchorToggleBtn.classList.add('is-active');
      return;
    }

    var confirmBtn = e.target.closest('#cartSubSetupConfirm');
    if (confirmBtn) {
      var els = getModalEls();
      if (!els || !pendingItemKey) return;
      var checkedRadio = els.modal.querySelector('input[name="cartSubSetupStart"]:checked');
      var choice = checkedRadio ? checkedRadio.value : 'today';
      var chosenDate, anchorMode = null;

      if (choice === 'today') {
        chosenDate = formatDate(new Date());
      } else if (choice === 'first_next_month') {
        chosenDate = firstOfNextMonth();
      } else {
        chosenDate = (els.customDateInput && els.customDateInput.value) || formatDate(new Date());
        var activeAnchorBtn = els.anchorNote.querySelector('.sub-toggle-row button.is-active');
        anchorMode = activeAnchorBtn ? activeAnchorBtn.dataset.value : 'reset_to_1st';
      }

      var openedItemKey = pendingItemKey;
      var variantId = pendingVariantId ? parseInt(pendingVariantId, 10) : null;
      confirmBtn.disabled = true;

      // Shopify computes a cart line's key from variant id + a hash of its
      // properties — so ANY properties change on a line (including the
      // wholesaler-reconciliation pass this page runs on load) changes that
      // line's key too. openedItemKey was captured when the popup opened
      // and can already be stale by the time Continue is clicked; posting
      // to a key that no longer exists gets a 400 from /cart/change.js.
      // Waiting for reconciliation to finish isn't enough on its own — we
      // also have to re-resolve the line fresh afterward, by variant id
      // (which never changes) rather than trusting openedItemKey.
      console.log('[cart-sub-setup] CONFIRM clicked. openedItemKey:', openedItemKey, '- variantId:', variantId, '- chosenDate:', chosenDate, '- anchorMode:', anchorMode, '- reconcile promise pending:', !!window.__wholesalerReconcilePromise);

      Promise.resolve(window.__wholesalerReconcilePromise)
        .then(function () {
          console.log('[cart-sub-setup] reconcile wait finished (or was never pending) — fetching /cart.js');
          return fetch('/cart.js');
        })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          console.log('[cart-sub-setup] /cart.js returned', cart.items.length, 'line(s). All keys:', cart.items.map(function (it) { return it.key; }));

          // prefer matching by variant id (stable across property/key
          // changes); fall back to the key we opened with only if we never
          // had a variant id to go on (e.g. stale drawer markup)
          var line = variantId
            ? cart.items.find(function (it) { return it.variant_id === variantId; })
            : cart.items.find(function (it) { return it.key === openedItemKey; });

          console.log('[cart-sub-setup] line for variantId', variantId, '->', line ? ('FOUND, current key ' + line.key) : 'NOT FOUND', '- its current properties:', line && line.properties);

          if (!line) {
            throw new Error('Could not find this item in the cart anymore — it may have been removed or changed.');
          }

          var currentItemKey = line.key;
          var finalProps = Object.assign({}, line.properties);

          finalProps['subscription'] = '6 month + 1 month free';
          finalProps[DELIVERY_DATE_PROPERTY_KEY] = chosenDate;
          if (anchorMode === 'reset_to_1st') {
            finalProps['Renewal Anchor'] = 'reset_to_1st';
          } else {
            delete finalProps['Renewal Anchor'];
          }

          console.log('[cart-sub-setup] finalProps about to be sent to /cart/change.js for key', currentItemKey, ':', JSON.parse(JSON.stringify(finalProps)));

          return updateLineProperties(currentItemKey, finalProps, 'button.Subscription_button');
        })
        .then(function () {
          confirmBtn.disabled = false;
          closeModal();
        })
        .catch(function (err) {
          console.error('[cart-sub-setup] confirm flow failed:', err);
          confirmBtn.disabled = false;
        });
      return;
    }
  });

  // bound directly to the overlay (not delegated via `document`) — this
  // modal lives in the layout, not inside the AJAX-refreshed drawer partial,
  // so it's never removed/recreated and a direct binding is safe. Mirrors
  // the product page's popup, which uses the same direct-binding pattern.
  // A document-level delegated click listener was closing this modal
  // spuriously on iOS: interacting with the native inline date-picker for
  // "Select your own date" produced a bubbled click whose target resolved
  // to this overlay by the time it reached `document`, so the "click
  // outside to close" check fired and killed the picker along with the
  // modal the instant it opened.
  var cartSubSetupOverlayEl = document.getElementById('cartSubSetupModal');
  if (cartSubSetupOverlayEl) {
    cartSubSetupOverlayEl.addEventListener('click', function (e) {
      if (e.target === cartSubSetupOverlayEl) {
        closeModal();
      }
    });
  }

  document.addEventListener('change', function (e) {
    if (!e.target.matches || !e.target.matches('input[name="cartSubSetupStart"]')) return;
    var els = getModalEls();
    if (!els) return;
    var isCustom = e.target.value === 'custom' && e.target.checked;
    els.customDateWrap.style.display = isCustom ? '' : 'none';
    els.anchorNote.style.display = isCustom ? '' : 'none';
    refreshSelectedRow(els);
  });
})();
</script>
{% endif %}

  </body>
</html>

