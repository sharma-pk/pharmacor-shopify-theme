<script>
let bundleInitialized = false;

/* ===============================
   MONEY FORMAT (expects cents)
=============================== */
function money(cents) {
  return '$' + (cents / 100).toFixed(2);
}

/* ===============================
   ENABLE ONLY BUNDLE BUTTONS
=============================== */
function enableButtons() {
  const bundleArea = document.getElementById('bundle-wrapper');
  if (!bundleArea) return;

  bundleArea.querySelectorAll('button, input[type="submit"], .bundle-card input').forEach(el => {
    el.disabled = false;
    el.removeAttribute('aria-disabled');
    el.classList.remove('disabled');
  });
}

/* ===============================
   SET BUNDLE QUANTITY (SAFE)
=============================== */
function setBundleQuantity() {
  setTimeout(() => {
    const qtyInput = document.querySelector('.custom-class-quantity, input[name="quantity"]');
    if (!qtyInput) return;

    const activeBundle = document.querySelector('.bundle-card.is-active');
    let qty = 1;

    if (activeBundle?.id?.startsWith('moq-card')) {
      const qtyEl = activeBundle.querySelector('.bundle-text strong');
      if (qtyEl) {
        const match = qtyEl.innerText.match(/(\d+)\+/);
        if (match) qty = Number(match[1]);
      }
    }

    qtyInput.value = qty;
    qtyInput.dispatchEvent(new Event('change', { bubbles: true }));

    setTimeout(enableButtons, 50);
  }, 0);
}

/* ===============================
   RESTORE ACTIVE BUNDLE (NO STORAGE)
=============================== */
function restoreActiveBundle() {
  const allCards = document.querySelectorAll('.bundle-card[id^="moq-card-"]');

  allCards.forEach(c => {
    c.classList.remove('is-active');
  });

  let activeCard =
    document.querySelector('.bundle-card input[type="radio"]:checked')?.closest('.bundle-card');

  if (!activeCard) {
    activeCard = document.getElementById('moq-card-1');
  }

  if (activeCard) {
    activeCard.classList.add('is-active');
    activeCard.querySelector('input')?.setAttribute('checked', true);
  }
}

/* ===============================
   UPDATE BUNDLE DATA
=============================== */
function updateBundleData(variantId) {

  const v = window.productData?.variants?.[variantId];
  const bundleWrapper = document.getElementById('bundle-wrapper');
  if (!v || !bundleWrapper) return;

  /* ===============================
     NO VOLUME DISCOUNT
  =============================== */
  if (!Array.isArray(v.volume_discounts) || v.volume_discounts.length === 0) {
    bundleWrapper.style.display = 'none';

    document.querySelectorAll('.bundle-card').forEach(c => {
      c.classList.remove('is-active');
      c.style.display = 'none';
    });

    document.querySelector('.bundle-card')?.classList.add('is-active');
    document.querySelector('.bundle-card')?.style.setProperty('display', '');

    setBundleQuantity();
    setTimeout(enableButtons, 50);
    return;
  }

  bundleWrapper.style.display = '';

  /* ===============================
     SINGLE PRICE
  =============================== */
  const basePriceCents = v.price;
  const compareBaseCents =
    (v.compare_at_price && v.compare_at_price > v.price)
      ? v.compare_at_price
      : null;

  document.getElementById('single-price').innerText = money(basePriceCents);

  const singleCompareEl = document.getElementById('single-compare');
  if (compareBaseCents) {
    singleCompareEl.innerText = money(compareBaseCents);
    singleCompareEl.style.display = '';
  } else {
    singleCompareEl.style.display = 'none';
  }

  /* ===============================
     MOQ TIERS (FIXED + SAFE)
  =============================== */

  const allCards = document.querySelectorAll('.bundle-card[id^="moq-card-"]');

  // reset all
  allCards.forEach(card => {
    card.style.display = 'none';
    card.classList.remove('is-active');
  });

  if (!Array.isArray(v.volume_discounts) || v.volume_discounts.length === 0) {
    return;
  }

  v.volume_discounts.forEach((tier, index) => {

    const card = document.getElementById(`moq-card-${index + 1}`);
    if (!card) return;

    card.style.display = '';

    const titleEl = card.querySelector('.bundle-text strong');
    if (titleEl) {
      titleEl.innerText = `${tier.quantityThreshold}+ MOQ Deal`;
    }
     const subEl = card.querySelector('.bundle-sub');
      if (subEl) {
        subEl.innerText = `You save ${tier.discountPercent}%`;
      }

    const discountMultiplier = (100 - tier.discountPercent);

    const totalDiscountedCents = Math.round(
      (basePriceCents * tier.quantityThreshold * discountMultiplier) / 100
    );

    const discountedUnitPriceCents = Math.floor(
      totalDiscountedCents / tier.quantityThreshold
    );

    const totalCompareCents = compareBaseCents
      ? Math.round(compareBaseCents * tier.quantityThreshold * (1 - tier.discountPercent / 100))
      : null;

    card.querySelector('.moq-price').innerText =
      money(discountedUnitPriceCents);

    const compareEl = card.querySelector('.moq-compare');
    if (compareBaseCents) {
      compareEl.innerText = money(compareBaseCents);
      compareEl.style.display = '';
    } else {
      compareEl.style.display = 'none';
    }

    card.querySelector('.moq-total-price').innerText =
      money(totalDiscountedCents);

    const totalCompareEl = card.querySelector('.moq-total-compare');
    if (totalCompareCents) {
      totalCompareEl.innerText = money(totalCompareCents);
      totalCompareEl.style.display = '';
    } else {
      totalCompareEl.style.display = 'none';
    }
  });

  /* ===============================
     FINAL RESTORE + SYNC
  =============================== */

  setTimeout(() => {
    restoreActiveBundle();
    setBundleQuantity();
    enableButtons();
  }, 0);

  /* OBSERVER */
  const observerTarget = document.getElementById('bundle-wrapper');
  if (observerTarget && !observerTarget.__observerAdded) {
    const observer = new MutationObserver(() => enableButtons());
    observer.observe(observerTarget, {
      attributes: true,
      subtree: true,
      attributeFilter: ['disabled', 'aria-disabled']
    });
    observerTarget.__observerAdded = true;
  }
}

/* ===============================
   INIT
=============================== */
document.addEventListener('DOMContentLoaded', () => {

  const variantInput = document.querySelector('input[name="id"]');

  if (variantInput?.value)
    updateBundleData(variantInput.value);

  if (variantInput) {
    new MutationObserver(() => {
      updateBundleData(variantInput.value);
    }).observe(variantInput, {
      attributes: true,
      attributeFilter: ['value']
    });
  }

  setTimeout(enableButtons, 100);
});

/* ===============================
   VARIANT CHANGE
=============================== */
document.addEventListener('variant:change', e => {
  if (e.detail?.variant?.id) {
    updateBundleData(e.detail.variant.id);

    setTimeout(() => {
      setBundleQuantity();
      enableButtons();
    }, 0);
  }
});

/* ===============================
   BUNDLE CHANGE
=============================== */
document.addEventListener('change', e => {

  if (e.target.name === 'bundle') {

    const activeCard = e.target.closest('.bundle-card');

    document.querySelectorAll('.bundle-card').forEach(card => {
      card.classList.remove('is-active');
      card.classList.add('bundle-active');
    });

    if (activeCard) {
      activeCard.classList.remove('bundle-active');
      activeCard.classList.add('is-active');
    }

    setBundleQuantity();
    setTimeout(enableButtons, 50);
  }
});
</script>


