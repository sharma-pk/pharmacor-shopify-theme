<script>
function initCustomWrappers() {

  const wrappers = document.querySelectorAll('.custom-list-wrapper');

  wrappers.forEach(wrapper => {

    if (wrapper.dataset.initialized === "true") return;
    wrapper.dataset.initialized = "true";

    const selects = wrapper.querySelectorAll('select');
    const jsonEl = wrapper.querySelector('.product-variants-json');

    let variantsData = [];

    if (jsonEl) {
      try {
        variantsData = JSON.parse(jsonEl.textContent);
      } catch (e) {
        console.error("Variant JSON parse error", e);
      }
    }

    function updateActiveState() {

      let values = [];
      let wholesalerValue = '';

      selects.forEach(select => {

        select.classList.remove('is-active');

        Array.from(select.options).forEach(option =>
          option.classList.remove('is-active')
        );

        const selectedOption = select.options[select.selectedIndex];

        if (selectedOption) {

          selectedOption.classList.add('is-active');
          select.classList.add('is-active');

          const text = selectedOption.text.trim();
          values.push(text);

          if (select.classList.contains('customwholesaler')) {
            wholesalerValue = text;
          }
        }

      });

      wrapper.dataset.activeValues = values.join(' | ');
      wrapper.dataset.values = wholesalerValue;

      const matchedVariant = variantsData.find(variant => {
        return variant.options.every((opt, index) => opt === values[index]);
      });

      wrapper.dataset.activeVariant = matchedVariant
        ? matchedVariant.id
        : '';
    }

    updateActiveState();

    selects.forEach(select => {
      select.addEventListener('change', updateActiveState);
    });

  });
}

/* ==============================
   INITIAL LOAD
============================== */
document.addEventListener('DOMContentLoaded', function () {
  initCustomWrappers();
});

/* ==============================
   WATCH FOR DOM REPLACEMENT
============================== */
(function () {
  var observer = new MutationObserver(function (mutations) {
    mutations.forEach(function (mutation) {
      if (mutation.addedNodes.length > 0) {
        initCustomWrappers();
      }
    });
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();
</script>



