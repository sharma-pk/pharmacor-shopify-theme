<script>
/* ======================================
   HELPER FUNCTIONS
====================================== */
// Extract account number, removing brand prefix (numbers can contain letters, so only whitespace is stripped)
function extractAccountNumber(value, brand = '') {
  if (!value || typeof value !== 'string') return '';
  // Remove brand from the start (case-insensitive)
  const cleaned = value.replace(new RegExp('^' + brand, 'i'), '');
  return sanitizeWholesalerNumber(cleaned);
}

/* ======================================
   GLOBAL FLAGS
====================================== */
window.__variantChangeInProgress = false;
window.__refreshingCart = false;
window.__cartQtyUpdating = false;
window.__cartRemoveUpdating = false;

/* ======================================
   PRELOADER
====================================== */
function showPreloader() {
  document.querySelector('.js-preloader')?.classList.add('is-active');
}
function hidePreloader() {
  document.querySelector('.js-preloader')?.classList.remove('is-active');
}

// shown when a cart update fails (e.g. rate-limited by another app) so the customer knows to retry, instead of it failing silently
function showCartUpdateError() {
  console.error('[Cart] update failed — likely rate-limited, please retry');
  document.querySelectorAll('.cart-update-error-toast').forEach(function (el) { el.remove(); });
  var toast = document.createElement('div');
  toast.className = 'cart-update-error-toast';
  toast.textContent = 'Could not update your cart — please try again.';
  toast.style.cssText = 'position:fixed;top:90px;right:20px;background:#c0392b;color:#fff;padding:14px 24px;border-radius:8px;font-size:14px;font-weight:600;z-index:999999;';
  document.body.appendChild(toast);
  setTimeout(function () { toast.remove(); }, 4000);
}

/* ======================================
   CART DRAWER HELPERS
====================================== */
function unlockAllCartDrawerButtons() {
  const drawer = document.querySelector('#CartDrawer');
  if (!drawer) return;

  drawer.querySelectorAll('button, [data-quantity-increase], [data-quantity-decrease]').forEach(btn => {
    btn.disabled = false;
    btn.removeAttribute('disabled');
    btn.removeAttribute('aria-disabled');
    btn.classList.remove('disabled');
  });
}

let cartDrawerObserver = null;

/* ======================================
   REFRESH CART DRAWER
====================================== */
async function refreshCartDrawer() {
  if (window.__refreshingCart) return;
  window.__refreshingCart = true;

  const drawer = document.querySelector('#CartDrawer');
  if (!drawer) return;

  cartDrawerObserver?.disconnect();

  try {
    const res = await fetch(`${location.pathname}?section_id=cart-drawer`, { cache: 'no-store' });
    const html = await res.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const newDrawer = doc.querySelector('#CartDrawer');

    if (newDrawer) {
      drawer.innerHTML = newDrawer.innerHTML;
      unlockAllCartDrawerButtons();
    }
  } finally {
    initCartDrawerObserver();
    window.__refreshingCart = false;
  }
}

/* ======================================
   CART DRAWER OBSERVER
====================================== */
function initCartDrawerObserver() {
  const drawer = document.querySelector('#CartDrawer');
  if (!drawer) return;

  if (!cartDrawerObserver) {
    cartDrawerObserver = new MutationObserver(mutations => {
      for (let m of mutations) {
        if (m.type === 'attributes' && ['disabled','aria-disabled'].includes(m.attributeName)) {
          unlockAllCartDrawerButtons();
        }
      }
    });
  }

  cartDrawerObserver.observe(drawer, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['disabled', 'aria-disabled']
  });
}

/* ======================================
   QUANTITY BUTTONS
====================================== */
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('[data-quantity-increase],[data-quantity-decrease]');
  if (!btn || window.__cartQtyUpdating) return;

  const input = btn.closest('.js-quantity')?.querySelector('[data-quantity-input]');
  if (!input) return;

  window.__cartQtyUpdating = true;

  let qty = Number(input.value) + (btn.hasAttribute('data-quantity-increase') ? 1 : -1);
  qty = Math.max(1, qty);

  try {
    showPreloader();
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: input.dataset.itemKey, quantity: qty })
    });
    await refreshCartDrawer();
  } finally {
    hidePreloader();
    window.__cartQtyUpdating = false;
  }
});

/* ======================================
   CART MANUAL INPUT (DEBOUNCED)
====================================== */
let inputDebounceTimer = null;
document.addEventListener('input', (e) => {
  const input = e.target.closest('[data-quantity-input]');
  if (!input) return;

  const val = Number(input.value);
  if (isNaN(val) || val < 1) return;
  input.__lastValidQty = val;
});

document.addEventListener('blur', (e) => {
  const input = e.target.closest('[data-quantity-input]');
  if (!input) return;

  clearTimeout(inputDebounceTimer);
  inputDebounceTimer = setTimeout(async () => {
    let qty = Number(input.value);
    if (isNaN(qty) || qty < 1) qty = input.__lastValidQty || 1;

    window.__cartQtyUpdating = true;
    try {
      showPreloader();
      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: input.dataset.itemKey, quantity: qty })
      });
      await refreshCartDrawer();
    } finally {
      hidePreloader();
      window.__cartQtyUpdating = false;
