function handleVariantChange(el){

  var section = el.closest('.custom-variant');
  if (!section) return;

  // Collect checked radios inside this product
  var inputs = section.querySelectorAll('input.radioinput:checked');
  var values = [];
  inputs.forEach(cb => values.push(cb.value));

  // Build variant key
  var joined = values.join('-')
    .toLowerCase()
    .replace(/[^a-z0-9\- ]+/g, '')
    .replace(/[\s_]+/g, '-')
    .replace(/-+/g, '-')
    .replace(/-/g, '');

  // Find hidden variant input
  var matchedEl = section.querySelector('.custom' + joined);

  // Always define variantInput BEFORE using
  var variantInput = section.querySelector('#variant-id');

  if (matchedEl) {
    var val = matchedEl.value;

    const price = matchedEl.getAttribute('variant-price');
    const compareprice = matchedEl.getAttribute('compareprice');

    const productCard = matchedEl.closest('.product-card');
    const priceItemEl = productCard?.querySelector('.price-item');
    const oldprice    = productCard?.querySelector('.price__olds span');

    if (priceItemEl) priceItemEl.textContent = price;
    if (oldprice) oldprice.textContent = compareprice;

    if (variantInput) {
      variantInput.setAttribute('data-variant-id', val);
    }
  }

  // --- Handle wholesaler accounts (scoped to this product's own section) — same shared resolution used on every other page ---
  applyWholesalerValue(section);

  var brand = values.includes('API') ? 'api' : values.includes('Sigma') ? 'sigma' : values.includes('Symbion') ? 'symbion' : values.includes('CH2') ? 'ch2' : '';
  if (brand) {
    var number = getLiveWholesalerNumberForBrand(brand);
    applyWholesalerValue(section, brand, number);
    if (number) $(variantInput).removeClass('emptybutton');
    else if (brand === 'api') $(variantInput).addClass('emptybutton'); // matches prior behavior: only API added the empty state, others only cleared it
  }
}

// product page: switching the Wholesaler option radio/select never touched the .API/.Sigma/.Symbion/.Ch2 hidden inputs — routes through the one shared handleWholesalerSelectionChange() (wholesaler-shared.js) now
