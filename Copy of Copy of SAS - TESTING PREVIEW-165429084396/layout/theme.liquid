        });
 
        /* Also clear legacy elements */
        document.querySelectorAll(".cart-item-order-date").forEach(function (el) {
          el.innerText = "";
        });
 
        console.log("✔ Order Date cleared");
      });
    }
 
    /* ---------------- LOAD ORDER DATE ---------------- */
    function loadOrderDate() {
      fetch("/cart.js")
        .then(res => res.json())
        .then(cart => {
 
          const savedDate = cart.attributes?.["Order Date"];
 
          /* AUTO APPLY TODAY if cart has items but no date saved */
          if (!savedDate && cart.items.length > 0) {
 
            const today = formatDateDMY(new Date()); // local calendar, not UTC
 
            $("#delivery-date").val(today);
 
            displayCartOrderDate(today);
 
            $("#selected-delivery-date").html(
              `<p>Selected Order Date: <strong>${formatDateDMY(today)}</strong></p>`
            );
 
            fetch("/cart/update.js", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                attributes: { "Order Date": today }
              })
            });
 
            console.log("📅 Auto applied Order Date:", today);
          }
 
          /* If a date is already saved, restore it */
          if (savedDate) {
            const dateValue = savedDate.split("T")[0];
 
            $("#delivery-date").val(dateValue);
 
            displayCartOrderDate(dateValue);
 
            $("#selected-delivery-date").html(
              `<p>Selected Order Date: <strong>${formatDateDMY(dateValue)}</strong></p>`
            );
          }
 
          applyOrderDateToAllProducts(cart);
 
          /* Clear if cart is empty */
          if (cart.items.length === 0) {
            clearOrderDateValue();
          }
 
        });
    }
 
    loadOrderDate();
 
    /* ---------------- SAVE DATE ON CHANGE ---------------- */
    $(document).on("change", "#delivery-date", function () {
 
      const selectedDate = $(this).val();
      if (!selectedDate) return;
 
      displayCartOrderDate(selectedDate);
 
      $("#selected-delivery-date").html(
        `<p>Selected Order Date: <strong>${formatDateDMY(selectedDate)}</strong></p>`
      );
 
      fetch("/cart/update.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          attributes: { "Order Date": selectedDate }
        })
      })
      .then(res => res.json())
      .then(cart => {
        applyOrderDateToAllProducts(cart);
      });
 
    });
 
    /* ---------------- CART UPDATE OBSERVER ---------------- */
    const observer = new MutationObserver(() => {
      fetch("/cart.js")
        .then(res => res.json())
        .then(cart => {
 
          applyOrderDateToAllProducts(cart);
 
          if (cart.items.length === 0) {
            clearOrderDateValue();
          }
 
        });
    });
 
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
 
    console.log("👀 Cart observer active");
 
  });
 
})(jQuery);
