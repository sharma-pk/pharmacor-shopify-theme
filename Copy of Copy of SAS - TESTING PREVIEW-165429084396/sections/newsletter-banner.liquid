<style>
    .newsletter-banner-section{
      padding:8px 44px;
    }

    .newsletter-banner-note{
      font-family:'Caveat', cursive;
      font-size:15px;
      color:rgb(207, 74, 38);
      margin-bottom:10px;
    }

    .newsletter-banner-card{
      cursor:pointer;
      border:none;
      width:100%;
      text-align:left;
      background:rgb(251, 241, 207);
      border-radius:18px;
      padding:24px 28px;
      display:grid;
      grid-template-columns:1fr auto;
      gap:20px;
      align-items:center;
      transition:background .15s ease;
    }
    .newsletter-banner-card:hover{
      background:rgb(246, 233, 187);
    }

    .newsletter-banner-eyebrow{
      font:800 11px 'Montserrat', sans-serif;
      letter-spacing:0.14em;
      text-transform:uppercase;
      color:rgb(185, 143, 18);
      margin-bottom:4px;
    }

    .newsletter-banner-heading{
      font:800 22px 'Montserrat', sans-serif;
      color:rgb(32, 50, 43);
    }

    .newsletter-banner-cta{
      font:800 13px 'Montserrat', sans-serif;
      color:rgb(0, 97, 74);
      background:rgb(255, 255, 255);
      border-radius:999px;
      padding:12px 24px;
      white-space:nowrap;
    }

    @media (max-width:640px){
      .newsletter-banner-section{padding:8px 20px;}
      .newsletter-banner-card{
        grid-template-columns:1fr;
        justify-items:start;
        gap:14px;
        padding:20px;
      }
      .newsletter-banner-heading{font-size:19px;}
    }
</style>

<section class="newsletter-banner-section">
  <div class="page-width">
    {%- if section.settings.note != blank -%}
      <div class="newsletter-banner-note">{{ section.settings.note }}</div>
    {%- endif -%}

    <a href="{{ section.settings.link | default: '#' }}" class="newsletter-banner-card">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="newsletter-banner-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <div class="newsletter-banner-heading">{{ section.settings.heading }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.button_text != blank -%}
        <span class="newsletter-banner-cta">{{ section.settings.button_text }} →</span>
      {%- endif -%}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Entry Banner",
  "tag": "section",
  "class": "shopify-section-newsletter-banner",
  "settings": [
    {
      "type": "text",
      "id": "note",
      "label": "Handwritten note",
      "default": "Homepage entry point for the new Newsletters & Free Downloads page (you asked where this should live)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Newsletters & Free Downloads"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read our newsletters & grab free activities"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Browse"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Entry Banner"
    }
  ]
}
{% endschema %}