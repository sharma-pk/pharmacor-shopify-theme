{%- comment -%}
------------------------------------------------------------------------------
	Section: Account template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render "adastra" with "/src/styles/account.scss" -%}

{%- assign desktop_image = section.settings.desktop_image -%}
{%- assign mobile_image	= section.settings.mobile_image | default: desktop_image -%}
{%- assign page_heading_color = section.settings.page_heading_color -%}

{%- capture img_focal -%}
	--img-desktop-pos: {{- desktop_image.presentation.focal_point -}};
	--img-mob-pos: {{- mobile_image.presentation.focal_point -}};
{%- endcapture -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		--page-heading-color: {{ page_heading_color }};
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px; 
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}


	.future-delivery {
		margin-bottom: 28px;
	}

	.future-delivery__heading {
		margin-bottom: 12px;
	}

	.future-delivery__empty {
		color: var(--color-text-secondary, #666);
	}

	.future-delivery__orders {
		margin-bottom: 0;
	}

	.account__order-view .button {
		vertical-align: middle;
	}

	.account__order-view .cancel-order-button {
		margin: 0 0 0 8px;
		box-sizing: border-box;
	}

	.cancel-order-button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.pharmacor-order-modal {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		align-items: center;
		justify-content: center;
		z-index: 9999;
	}

	.pharmacor-order-modal--visible {
		display: flex;
	}

	.pharmacor-order-modal__box {
		background: #fff;
		padding: 24px 28px;
		border-radius: 10px;
		max-width: 360px;
		text-align: center;
	}

	.pharmacor-order-modal__box p {
		margin: 0 0 16px;
		font-size: 15px;
	}

	.pharmacor-order-modal--error .pharmacor-order-modal__box {
		border: 2px solid #c62828;
	}
{%- endstyle -%}


<section class="account">
	{%- if desktop_image != blank -%}
		<div class="account__banner-image-wrapper">
			<h1 class="account__heading">
            
				{{- "customer.account.title" | t -}}
               
           
			</h1>

			<picture>
				<source
					srcset="{{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x"
					media="(max-width: 375px)"
				/>

				<source
					srcset="{{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x"
					media="(max-width: 575px)"
				/>

				<source
					srcset="{{ mobile_image | image_url: width: 767 }} 1x, {{ mobile_image | image_url: width: 1534 }} 2x"
					media="(max-width: 767px)"
				/>

				<source
					srcset="{{ desktop_image | image_url: width: 991 }} 1x, {{ desktop_image | image_url: width: 1928 }} 2x"
					media="(max-width: 991px)"
				/>

				<source
					srcset="{{ desktop_image | image_url: width: 1199 }} 1x, {{ desktop_image | image_url: width: 2398 }} 2x"
					media="(max-width: 1199px)"
				/>

				<source
					srcset="{{ desktop_image | image_url: width: 1500 }} 1x, {{ desktop_image | image_url: width: 3000 }} 2x"
					media="(max-width: 1500px)"
				/>

				<source
					srcset="{{ desktop_image | image_url: width: 1600 }} 1x, {{ desktop_image | image_url: width: 3200 }} 2x"
					media="(max-width: 1600px)"
				/>

				<source
					srcset="{{ desktop_image | image_url: width: 1920 }} 1x, {{ desktop_image | image_url: width: 3840 }} 2x"
					media="(max-width: 1920px)"
				/>

				<img
					class="account__banner-image"
					srcset="{{ desktop_image | image_url: width: 2048 }} 1x, {{ desktop_image | image_url: width: 4096 }} 2x"
					src="{{- desktop_image | image_url: width: 2048 -}}"
					alt="{{- desktop_image.alt -}}"
					style="{{- img_focal -}}"
				/>
			</picture>
		</div>
	{%- endif -%}

	<div class="account__container">
		{%- if desktop_image == blank -%}
			<h1 class="account__heading">
                <span class="custom-otherpage">
				{{- "customer.account.title" | t -}}
                  </span>
                   <span class="custom-mypage">
              Previous
              </span>
                
			</h1>
		{%- endif -%}

		<div class="account__row">
			<div class="account__col account__col--details">
				<div class="account__user-icon" aria-hidden="true">
					{%- render 'icons', icon: 'account' -%}
				</div>

				<div class="account__user-info">
					<div class="account__full-name">
						<span>
							{{- customer.default_address.first_name -}}
						</span>

						<span>
							{{- customer.default_address.last_name -}}
						</span>
					</div>

			

					<div class="account__address">
						{{- customer.default_address.country -}}
					</div>
				</div>

				<div class="account__user-buttons">
					<a class="button button--primary account__addresses-link" href="{{- routes.account_addresses_url -}}">
						{{ "customer.account.view_addresses" | t }} ({{ customer.addresses_count }}) {%- render 'icons', icon: 'arrow-right' -%}
					</a>

                    <a class="button button--primary account__addresses-link" href="/pages/subscriptions">
						{{ "customer.account.view_subscriptions" | t }} {%- render 'icons', icon: 'arrow-right' -%}
					</a>
                     <a class="button button--primary account__addresses-link" href="/pages/draft-orders">
						View Draft Orders
						{% render 'icons', icon: 'arrow-right' %}
					</a>
					<a class="button button--primary account__logout-link" href="{{- routes.account_logout_url -}}">
						{{- "layout.customer.log_out" | t -}} {%- render 'icons', icon: 'arrow-right' -%}
					</a>
					
				</div>
			</div>

			<div class="account__col account__col--orders">
				{%- if customer -%}
					{%- assign has_future_delivery = false -%}
					{%- assign future_delivery_html = '' -%}

					{%- capture delivery_date_property_names_str -%}
						{%- render 'delivery-date-property-names' -%}
					{%- endcapture -%}
					{%- assign delivery_date_property_names = delivery_date_property_names_str | strip | split: ',' -%}

					{%- for order in customer.orders -%}
						{%- assign product_dates_str = '' -%}

						{%- for line_item in order.line_items -%}
							{%- for property in line_item.properties -%}
								{%- assign prop_name_lower = property.first | downcase -%}
								{%- assign prop_matches_date_name = false -%}

								{%- for property_name in delivery_date_property_names -%}
									{%- assign property_name_lower = property_name | downcase -%}
									{%- if prop_name_lower contains property_name_lower -%}
										{%- assign prop_matches_date_name = true -%}
									{%- endif -%}
								{%- endfor -%}

								{%- if prop_matches_date_name and property.last != blank -%}
									{%- assign product_dates_str = product_dates_str | append: property.last | append: ',' -%}
								{%- endif -%}
							{%- endfor -%}
						{%- endfor -%}

						{%- assign product_dates = product_dates_str | split: ',' | uniq | sort -%}

						{%- assign order_date_value = order.attributes['Order Date'] -%}
						{%- assign order_note_attr_value = '' -%}
						{%- if order.note_attributes != blank -%}
							{%- assign note_order_date_attr = order.note_attributes | where: 'name', 'Order Date' | first -%}
							{%- if note_order_date_attr != blank -%}
								{%- assign order_note_attr_value = note_order_date_attr.value -%}
							{%- endif -%}
							{%- for property_name in delivery_date_property_names -%}
								{%- if order_note_attr_value == blank -%}
									{%- assign note_date_attr = order.note_attributes | where: 'name', property_name | first -%}
									{%- if note_date_attr != blank -%}
										{%- assign order_note_attr_value = note_date_attr.value -%}
									{%- endif -%}
								{%- endif -%}
							{%- endfor -%}
						{%- endif -%}

						{%- comment -%} Product-level Processed Date properties (or, for old orders, Delivery Date) win, latest one if they differ; otherwise fall back to order note attributes or the order-level Order Date attribute. {%- endcomment -%}
						{%- assign fd_delivery_date = '' -%}

						{%- if product_dates.size > 0 -%}
							{%- assign fd_delivery_date = product_dates | last -%}
						{%- elsif order_note_attr_value != blank -%}
							{%- assign fd_delivery_date = order_note_attr_value -%}
						{%- elsif order_date_value != blank -%}
							{%- assign fd_delivery_date = order_date_value -%}
						{%- endif -%}

						{%- assign fd_today_date = 'now' | date: '%Y-%m-%d' -%}
						{%- assign fd_is_future_order = false -%}

						{%- if fd_delivery_date != blank and fd_delivery_date > fd_today_date -%}
							{%- assign fd_is_future_order = true -%}
						{%- endif -%}

						{%- if fd_is_future_order -%}
							{%- assign has_future_delivery = true -%}

							{%- capture future_delivery_card -%}
								{%- render 'account-order-row', order: order, only_first_line_item: true -%}
							{%- endcapture -%}

							{%- assign future_delivery_html = future_delivery_html | append: future_delivery_card -%}
						{%- endif -%}
					{%- endfor -%}

					<div class="future-delivery">
						<h2 class="h4 account__subheading future-delivery__heading">Future Delivery</h2>

						{%- if has_future_delivery -%}
							<ul class="account__orders js-accordion-container future-delivery__orders">
								<div class="account__header" aria-hidden="true">
									<span class="account__header-col account__header-col--number">
										{{- "customer.orders.order_number" | t -}}
									</span>

									<span class="account__header-col">
										{{- "customer.orders.date" | t -}}
									</span>

									<span class="account__header-col account__header-col--status">
										{{- "customer.orders.payment_status" | t -}}
									</span>

									<span class="account__header-col account__header-col--quantity">
										{{- "customer.orders.quantity" | t -}}
									</span>

									<span class="account__header-col account__header-col--total">
										{{- "customer.orders.total" | t -}}
									</span>
								</div>

								{{- future_delivery_html -}}
							</ul>
						{%- else -%}
							<p class="future-delivery__empty">You have no upcoming future-dated orders.</p>
						{%- endif -%}
					</div>
				{%- endif -%}

				<h2 class="h4 account__subheading">
					{{- "customer.orders.title" | t -}}
				</h2>
  {% if customer %}
    
				{%- paginate customer.orders by 20 -%}
					{%- if customer.orders.size != 0 -%}
						<ul class="account__orders js-accordion-container">
							<div class="account__header" aria-hidden="true">
								<span class="account__header-col account__header-col--number">
									{{- "customer.orders.order_number" | t -}}
								</span>

								<span class="account__header-col">
									{{- "customer.orders.date" | t -}}
								</span>

								<span class="account__header-col account__header-col--status">
									{{- "customer.orders.payment_status" | t -}}
								</span>

								<span class="account__header-col account__header-col--quantity">
									{{- "customer.orders.quantity" | t -}}
								</span>

								<span class="account__header-col account__header-col--total">
									{{- "customer.orders.total" | t -}}
								</span>
							</div>

							{%- for order in customer.orders -%}
								{%- render 'account-order-row', order: order -%}
							{%- endfor -%}
						</ul>
					{%- else -%}
						<p class="account__orders-none">
							{{- "customer.orders.none" | t -}}
						</p>
					{%- endif -%}



                  
					{%- if paginate.pages > 1 -%}
						{%- render "pagination", paginate: paginate -%}
					{%- endif -%}
				{%- endpaginate -%}
      {% else %}
              {% endif %}
			</div>

		</div>
	</div>
</section>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script>
$(document).ready(function () {
  $(".mydynamic-quick-add").click(function () {
    var _this = $(this);
    var parentclass = _this.parent().parent().parent().parent();
    var parentmain = parentclass.parent().parent();

    // Step 1: Accordion setup
    setTimeout(function () {
      $(parentmain).addClass("is-active right");
      $(parentmain).find(".js-accordion-control").attr("aria-expanded", "true");
      $(parentmain).find(".js-accordion-content").css("height", "auto");
    }, 100);

    // Step 2: Sequentially trigger .myaddtocart1 to .myaddtocart10
    for (let i = 1; i <= 20; i++) {
      setTimeout(function () {
        var selector = ".myaddtocart" + i;
        var value = $(parentmain).find(".myinputvalue").val();
        $(parentclass).find(selector).trigger("click");

        console.log("Clicked", selector, "with value:", value);
      }, i * 1100); // each step 600ms apart
    }
  });
});


</script>

<div id="pharmacor-order-modal" class="pharmacor-order-modal">
	<div class="pharmacor-order-modal__box">
		<p id="pharmacor-order-modal-message"></p>
		<button type="button" id="pharmacor-order-modal-close" class="button button--primary">OK</button>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		'use strict';

		var CANCEL_ORDER_API_BASE_URL = 'https://api.pharmacor.com.au/api/order';
		var CANCEL_ORDER_API_SECRET = '057b10862c3b5256f332dcd4478d0df07a788130d484e6b1a177fc526b652236';

		var modal = document.getElementById('pharmacor-order-modal');
		var modalMessage = document.getElementById('pharmacor-order-modal-message');
		var modalClose = document.getElementById('pharmacor-order-modal-close');

		function showOrderModal(message, isError) {
			modalMessage.textContent = message;
			modal.classList.toggle('pharmacor-order-modal--error', !!isError);
			modal.classList.add('pharmacor-order-modal--visible');
		}

		function hideOrderModal() {
			modal.classList.remove('pharmacor-order-modal--visible');
		}

		if (modalClose) {
			modalClose.addEventListener('click', hideOrderModal);
		}

		document.addEventListener('click', function (event) {
			var button = event.target.closest('.cancel-order-button');
			if (!button) return;

			var orderId = button.getAttribute('data-order-id');
			var orderName = button.getAttribute('data-order-name');

			var originalText = button.textContent;
			button.disabled = true;
			button.textContent = 'Cancelling...';

			fetch(CANCEL_ORDER_API_BASE_URL + '/' + orderId + '/cancel', {
				method: 'POST',
				headers: { 'x-api-secret': CANCEL_ORDER_API_SECRET }
			})
				.then(function (response) {
					return response.json().catch(function () { return {}; }).then(function (data) {
						return { ok: response.ok, status: response.status, data: data };
					});
				})
				.then(function (result) {
					var returnedOrderName = (result.data && result.data.orderName) || orderName;

					var message = (result.data && result.data.message)
						|| (result.ok
							? ('Order ' + returnedOrderName + ' was successfully cancelled.')
							: ('Sorry, we could not cancel order ' + returnedOrderName + ' (status ' + result.status + '). Please try again or contact support.'));

					showOrderModal(message, !result.ok);
					console.log('[Cancel Order] response', result);

					if (result.ok) {
						var accordionItem = button.closest('.account__accordion');
						if (accordionItem) accordionItem.remove();
					} else {
						button.disabled = false;
						button.textContent = originalText;
					}
				})
				.catch(function (error) {
					console.error('[Cancel Order]', error);
					showOrderModal('Sorry, we could not cancel order ' + orderName + ': ' + error.message, true);
					button.disabled = false;
					button.textContent = originalText;
				});
		});
	});
</script>

{% schema %}
{
	"name": "Account template",
	"settings": [
		{
			"type": "image_picker",
			"id": "desktop_image",
			"label": "Image desktop"
		},
		{
			"type": "image_picker",
			"id": "mobile_image",
			"label": "Image mobile"
		},
		{
			"type": "color",
			"id": "page_heading_color",
			"label": "Page heading color",
			"default": "#000"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
  "presets": [
    {
      "name": "Account template"
    }
  ]
}
{%- endschema -%}
