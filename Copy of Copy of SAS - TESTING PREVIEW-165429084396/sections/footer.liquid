<script>
document.addEventListener("DOMContentLoaded", function () {
  const btn = document.querySelector(".cusotm-bottom-top-scroll, .cusotm-bottom-top-scroll img");

  if (btn) {
    btn.addEventListener("click", function () {
      window.scrollTo({
        top: 0,
        behavior: "smooth" // ye scroll ko smooth banata hai
      });
    });
  }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const logoutLink = document.querySelector('a[href="/account/logout"]');
  
  if (logoutLink) {
    logoutLink.addEventListener('click', function(e) {
      e.preventDefault();

      // Clear cart before logging out
      fetch('/cart/clear.js', { method: 'POST' })
        .then(() => {
          // Now log out the customer
          window.location.href = '/account/logout';
        })
        .catch(() => {
          // Even if clearing fails, still log out
          window.location.href = '/account/logout';
        });
    });
  }
});
</script>

