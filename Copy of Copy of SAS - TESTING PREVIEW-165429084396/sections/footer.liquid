<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sortSelect = document.getElementById('custom-sort');
    const productsContainer = document.getElementById('custom-products');
    const products = Array.from(productsContainer.querySelectorAll('.product-item'));

    function sortProducts(criteria) {
      let sorted = [...products];

      switch (criteria) {
        case 'title-asc':
          sorted.sort((a, b) => a.dataset.title.localeCompare(b.dataset.title));
          break;
        case 'title-desc':
          sorted.sort((a, b) => b.dataset.title.localeCompare(a.dataset.title));
          break;
        case 'price-asc':
          sorted.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
          break;
        case 'price-desc':
          sorted.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
          break;
        case 'created-asc':
          sorted.sort((a, b) => new Date(a.dataset.created) - new Date(b.dataset.created));
          break;
        case 'created-desc':
          sorted.sort((a, b) => new Date(b.dataset.created) - new Date(a.dataset.created));
          break;
        default:
          sorted = [...products]; // manual / default order
      }

      productsContainer.innerHTML = '';
      sorted.forEach((item) => productsContainer.appendChild(item));
    }

    sortSelect.addEventListener('change', function () {
      sortProducts(this.value);
    });
  });
</script>
