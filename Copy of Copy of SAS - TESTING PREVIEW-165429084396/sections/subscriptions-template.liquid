  ------------------------------------------------------- */

    let activeCard = null;
    let activeCardReactivating = false;

    function openEditModal(card, { reactivating = false } = {}) {
      activeCard = card;
      activeCardReactivating = reactivating;

      const dateInput = document.getElementById('subB-date');
      const today = new Date();
      dateInput.min = `${today.getFullYear()}-${pad2(today.getMonth() + 1)}-${pad2(today.getDate())}`;
      dateInput.value = card.dataset.nextBilling;

      document.getElementById('subB-qty').value = card.dataset.quantity;

      const qtyLabel = document.getElementById('subB-qty-label');

      qtyLabel.innerHTML =
        `<span class="sub-qty-label__title">${card.dataset.productTitle}</span>` +
        `<span class="sub-qty-label__variant"></span>`;

      document
        .getElementById('subB-toggle')
        .querySelectorAll('button')
        .forEach((b) => {
          b.classList.toggle('is-active', b.dataset.value === 'every_month');
        });

      const wSel = document.getElementById('subB-wholesaler');

      if (wSel) {
        wSel.value = '';
      }

      updateQtyLabelVariant();

      const pauseBtn = document.getElementById('subB-pause');

      if (pauseBtn) {
        pauseBtn.style.display = card.dataset.status === 'active' ? '' : 'none';
      }

      // Both buttons place an order today, and cancel the pending one — say so up front.
      const dropNote = document.getElementById('subB-drop-note');

      if (dropNote) {
        const pending = card.dataset.firstDropPending === 'true';

        dropNote.hidden = !pending;

        if (pending) {
          dropNote.textContent =
            `First drop ${formatDisplay(card.dataset.firstDropDate)} hasn't been sent. ` +
            `Both options below cancel it and place a new order today.`;
        }
      }

      document.getElementById('subModalB').classList.add('is-open');
    }

