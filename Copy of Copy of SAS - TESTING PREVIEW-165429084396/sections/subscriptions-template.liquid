    const activeFiltersEl = document.getElementById('subsActiveFilters');

    /* combinedSelect's value is "sort:xxx" or "status:xxx" — a native
       <select> only ever holds one selection, so picking a sort option and
       picking a status option are mutually exclusive by construction. */
    function parseCombinedValue() {
      const raw = combinedSelect ? combinedSelect.value : '';

      const [type, value] = raw ? raw.split(':') : ['', ''];

      return { type: type || '', value: value || '' };
    }

    function renderActiveFilters() {
      if (!activeFiltersEl) return;

      activeFiltersEl.innerHTML = '';

      if (!combinedSelect || !combinedSelect.value) return;

      const selectedOption = combinedSelect.options[combinedSelect.selectedIndex];

      const groupLabel =
        selectedOption && selectedOption.parentElement && selectedOption.parentElement.tagName === 'OPTGROUP'
          ? selectedOption.parentElement.label
          : '';

      const optionText = selectedOption ? selectedOption.text : combinedSelect.value;

      const label = groupLabel ? `${groupLabel}: ${optionText}` : optionText;

      const chip = document.createElement('span');

      chip.className = 'subs-filter-chip';

      const labelSpan = document.createElement('span');

      labelSpan.textContent = label;

      chip.appendChild(labelSpan);

      const removeBtn = document.createElement('button');

      removeBtn.type = 'button';

      removeBtn.className = 'subs-filter-chip__remove';

      removeBtn.setAttribute('aria-label', `Remove ${label} filter`);

      removeBtn.textContent = '\u00d7';

      removeBtn.addEventListener('click', () => {
        combinedSelect.value = '';

        currentPage = 1;

        applyFilters();
      });

      chip.appendChild(removeBtn);

      activeFiltersEl.appendChild(chip);
    }

    const originalCardOrder = list ? Array.from(list.querySelectorAll('.sub-card')) : [];

    const originalIndexOf = new Map(originalCardOrder.map((card, i) => [card, i]));

    function nextDropTime(card) {
      const val = (card.dataset.nextBilling || '').trim();

      if (!val) {
        return Infinity;
      }

      const t = new Date(val + 'T00:00:00').getTime();

      return isNaN(t) ? Infinity : t;
    }

    function applyFilters() {
      if (!list) return;

      renderActiveFilters();

      const { type: filterType, value: filterValue } = parseCombinedValue();

      const status = filterType === 'status' ? filterValue.trim().toLowerCase() : '';

      const dropMode = filterType === 'sort' && filterValue === 'sort_by' ? 'sort_by' : '';

      const cards = Array.from(list.querySelectorAll('.sub-card'));

      cards.forEach((card) => {
        const cardStatus = (card.dataset.status || '').trim().toLowerCase();

        const statusMatches = !status || cardStatus === status;

        const hideForNextDrop = dropMode === 'sort_by' && (cardStatus === 'cancel' || cardStatus === 'pause');

        card.style.display = statusMatches && !hideForNextDrop ? '' : 'none';
      });

      const azSort = filterType === 'sort' ? filterValue : '';

      const visible = cards.filter((c) => c.style.display !== 'none');

      visible.sort((a, b) => {
        if (azSort === 'az') {
          return a.dataset.search.localeCompare(b.dataset.search);
        }

        if (azSort === 'za') {
          return b.dataset.search.localeCompare(a.dataset.search);
        }

        if (dropMode === 'sort_by') {
          const diff = nextDropTime(a) - nextDropTime(b);

          if (diff !== 0) {
            return diff;
          }

          return originalIndexOf.get(a) - originalIndexOf.get(b);
        }

        return originalIndexOf.get(a) - originalIndexOf.get(b);
      });

      visible.forEach((c) => list.appendChild(c));

      renderPagination(cards, visible);
    }

    /* -------------------------------------------------------
     PAGINATION
  ------------------------------------------------------- */

    const PAGE_SIZE = 10;

    let currentPage = 1;

    function renderPagination(allCards, visibleCards) {
      const label = document.getElementById('subsPaginationLabel');

      const pagesEl = document.getElementById('subsPaginationPages');

      if (!label || !pagesEl) {
        return;
      }

      const totalPages = Math.max(1, Math.ceil(visibleCards.length / PAGE_SIZE));

      if (currentPage > totalPages) {
        currentPage = totalPages;
      }

      const start = (currentPage - 1) * PAGE_SIZE;

      const end = start + PAGE_SIZE;

      visibleCards.forEach((card, i) => {
        card.style.display = i >= start && i < end ? '' : 'none';
      });

      label.textContent = `You are viewing ${Math.min(visibleCards.length, PAGE_SIZE)} out of ${
        visibleCards.length
      } Molecules`;

      pagesEl.innerHTML = '';

      for (let p = 1; p <= totalPages; p++) {
        const span = document.createElement('span');

        span.textContent = p;

        if (p === currentPage) {
          span.classList.add('is-active');
        }

        span.addEventListener('click', () => {
          currentPage = p;

          applyFilters();
        });

        pagesEl.appendChild(span);
      }
    }

    /* -------------------------------------------------------
     FILTER EVENTS
  ------------------------------------------------------- */

    combinedSelect?.addEventListener('change', () => {
      currentPage = 1;

      applyFilters();
    });

    /* -------------------------------------------------------
     INITIAL FILTER
  ------------------------------------------------------- */

    applyFilters();
  })();
</script>

