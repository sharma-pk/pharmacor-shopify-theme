        );

        const daysPhrase = daysOut === 0 ? 'today' : daysOut === 1 ? 'in 1 day' : `in ${daysOut} days`;

        console.log('Next billing:', card.dataset.nextBilling);

        console.log('Formatted next billing:', nextDate);

        console.log('Days until next billing:', daysOut);

        console.log('Days phrase:', daysPhrase);

        // A pending first drop is replaced: the queued order is cancelled, so say so plainly.
        const firstDropPending = card.dataset.firstDropPending === 'true';

        const firstDropDate = firstDropPending ? formatDisplay(card.dataset.firstDropDate) : null;

        document.getElementById('subDrop-desc').textContent = firstDropPending
          ? `Your first drop is scheduled for ${firstDropDate} and hasn't been sent yet. Dropping now will cancel that order and place a new one today.`
