      const applyOnce =
        document.getElementById('subB-toggle').querySelector('.is-active').dataset.value === 'just_once';

      const wSel = document.getElementById('subB-wholesaler');

      const wholesalerValue = wSel ? wSel.value : '';

      const wholesalerSlot = wSel && wSel.selectedOptions[0] ? wSel.selectedOptions[0].dataset.slot : '';

      const params = {
        ...baseParams(activeCard),
        quantity: newQty,
      };

      if (newDate && newDate !== activeCard.dataset.nextBilling) {
        params.next_billing = newDate;

        if (applyOnce && !activeCardReactivating) {
          params.apply_once = 'true';
        }
