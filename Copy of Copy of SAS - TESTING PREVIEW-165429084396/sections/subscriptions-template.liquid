      if (activeCardReactivating) {
        params.newStatus = 'ACTIVE';
      }

      console.log('Saving subscription changes:', params);

      setLoading(e.currentTarget, true, 'Saving...');

      await callUpdate(params);

      activeCardReactivating = false;

