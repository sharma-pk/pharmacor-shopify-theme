  ------------------------------------------------------- */

    const WHOLESALER_BRAND_BY_SLOT = { 1: 'API', 2: 'Sigma', 3: 'Symbion', 4: 'CH2' };

    // reflects whatever the "Change Wholesaler" select is currently set to —
    // the newly picked brand while a change is staged, or the subscription's
    // existing brand/variant when it's back on "No change"
    function updateQtyLabelVariant() {
      if (!activeCard) return;

      const qtyLabel = document.getElementById('subB-qty-label');
      const variantSpan = qtyLabel && qtyLabel.querySelector('.sub-qty-label__variant');

      if (!variantSpan) return;

      const wSel = document.getElementById('subB-wholesaler');
      const selectedOption = wSel && wSel.selectedOptions[0];
      const selectedSlot = wSel && wSel.value ? selectedOption?.dataset.slot : '';
      const variantTitle = activeCard.dataset.variantTitle || '';

      let line;

      if (selectedSlot) {
        const newBrand = WHOLESALER_BRAND_BY_SLOT[selectedSlot] || '';

        line = newBrand && variantTitle ? `${newBrand} / ${variantTitle}` : newBrand || variantTitle;
      } else {
        line = activeCard.dataset.variantLine || variantTitle;
      }

      variantSpan.textContent = line;
    }

    document.getElementById('subB-wholesaler')?.addEventListener('change', updateQtyLabelVariant);

