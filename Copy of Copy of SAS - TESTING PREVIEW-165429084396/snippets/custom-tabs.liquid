<script>
function showCustomDataAppSection(event, sectionId) {
  var i, customDataAppSections, customDataAppButtons;
  customDataAppSections = document.getElementsByClassName("custom-data-app-section");
  for (i = 0; i < customDataAppSections.length; i++) {
    customDataAppSections[i].style.display = "none";
  }
  customDataAppButtons = document.getElementsByClassName("custom-data-app-btn");
  for (i = 0; i < customDataAppButtons.length; i++) {
    customDataAppButtons[i].className = customDataAppButtons[i].className.replace(" active-custom-data-app", "");
  }
  document.getElementById(sectionId).style.display = "block";
  event.currentTarget.className += " active-custom-data-app";
}
</script>
