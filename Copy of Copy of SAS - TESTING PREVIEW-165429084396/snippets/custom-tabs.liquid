  flex-wrap: unset;}
.custom-data-app-btn {background-color: #404445;text-transform: uppercase; 
  font-size: 17px;
  line-height: 1.2;
  color: #fff;
  position: relative;
  transition: all .5s;
padding: 12px 16px;
  ransition: 0.3s;
  border: 1px solid #000;}
.custom-data-app-btn:hover {
  color: #fff;
}
