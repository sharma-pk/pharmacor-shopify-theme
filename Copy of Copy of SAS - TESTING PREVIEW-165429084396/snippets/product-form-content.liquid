      {% if customer %}
  <div class="add_to_cart_qunatitty">
    <div class="product-quantity__wrapper cusotm-wrapper-qiantity custom-wraperr">
      <div class="product-quantity__container text">
        <button
          class="product-quantity__button descrease-c"
          type="button"
          data-quantity-decrease
          aria-label="{{ 'products.quantity.decrease' | t: product: product.title | escape }}"
        >
          {% render 'icons', icon: 'minus' %}
        </button>
        {% assign form_id = 'product_form_' | append: product.id | append: '_section_' | append: section.id %}

        <input
          style="text-align:center"
          form="{{- form_id -}}"
          type="number"
          {% unless additional %}
            name="quantity"
          {% endunless %}
          id="Product_{{- product.id -}}-Quantity{%- if additional -%}-additional{%- endif -%}"
          class="product-quantity__input"
          value="1"
          min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
          step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
          data-quantity-input
          {% if additional %}
            data-quantity-input-additional
          {%- endif -%}
        >

        <button
          class="product-quantity__button increase-c"
          type="button"
          data-quantity-increase
          aria-label="{{ 'products.quantity.increase' | t: product: product.title | escape }}"
        >
          {% render 'icons', icon: 'plus' %}
        </button>
      </div>
    </div>
    <div class="add_to_cart" style="{% if hide_purchase_controls %}display:none;{% endif %}">
      <button
type="submit"
  class="
    custom-btn-boxes proo product-add-to-cart__button add-to-cart button button--block button--{{- button_type -}}
  "

  {% if product.template_suffix == 'pre-order' %}
    data-preorder
  {% endif %}
>
  {%- render 'icons', icon: 'cart' -%}

  <span class="js-product-add-to-cart-button-text">
    {% if product.first_available_variant.available %}
      {% if product.template_suffix == 'pre-order' %}
        {{- 'products.product.pre_order' | t -}}
      {% else %}
        {{- 'products.product.add_to_cart' | t -}}
      {% endif %}
    {% else %}
      {{- 'products.product.sold_out' | t -}}
    {% endif %}

      </span>
        </button>
    </div>
  </div>

  {% comment %}
    <button
    	type="submit"
    	class="custom-btn-boxes product-add-to-cart__button add-to-cart button button--block button--{{- button_type -}}
    			{% unless product.first_available_variant.available %}
    				disabled
    			{% endunless %}
    		"
    	{% unless product.first_available_variant.available %}
    		disabled
    	{% endunless %}
    	{% if product.template_suffix == 'pre-order' %}
    		data-preorder
    	{% endif %}
    >
    	{%- render 'icons', icon: 'cart' -%}

    	<span class="js-product-add-to-cart-button-text">
    		{% if product.first_available_variant.available %}
    			{% if product.template_suffix == 'pre-order' %}
    				{{- 'products.product.pre_order' | t -}}
    			{% else %}
    				{{- 'products.product.add_to_cart' | t -}}
    			{% endif %}
    		{% else %}
    			{{- 'products.product.sold_out' | t -}}
    		{% endif %}
    	</span>
    </button>
  {% endcomment %}
  {% comment %}
    {% render 'custom-product-quantity', block: block, product: product, show_label: true %}
  {% endcomment %}

  {% if block.settings.show_additional_buttons and hide_purchase_controls == false %}
    <div class="product-add-to-cart__additional-buttons">
      {{- form | payment_button -}}
    </div>
  {% endif %}
{% endif %}
  {% if customer %}
    {% for address in customer.addresses %}
      <!-- <p style="" class="custom-address-1">{{ customer.tags | join: ', ' }}</p> -->
      <div class="my-cusotm-tag-main">
        {% for tag in customer.tags %}
          <span class="customer-tag custom-address-1" style="position: absolute; opacity: 0;">
            {{- tag | handleize -}}
          </span>
        {% endfor %}
      </div>
    {% endfor %}
    <style>
      {% if template.name == 'product' %}
      /* .product-inventory-status{display: none;} */
        {% endif %}
    </style>
  {% endif %}
{% endif %}

{% if template.name == 'product' %}
<script>
(function () {
  const modal = document.getElementById('subSetupModal');
  const confirmBtn = document.getElementById('subSetupConfirm');
  const anchorNote = document.getElementById('subSetupAnchorNote');
  if (!modal || !confirmBtn || !anchorNote) return;

  const deliveryDateInput = document.getElementById('delivery_date');
  const customDateWrap = document.getElementById('subSetupCustomDateWrap');
  const customDateInput = document.getElementById('subSetupCustomDate');
  const anchorToggle = anchorNote.querySelector('.sub-toggle-row');
  if (!anchorToggle) return;

  function formatDate(d) {
    return d.toISOString().split('T')[0];
  }
  function firstOfNextMonth() {
    const d = new Date();
    return formatDate(new Date(d.getFullYear(), d.getMonth() + 1, 1));
  }

  window.openSubSetupModal = function () {
    modal.classList.add('is-open');
  };

  // tracks whether Continue was ever actually clicked — the delivery date
  // field is shared with plain one-time purchases, so it must only be reset
  // if this modal itself is the thing that wrote to it in the first place
  let subscriptionConfigured = false;

  // resets this modal's own UI back to defaults, and — only if Continue was
  // actually clicked at some point — also clears the delivery date / Renewal
  // Anchor it wrote. Opening and cancelling without ever confirming must leave
  // a delivery date the customer picked before touching this modal untouched.
  window.resetSubSetupState = function () {
    startRadios.forEach((r) => { r.checked = r.value === 'today'; });
    refreshSelectedRow();
    customDateWrap.style.display = 'none';
    anchorNote.style.display = 'none';
    if (customDateInput) customDateInput.value = formatDate(new Date());
    anchorToggle.querySelectorAll('button').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.value === 'reset_to_1st');
    });

    if (subscriptionConfigured) {
      if (deliveryDateInput) deliveryDateInput.value = '';
      const form = modal.closest('form');
      const anchorInput = form ? form.querySelector('[name="properties[Renewal Anchor]"]') : null;
      if (anchorInput) anchorInput.remove();
    }
    subscriptionConfigured = false;
  };

  window.closeSubSetupModal = function (revert) {
    modal.classList.remove('is-open');
    if (revert) {
      window.resetSubSetupState();
      if (typeof window.revertToOneTimePurchase === 'function') {
        window.revertToOneTimePurchase();
      }
    }
  };

  modal.addEventListener('click', (e) => {
    if (e.target === modal) window.closeSubSetupModal(true);
  });

  const startRadios = modal.querySelectorAll('input[name="subSetupStart"]');
  function refreshSelectedRow() {
    startRadios.forEach((r) => r.closest('.sub-setup-radio').classList.toggle('is-selected', r.checked));
  }
  startRadios.forEach((radio) => {
    radio.addEventListener('change', () => {
      const isCustom = radio.value === 'custom' && radio.checked;
      customDateWrap.style.display = isCustom ? '' : 'none';
      anchorNote.style.display = isCustom ? '' : 'none';
      refreshSelectedRow();
    });
  });
  refreshSelectedRow();

  anchorToggle.querySelectorAll('button').forEach((btn) => {
    btn.addEventListener('click', () => {
      anchorToggle.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    });
  });

  confirmBtn.addEventListener('click', () => {
    subscriptionConfigured = true;
    const choice = modal.querySelector('input[name="subSetupStart"]:checked').value;
    let chosenDate;
    let anchorMode = null;

    if (choice === 'today') {
      chosenDate = formatDate(new Date());
    } else if (choice === 'first_next_month') {
      chosenDate = firstOfNextMonth();
    } else {
      chosenDate = customDateInput.value || formatDate(new Date());
      anchorMode = anchorToggle.querySelector('.is-active').dataset.value;
    }

    if (deliveryDateInput) deliveryDateInput.value = chosenDate;

    // scoped to this modal's own enclosing form, not a page-wide class search —
    // a page-wide selector can grab a different product's form/button (e.g. a
    // related/cross-sell product card rendered earlier in the DOM), which would
    // both silently append Renewal Anchor to a form that's never submitted, and
    // strip the active state off the button the customer actually clicked
    // without correctly restoring it (since it'd add .active to the wrong one)
    const form = modal.closest('form');
    if (form) {
      form.querySelectorAll('.Subscription_buttons button').forEach((btn) => btn.classList.remove('active'));
      form.querySelector('.Subscription_buttons button.Subscription_button')?.classList.add('active');

      let anchorInput = form.querySelector('[name="properties[Renewal Anchor]"]');
      if (anchorMode === 'reset_to_1st') {
        if (!anchorInput) {
          form.insertAdjacentHTML('beforeend', `<input type="hidden" name="properties[Renewal Anchor]" value="reset_to_1st">`);
        } else {
          anchorInput.value = 'reset_to_1st';
        }
      } else if (anchorInput) {
        anchorInput.remove();
      }

      if (!form.querySelector('[name="properties[subscription]"]')) {
        form.insertAdjacentHTML('beforeend', `<input type="hidden" name="properties[subscription]" value="6 month + 1 month free">`);
      }

    }

    window.closeSubSetupModal(false);
  });
})();
</script>
{% endif %}





