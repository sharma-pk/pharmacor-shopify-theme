          </div>
          <ul>
            <li><a href="{{ section.settings.loyalty_link }}">{{- section.settings['benefits_title-1'] }}<span><svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
