{% comment %}
  Section: Welcome Dashboard
  Description: Personalized dashboard with collection tabs + A-Z filter within each tab
{% endcomment %}
<style>
/* Pharmate Club Points Widget */
.pcc-top-row {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 24px;
}
.pcc-top-heading {
  flex: 0 0 auto;
  white-space: nowrap;
}
.pcc-top-row .pcc-widget {
  flex: 1;
  margin-bottom: 0;
  min-width: 0;
}
@media only screen and (max-width: 767px) {
  .pcc-top-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .pcc-top-heading { white-space: normal; }
  .pcc-top-row .pcc-widget { width: 100%; }
}

.pcc-widget {
  --pcc-widget-bg: {{ section.settings.pcc_widget_bg }};
  --pcc-label-color: {{ section.settings.pcc_label_color }};
  --pcc-badge-bg: {{ section.settings.pcc_badge_bg }};
  --pcc-badge-text: {{ section.settings.pcc_badge_text_color }};
  --pcc-badge-dot: {{ section.settings.pcc_badge_dot_color }};
  --pcc-pts-color: {{ section.settings.pcc_points_color }};
  --pcc-pts-label-color: {{ section.settings.pcc_points_label_color }};
  --pcc-bar-track: {{ section.settings.pcc_bar_track_color }};
  --pcc-bar-fill: {{ section.settings.pcc_bar_fill_color }};
  --pcc-bar-dot: {{ section.settings.pcc_bar_dot_color }};
  --pcc-footer-border: {{ section.settings.pcc_footer_border_color }};
  --pcc-redeem-color: {{ section.settings.pcc_redeem_btn_color }};
  --pcc-to-label: {{ section.settings.pcc_to_label_color }};
  --pcc-to-pts: {{ section.settings.pcc_to_pts_color }};
  --pcc-border-color: {{ section.settings.pcc_border_color }};
  --pcc-border-width: {{ section.settings.pcc_border_width }}px;
  background: var(--pcc-widget-bg);
  border: var(--pcc-border-width) solid var(--pcc-border-color);
  border-radius: 16px;
  padding: 24px 28px;
  margin-bottom: 24px;
  box-sizing: border-box;
}
.pcc-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10px;
}
.pcc-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--pcc-label-color);
  margin-bottom: 4px;
}
.pcc-badge {
  align-items: center;
  gap: 6px;
  background: var(--pcc-badge-bg);
  color: var(--pcc-badge-text);
  border-radius: 20px;
  padding: 6px 14px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}
.pcc-dot-indicator {
  width: 8px;
  height: 8px;
  background: var(--pcc-badge-dot);
  border-radius: 50%;
  display: inline-block;
}
.pcc-pts-row {
  margin: 4px 0 18px;
  line-height: 1;
}
.pcc-pts-row strong {
  font-size: 36px;
  font-weight: 700;
  color: var(--pcc-pts-color);
  margin-right: 8px;
  font-variant-numeric: tabular-nums;
}
.pcc-pts-label {
  font-size: 16px;
  color: var(--pcc-pts-label-color);
}
.pcc-bar-outer {
  position: relative;
  padding: 5px 0;
}
.pcc-bar-track {
  position: relative;
  height: 10px;
  background: var(--pcc-bar-track);
  border-radius: 10px;
  overflow: hidden;
}
.pcc-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: var(--pcc-bar-fill);
  border-radius: 10px;
  transition: width 0.7s ease;
  max-width: 100%;
}
.pcc-dot-marker {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 12px;
  height: 12px;
  background: var(--pcc-bar-dot);
  border: none;
  border-radius: 50%;
  z-index: 1;
  display: block;
}
.pcc-dot-marker--start {
  left: 0;
  transform: translateY(-50%);
}
.pcc-dot-marker.pcc-dot-marker--passed {
  background: var(--pcc-bar-fill);
  border: none;
}
.pcc-tier-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
}
.pcc-tier-item {
  display: flex;
  flex-direction: column;
  min-width: 60px;
}
.pcc-tier-item--left  { align-items: flex-start; }
.pcc-tier-item--center { align-items: center; }
.pcc-tier-item--right { align-items: flex-end; }
.pcc-tier-name {
  font-size: 12px;
  font-weight: 600;
  color: var(--pcc-label-color);
}
.pcc-tier-pts {
  font-size: 11px;
  color: #888;
}
.pcc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--pcc-footer-border);
  gap: 12px;
}
.pcc-next-tier-wrap {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.pcc-to-label {
  font-size: 12px;
  color: var(--pcc-to-label);
  display: block;
}
.pcc-to-pts {
  font-size: 15px;
  font-weight: 700;
  color: var(--pcc-to-pts);
  display: block;
}
.pcc-maintain-text {
  font-size: 15px;
  font-weight: 700;
  color: var(--pcc-to-pts);
  display: block;
  margin-top: 4px;
}
.pcc-redeem-btn {
  display: inline-block;
  border: 1.5px solid var(--pcc-redeem-color);
  color: var(--pcc-redeem-color);
  background: transparent;
  border-radius: 8px;
  padding: 9px 20px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.2s, color 0.2s;
  flex-shrink: 0;
}
.pcc-redeem-btn:hover {
  background: var(--pcc-redeem-color);
  color: var(--pcc-badge-text);
}
@media only screen and (max-width: 767px) {
  .pcc-widget { padding: 18px 16px; }
  .pcc-pts-row strong { font-size: 28px; }
  .pcc-footer { flex-direction: column; align-items: flex-start; }
}

.welcome_back_row {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;
}
.sas-upcoming-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f44e9b;
    border-radius: 16px;
    padding: 10px 8px;
    font-size: 16px;
    color: #fff;
    {% comment %} font-weight: 700; {% endcomment %}
    font-family: Neutrif Studio;
    border: 1px solid #c0dd96;
    justify-content: space-between;
    max-width:850px;
    width: calc(100% - 7px);
    margin-left: auto;
}
 
.sas-upcoming-banner__icon { display: flex; align-items: center; }
.sas-upcoming-banner__icon svg { width: 32px; height: 32px; }
.sas-upcoming-banner__view {font-family: Neutrif Studio;
  background: #fff; color: #222; border-radius: 30px; padding: 6px 16px;
  font-size: 15px; font-weight: 400; text-decoration: none; white-space: nowrap;
}
.text_label {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
}

@media (min-width: 1300px) {
.template-index .welcome-box h2 {
    min-width: 610px;
}
}
@media (min-width: 1300px) and (max-width: 1899px) {
      html .template-index .welcome_back_row {
        grid-template-columns: 29% 29% 1fr !important;
    }
}

@media (min-width: 768px) and (max-width: 1600px) {
.sas-upcoming-banner span {
    font-size: 14px;
}
.template-index .welcome-box h2 {
    min-width: 450px;
}
.template-index .welcome-box h2 {
    font-size: 36px;
}
.sas-upcoming-banner__view {
    padding: 6px 14px;
    font-size: 12px;

}
 
}
@media (min-width: 768px) and (max-width:1023px) {

.sas-upcoming-banner {
    flex-wrap: wrap;
}
.template-index .welcome-box h2 {
    min-width: 370px;
}
.template-index .welcome-box h2 {
    font-size: 30px;
}


}

@media (min-width: 767px) {
.template-index .welcome_back_row {
    display: grid;
    grid-template-columns: 27% 27% 1fr !important;
}
.template-index .welcome-box h2 {
    grid-column: 1;
}
.template-index .sas-upcoming-banner {
    grid-column: 3;
}
}
 @media only screen and (max-width: 700px) {
  .welcome_back_row { flex-direction: column; align-items: flex-start; }
  .sas-upcoming-banner { flex-wrap: wrap; }
  .sas-upcoming-banner {
    font-size: 12px;
}
.sas-upcoming-banner__view {
    font-size: 10px;
    margin-left: auto;
}
.sas-upcoming-banner__icon svg {
    width: 22px;
    height: 22px;
}
} 

</style>

<div class="welcome-box">
  {% if customer %}
    <div class="wrapper_welcome ">
     <div class="welcome_back_row">
      <h2 class="welcome_back">
        Welcome Back, {{ customer.first_name }}!
      </h2>

      {% assign upcoming_sub_subscriptions = customer.metafields.membership.subscription_orders.value | json_parse %}
      {% assign today_midnight = 'now' | date: '%Y-%m-%d' %}
      {% assign today_ts = today_midnight | date: '%s' %}
      {% assign soonest_days = 9999 %}
      {% for sub in upcoming_sub_subscriptions %}
        {% if sub.status == 'ACTIVE' or sub.status == 'active' %}
          {% assign billing_ts = sub.next_billing | date: '%s' %}
          {% assign days_out = billing_ts | minus: today_ts | divided_by: 86400 %}
          {% if days_out >= 0 and days_out < soonest_days %}
            {% assign soonest_days = days_out %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% comment %} {% if soonest_days <= 7 %} {% endcomment %}
        <div class="sas-upcoming-banner">
          <div class="text_label">
          <span class="sas-upcoming-banner__icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.5C13 2.5 13.8 3.3 13.8 4.3V4.9C16.5 5.7 18.4 8.2 18.4 11.2V15.3L20 17.7C20.3 18.1 20 18.7 19.5 18.7H4.5C4 18.7 3.7 18.1 4 17.7L5.6 15.3V11.2C5.6 8.2 7.5 5.7 10.2 4.9V4.3C10.2 3.3 11 2.5 12 2.5Z" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M9.5 21C9.5 21 10 22 12 22C14 22 14.5 21 14.5 21" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </span>
          <span>
            {% if soonest_days == 0 %}
              You have a Subscribe &amp; Save order arriving today
            {% elsif soonest_days == 1 %}
              You have an upcoming Subscribe &amp; Save order arriving tomorrow
            {% else %}
              You have an upcoming Subscribe &amp; Save order arriving in {{ soonest_days }} days
            {% endif %}
          </span>
        </div>
          <a href="/pages/subscriptions" class="sas-upcoming-banner__view">View details</a>
        </div>
      {% comment %} {% endif %} {% endcomment %}
     </div>



