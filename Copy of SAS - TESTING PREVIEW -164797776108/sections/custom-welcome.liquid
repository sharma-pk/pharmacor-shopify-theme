<script>
(function () {
  var ITEMS_PER_PAGE = 10;
  var tabState = {}; // per-tab: { letter, visibleCount }

  function getItems(panel, letter) {
    if (letter === 'ALL') return Array.prototype.slice.call(panel.querySelectorAll('.az-product-item'));
    return Array.prototype.slice.call(panel.querySelectorAll('.az-product-item[data-letter="' + letter + '"]'));
  }

  function filterProducts(panel, letter) {
    tabState[panel.id] = { letter: letter, visibleCount: 0 };
    panel.querySelectorAll('.az-product-item').forEach(function (item) { item.classList.remove('az-visible'); });
    var items = getItems(panel, letter);
    var showCount = Math.min(ITEMS_PER_PAGE, items.length);
    for (var i = 0; i < showCount; i++) { items[i].classList.add('az-visible'); }
    tabState[panel.id].visibleCount = showCount;
    var noProducts = panel.querySelector('.az-no-products');
    if (noProducts) noProducts.style.display = items.length === 0 ? 'block' : 'none';
    var loadMoreBtn = panel.querySelector('.loadMore');
    if (loadMoreBtn) loadMoreBtn.style.display = items.length > ITEMS_PER_PAGE ? 'block' : 'none';
  }

  function loadMore(panel) {
    var state = tabState[panel.id];
    if (!state) return;
    var items = getItems(panel, state.letter);
    var end = Math.min(state.visibleCount + ITEMS_PER_PAGE, items.length);
    for (var i = state.visibleCount; i < end; i++) { items[i].classList.add('az-visible'); }
    state.visibleCount = end;
    if (state.visibleCount >= items.length) {
      var loadMoreBtn = panel.querySelector('.loadMore');
      if (loadMoreBtn) loadMoreBtn.style.display = 'none';
    }
  }

  // ── 1. Collection Tab switching ──
  document.querySelectorAll('.nav-tabs .tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      // Get the currently active letter before switching tabs
      var activeLetter = 'ALL';
      var activeAzBtn = document.querySelector('.tab-section[style*="display:block"] .az-btn.active-az, .tab-section[style*="display: block"] .az-btn.active-az');
      if (activeAzBtn) activeLetter = activeAzBtn.getAttribute('data-letter');

      document.querySelectorAll('.nav-tabs .tab-btn').forEach(function (b) { b.classList.remove('active-tab'); });
      document.querySelectorAll('.tab-section').forEach(function (p) { p.style.display = 'none'; });
      btn.classList.add('active-tab');
      var panel = document.getElementById(btn.getAttribute('data-tab'));
      if (!panel) return;
      panel.style.display = 'block';

      // Apply the same letter on the new tab
      var azStrip = panel.querySelector('.az-nav-tabs');
      if (azStrip) {
        azStrip.querySelectorAll('.az-btn').forEach(function (b) { b.classList.remove('active-az'); });
        var matchBtn = azStrip.querySelector('[data-letter="' + activeLetter + '"]');
        if (matchBtn) matchBtn.classList.add('active-az');
      }
      filterProducts(panel, activeLetter);
    });
  });

  // ── 2. A–Z filtering within a tab ──
  document.querySelectorAll('.az-nav-tabs').forEach(function (strip) {
    strip.querySelectorAll('.az-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        strip.querySelectorAll('.az-btn').forEach(function (b) { b.classList.remove('active-az'); });
        btn.classList.add('active-az');
        filterProducts(strip.closest('.tab-section'), btn.getAttribute('data-letter'));
      });
    });
  });

  // ── 3. Load More ──
  document.querySelectorAll('.tab-section .loadMore').forEach(function (btn) {
    btn.style.display = 'none';
    btn.addEventListener('click', function () { loadMore(btn.closest('.tab-section')); });
  });

  // ── 4. Search ──
  var searchBtn = document.querySelector('.serach_btn');
  if (searchBtn) {
    searchBtn.addEventListener('click', function () {
      var val = (document.getElementById('searchInput').value || '').trim().toLowerCase();
      document.querySelectorAll('.collection__item').forEach(function (el) {
        var t = el.querySelector('.product-card__title');
        el.style.display = (t && t.textContent.toLowerCase().includes(val)) ? '' : 'none';
      });
      document.querySelectorAll('.custom_product-section, .custom-main-inner-wrap').forEach(function (el) {
        var t = el.querySelector('.product-name');
        el.style.display = (t && t.textContent.toLowerCase().includes(val)) ? '' : 'none';
      });
    });
  }

  // ── 5. Custom select menu ──
  var optionMenu = document.querySelector('.select-menu');
  if (optionMenu) {
    var selectBtn = optionMenu.querySelector('.select-btn');
    var sBtnText  = optionMenu.querySelector('.sBtn-text');
    selectBtn.addEventListener('click', function () { optionMenu.classList.toggle('active'); });
    optionMenu.querySelectorAll('.option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        sBtnText.innerText = opt.querySelector('.option-text').innerText;
        optionMenu.classList.remove('active');
      });
    });
  }

  // ── 6. Init: show all products in the first active tab on page load ──
  var firstPanel = document.querySelector('.tab-section[style*="display:block"], .tab-section[style*="display: block"]');
  if (firstPanel) filterProducts(firstPanel, 'ALL');

})();
</script>



<script>
(function () {
  // Log all known Smile.io events
  ['smile:setup','smile:ready','smile:loaded','smile:customer_loaded','smile:customer_status','smile:customer_data'].forEach(function(evt) {
    document.addEventListener(evt, function(e) {
      console.log('[Smile Debug] Event fired:', evt, e.detail);
    });
  });
  // Log postMessages from Smile.io (in case they use an iframe)
  window.addEventListener('message', function(e) {
    if (e.data && JSON.stringify(e.data).indexOf('smile') > -1) {
      console.log('[Smile Debug] postMessage:', e.origin, e.data);
    }
  });
  // Check window objects after 2s
  setTimeout(function() {
    console.log('[Smile Debug] window.smile =', window.smile);
    console.log('[Smile Debug] window.Smile =', window.Smile);
    console.log('[Smile Debug] window.SmileUI =', window.SmileUI);
    console.log('[Smile Debug] window.__pcc_pts =', window.__pcc_pts);
  }, 2000);
  // Log every fetch call
  var _origFetch = window.fetch;
  window.fetch = function(r, o) {
    var url = typeof r === 'string' ? r : (r && r.url) || '';
    if (url.indexOf('smile') > -1 || url.indexOf('yotpo') > -1) {
      console.log('[Smile Debug] fetch call:', url);
    }
    return _origFetch.apply(this, arguments);
  };
})();
</script>

<!-- Intercepts Smile.io network calls — runs before their script loads -->
<script>
(function () {
  function _pccSmileData(data) {
    var c = (data && data.customers && data.customers[0]) || (data && data.customer);
    if (c && typeof c.points_balance !== 'undefined') {
      var tierName = c.vip_tier_name || (c.vip_tier && c.vip_tier.name) || null;
      window.__pcc_pts  = c.points_balance;
      window.__pcc_tier = tierName;
      var smileSpent = c.vip_tier_earning_amount || c.amount_spent_in_period || c.ytd_amount_spent || null;
      if (smileSpent != null) window.__pcc_spent = parseFloat(smileSpent) || 0;
      var smileDelta = c.delta_to_next_vip_tier;
      if (smileDelta != null) window.__pcc_delta = parseFloat(smileDelta);
      var expiry = c.vip_tier_expires_at || c.vip_tier_ends_at || null;
      if (expiry) window.__pcc_expiry = expiry;
      document.dispatchEvent(new CustomEvent('pcc:data', {
        detail: { pts: c.points_balance, tier: tierName }
      }));
    }
    if (data && data.vip_tiers && data.vip_tiers.length) {
      window.__pcc_vip_tiers = data.vip_tiers;
      document.dispatchEvent(new CustomEvent('pcc:tiers', { detail: { tiers: data.vip_tiers } }));
    }
  }
  // Intercept fetch
  var _f = window.fetch;
  window.fetch = function (resource, opts) {
    var url = typeof resource === 'string' ? resource : (resource && resource.url) || '';
    var p = _f.apply(this, arguments);
    if (url.indexOf('smile.io') > -1 || url.indexOf('yotpo.com') > -1) {
      p.then(function (res) {
        res.clone().json().then(_pccSmileData).catch(function () {});
      }).catch(function () {});
    }
    return p;
  };
  // Intercept XMLHttpRequest (older Smile.io versions)
  var _open = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (m, url) {
    this._smUrl = String(url || '');
    _open.apply(this, arguments);
  };
  var _send = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.send = function () {
    if (this._smUrl && (this._smUrl.indexOf('smile.io') > -1 || this._smUrl.indexOf('yotpo.com') > -1)) {
      var x = this;
      x.addEventListener('load', function () {
        try { _pccSmileData(JSON.parse(x.responseText)); } catch (e) {}
      });
    }
    _send.apply(this, arguments);
  };
})();
</script>

<script>
(function () {
  var widget = document.querySelector('.pcc-widget');
  if (!widget) return;

  {% if customer %}
  var CUSTOMER_ID = '{{ customer.id }}';
  {% endif %}
  var API_KEY    = '{{ section.settings.smile_public_key | escape }}';
  var TIER1_PTS  = {{ section.settings.tier1_pts | default: 500 }};
  var TIER2_PTS  = {{ section.settings.tier2_pts | default: 1000 }};
  var TIER3_PTS  = {{ section.settings.tier3_pts | default: 10000 }};
  var TIER1_NAME  = '{{ section.settings.tier1_name  | default: "Silver"   | escape }}';
  var TIER2_NAME  = '{{ section.settings.tier2_name  | default: "Gold"     | escape }}';
  var TIER3_NAME  = '{{ section.settings.tier3_name  | default: "Platinum" | escape }}';
  var TIER1_COLOR = '{{ section.settings.tier1-color | default: "#9ca3af" }}';
  var TIER2_COLOR = '{{ section.settings.tier2-color | default: "#d4af37" }}';
  var TIER3_COLOR = '{{ section.settings.tier3-color | default: "#7c8080" }}';
  var EXPIRY_LABEL = '{{ section.settings.expiry_label | escape }}';
  var TIER2_SPEND = {{ section.settings.tier2_spend | default: 5000 }};
  var TIER3_SPEND = {{ section.settings.tier3_spend | default: 15000 }};
  var tiers = [
    { name: TIER1_NAME, pts: TIER1_PTS },
    { name: TIER2_NAME, pts: TIER2_PTS },
    { name: TIER3_NAME, pts: TIER3_PTS }
  ];

  function fmt(n) { return parseInt(n, 10).toLocaleString(); }

  function updateWidget(points, smileTierName) {
    var pts = parseInt(points, 10) || 0;

    var ptsEl = document.getElementById('pcc-pts-val');
    if (ptsEl) ptsEl.textContent = fmt(pts);

    // Determine which segment to show — segment is driven by actual points,
    // NOT the Smile.io tier name, so that 0-point loading states show the
    // correct "To reach <tier>" message. Badge still uses smileTierName.
    var tierLower  = (smileTierName || '').toLowerCase();
    var isPlatinum = tierLower === TIER3_NAME.toLowerCase() || pts >= TIER3_PTS;
    var isGold     = !isPlatinum && (tierLower === TIER2_NAME.toLowerCase() || pts >= TIER2_PTS);
    var isSilver   = !isPlatinum && !isGold && pts >= TIER1_PTS;
    // pre-Silver: pts < TIER1_PTS (shows 0→Silver, footer "To reach Silver")

    var rangeMin, rangeMax, startName, startPts, endName, endPts, showStart;
     if (isPlatinum) {
      // Maxed out: bar at 100%, platinum only — no Gold label shown
      rangeMin = TIER2_PTS; rangeMax = TIER3_PTS;
      startName = null; startPts = 0;
      endName = TIER3_NAME;  endPts = TIER3_PTS;
      showStart = false;
      } else if (isGold) {
      // Gold → Platinum segment
      rangeMin = TIER2_PTS; rangeMax = TIER3_PTS;
      startName = TIER2_NAME; startPts = TIER2_PTS;
      endName = TIER3_NAME;  endPts = TIER3_PTS;
      showStart = true;
    } else if (isSilver) {
      // Silver → Gold segment
      rangeMin = TIER1_PTS; rangeMax = TIER2_PTS;
      startName = TIER1_NAME; startPts = TIER1_PTS;
      endName = TIER2_NAME;  endPts = TIER2_PTS;
      showStart = true;
    } else {
      // Pre-Silver: 0 → Silver; LEFT hidden, RIGHT shows Silver
      rangeMin = 0; rangeMax = TIER1_PTS;
      startName = null; startPts = 0;
      endName = TIER1_NAME; endPts = TIER1_PTS;
      showStart = false;
    }

    // Bar fill
    var fill = document.getElementById('pcc-bar-fill');
    if (fill) {
      var pct = isPlatinum
        ? 100
        : (rangeMax > rangeMin ? Math.max(0, Math.min(100, ((pts - rangeMin) / (rangeMax - rangeMin)) * 100)) : 0);
      fill.style.width = pct.toFixed(2) + '%';
      fill.classList.remove('silver-badge', 'gold-badge', 'platinum-badge');
      fill.classList.add(isPlatinum ? 'platinum-badge' : isGold ? 'gold-badge' : 'silver-badge');
    }

    // Dots
    var dotStart = document.getElementById('pcc-dot-start');
    var dotEnd   = document.getElementById('pcc-dot-end');
    var startTierClass = startName === TIER2_NAME ? 'gold-badge' : startName === TIER3_NAME ? 'platinum-badge' : 'silver-badge';
    var endTierClass   = endName === TIER2_NAME ? 'gold-badge' : endName === TIER3_NAME ? 'platinum-badge' : 'silver-badge';
    if (dotStart) {
      dotStart.style.visibility = showStart ? '' : 'hidden';
      dotStart.classList.toggle('pcc-dot-marker--passed', showStart && pts >= rangeMin);
      dotStart.classList.remove('silver-badge', 'gold-badge', 'platinum-badge');
      dotStart.classList.add(startTierClass);
    }
    if (dotEnd) {
      dotEnd.classList.remove('silver-badge', 'gold-badge', 'platinum-badge');
      dotEnd.classList.add(endTierClass);
      dotEnd.style.visibility = '';
      dotEnd.classList.toggle('pcc-dot-marker--passed', isPlatinum || pts >= rangeMax);
    }

    // Tier labels
    var startItem   = document.querySelector('.pcc-tier-item--left');
    var startNameEl = document.getElementById('pcc-tier-start-name');
    var startPtsEl  = document.getElementById('pcc-tier-start-pts');
    var endItem     = document.getElementById('pcc-tier-end-item');
    var endNameEl   = document.getElementById('pcc-tier-end-name');
    var endPtsEl    = document.getElementById('pcc-tier-end-pts');
    if (startItem)   startItem.style.visibility = showStart ? '' : 'hidden';
    if (startNameEl) startNameEl.textContent = startName || '';
    if (startPtsEl)  startPtsEl.textContent  = startPts ? fmt(startPts) + ' pts' : '';
    if (endItem)     endItem.style.display = '';
    if (endNameEl)   endNameEl.textContent = endName || '';
    if (endPtsEl)    endPtsEl.textContent  = endPts ? fmt(endPts) + ' pts' : '';

    // Color each tier label by the tier it represents (not the member's current tier)
    // start label = current tier's color, end label = target tier's color
    var startLabelColor = isPlatinum ? TIER2_COLOR : isGold ? TIER2_COLOR : isSilver ? TIER1_COLOR : null;
    var endLabelColor   = isPlatinum ? TIER3_COLOR : isGold ? TIER3_COLOR : isSilver ? TIER2_COLOR : TIER1_COLOR;
    if (startNameEl) startNameEl.style.color = startLabelColor || '';
    if (endNameEl)   endNameEl.style.color   = endLabelColor   || '';

    // Apply tier color to badge background and progress bar fill
    var tierColor = isPlatinum ? TIER3_COLOR : isGold ? TIER2_COLOR : isSilver ? TIER1_COLOR : null;
    if (tierColor) {
      widget.style.setProperty('--pcc-badge-bg', tierColor);
      widget.style.setProperty('--pcc-bar-fill', tierColor);
    }

    // Member badge
    var tierLabel = smileTierName
      || (isPlatinum ? TIER3_NAME : isGold ? TIER2_NAME : isSilver ? TIER1_NAME : null);
    if (tierLabel) {
      var badge    = document.getElementById('pcc-badge');
      var badgeTxt = document.getElementById('pcc-badge-text');
      if (badge && badgeTxt) {
        badgeTxt.textContent = tierLabel + ' member';
        var badgeTierClass = isPlatinum ? 'platinum-badge' : isGold ? 'gold-badge' : 'silver-badge';
        badge.classList.remove('silver-badge', 'gold-badge', 'platinum-badge');
        badge.classList.add(badgeTierClass);
        badgeTxt.classList.remove('silver-badge', 'gold-badge', 'platinum-badge');
        badgeTxt.classList.add(badgeTierClass);
        badge.style.display = 'flex';
      }
    }

    // Footer next-tier message
    var nextEl = document.getElementById('pcc-next-tier');
    if (nextEl) {
      if (isPlatinum) {
        nextEl.innerHTML = '<span class="pcc-to-label">Congratulations!</span>' +
          '<strong class="pcc-to-pts">You\'ve reached ' + TIER3_NAME + '!</strong>';
      } else {
        var rem = Math.max(0, endPts - pts);
        nextEl.innerHTML =
          '<span class="pcc-to-label">To reach ' + endName + '</span>' +
          '<strong class="pcc-to-pts">Spend $' + fmt(rem) + ' to upgrade ' + endName + '</strong>';
      }
      // Expiry date notice
      var expiryDate = window.__pcc_expiry || null;
      var expiryDateStr = '';
      if (expiryDate) {
        try {
          var expD = new Date(expiryDate);
          // Smile.io returns exclusive end date (Jan 1 = valid through Dec 31 prior day)
          expD.setDate(expD.getDate() - 1);
          expiryDateStr = expD.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
        } catch (e) { expiryDateStr = expiryDate; }
      }
      // Maintain message — show for Gold/Platinum only, never for Silver
      var maintainThreshold = isPlatinum ? TIER3_SPEND : isGold ? TIER2_SPEND : 0;
      if (maintainThreshold > 0) {
        var spentAmt = null;
        var maintainGapOverride = null;
        if (window.__pcc_spent != null) {
          spentAmt = window.__pcc_spent;
        } else if (window.__pcc_delta != null) {
          if (isPlatinum) {
            maintainGapOverride = Math.max(0, Math.round(window.__pcc_delta));
          } else {
            var nextTierThresh = TIER3_SPEND;
            if (nextTierThresh > 0) spentAmt = Math.max(0, nextTierThresh - window.__pcc_delta);
          }
        }
        var maintainGap = null;
        if (spentAmt !== null) {
          var scale = (maintainThreshold > 100000 || spentAmt > 100000) ? 100 : 1;
          maintainGap = Math.max(0, Math.round((maintainThreshold - spentAmt) / scale));
        } else if (maintainGapOverride !== null) {
          maintainGap = maintainGapOverride;
        } else if (isPlatinum) {
          maintainGap = 0;
        }
        if (maintainGap !== null) {
          var byDate = expiryDateStr || ('December 31, ' + (new Date().getFullYear() + 1));
          var tierForMsg = isPlatinum ? TIER3_NAME : isGold ? TIER2_NAME : TIER1_NAME;
          if (maintainGap > 0) {
            nextEl.innerHTML += '<span class="pcc-maintain-text">Spend $' + fmt(maintainGap) + ' by ' + byDate + ' to maintain your current level</span>';
          } else {
            nextEl.innerHTML += '<span class="pcc-maintain-text">You\'re locked in! You\'ve secured your ' + tierForMsg + ' status until ' + byDate + '</span>';
          }
        }
      }
    }
  }


  // Initial render (no tier data yet)
  updateWidget(0);

  function updateTiers(smileTiers) {
    if (!smileTiers || !smileTiers.length) return;
    var sorted = smileTiers.slice()
      .sort(function(a, b) { return (a.points_threshold || 0) - (b.points_threshold || 0); })
      .filter(function(t) { return t.points_threshold > 0; });
    if (!sorted.length) return;
    var t1 = sorted[0] || null;
    var t2 = sorted[1] || null;
    var t3 = sorted[2] || sorted[sorted.length - 1] || null;
    if (t1) { TIER1_PTS = t1.points_threshold; TIER1_NAME = t1.name || TIER1_NAME; }
    if (t2) { TIER2_PTS = t2.points_threshold; TIER2_NAME = t2.name || TIER2_NAME; }
    if (t3) { TIER3_PTS = t3.points_threshold; TIER3_NAME = t3.name || TIER3_NAME; }
    tiers = [
      { name: TIER1_NAME, pts: TIER1_PTS },
      { name: TIER2_NAME, pts: TIER2_PTS },
      { name: TIER3_NAME, pts: TIER3_PTS }
    ];
    updateWidget(window.__pcc_pts || 0, window.__pcc_tier || null);
  }

  document.addEventListener('pcc:tiers', function(e) {
    if (e.detail && e.detail.tiers) updateTiers(e.detail.tiers);
  });
  if (window.__pcc_vip_tiers) updateTiers(window.__pcc_vip_tiers);

  function roundNice(n) {
    if (n < 1000)   return Math.floor(n / 100) * 100 || 100;
    if (n < 10000)  return Math.floor(n / 1000) * 1000;
    if (n < 100000) return Math.floor(n / 10000) * 10000;
    return Math.floor(n / 50000) * 50000;
  }

  function adjustThresholdsForCustomer(pts, tierName) {
    if (!pts || !tierName) return;
    var rounded = roundNice(pts);
    if (!rounded) return;
    var tl = tierName.toLowerCase();
    if (tl === TIER3_NAME.toLowerCase()) {
      TIER3_PTS = rounded; tiers[2].pts = rounded;
    } else if (tl === TIER2_NAME.toLowerCase()) {
      TIER2_PTS = rounded; tiers[1].pts = rounded;
      if (TIER3_PTS <= TIER2_PTS) { TIER3_PTS = TIER2_PTS * 2; tiers[2].pts = TIER3_PTS; }
    } else if (tl === TIER1_NAME.toLowerCase()) {
      TIER1_PTS = rounded; tiers[0].pts = rounded;
      if (TIER2_PTS <= TIER1_PTS) { TIER2_PTS = TIER1_PTS * 2; tiers[1].pts = TIER2_PTS; }
      if (TIER3_PTS <= TIER2_PTS) { TIER3_PTS = TIER2_PTS * 2; tiers[2].pts = TIER3_PTS; }
    }
  }

  function onSmileData(pts, tierName) {
    adjustThresholdsForCustomer(pts, tierName);
    updateWidget(pts, tierName);
  }

  document.addEventListener('pcc:data', function (e) {
    if (e.detail && typeof e.detail.pts !== 'undefined') onSmileData(e.detail.pts, e.detail.tier);
  });
  if (typeof window.__pcc_pts !== 'undefined') {
    onSmileData(window.__pcc_pts, window.__pcc_tier);
  }

  function tryWindowSmile() {
    var win = window.Smile || window.smile;
    if (!win) return false;
    var c = win.customer || win.customerData || win.current_customer;
    if (c && c.points_balance !== undefined) {
      onSmileData(c.points_balance);
      return true;
    }
    return false;
  }

  [
    'smile:setup', 'smile:ready', 'smile:loaded',
    'smile:customer_loaded', 'smile:customer_status', 'smile:customer_data'
  ].forEach(function (evt) {
    document.addEventListener(evt, function (e) {
      var detail = e.detail || {};
      var c = detail.customer || detail.customerData || detail;
      if (c && c.points_balance !== undefined) {
        onSmileData(c.points_balance);
      } else {
        tryWindowSmile();
      }
    });
  });

  if (!tryWindowSmile()) {
    var _attempts = 0;
    var _poll = setInterval(function () {
      _attempts++;
      if (tryWindowSmile() || _attempts >= 12) clearInterval(_poll);
    }, 500);
  }

  function trySmileTiers() {
    var win = window.SmileUI || window.Smile || window.smile;
    if (!win) return false;
    var tierData = win.vip_tiers || win.tiers
      || (win.program && win.program.vip_tiers)
      || (win.config && win.config.vip_tiers)
      || (win.settings && win.settings.vip_tiers)
      || null;
    if (tierData && tierData.length) { updateTiers(tierData); return true; }
    return false;
  }
  if (!trySmileTiers()) {
    var _ta = 0;
    var _tp = setInterval(function () {
      _ta++;
      if (trySmileTiers() || _ta >= 20) clearInterval(_tp);
    }, 500);
  }

  if (API_KEY && typeof CUSTOMER_ID !== 'undefined') {
    setTimeout(function () {
      if (window.__pcc_pts) return;
      fetch('https://api.smile.io/v1/customers?customer_external_id=shopify-' + CUSTOMER_ID, {
        headers: { 'Authorization': 'Bearer ' + API_KEY }
      })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (data) {
        if (data.customers && data.customers[0]) onSmileData(data.customers[0].points_balance || 0);
      })
      .catch(function () {});
    }, 2000);
  }
})();
</script>

<script>
  // This section had no add-to-cart handler of its own — it was relying on a
  // global .custom-btn-boxes handler in layout/theme.liquid that got disabled
  // (it double-fired /cart/add.js alongside every section's own handler,
  // creating duplicate cart lines). Adding a dedicated one here, matching the
  // fixed pattern used in collection-grid.liquid / wellcom-search.liquid.
  document.addEventListener('DOMContentLoaded', function () {
    document.body.addEventListener('click', function (e) {
      var btn = e.target.closest('.custom-btn-boxes');
      if (!btn) return;
      if (btn.classList.contains('atc-loading')) return;

      var parentForm = btn.closest('form');
      if (!parentForm) return;

      var addingVariantId = resolveWholesalerVariantId(parentForm);
      var properties = buildWholesalerCartProperties(parentForm, addingVariantId);

      var formobj = {
        quantity: parentForm.querySelector('.custom-class-quantity')?.value || 1,
        id: addingVariantId,
        properties: properties
      };

      btn.classList.add('atc-loading');
      var btnText = btn.querySelector('.js-product-add-to-cart-button-text');
      var originalText = btnText ? btnText.textContent : null;
      if (btnText) btnText.textContent = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formobj)
      })
        .then(function (res) { return res.json(); })
        .then(function (addedItem) {
          if (addedItem && addedItem.status) {
            var errMsg = addedItem.description || 'Could not add to cart.';
            showATCNotification(errMsg, 'error');
            return;
          }

          var bubble = document.getElementById('cart-icon-bubble');
          if (bubble) {
            fetch(window.location.href)
              .then(function (r) { return r.text(); })
              .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var newBubble = doc.querySelector('#cart-icon-bubble');
                if (newBubble) bubble.innerHTML = newBubble.innerHTML;
              });
          }

          var itemTitle = addedItem && addedItem.product_title ? addedItem.product_title : 'Item';
          showATCNotification(itemTitle + ' added to cart!', 'success');

          refreshCartDrawer();
        })
        .catch(function (err) {
          console.log('cart add error:', err);
          showATCNotification('Could not add to cart.', 'error');
        })
        .finally(function () {
          btn.classList.remove('atc-loading');
          if (btnText && originalText !== null) btnText.textContent = originalText;
        });
    });

    function showATCNotification(message, type) {
      var existing = document.querySelector('.atc-toast-notification');
      if (existing) existing.remove();

      var toast = document.createElement('div');
      toast.className = 'atc-toast-notification';
      toast.textContent = message;
      toast.style.cssText = 'position:fixed;top:90px;right:20px;background:' +
        (type === 'success' ? '#30623D' : '#c0392b') +
        ';color:#fff;padding:14px 24px;border-radius:8px;font-size:14px;font-weight:600;z-index:999999;opacity:0;transform:translateY(-10px);transition:all 0.3s ease;';
      document.body.appendChild(toast);

      setTimeout(function () {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
      }, 10);

      setTimeout(function () {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(function () { toast.remove(); }, 200);
      }, 2000);
    }

    function refreshCartDrawer(done) {
      var drawer = document.getElementById('CartDrawer');
      if (!drawer) return;

      var sectionKey = drawer.dataset.sectionId;

      fetch('/?sections=' + encodeURIComponent(sectionKey) + '&_=' + Date.now())
        .then(function (res) { return res.json(); })
        .then(function (res) {
          var html = res[sectionKey];
          if (html) {
            swapDrawerHTML(html);
            if (done) done();
          } else {
            fallback();
          }
        })
        .catch(fallback);

      function fallback() {
        fetch('/?section_id=cart-drawer&_=' + Date.now())
          .then(function (res) { return res.text(); })
          .then(function (html) {
            swapDrawerHTML(html);
            if (done) done();
          });
      }

      function swapDrawerHTML(newHtml) {
        var temp = document.createElement('div');
        temp.innerHTML = newHtml;

        var newContainer = temp.querySelector('.js-cart-container');
        if (newContainer) {
          drawer.querySelector('.js-cart-container').innerHTML = newContainer.innerHTML;
        }

        var newFooter = temp.querySelector('.cart-drawer__footer');
        if (newFooter) {
          drawer.querySelector('.cart-drawer__footer').innerHTML = newFooter.innerHTML;
        }
      }
    }
  });
</script>
