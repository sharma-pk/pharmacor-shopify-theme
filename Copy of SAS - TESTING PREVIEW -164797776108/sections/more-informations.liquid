{% schema %}
{
  "name": "Product: More Information",
  "settings": [
    {
      "type": "image_picker",
      "id": "imageallergen1",
      "label": "Gluten free Image"
    },
    {
      "type": "image_picker",
      "id": "imageallergen2",
      "label": "Gelatin free Image"
    },
    {
      "type": "image_picker",
      "id": "imageallergen3",
      "label": "Lactose free Image"
    }
  ],
  "blocks": [
    {
      "type": "active_ingredients",
      "name": "Active Ingredients",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Active Ingredients Text"
        }
      ]
    },
    {
  "type": "free_from_block",
  "name": "Free From Block",
  "settings": [
   
  ]
},
    {
      "type": "indicators",
      "name": "Indicators",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Indicators Text"
        }
      ]
    },
    {
      "type": "tablet_description",
      "name": "Tablet Description",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Tablet Description Text"
        }
      ]
    },
    {
      "type": "storage",
      "name": "Storage Conditions",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Storage Text"
        }
      ]
    },
    {
      "type": "warnings",
      "name": "Warnings",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Warning Text"
        }
      ]
    },
    {
      "type": "additional_info",
      "name": "Additional Info",
      "settings": [
        { "type": "text", "id": "generic_name", "label": "Generic Name" },
        { "type": "text", "id": "pbs_listed1", "label": "PBS Listed" },
        { "type": "text", "id": "rpbs_listed1", "label": "RPBS Listed" },
        { "type": "text", "id": "strength", "label": "Strength" },
        { "type": "text", "id": "dosage", "label": "Dosage" },
        { "type": "text", "id": "pack_size", "label": "Pack Size" },
        { "type": "text", "id": "schedule", "label": "Schedule" },
        { "type": "text", "id": "shelf_life", "label": "Shelf Life" },
        { "type": "text", "id": "innovator", "label": "Innovator" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "More Info with Blocks",
      "blocks": [
        { "type": "active_ingredients" },
        { "type": "free_from_block" },
        { "type": "indicators" },
        { "type": "tablet_description" },
        { "type": "storage" },
        { "type": "additional_info" },
        { "type": "warnings" }
      ]
    }
  ]
}
{% endschema %}

<section class="more-info-section">
  <div class="infor_wrapper">
  <h2>More Information</h2>
  <div class="info-grid">

    {% for block in section.blocks %}
      {% case block.type %}

        {% when "active_ingredients" %}
          <div class="info-card">
            <h3>Active Ingredients</h3>
            <div class="info_content">{{ block.settings.content | newline_to_br }}</div>
          </div>

        {% when "free_from_block" %}
          <div class="free-from-wrapper info-card">
             <h3>Free-From</h3>
             
      {% comment %} <div class="free-from-card">
  {% for i in (1..5) %}
    {% assign icon_key = "icon_" | append: i %}
    {% assign label_key = "label_" | append: i %}
    {% assign icon = block.settings[icon_key] %}
    {% assign label = block.settings[label_key] %}
    {% if icon or label %}
       <div class="icon_with_text">
        {% if icon %}
          <img src="{{ icon | img_url:'master' }}" alt="{{ label }}" class="free-icon" />
        {% endif %}
        <span>{{ label }}</span>
      </div>
    {% endif %}
  {% endfor %}
     </div> {% endcomment %}
      <div class="free-from-card">
           
              {% if product.metafields.custom.allergen contains 'Gluten free' %}
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen1 | img_url: 'master' }}" style="width: 80px;" alt="Gluten free">
                 <span>Gluten free</span>
                </div>
              {% endif %}
               {% if product.metafields.custom.allergen contains 'gluten free' %}
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen1 | img_url: 'master' }}" style="width: 80px;" alt="Gluten free">
                <span>Gluten free</span>
                </div>
              {% endif %}
              {% if product.metafields.custom.allergen contains 'Gelatin free' %}
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen2 | img_url: 'master' }}" style="width: 80px;" alt="Gelatin free">
                <span>Gelatin free</span>
                </div>
              {% endif %}
              {% if product.metafields.custom.allergen contains 'gelatin free' %} 
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen2 | img_url: 'master' }}" style="width: 80px;" alt="Gelatin free">
                <span>Gelatin free</span>
                </div>
              {% endif %}
              {% if product.metafields.custom.allergen contains 'Lactose free' %}
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen3 | img_url: 'master' }}" style="width: 80px;" alt="Lactose free">
                <span>Lactose free</span>
                </div>
              {% endif %}
              {% if product.metafields.custom.allergen contains 'lactose free' %}
                 <div class="icon_with_text">
                <img src="{{ section.settings.imageallergen3 | img_url: 'master' }}" style="width: 80px;" alt="Lactose free">
                <span>Lactose free</span>
                 </div>
              {% endif %}
              

            </div>
</div>

        {% when "indicators" %}
          <div class="info-card full">
            <h3>Indicators</h3>
             <div class="info_content">{{ block.settings.content | newline_to_br }}</div>
          </div>

        {% when "tablet_description" %}
          <div class="info-card">
            <h3>Tablet Description</h3>
            <div class="info_content">{{ block.settings.content }}</div>
          </div>

        {% when "storage" %}
          <div class="info-card">
            <h3>Storage Conditions</h3>
             <div class="info_content">{{ block.settings.content }}</div>
          </div>

        {% when "warnings" %}
          <div class="info-card warning">
            <h3>Warnings</h3>
             <div class="info_content">{{ block.settings.content }}</div>
          </div>

        {% when "additional_info" %}
          <div class="info-card">
            <h3>Additional Information</h3>
            <ul class="meta-info">
              <li><strong>Generic Name:</strong> {{ block.settings.generic_name }}</li><li>
              <strong>PBS Listed:</strong> {% if block.settings.pbs_listed1  %}✔{% else %}✘{% endif %}</li>
              <li><strong>RPBS:</strong> {% if block.settings.rpbs_listed1 %}✔{% else %}✘{% endif %}</li>
              <li><strong>Strength:</strong> {{ block.settings.strength }}</li>
              <li><strong>Dosage:</strong> {{ block.settings.dosage }}</li>
              <li><strong>Pack Size:</strong> {{ block.settings.pack_size }}</li>
              <li><strong>Schedule:</strong> {{ block.settings.schedule }}</li>
              <li><strong>Shelf Life:</strong> {{ block.settings.shelf_life }}</li>
              <li><strong>Innovator:</strong> {{ block.settings.innovator }}</li>
            </ul>
          </div>

      {% endcase %}
    {% endfor %}

  </div>
  </div>
</section>

<style>
.more-info-section {
  background: #fff;
  padding: 40px;
  border-radius: 12px;
  margin-top: 40px;
  font-family: sans-serif;
}

.infor_wrapper {
  background: #F3F8F8;
  padding: 80px 200px;
  margin: 0 auto;
  border-radius: 20px;
}

.more-info-section h2 {
  margin-bottom: 30px;
  border-bottom: 2px solid #30623D;
  padding-bottom: 40px;
  font-family: "Neutrif Studio", sans-serif;
  font-weight: 500;
  font-size: 50px;
  line-height: normal;
  letter-spacing: 0;
  text-align: center;
  color: #30623D;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.info-card {
  display: grid;
  grid-template-columns: 30% 70%;
  gap: 20px;
  padding: 20px;
  border-radius: 10px;
}

.info-card h3 {
  font-family: "Neutrif Studio", sans-serif;
  font-weight: 600;
  font-size: 25px;
  line-height: normal;
  letter-spacing: 0;
  color: #30623D;
}

.info_content,
.meta-info li {
  font-family: "Neutrif Studio", sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: normal;
  letter-spacing: 0;
  text-align: justify;
  text-transform: capitalize;
  color: #7D7777;
}

.meta-info {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  list-style: none;
  padding-left: 0;
  font-size: 14px;
}

.meta-info li {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-bottom: 4px;
}

.meta-info li strong {
  font-family: "Neutrif Studio", sans-serif;
  font-weight: 600;
  font-size: 20px;
  line-height: normal;
  letter-spacing: 0;
  color: #30623D;
}

.full {
  grid-column: 1 / -1;
}

.free-from-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: nowrap;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 14px;
}

.free-from-card span {
  font-family: "Neutrif Studio", sans-serif;
  font-weight: 500;
  font-size: 20px;
  line-height: normal;
  letter-spacing: 0;
  text-align: center;
  text-transform: capitalize;
  color: #7D7777;
}

.free-icon {
  width: 100px;
  height: 100px;
  object-fit: contain;
}

@media only screen and (max-width: 767px) {
  .infor_wrapper {
    padding: 40px 20px;
  }

  .info-card {
    grid-template-columns: 100%;
  }

  .meta-info {
    grid-template-columns: 1fr 1fr;
  }

  .free-from-card {
    flex-wrap: wrap;
  }
  .more-info-section {
    padding: 0px 20px 50px;
  }
  .more-info-section h2{
        font-size: 35px;
  }
}
</style>
