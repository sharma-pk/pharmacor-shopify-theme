  <script>
    function showTab(e, tabId) {
      let sections = document.getElementsByClassName('tab-section');
      for (let i = 0; i < sections.length; i++) {
        sections[i].style.display = 'none';
      }

      let buttons = document.getElementsByClassName('tab-btn');
      for (let i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('active-tab');
      }

      const targetSection = document.getElementById(tabId);
      if (targetSection) targetSection.style.display = 'block';
      e.currentTarget.classList.add('active-tab');
    }
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.custom-product-card-list-wrap .custom_product-section').forEach(function (card) {
        const container = card.querySelector('.product-quantity__container');
        if (!container) return;

        const input = container.querySelector('.product-quantity__input2');
        const btnDecrease = container.querySelector('[data-quantity-decrease]');
        const btnIncrease = container.querySelector('[data-quantity-increase]');
        const addToCartInput = card.querySelector('.add-to-card-input');
        if (!input || !btnDecrease || !btnIncrease || !addToCartInput) return;

        const min = parseInt(input.min) || 1;
        const max = parseInt(input.max) || Infinity;

        function syncValue() {
          addToCartInput.value = input.value;
        }

        // Decrease button
        btnDecrease.addEventListener('click', function () {
          let value = parseInt(input.value);
          if (isNaN(value)) value = min;
          if (value > min) {
            input.value = value - 1;
          } else {
            input.value = ''; // allow empty instead of min
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
          syncValue();
        });

        // Increase button
        btnIncrease.addEventListener('click', function () {
          let value = parseInt(input.value);
          if (isNaN(value)) value = 0;
          if (value < max) {
            input.value = value + 1;
          } else {
            input.value = max;
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
          syncValue();
        });

        // Allow clearing with Backspace
        input.addEventListener('keydown', function (e) {
          // Backspace key = 8, Delete = 46
          if ((e.key === 'Backspace' || e.key === 'Delete') && input.value.length === 1) {
            // clear value completely
            input.value = '';
            e.preventDefault(); // prevent browser from re-filling min
            syncValue();
          }
        });

        // On manual typing
        input.addEventListener('input', function () {
          if (input.value === '') {
            syncValue();
            return;
          }
          input.value = input.value.replace(/[^\d]/g, '');
          let value = parseInt(input.value);
          if (!isNaN(value)) {
            if (value > max) value = max;
            input.value = value;
          }
          syncValue();
        });

        // Keep blank after blur
        input.addEventListener('blur', syncValue);

        syncValue();
      });
    });
  </script>
