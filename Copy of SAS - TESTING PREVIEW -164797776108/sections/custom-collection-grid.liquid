  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const initContainers = new WeakSet();

      function initQuantity(container) {
        if (initContainers.has(container)) return; // avoid double-binding
        initContainers.add(container);

        const input = container.querySelector('[data-quantity-input]');
        const decreaseBtn = container.querySelector('.descrease-c') || container.querySelector('.decrease-c');
        const increaseBtn = container.querySelector('.increase-c');
        const addToCartInput = container.querySelector('.add-to-card-input');
        const customValueEls = container.querySelectorAll('.custom-class-quantity');

        if (!input) return;

        const clamp = (n, min, max) => Math.max(min, Math.min(max, n));

        const sync = () => {
          const min = parseInt(input.min) || 1;
          const rawMax = parseInt(input.max);
          const max = Number.isFinite(rawMax) ? rawMax : Infinity;

          let v = parseInt(input.value);
          if (Number.isNaN(v)) v = min;
          v = clamp(v, min, max);

          input.value = v;

          // ✅ mirror to custom-class-quantity (handle both hidden input & normal text element)
          customValueEls.forEach((el) => {
            if (el.tagName === 'INPUT') {
              el.value = v;
            } else {
              el.textContent = v;
            }
          });

          // ✅ mirror to hidden/extra input if present
          if (addToCartInput) {
            addToCartInput.value = v;
            addToCartInput.dispatchEvent(new Event('input', { bubbles: true }));
            addToCartInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        };

        // start at 1 (or respect existing) then sync everything
        if (!input.value) input.value = 1;
        sync();

        decreaseBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          const min = parseInt(input.min) || 1;
          let v = parseInt(input.value) || min;
          if (v > min) {
            input.value = v - 1;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
            sync();
          }
        });

        increaseBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          const rawMax = parseInt(input.max);
          const max = Number.isFinite(rawMax) ? rawMax : Infinity;
          let v = parseInt(input.value) || 1;
          if (v < max) {
            input.value = v + 1;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
            sync();
          }
        });

        // manual typing
        input.addEventListener('input', sync);
        input.addEventListener('change', sync);
      }

      document.querySelectorAll('.product-quantity__container').forEach(initQuantity);
    });
  </script>
