<script>
  $(".serach_btn").on("click", function() {
      var searchValue = $("#searchInput").val().trim();
      var searchLower = searchValue.toLowerCase();

      // 1️⃣ For .collection__item
      $(".collection__item").each(function() {
          var title = $(this).find('.product-card__title').text().toLowerCase();
          if (title.includes(searchLower)) {
              $(this).show();
          } else {
              $(this).hide();
          }
      });

      // 2️⃣ For .custom_product-section
      $(".custom_product-section,.custom-main-inner-wrap").each(function() {
          var title = $(this).find('.product-name').text().toLowerCase();
          if (title.includes(searchLower)) {
              $(this).show();
          } else {
              $(this).hide();
          }
      });
  });
