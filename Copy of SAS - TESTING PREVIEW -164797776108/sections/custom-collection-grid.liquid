  <script>
    $(document).ready(function () {
      function updatePrice($wrap) {
        var checkedValues = [];
        $wrap.find('input').each(function () {
          if ($(this).is(':checked')) {
            var checkedValue = $(this).attr('customval');
            let formattedValue = checkedValue.toLowerCase().replace(/\s+/g, '-');
            checkedValues.push(formattedValue);
          }
        });
        var combinedValues = checkedValues.join('-').toLowerCase();
        if (!combinedValues) return;
        setTimeout(function () {
          var variantid = $wrap.find('.man-class-cont #' + combinedValues).attr('product-id');
          var variantprice = $wrap.find('.man-class-cont #' + combinedValues).attr('variant-price');
          var variantcompareprice = $wrap.find('.man-class-cont #' + combinedValues).attr('compare-price');
          // alert(crvalue);
          // alert(variantprice);
          // alert(variantcompareprice);

          $wrap.find('.cusotm-cart-id').val(variantid);
          $wrap.closest('.product-card').find('.price-item--sale').html(variantprice);
          $wrap
            .closest('.product-card')
            .find('.data-wpd-hide.price-item.price-item--regular')
            .html(variantcompareprice);
          var myvariantQuantity = $wrap.find('.' + combinedValues).attr('varientquentity');
          console.log('Variant Quantity:', myvariantQuantity);
          let $buyNowBtn = $wrap.find('.btn--buy-now');
          let newHref = 'https://shop.pharmacor.com.au/checkout?variant=' + variantid + '&quantity=1';
          $buyNowBtn.attr('href', newHref);
        }, 50);
      }

      $('.custom-variant-wrap input').on('change', function () {
        var $currentWrap = $(this).closest('.custom-variant-wrap');
        updatePrice($currentWrap);
      });
      $('.custom-variant-wrap').each(function () {
        updatePrice($(this));
      });
    });
  </script>

  <script>
    $(document).ready(function () {
      if ($(window).width() > 992) {
        // Initial setup for hiding the custom-variant
        $('.custom-variant').slideUp(1);

        // Hover function to show/hide the custom-variant
        function initHover() {
          $('.collection__item, .featured-products__col, .products-thumbnails__product').hover(
            function () {
              $(this).find('.custom-variant').stop(true, true).slideDown(300);
            },
            function () {
              $(this).find('.custom-variant').stop(true, true).slideUp(500);
            }
          );
        }

        initHover();

        function checkURLChange() {
          setTimeout(function () {
            $('.custom-variant').slideUp(1);
            initHover();
          }, 1600);
          initHover();
        }

        var pushState = history.pushState;
        history.pushState = function (state) {
          pushState.apply(history, arguments);
          checkURLChange();
        };

        $(window).on('popstate', function () {
          checkURLChange();
        });
      }
    });
  </script>

  <script>
    (function() {
      document.querySelectorAll(".custom-carttt").forEach(function(el) {
        el.addEventListener("click", function() {
          var parentForm = $(this).closest("form");

          var idimp          = resolveWholesalerVariantId(parentForm);
          var customquantity = parentForm.find(".custom-quantity").val();
          var subscription    = parentForm.find('[name="properties[subscription]"]').val();
          var pickup_location    = $('[name="properties[Shipping Option]"]:checked').val();

          var properties = buildWholesalerCartProperties(parentForm, idimp, {
            "subscription": subscription,
            "Shipping Option": pickup_location
          });

          let formobj = {
            quantity: customquantity,
            id: idimp,
            properties: properties
          };

          $.ajax({
            type: "POST",
            url: "/cart/add.js",
            cache: false,
            data: formobj,
            dataType: "json",
            success: function() {
              // bubble refresh
              $('#cart-icon-bubble').load(window.location.href + " #cart-icon-bubble > *");

              // drawer refresh
              refreshCartDrawer(function(){
                {% if settings.home-page-drawer %}
                  $(".header__icon--cart").trigger("click");
                  $("body").addClass("cart-open");
                {% endif %}
              });
            },
            error: function(xhr, status, error) {
              console.log('cart add error:', error);
            }
          });
        });
      });

      // -------- Drawer Refresh (Section Rendering API) ----------
      function refreshCartDrawer(done){
        var $drawer = $("#CartDrawer");
        var sectionKey = $drawer.data("section-id");

        $.ajax({
          type: "GET",
          url: "/?sections=" + encodeURIComponent(sectionKey) + "&_=" + Date.now(),
          dataType: "json",
          success: function(res){
            var html = res && res[sectionKey];
            if(html) {
              swapDrawerHTML(html);
              if(typeof done === "function") done();
            } else {
              fallbackHTML(done);
            }
          },
          error: function(){
            fallbackHTML(done);
          }
        });

        function fallbackHTML(cb){
          $.ajax({
            type: "GET",
            url: "/?section_id=cart-drawer&_=" + Date.now(),
            dataType: "html",
            success: function(html){
              swapDrawerHTML(html);
              if(typeof cb === "function") cb();
            }
          });
        }

        function swapDrawerHTML(newHtml){
          var $tmp = $(newHtml);

          var $newContainer = $tmp.find(".js-cart-container");
          if($newContainer.length){
            $drawer.find(".js-cart-container").html($newContainer.html());
          } else {
            var $alt = $tmp.filter(".drawer").find(".js-cart-container");
            if($alt.length){
              $drawer.find(".js-cart-container").html($alt.html());
            }
          }

          var $newFooter = $tmp.find(".cart-drawer__footer");
          if($newFooter.length){
            $drawer.find(".cart-drawer__footer").html($newFooter.html());
          }
        }
      }
    })();
  </script>
