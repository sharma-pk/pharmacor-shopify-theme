    <script>
      document.addEventListener('DOMContentLoaded', function () {
        let wrapper = document.querySelector('#dynamic'); // product wrapper
        if (!wrapper) return;
        let items = wrapper.querySelectorAll('.collection__item');
        let loadMoreBtn = document.querySelector('.loadMore');
        let visible = 100;

        // sab ko hide kar do (CSS se bhi kar sakte ho)
        items.forEach((item) => (item.style.display = 'none'));

        // pehle 6 show karo
        for (let i = 0; i < visible && i < items.length; i++) {
          items[i].style.display = 'block';
        }

        if (!loadMoreBtn) return;

        // button hide karo agar products 6 ya usse kam hain
        if (items.length <= visible) {
          loadMoreBtn.style.display = 'none';
        }

        // button click par aur 6 show karo
        loadMoreBtn.addEventListener('click', function () {
          let nextVisible = visible + 100;
          for (let i = visible; i < nextVisible && i < items.length; i++) {
            items[i].style.display = 'block';
          }
          visible = nextVisible;

          if (visible >= items.length) {
            loadMoreBtn.style.display = 'none';
          }
        });
      });
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        let parents = document.querySelectorAll('.custom-product-parent');

        parents.forEach(function (parent) {
          let items = parent.querySelectorAll('.customitem');
          let loadMoreBtn = parent.querySelector('.loadMore');
          let visible = 100;

          // sabko hide kardo
          items.forEach((item) => (item.style.display = 'none'));

          // pehle 6 show
          for (let i = 0; i < visible && i < items.length; i++) {
            items[i].style.display = 'block';
          }

          if (!loadMoreBtn) return;

          loadMoreBtn.addEventListener('click', function () {
            // alert("Load More clicked ✅");
            let nextVisible = visible + 100;
            for (let i = visible; i < nextVisible && i < items.length; i++) {
              items[i].style.display = 'block';
            }
            visible = nextVisible;

            if (visible >= items.length) {
              loadMoreBtn.style.display = 'none';
            }
          });

          if (items.length <= 100) {
            loadMoreBtn.style.display = 'none';
          }
        });
