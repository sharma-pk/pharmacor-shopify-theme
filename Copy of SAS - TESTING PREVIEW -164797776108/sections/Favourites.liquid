<script>
  function showTab(e, tabId) {
    let sections = document.getElementsByClassName('tab-section');
    for (let i = 0; i < sections.length; i++) {
      sections[i].style.display = 'none';
    }

    let buttons = document.getElementsByClassName('tab-btn');
    for (let i = 0; i < buttons.length; i++) {
      buttons[i].classList.remove('active-tab');
    }

    const targetSection = document.getElementById(tabId);
    if (targetSection) targetSection.style.display = 'block';
    e.currentTarget.classList.add('active-tab');
  }
</script>


<script>

$(document).ready(function () {

  // ---- helper for number parsing ----
  function parseMoney(val) {
    return parseFloat((val || "0").replace(/[^0-9.]/g, "")) || 0;
  }

  function handleDropdownChange($dropdown) {
    const $parent = $dropdown.closest('.custom-main-inner-wrap');

    // Build variant key from dropdown values
    let combinedValue = [];
    $parent.find('.custom_dropdown').each(function () {
      if (this.value) combinedValue.push(this.value);
    });

    combinedValue = combinedValue.join("-")
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[\/\.]/g, "-");

    if (!combinedValue) return;

    // Find matching hidden variant inputs
    const $variantElements = $parent.find("." + combinedValue);
    if (!$variantElements.length) return;

    const $baseEl = $variantElements.first();

    const variantId = $baseEl.attr("myvarientid");
    const variantProfit = $baseEl.attr("variantprofit");
    const variantQty = parseInt($baseEl.attr("varientquentity") || "0", 10);

    const variantPrice = parseMoney($baseEl.attr("varienrprice"));
    const variantComparePrice = parseMoney($baseEl.attr("varienrcompprice"));
    const tierPrice = parseMoney($baseEl.attr("customwholesaleprice"));

    // ===== Determine final selling price =====
    let displayPrice = variantPrice;
    if (tierPrice > 0) displayPrice = tierPrice;

    // ===== Volume Discount Rendering (Multiple Tiers) =====
    const $volumeBox = $parent.find("#variant-volume-discount");
    const $volumeText = $volumeBox.find(".volume-offer-text");
    $volumeText.empty();

    $variantElements.each(function () {
      const qty = parseInt(this.getAttribute("volumeqty") || "0", 10);
      const price = parseMoney(this.getAttribute("volumediscountprice"));

      if (qty > 0 && price > 0) {
        const row = document.createElement("div");
        row.innerHTML = `
          <span class="volume-qty">Buy ${qty}+</span>
          <span class="volume-price"><span class="volumne-arrow">→</span> $${price.toFixed(2)}</span>
        `;
        $volumeText.append(row);
      }
    });

    $volumeBox.toggle($volumeText.children().length > 0);

    // ===== Saving Percentage =====
    if (variantComparePrice > displayPrice && variantComparePrice > 0) {
      let savingPercent = Math.round(((variantComparePrice - displayPrice) / variantComparePrice) * 100);
      if (savingPercent <= 0) savingPercent = 1;

      $parent.find(".custom-sale-pricee").html("Saving: " + savingPercent + "%");
      $parent.find(".price__discount")
        .contents()
        .filter(function () { return this.nodeType === 3; })
        .first()
        .replaceWith(savingPercent + "% ");
    }

    // ===== ✅ Correct Ultra Theme Price Update =====

    // Sale / Final Price
    $parent.find(".price-item.price-item--sale")
      .html("$" + displayPrice.toFixed(2));

    // Compare-at Price (show only if higher)
    if (variantComparePrice > displayPrice) {
      $parent.find(".price-item.price-item--regular")
        .html("$" + variantComparePrice.toFixed(2))
        .show();
    } else {
      $parent.find(".price-item.price-item--regular").hide();
    }

    // Custom discount price box
    $parent.find(".discount-price-item")
      .attr("data-wpd-variant-id", variantId)
      .html("$" + displayPrice.toFixed(2));

    // ===== Hidden Inputs =====
    $parent.find(".my-add-to-cart-value").val(variantId);
    $parent.find("#my-variant-profit").val(variantProfit);

    // ===== Stock =====
    const $stockBox = $parent.find(".custom-quantity-items");
    const $backorder = $parent.find('.backorder-order');

    if (variantQty > 0) {
