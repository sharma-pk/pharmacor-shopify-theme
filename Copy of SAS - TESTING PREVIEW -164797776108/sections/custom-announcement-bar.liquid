    "settings": [
        {
        "type": "range",
        "id": "icon-margin-top",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Margin Top",
        "default": 0
    },
    {
        "type": "range",
        "id": "icon-margin-bottom",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Margin Bottom",
        "default": 0
