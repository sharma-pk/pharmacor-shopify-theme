      {
        "type": "range",
        "id": "speed-2",
        "min": 10,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Scrolling Speed Mobile",
        "default": 25
      },
    {
       "type":"color",
       "id":"color-1",
      "label":"Background Color"
    },
     {
       "type":"color",
       "id":"color-bg-1",
       "label":"Text Color"
      }
    ] ,
	"blocks": [
    	{
			"name": "Icon Slide",
        	"type": "reviews",
