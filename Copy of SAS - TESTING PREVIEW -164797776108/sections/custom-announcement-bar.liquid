                "label":"2nd Title URL"
              },
              {
                "type":"text",
                "id":"title-2",
                "label":"3rd Title"
              },
              {
                "type":"image_picker",
                "id":"img2",
                "label":"3rd Image"
              },
              {
                "type":"url",
                "id":"title-url-2",
                "label":"3rd Title URL"
              },
                {
                "type":"text",
                "id":"title-3",
                "label":"4th Title"
              },
              {
                "type":"image_picker",
                "id":"img3",
                "label":"4th Image"
              },
              {
                "type":"url",
                "id":"title-url-3",
                "label":"4th Title URL"
              },
               {
                "type":"text",
                "id":"title-4",
                "label":"5th Title"
              },
              {
                "type":"image_picker",
                "id":"img4",
                "label":"5th Image"
              },
              {
                "type":"url",
                "id":"title-url-4",
                "label":"5th Title URL"
              }
            ]
        }
    ],
	"presets":[
	  {
		"name": "Custom Announcement Bar",
		"category": "Slider"
	  }
	]
  }
{% endschema %}

