<script>
  (function() {
    $(document.body).on("click", ".custom-carttt", function() {
      var $btn = $(this);
      if ($btn.hasClass('atc-loading')) return;

      var parentForm = $btn.closest("form");

      var idimp          = resolveWholesalerVariantId(parentForm);
      var customquantity = parentForm.find(".custom-quantity").val();
      var subscription    = parentForm.find('[name="properties[subscription]"]').val();
      var pickup_location    = $('[name="properties[Shipping Option]"]:checked').val();

      var properties = buildWholesalerCartProperties(parentForm, idimp, {
        "subscription": subscription,
        "Shipping Option": pickup_location
      });

      let formobj = {
        quantity: customquantity,
        id: idimp,
        properties: properties
      };

      $btn.addClass('atc-loading');
      var $btnText = $btn.find('.js-product-add-to-cart-button-text');
      var originalText = $btnText.text();
      if ($btnText.length) $btnText.text('Adding...');

      $.ajax({
        type: "POST",
        url: "/cart/add.js",
        cache: false,
        data: formobj,
        dataType: "json",
        success: function(addedItem) {
          if (addedItem && addedItem.status) {
            showATCNotification(addedItem.description || 'Could not add to cart.', 'error');
            return;
          }

          // bubble refresh
          $('#cart-icon-bubble').load(window.location.href + " #cart-icon-bubble > *");

          var itemTitle = addedItem && addedItem.product_title ? addedItem.product_title : 'Item';
          showATCNotification(itemTitle + ' added to cart!', 'success');

          // drawer refresh
          refreshCartDrawer(function(){
            {% if settings.home-page-drawer %}
              $(".header__icon--cart").trigger("click");
              $("body").addClass("cart-open");
            {% endif %}
          });
        },
        error: function(xhr, status, error) {
          console.log('add to cart error:', error);
          showATCNotification('Could not add to cart.', 'error');
        },
        complete: function() {
          $btn.removeClass('atc-loading');
          if ($btnText.length) $btnText.text(originalText);
        }
      });
    });

    function showATCNotification(message, type) {
      $('.atc-toast-notification').remove();
      var $toast = $('<div class="atc-toast-notification">' + message + '</div>');
      $toast.css({
        position: 'fixed', top: '90px', right: '20px',
        background: type === 'success' ? '#30623D' : '#c0392b',
        color: '#fff', padding: '14px 24px', borderRadius: '8px',
        fontSize: '14px', fontWeight: '600', zIndex: 999999,
        opacity: 0, transform: 'translateY(-10px)', transition: 'all 0.3s ease'
      });
      $('body').append($toast);
      setTimeout(function () { $toast.css({ opacity: 1, transform: 'translateY(0)' }); }, 10);
      setTimeout(function () {
        $toast.css({ opacity: 0, transform: 'translateY(-10px)' });
        setTimeout(function () { $toast.remove(); }, 200);
      }, 2000);
    }

    // -------- Drawer Refresh (Section Rendering API) ----------
    function refreshCartDrawer(done){
      var $drawer = $("#CartDrawer");
      var sectionKey = $drawer.data("section-id");

      $.ajax({
        type: "GET",
        url: "/?sections=" + encodeURIComponent(sectionKey) + "&_=" + Date.now(),
        dataType: "json",
        success: function(res){
          var html = res && res[sectionKey];
          if(html) {
            swapDrawerHTML(html);
            if(typeof done === "function") done();
          } else {
            fallbackHTML(done);
          }
        },
        error: function(){
          fallbackHTML(done);
        }
      });

      function fallbackHTML(cb){
        $.ajax({
          type: "GET",
          url: "/?section_id=cart-drawer&_=" + Date.now(),
          dataType: "html",
          success: function(html){
            swapDrawerHTML(html);
            if(typeof cb === "function") cb();
          }
        });
      }

      function swapDrawerHTML(newHtml){
        var $tmp = $(newHtml);

        var $newContainer = $tmp.find(".js-cart-container");
        if($newContainer.length){
          $drawer.find(".js-cart-container").html($newContainer.html());
        } else {
          var $alt = $tmp.filter(".drawer").find(".js-cart-container");
          if($alt.length){
            $drawer.find(".js-cart-container").html($alt.html());
          }
        }

        var $newFooter = $tmp.find(".cart-drawer__footer");
        if($newFooter.length){
          $drawer.find(".cart-drawer__footer").html($newFooter.html());
        }
      }
    }
  })();
</script>

