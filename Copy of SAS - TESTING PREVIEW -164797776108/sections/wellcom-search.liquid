{% comment %}
  Section: Welcome Dashboard
  Description: Personalized dashboard for returning customers with dynamic data and theme-editable fields
{% endcomment %}
<style>
    .input-wrapper.search__input-wrapper{max-width: 800px; margin: 0 auto;
  	position: relative;
  }
   .input-wrapper.search__input-wrapper input{ border: 1px solid #ddd !important;padding: 20px !important;}
   .focus-visible-outline.search__submit {
  	position: absolute;
  	right: 20px;
  	top: 16px;
  }
</style>
<div class="welcome-box">
  <div class="search__header-content">
    <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
      <div class="input-wrapper search__input-wrapper">
        <input
          class="input search__input js-search-input"
          type="search"
          id="searchInput"
          placeholder="{{- 'general.search.search_input_placeholder' | t -}}"
          aria-label="{{- 'general.predictive_search.placeholder_aria_label' | t | escape -}}"
          name="q"
          value="{{ search.terms | escape }}"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        >

        <button
          class="focus-visible-outline search__submit"
          type="submit"
          aria-label="{{- 'sections.search_template.submit_query_aria_label' | t | escape -}}"
        >
          {%- render 'icons', icon: 'search' -%}
        </button>
      </div>

      <input name="options[prefix]" type="hidden" value="last">
      <input class="js-search-types" type="hidden" name="type" value="{{- search_type_values -}}">
    </form>
  </div>

  {% comment %} {% render 'collection-list',product:product %} {% endcomment %}

  <div class="collections-list-wrapper">
    <div class="filters_home">
      {%- assign active_filters_size = 0 -%}
      {%- assign filters_type = section.settings.filters_type -%}

      {%- for filter in collection.filters -%}
        {%- case filter.type -%}
          {%- when 'list', 'boolean' -%}
            {%- assign active_filters_size = active_filters_size | plus: filter.active_values.size -%}
          {%- when 'price_range' -%}
            {%- if filter.min_value.value > 0 or filter.max_value.value < filter.range_max -%}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                {%- assign active_filters_size = active_filters_size | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
      {% endfor %}

      <div class="collection__header-row sort_with_icons">
        {%- render 'product-filters-and-sort-bar', product_list: collection, without_filter_button: true -%}

        <div class="sort_with_icons">
          <div class="grid-lists-iconss">
           
            <div class="list-view-btn iocns active">
              <span>
                <svg width="37" height="29" viewBox="0 0 37 29" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="7.70667" y="0.480713" width="28.992" height="4.40385" fill="#30623D"></rect>
                  <circle cx="2.20193" cy="2.68264" r="2.20193" fill="#30623D"></circle>
                  <rect x="7.70667" y="12.2243" width="28.992" height="4.40385" fill="#30623D"></rect>
                  <circle cx="2.20193" cy="14.4263" r="2.20193" fill="#30623D"></circle>
                  <rect x="7.70667" y="23.9679" width="28.992" height="4.40385" fill="#30623D"></rect>
                  <circle cx="2.20193" cy="26.1698" r="2.20193" fill="#30623D"></circle>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="list_of_collections">
      

      <div id="custom" class="custom-collection-page-tabcontent">
        <style>
               .custom-btn-boxes{border: 2px solid #30623d!important;
            padding-top: 20px!important;
            padding-bottom: 20px!important;
            cursor: pointer!important;}
                    /* Container for tabs */
                    .nav-tabs {
                      overflow: hidden;
                    }

                    /* Tab buttons */
                    .nav-tabs button {
                      background: transparent;
                      float: left;
                      border: none;
                      cursor: pointer;
                      padding: 10px 30px;
                      margin-right: 6px;
                      font-size: 16px;
                      transition: 0.3s;
                      border: 2px solid #30623d;
                      border-radius: 30px;
                    }

                    /* Hover effect */
                    .nav-tabs button:hover {
                      background: #30623d;
                      color: #fff;
                    }

                    /* Active state */
                    .nav-tabs button.active-tab {
                      background: #30623d;
                      color: #fff;
                    }

                    .tab-section {
                      display: none;
                    }
          @media only screen and (max-width: 767px){
                    .wrapper_welcome{padding: 12px !important;}
                  }
        </style>

        <div class="nav-tabs">
          {% for block in section.blocks %}
            {% assign block_collection = collections[block.settings.collection] %}
            <button
              class="tab-btn {% if forloop.index == 1 %}active-tab{% endif %}"
              onclick="showTab(event, 'custom{{ block.id }}')"
            >
              {% if block.settings.custom_name != blank -%}
                {{- block.settings.custom_name -}}
              {%- else %}
                {{ block_collection.title -}}
              {%- endif %}
            </button>
          {% endfor %}

          <!-- Static tab button -->
          <button
            class="tab-btn myhidden"
            onclick="showTab(event, 'custom-all')"
          >
            Filter Products
          </button>
        </div>

        <div class="custom-cart-list-main">
          <div class="custom_labels">
            <div class="custom-list-image">Image</div>
            <div class="custom-list-product-name">Product Name</div>
            <div class="custom-list-wholesaler">
              <div style="width: 50%;">Wholesaler</div>
              <div style="width: 50%;">Strength/Pack Size</div>
            </div>
            {% if customer %}
              <div class="custom-list-price">Price</div>
              <div class="custom-list-quantity">Quantity</div>
         
            {% else %}
              <div class="custom-list-product-info">Product Info</div>
            {% endif %}
          </div>

          {% for block in section.blocks %}
            {% assign block_collection = collections[block.settings.collection] %}
            {% if block_collection %}
              <div
                id="custom{{ block.id }}"
                class="my-collection-list-tabcontent tab-section"
                {% if forloop.index == 1 %}
                  style="display: block"
                {% endif %}
              >
                <div class="custom-product-card-list custom-product-parent" style="width: 100%;">
                  <div class="custom-product-card-list-wrap " id="custom-products">
                    {% paginate block_collection.products by 120 %}
                      {%- for product in block_collection.products -%}
                        {% render 'custom-list-item', product: product, section: section, title: block_collection %}
                      {%- endfor -%}

                      {% if paginate.pages > 1 %}
                        {{ paginate | default_pagination }}
                      {% endif %}
                    {% endpaginate %}
                  </div>
                  <div class="text-center">
                    <button id="loadMore" class="loadMore btn">{{ section.settings['load-more'] }}</button>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {%- comment -%}
            ---- STATIC BLOCK (All Products) ----
          {%- endcomment -%}
          <div
            id="custom-all"
            class="my-collection-list-tabcontent tab-section"
            style="display: none"
          >
            <div class="custom-product-card-list allproductss custom-product-parent" style="width: 100%;">
              <div class="custom-product-card-list-wrap">
                {% paginate collections.all.products by 120 %}
                  {%- for product in collections.all.products -%}
                    {% render 'custom-list-item', product: product, section: section, title: 'All Products' %}
                  {%- endfor -%}

                  {% if paginate.pages > 1 %}
                    {{ paginate | default_pagination }}
                  {% endif %}
                {% endpaginate %}
              </div>
            </div>
          </div>
        </div>
      </div>

      {% comment %}
        <div class="text-center">
          <a href="{{ section.settings.btn_link }}" class="btn">{{ section.settings.btn_text }}</a>
        </div>
      {% endcomment %}
    </div>
  </div>
</div>
<style>
    .custom-collection-list .customitem {
    display: none;
  }
  .allproductss .customitem {
    display: block!important;
  }

  .myhidden {
    display: none !important;
  }
</style>

<!-- Search UI -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const countEl = document.getElementById('searchCount');
    const containerSelector = '#dynamic .product-item';
    let debounceTimer = null;

    if (!searchInput) {
      console.warn('searchInput element not found (id="searchInput") — filter will not run.');
      return;
    }

    // Normalize & extract a handle from many possible query formats:
    // - full URL (https://.../products/handle)
    // - "/products/handle"
    // - "handle"
    function extractHandleFromQuery(raw) {
      if (!raw) return '';
      let q = String(raw).trim();

      // If a "key=value" hash (e.g. #q=foo) or leading ?/#, strip
      q = q.replace(/^[#?]+/, '');
      // drop trailing query/hash if present
      q = q.replace(/[?#].*$/, '');
      try {
        q = decodeURIComponent(q);
      } catch (e) {
        /* ignore */
      }
      q = q.toLowerCase().trim();

      // If contains /products/ -> return segment after it
      let m = q.match(/\/products\/([^\/]+)/i);
      if (m && m[1]) return m[1];

      // Remove domain if user pasted full URL
      q = q.replace(/^https?:\/\/[^\/]+/i, '');
      q = q.replace(/^\/+|\/+$/g, '');
      const parts = q.split('/').filter(Boolean);
      return parts.length ? parts[parts.length - 1] : q;
    }

    // Get item handle by multiple fallbacks
    function getHandleFromItem(item) {
      if (!item) return '';

      // 1) data-handle
      const dh = (item.getAttribute && item.getAttribute('data-handle')) || (item.dataset && item.dataset.handle);
      if (dh) return String(dh).toLowerCase().trim();

      // 2) <a href*="/products/">
      const prodA = item.querySelector && item.querySelector('a[href*="/products/"]');
      if (prodA) {
        const href = prodA.getAttribute('href') || '';
        const m = href.match(/\/products\/([^\/?#]+)/i);
        if (m && m[1]) return decodeURIComponent(m[1]).toLowerCase();
      }

      // 3) any anchor -> last path segment
      const anyA = item.querySelector && item.querySelector('a[href]');
      if (anyA) {
        let href = anyA.getAttribute('href') || '';
        href = href.replace(/[?#].*$/, ''); // strip query/hash
        const parts = href.split('/').filter(Boolean);
        if (parts.length) return parts[parts.length - 1].toLowerCase();
      }

      // 4) fallback: data-title or attribute data-title -> normalized
      const title =
        (item.getAttribute && (item.getAttribute('data-title') || item.getAttribute('data-name'))) ||
        (item.dataset && item.dataset.title);
      if (title) return String(title).toLowerCase().trim().replace(/\s+/g, '-');

      return '';
    }

    // Update URL's q param without reloading
    function setUrlQuery(q, replace = true) {
      try {
        const url = new URL(window.location.href);
        if (!q) {
          url.searchParams.delete('q');
          url.searchParams.delete('search');
          url.searchParams.delete('filter');
          url.searchParams.delete('handle');
        } else {
          url.searchParams.set('q', q);
        }
        if (replace) history.replaceState({ q }, '', url.href);
        else history.pushState({ q }, '', url.href);
      } catch (e) {
        // if URL API not available, skip gracefully
      }
    }

    // Read query from URL (params, then hash, then pathname)
    function readQueryFromUrl() {
      try {
        const url = new URL(window.location.href);
        const keys = ['q', 'search', 'filter', 'handle'];
        for (const k of keys) {
          if (url.searchParams.has(k)) {
            return url.searchParams.get(k) || '';
          }
        }
        // hash like #q=foo or just #foo
        if (window.location.hash) {
          const hash = window.location.hash.replace(/^#/, '');
          const m = hash.match(/(?:q|search|filter|handle)=(.+)/i);
          if (m && m[1]) return decodeURIComponent(m[1]);
          return decodeURIComponent(hash || '');
        }
        // pathname checks (e.g. /products/handle or last segment)
        const pathname = window.location.pathname || '';
        const m = pathname.match(/\/products\/([^\/?#]+)/i);
        if (m && m[1]) return decodeURIComponent(m[1]);
        // otherwise try the last path segment if it looks like a handle
        const parts = pathname.replace(/^\/+|\/+$/g, '').split('/');
        if (parts.length) {
          const last = parts[parts.length - 1];
          // ignore if default pages like "" or index or collections root
          if (!/^(collections|search|collections\/all|index|$)$/i.test(last)) return decodeURIComponent(last);
        }
      } catch (e) {
        // ignore
      }
      return '';
    }

    // Main filtering
    function filterProducts(rawQuery, pushUrl = false) {
      const q = extractHandleFromQuery(rawQuery);
      const items = Array.from(document.querySelectorAll(containerSelector));
      if (!q) {
        items.forEach((it) => (it.style.display = ''));
        if (countEl) countEl.textContent = '';
        if (pushUrl) setUrlQuery('', true);
        return;
      }

      let matches = 0;
      items.forEach((item) => {
        const handle = getHandleFromItem(item) || '';
        if (handle.includes(q)) {
          item.style.display = '';
          matches++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = matches ? matches + ' product(s) found' : 'No products found';
      if (pushUrl) setUrlQuery(q, true);
    }

    // Debounced input -> filter + update url
    searchInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      const val = this.value;
      debounceTimer = setTimeout(() => filterProducts(val, true), 400);
    });

    // Slash to focus (optional)
    document.addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });

    // react to back/forward
    window.addEventListener('popstate', function (e) {
      const q = readQueryFromUrl() || (e.state && e.state.q) || '';
      searchInput.value = q;
      filterProducts(q, false);
    });

    // If products are injected later (ajax / lazy render), re-apply filter automatically:
    const dynamicContainer = document.getElementById('dynamic');
    if (dynamicContainer) {
      const mo = new MutationObserver(() => {
        // re-run current filter without pushing URL
        filterProducts(searchInput.value || readQueryFromUrl(), false);
      });
      mo.observe(dynamicContainer, { childList: true, subtree: true });
    }

    // initial: prefer URL query, otherwise input value
    const initialQuery = readQueryFromUrl();
    if (initialQuery) {
      searchInput.value = initialQuery;
      filterProducts(initialQuery, false);
    } else if (searchInput.value) {
      filterProducts(searchInput.value, false);
    } else {
      // show all by default
      const items = Array.from(document.querySelectorAll(containerSelector));
      items.forEach((it) => (it.style.display = ''));
      if (countEl) countEl.textContent = '';
    }
  });
</script>

<script>
  document.getElementById('searchInput').addEventListener('input', function () {
    var searchVal = this.value.trim();
    var allTabs = document.querySelectorAll('.nav-tabs .tab-btn');
    var allProductsBtn = document.querySelector(".nav-tabs .tab-btn[onclick*='custom-all']");

    if (searchVal.length > 0) {
      // sab tabs hide karo
      allTabs.forEach(function (btn) {
        btn.classList.add('myhidden');
        btn.classList.remove('active-tab');
      });

      // All Products ko dikhana aur activate karna
      if (allProductsBtn) {
        allProductsBtn.classList.remove('myhidden');
        allProductsBtn.classList.add('active-tab');

        // uska click trigger bhi karo
        allProductsBtn.click();
      }
    } else {
      // sab tabs wapas show karo
      allTabs.forEach(function (btn, index) {
        btn.classList.remove('myhidden');
        btn.classList.remove('active-tab');
      });

      // pehli tab ko wapas active aur click karo
      let firstTab = allTabs[0];
      if (firstTab) {
        firstTab.classList.add('active-tab');
        firstTab.click();
      }

      // All Products tab ko wapas hide karo
      if (allProductsBtn) {
        allProductsBtn.classList.add('myhidden');
        allProductsBtn.classList.remove('active-tab');
      }
    }
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    let wrapper = document.querySelector('#dynamic'); // product wrapper
    if (!wrapper) return;
    let items = wrapper.querySelectorAll('.collection__item');
    let loadMoreBtn = document.querySelector('.loadMore');
    let visible = 10;

    // sab ko hide kar do (CSS se bhi kar sakte ho)
    items.forEach((item) => (item.style.display = 'none'));

    // pehle 6 show karo
    for (let i = 0; i < visible && i < items.length; i++) {
      items[i].style.display = 'block';
    }

    if (!loadMoreBtn) return;

    // button hide karo agar products 6 ya usse kam hain
    if (items.length <= visible) {
      loadMoreBtn.style.display = 'none';
    }

    // button click par aur 6 show karo
    loadMoreBtn.addEventListener('click', function () {
      let nextVisible = visible + 10;
      for (let i = visible; i < nextVisible && i < items.length; i++) {
        items[i].style.display = 'block';
      }
      visible = nextVisible;

      if (visible >= items.length) {
        loadMoreBtn.style.display = 'none';
      }
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    let parents = document.querySelectorAll('.custom-product-parent');

    parents.forEach(function (parent) {
      let items = parent.querySelectorAll('.customitem');
      let loadMoreBtn = parent.querySelector('.loadMore');
      let visible = 10;

      // sabko hide kardo
      items.forEach((item) => (item.style.display = 'none'));

      // pehle 6 show
      for (let i = 0; i < visible && i < items.length; i++) {
        items[i].style.display = 'block';
      }

      if (!loadMoreBtn) return;

      loadMoreBtn.addEventListener('click', function () {
        // alert("Load More clicked ✅");
        let nextVisible = visible + 10;
        for (let i = visible; i < nextVisible && i < items.length; i++) {
          items[i].style.display = 'block';
        }
        visible = nextVisible;

        if (visible >= items.length) {
          loadMoreBtn.style.display = 'none';
        }
      });

      if (items.length <= 10) {
        loadMoreBtn.style.display = 'none';
      }
    });
  });
</script>

