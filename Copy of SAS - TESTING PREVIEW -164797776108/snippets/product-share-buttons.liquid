{% comment %}
------------------------------------------------------------------------------
  Snippet: Share buttons
  ----------------------
  Used on PDP
------------------------------------------------------------------------------
{% endcomment %}
{%- capture styles -%}
	--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
	--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
	--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
	--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
{%- endcapture -%}

<div class="product-share-buttons" style="{{ styles }}">
	<span class="product-share-buttons__label">
		{{- 'products.product.share_label' | t -}}
	</span>

	<input id="share-input-{{ section_id }}" class="is-hidden" type="text" value="{{ shop.url | append: product.url }}">

	<a href="#"
	   class="button-social js-social-share"
	   data-share-title="{{ product.title | escape }}"
	   data-share-url="{{ shop.url | append: product.url }}"
	   data-input-fallback="share-input-{{ section_id }}"
	   aria-label="{{ 'general.social.share_button' | t }}"
	>
		<span class="tooltip js-share-tooltip">{{ 'general.social.share_success' | t }}</span>

		{% render 'icons-social', icon: "share" %}
	</a>

	{% if block.settings.show_facebook %}
		{% render 'share-button', social: "facebook", product: product %}
	{% endif %}

	{% if block.settings.show_twitter %}
		{% render 'share-button', social: "twitter", product: product %}
	{% endif %}

	{% if block.settings.show_pinterest %}
		{% render 'share-button', social: "pinterest", product: product %}
	{% endif %}

<style>
  .share-button {
    display: inline-flex;
    align-items: center;
    background-color: #fff;
    color: #000; /* default black icon/text */
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .share-button svg {
    width: 25px;
    height: 25px;
    margin-right: 8px;
    fill: currentColor; /* inherits from .share-button color */
    transition: fill 0.2s ease;
  }

  .share-button:hover {
    color: #16a34a; 

  }
</style>


<!-- Share on Outlook -->
<a class="share-button"
   href="mailto:?subject={{ product.title | url_escape }}&body={{ product.title | url_escape }}%0A{{ shop.url }}{{ product.url }}"
   target="_blank" rel="noopener">

  <!-- Outlook SVG Icon (Black) -->
  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
    <path d="M6 4h20v24H6z" fill="currentColor"/>
    <path d="M10 12h12v2H10zm0 4h12v2H10z" fill="#fff"/>
  </svg>
 Share via Outlook
</a>

<a class="share-button share-button-hubspot" 
   href="https://share.hsforms.com/1/abc123/index.html?product={{ product.title | url_encode }}&url={{ shop.url | append: product.url | url_encode }}"
   target="_blank" rel="noopener noreferrer"
   aria-label="Share this product on HubSpot">
  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M12.95 2.122a2.122 2.122 0 1 1-4.243 0 2.122 2.122 0 0 1 4.243 0ZM4.5 17a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5ZM17.5 20a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5ZM6.5 15V8.2a3.5 3.5 0 0 0 3.5 0V13h5V6.2a3.5 3.5 0 0 0 3.5 0V10h1v1h-1v5a3.5 3.5 0 0 0-3.5 0v-5h-5v6.8a3.5 3.5 0 0 0-3.5 0V15h-1Z" fill="currentColor"/>
  </svg>
  <span>Share via HubSpot</span>
</a>

</div>
<!--  -->
