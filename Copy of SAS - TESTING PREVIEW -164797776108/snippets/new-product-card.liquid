<script>
  $(document).ready(function () {
    // Unbind any existing handlers before binding to avoid duplicates
    $('.radio-button-label').off('click').on('click', function () {
      var $this = $(this);
      
      setTimeout(function () {
        var selectedValue = $this.parent().find(".radioinput:checked").val();
        var getvalueapi = localStorage.getItem('apistorage');
        const getvalue = localStorage.getItem('storedURL');
        const getvaluesymbion = localStorage.getItem('aciveitemsymbionstorage');
        const getvaluech2 = localStorage.getItem('aciveitemch2storage');

        var $button = $this.parent().parent().find('.product-add-to-cart__button');

        if (selectedValue.includes('API')) {
          if (!getvalueapi || getvalueapi.trim() === '') {
            $button.attr('disabled', 'disabled');
            $('html, body').animate({ scrollTop: 0 }, 'smooth');
            $('.wholeselerinfo').css('display', 'inline-block');
            $('.wholeselername').text(selectedValue);
          } else {
            $button.removeAttr('disabled');
              $('.wholeselerinfo').css('display', 'none');
          }
        } else if (selectedValue.includes('Sigma')) {
          if (!getvalue || getvalue.trim() === '') {
            $button.attr('disabled', 'disabled');
            $('html, body').animate({ scrollTop: 0 }, 'smooth');
            $('.wholeselerinfo').css('display', 'inline-block');
              $('.wholeselername').text(selectedValue);
          } else {
            $button.removeAttr('disabled');
                 $('.wholeselerinfo').css('display', 'none');
          }
        } else if (selectedValue.includes('Symbion')) {
          if (!getvaluesymbion || getvaluesymbion.trim() === '') {
            $button.attr('disabled', 'disabled');
            $('html, body').animate({ scrollTop: 0 }, 'smooth');
            $('.wholeselerinfo').css('display', 'inline-block');
              $('.wholeselername').text(selectedValue);
          } else {
            $button.removeAttr('disabled');
                 $('.wholeselerinfo').css('display', 'none');
          }
        } else if (selectedValue.includes('CH2')) {
          if (!getvaluech2 || getvaluech2.trim() === '') {
            $button.attr('disabled', 'disabled');
            $('html, body').animate({ scrollTop: 0 }, 'smooth');
            $('.wholeselerinfo').css('display', 'inline-block');
              $('.wholeselername').text(selectedValue);
          } else {
            $button.removeAttr('disabled');
                 $('.wholeselerinfo').css('display', 'none');
          }
        }
      }, 300); // Delay in milliseconds
    });
 });
</script>

<script>
  $(document).ready(function () {
    $('.product-card__image-wrapper-link').on('click', function (e) {
      var $this = $(this);

      // اگر href پہلے ہی اپڈیٹ ہو چکا ہے، تو allow default behavior
      if ($this.attr('data-link-updated') === 'true') {
        return; // کچھ نہ روکو، نارمل لنک کی طرح کام کرے
      }

      e.preventDefault(); // پہلی بار کلک پر روکے

      var myparent = $this.closest('.product-card');
      var myurl = $(myparent).find(".product-card__title").attr("href");

      // href کو فوری طور پر اپڈیٹ کرو
      $this.attr("href", myurl);

      // مارک کرو کہ یہ اپڈیٹ ہو چکا ہے
      $this.attr('data-link-updated', 'true');

      // اب اگلی بار کلک پر ری لوڈ ہوگا
    });
  });
</script>

