{%- comment -%}
  ------------------------------------------------------------------------------
  Snippet: Header mobile menu list
  Render header mobile menu  list
  - menu: menu object;
  - blocks: transfer block object;
  - menu_id: menu id;
  - type: type (burger-menu).
  - menu_highlighted_link_name: menu highlighted link name.

  Usage:
  {%- render 'header-mobile-menu-list' -%}
  ------------------------------------------------------------------------------
{%- endcomment -%}
<style>
    .wholeseller-wraper {
      width: 100%;
    }

        .customlable {
          border-color: #b0d0bb;
          background-color: #b0d0bb;
          color: #000;
          padding: 2px 30px;
          border-radius: 20px;
          margin: 2px 0px;
        }
            .header-mobile__menu-list .main-wraper {
               display: block!important;
             }
               .mainwraper {
               position: relative;
             }
             .header-mobile__menu .custom-inner-wholesaler  {
               position: absolute;
               margin-left: 0px!important;
               margin-top: 0px!important;
               border-radius: 10px!important;
               overflow: hidden!important;
               border: 1px solid #ddd;
               top: 65px!important;
             }
               .active-filters {
               margin-top: 12px;display: flex;
             }
               .custom__label{
               padding: 6px;background-color: #5a9d62;margin: 5px;
               font-size: 13px;
               border-radius: 9px; display: none;
             }
               .active-filters input[type="radio"]:checked + label {
                   background-color: lightblue;
                 display: block;
                 }
               .custom__account {
               padding: 0px 13px;
               min-height: 44px;
               margin-top: 10px;
             }
  @media only screen and (max-width: 767px){
      .custom-active {
        border-color: #599d61!important;
        background-color: #599d61!important;
        color: #fff!important;
      }
  }
</style>
<ul class="header-mobile__menu-list">
  {%- for first_level_link in menu.links -%}
    {%- assign has_megamenu = false -%}
    {%- assign megamenu_object = '' -%}
    {%- assign item_class_highlighted = '' -%}

    {%- if first_level_link.title == menu_highlighted_link_name -%}
      {%- assign item_class_highlighted = 'header-mobile__menu-item--highlighted' -%}
    {%- endif -%}

    {%- for block in blocks -%}
      {%- if type == 'burger-menu' -%}
        {%- if block.type == 'megamenu-brands' -%}
          {%- assign menu_handle = block.settings.burger_menu_handle | handleize -%}

          {%- if first_level_link.handle == menu_handle -%}
            {%- if first_level_link.links != blank -%}
              {%- assign has_megamenu = true -%}
              {%- assign megamenu_object = block -%}

              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {%- if block.type != 'megamenu-brands-logo' -%}
          {%- assign menu_handle = block.settings.menu_handle | handleize -%}

          {%- if first_level_link.handle == menu_handle -%}
            {% if block.type == 'megamenu' or block.type == 'megamenu-row-menus' %}
              {%- if first_level_link.links != blank -%}
                {%- assign has_megamenu = true -%}
                {%- assign megamenu_object = block -%}

                {%- break -%}
              {%- endif -%}
            {%- else -%}
              {%- assign has_megamenu = true -%}
              {%- assign megamenu_object = block -%}

              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <li>
      {%- if first_level_link.links != blank or has_megamenu == true -%}
        <button
          class="header-mobile__menu-item js-mobile-header-menu-toggler {{ item_class_highlighted -}}"
          type="button"
          data-target="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.title | handleize -}}"
          aria-controls="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.title | handleize -}}"
          aria-expanded="false"
        >
          {% assign item_icon = first_level_link.object.metafields.custom.menu_icon %}

          {%- if item_icon != blank -%}
            <span class="header-mobile__menu-item-icon-wrapper">
              <picture>
                <img
                  class="header-mobile__menu-item-icon"
                  src="{{ item_icon | image_url: width: 32, height: 32 }}"
                  srcset="{{ item_icon | image_url: width: 32, height: 32 }} 1x, {{ item_icon | image_url: width: 64, height: 64 }} 2x"
                  alt="{{- item_icon.alt -}}"
                >
              </picture>
            </span>
          {%- endif -%}

          <span class="header-mobile__menu-item-text">
            {{- first_level_link.title | escape -}}
          </span>

          {% assign badge_text = megamenu_object.settings.badge_text %}
          {% assign badge_text_color = megamenu_object.settings.badge_text_color %}
          {% assign badge_background_color = megamenu_object.settings.badge_background_color %}

          {%- if badge_text != blank -%}
            <span
              class="header-mobile__menu-item-badge"
              style="--header-background: {{ header_bg -}}; --badge-text-color: {{ badge_text_color }}; --badge-background-color: {{ badge_background_color }};"
            >
              {{- badge_text -}}
            </span>
          {%- endif -%}

          <span class="header-mobile__menu-item-toggle-icon">
            {%- render 'icons', icon: 'arrow-down' -%}
          </span>
        </button>

        <div
          id="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.title | handleize -}}"
          data-menu-type="nested"
          class="header-mobile__menu-list-wrapper header-mobile__menu-list-wrapper--nested js-mobile-header-menu is-hidden"
        >
          <ul class="header-mobile__menu-list header-mobile__menu-list--nested">
            <li>
              <button
                class="header-mobile__menu-item header-mobile__menu-item--back js-mobile-header-menu-toggler"
                type="button"
                data-target="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.title | handleize -}}"
                aria-controls="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.title | handleize -}}"
                aria-expanded="false"
              >
                <span class="header-mobile__menu-item-icon-back">
                  {%- render 'icons', icon: 'slider-arrow-left' -%}
                </span>

                <span class="header-mobile__menu-item-text">
                  {{- first_level_link.title -}}
                </span>
              </button>
            </li>

            {%- capture megamenu -%}
							{%- if megamenu_object.type == 'megamenu' and has_megamenu == true -%}
								{%- render 'header-mobile-mega-menu', menu: first_level_link, megamenu_object: megamenu_object -%}
							{%- endif -%}

							{%- if megamenu_object.type == 'megamenu-images' and has_megamenu == true -%}
								{%- render 'header-mobile-mega-menu-images', megamenu_object: megamenu_object -%}
							{%- endif -%}

							{%- if megamenu_object.type == 'megamenu-row-menus' and has_megamenu == true -%}
								{%- render 'header-mobile-mega-menu-row-menus', menu: first_level_link, megamenu_object: megamenu_object -%}
							{%- endif -%}

							{%- if megamenu_object.type == 'megamenu-brands' and has_megamenu == true -%}
								{%- assign brands_logos_blocks = section.blocks | where: 'type', 'megamenu-brands-logo' -%}

								{%- render 'header-mobile-mega-menu-brands', menu: first_level_link, megamenu_object: megamenu_object, blocks: brands_logos_blocks -%}
							{%- endif -%}

							{%- if megamenu_object.type == 'megamenu-half-to-half' and has_megamenu == true -%}
								{%- if megamenu_object.settings.heading == blank and megamenu_object.settings.subheading == blank and megamenu_object.settings.image == blank -%}
									{%- assign has_megamenu = false -%}
								{%- else -%}
									{%- render 'header-mobile-mega-menu-half-to-half', megamenu_object: megamenu_object -%}
								{%- endif -%}
							{%- endif -%}
						{%- endcapture -%}

            {%- if megamenu != blank and has_megamenu == true and megamenu_object.type != 'megamenu' -%}
              <li>
                {{- megamenu -}}
              </li>
            {%- else -%}
              {%- for second_level_link in first_level_link.links -%}
                <li>
                  {%- if second_level_link.links != blank -%}
                    <button
                      class="header-mobile__menu-item js-mobile-header-menu-toggler"
                      type="button"
                      data-target="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.handle -}}-{{- second_level_link.handle -}}"
                      aria-controls="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.handle -}}-{{- second_level_link.handle -}}"
                      aria-expanded="false"
                    >
                      {% assign item_icon = second_level_link.object.metafields.custom.menu_icon %}

                      {%- if item_icon != blank -%}
                        <span class="header-mobile__menu-item-icon-wrapper">
                          <picture>
                            <img
                              class="header-mobile__menu-item-icon"
                              src="{{ item_icon | image_url: width: 32, height: 32 }}"
                              srcset="{{ item_icon | image_url: width: 32, height: 32 }} 1x, {{ item_icon | image_url: width: 64, height: 64 }} 2x"
                              alt="{{- item_icon.alt -}}"
                            >
                          </picture>
                        </span>
                      {%- endif -%}

                      <span class="header-mobile__menu-item-text">
                        {{ second_level_link.title | escape }}
                      </span>

                      <span class="header-mobile__menu-item-toggle-icon">
                        {%- render 'icons', icon: 'arrow-down' -%}
                      </span>
                    </button>

                    <div
                      id="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.handle -}}-{{- second_level_link.handle -}}"
                      data-menu-type="deep-nested"
                      class="header-mobile__menu-list-wrapper header-mobile__menu-list-wrapper--deep-nested js-mobile-header-menu is-hidden"
                    >
                      <ul class="header-mobile__menu-list header-mobile__menu-list--nested">
                        <li>
                          <button
                            class="header-mobile__menu-item header-mobile__menu-item--back js-mobile-header-menu-toggler"
                            type="button"
                            data-target="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.handle -}}-{{- second_level_link.handle -}}"
                            aria-controls="headerMobileMenu:{{- menu_id -}}-{{- menu.handle -}}-{{ forloop.index }}-{{- first_level_link.handle -}}-{{- second_level_link.handle -}}"
                            aria-expanded="false"
                          >
                            <span class="header-mobile__menu-item-icon-back">
                              {%- render 'icons', icon: 'slider-arrow-left' -%}
                            </span>

                            <span class="header-mobile__menu-item-text">
                              {{- second_level_link.title -}}
                            </span>
                          </button>
                        </li>

                        {%- for third_level_link in second_level_link.links -%}
                          <li>
                            <a
                              class="header-mobile__menu-item header-mobile__menu-item-link"
                              href="{{- third_level_link.url -}}"
                            >
                              {% assign item_icon = third_level_link.object.metafields.custom.menu_icon %}

                              {%- if item_icon != blank -%}
                                <span class="header-mobile__menu-item-icon-wrapper">
                                  <picture>
                                    <img
                                      class="header-mobile__menu-item-icon"
                                      src="{{ item_icon | image_url: width: 32, height: 32 }}"
                                      srcset="{{ item_icon | image_url: width: 32, height: 32 }} 1x, {{ item_icon | image_url: width: 64, height: 64 }} 2x"
                                      alt="{{- item_icon.alt -}}"
                                    >
                                  </picture>
                                </span>
                              {%- endif -%}

                              <span class="header-mobile__menu-item-text">
                                {{- third_level_link.title -}}
                              </span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- else -%}
                    <a
                      class="header-mobile__menu-item header-mobile__menu-item-link"
                      href="{{- second_level_link.url -}}"
                    >
                      {% assign item_icon = second_level_link.object.metafields.custom.menu_icon %}

                      {%- if item_icon != blank -%}
                        <span class="header-mobile__menu-item-icon-wrapper">
                          <picture>
                            <img
                              class="header-mobile__menu-item-icon"
                              src="{{ item_icon | image_url: width: 32, height: 32 }}"
                              srcset="{{ item_icon | image_url: width: 32, height: 32 }} 1x, {{ item_icon | image_url: width: 64, height: 64 }} 2x"
                              alt="{{- item_icon.alt -}}"
                            >
                          </picture>
                        </span>
                      {%- endif -%}

                      <span class="header-mobile__menu-item-text">
                        {{- second_level_link.title -}}
                      </span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {%- if megamenu != blank and has_megamenu == true and megamenu_object.type == 'megamenu' -%}
                <li>
                  {{- megamenu -}}
                </li>
              {%- endif -%}
            {%- endif -%}
          </ul>
        </div>
      {%- else -%}
        <a
          class="header-mobile__menu-item header-mobile__menu-item-link {{ item_class_highlighted -}}"
          href="{{- first_level_link.url -}}"
        >
          {% assign item_icon = first_level_link.object.metafields.custom.menu_icon %}

          {%- if item_icon != blank -%}
            <span class="header-mobile__menu-item-icon-wrapper">
              <picture>
                <img
                  class="header-mobile__menu-item-icon"
                  src="{{ item_icon | image_url: width: 32, height: 32 }}"
                  srcset="{{ item_icon | image_url: width: 32, height: 32 }} 1x, {{ item_icon | image_url: width: 64, height: 64 }} 2x"
                  alt="{{- item_icon.alt -}}"
                >
              </picture>
            </span>
          {%- endif -%}

          <span class="header-mobile__menu-item-text">
            {{- first_level_link.title | escape -}}
          </span>
        </a>
      {%- endif -%}
    </li>
  {%- endfor -%}

  <div class="mainwraper">
    {% if customer %}
      <div class="main-wraper">
        <!-- Wholeseller SELECT instead of radios -->
        {% if customer %}
          {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}

          {% assign has_api = false %}
          {% assign has_sigma = false %}
          {% assign has_symbion = false %}
          {% assign has_ch2 = false %}

          {% for item in coverage_countries %}
            {% assign selleritem = item | downcase %}
            {% if selleritem contains 'api' %}
              {% assign has_api = true %}
            {% endif %}
            {% if selleritem contains 'sigma' %}
              {% assign has_sigma = true %}
            {% endif %}
            {% if selleritem contains 'symbion' %}
              {% assign has_symbion = true %}
            {% endif %}
            {% if selleritem contains 'ch2' %}
              {% assign has_ch2 = true %}
            {% endif %}
          {% endfor %}

          <select id="wholeseller-select" class="wholeseller-wraper">
            {% if has_api %}
              <option
                value="api"
                {% if firstwholeseller %}
                  selected
                {% endif %}
              >
                API
              </option>
            {% endif %}
            {% if has_symbion %}
              <option
                value="symbion"
                {% if firstwholeseller3 %}
                  selected
                {% endif %}
              >
                Symbion
              </option>
            {% endif %}
            {% if has_sigma %}
              <option
                value="sigma"
                {% if firstwholeseller2 %}
                  selected
                {% endif %}
              >
                Sigma
              </option>
            {% endif %}
            {% if has_ch2 %}
              <option
                value="ch2"
                {% if firstwholeseller4 %}
                  selected
                {% endif %}
              >
                CH2
              </option>
            {% endif %}
          </select>
        {% endif %}

        <div class="wholeseller mobileseller">
          {% if customer %}
            {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
            <ul class="header-mega-menu__menu">
              {% for item in coverage_countries %}
                {% assign selleritem = item | downcase | replace: ' ', '' %}
                <li class="wholwseller-item" data-value="{{ selleritem }}">
                  <input
                    type="radio"
                    id="country-{{ forloop.index }}-{{ selleritem | handle }}"
                    name="{%if selleritem contains 'api' %} api{%endif%}{%if selleritem contains 'sigma'%}sigma {% endif %}{%if selleritem contains 'symbion'%}symbion{% endif %}{%if  selleritem contains 'ch2'%}ch2{% endif %}"
                    value="{{ selleritem }}"
                    class="wholwseller-input {%if selleritem contains 'api' %} customapi{%endif%}{%if selleritem contains 'sigma'%}customsigma {% endif %}{%if selleritem contains 'symbion'%}customsymbion{% endif %}{%if  selleritem contains 'ch2'%}customch2{% endif %}"

                    class="
                      wholwseller-input  {{ selleritem }}
                      {% if selleritem contains 'api' %} customapi{% endif %}
                      {% if selleritem contains 'sigma'%} customsigma{% endif %}
                      {% if selleritem contains 'symbion'%} customsymbion{% endif %}
                      {% if selleritem contains 'ch2'%} customch2{% endif %}
                    "
                    itemnumber="
                      {% assign cleaned_item = selleritem
                        | remove: 'api'
                                  | remove: 'sigma'
                                  | remove: 'symbion'
                                  | remove: 'ch2'
                                  | remove: 'API'
                                  | remove: 'Sima'
                                  | remove: 'Symbion'
                                  | remove: 'CH2'
                      %}
                      {{ cleaned_item }}
                    "
                  >
                  <label
                    for="country-{{ forloop.index }}-{{ selleritem | handle }}"
                    class="customlable {{ selleritem }}"
                  >
                    {% assign cleaned_item = selleritem
                      | remove: 'api'
                      | remove: 'sigma'
                      | remove: 'symbion'
                      | remove: 'ch2'
                    %}
                    {{ cleaned_item }}
                  </label>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>

      <style>
        .wholwseller-item { display: none; } /* hide all by default */
        .wholwseller-item.active { display: list-item; }
      </style>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const select = document.getElementById('wholeseller-select');
          const items = document.querySelectorAll('.wholwseller-item');
          const radios = document.querySelectorAll('.wholwseller-input');

          // Restore wholeseller selection
          const savedWholeseller = localStorage.getItem('selected_wholeseller');
          if (savedWholeseller) {
            select.value = savedWholeseller;
          }

          // Restore country selection (only if still valid for current coverage)
          const savedCountry = localStorage.getItem('selected_country');
          if (savedCountry && (typeof isWholesalerCovered !== 'function' || isWholesalerCovered(savedCountry))) {
            const savedInput = document.querySelector(`.wholwseller-input[value="${savedCountry}"]`);
            if (savedInput) savedInput.checked = true;
          } else if (savedCountry) {
            localStorage.removeItem('selected_country');
          }

          function updateVisible() {
            let selected = select.value;
            if (selected) {
              // Save wholeseller in localStorage
              localStorage.setItem('selected_wholeseller', selected);
            }

            items.forEach((item) => {
              if (selected && item.dataset.value.includes(selected)) {
                item.classList.add('active');
              } else {
                item.classList.remove('active');
              }
            });
          }

          // Save country selection
          radios.forEach((radio) => {
            radio.addEventListener('change', function () {
              if (this.checked) {
                localStorage.setItem('selected_country', this.value);
                if (typeof applyWholesalerNumberOverride === 'function') applyWholesalerNumberOverride();
              }
            });
          });

          // Event listener for dropdown
          select.addEventListener('change', updateVisible);

          updateVisible(); // Run on page load
        });
      </script>

      <div
        class="custom-inner-wholesaler"
        style="position: absolute; margin-left: 190px; margin-top: -10px; border-radius: 10px; overflow: hidden; border: 1px solid #ddd;"
      >
        {% if customer %}
          {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
          {% for item in coverage_countries %}
            <div
              class="
                main-country-{{ forloop.index }} myccc
                          {% assign clean_handle = item | handleize | replace: '-', ' ' %}
                {% assign clean_handle_no_numbers = clean_handle | remove: '0' | remove: '1' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' %}
                          cc{{ clean_handle_no_numbers }}
              "
            >
              <span
                class="mygrand-child {{ item | handleize | replace: '-', ''}}"
                active-item="{{ item | handleize | replace: '-', ''}}"
              >
                {{- item -}}
              </span>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</ul>
{% if customer and customer.orders_count > 0 %}
  {% assign last_order = customer.orders.first %}
  {% if last_order.line_items.size > 0 %}
    {% assign last_line_item = last_order.line_items.last %}
    {% assign wholesaler_number = '' %}

    {% for property in last_line_item.properties %}
      {% if property.first == 'Wholesaler Account No.1' %}
        {% assign wholesaler_number = property.last | strip %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Run only on mobile screens
    if (window.innerWidth > 1199) return;

    // Get wholesaler number from Liquid
    var wholesalerNumber = "{{ wholesaler_number | downcase | replace: ' ', '' }}";

    // Select all visible wholeseller items
    var items = Array.from(document.querySelectorAll('.wholwseller-item')).filter((item) => item.offsetParent !== null);

    if (items.length === 0) return;

    // Remove custom-active from all labels first
    items.forEach(function (item) {
      var label = item.querySelector('label');
      if (label) label.classList.remove('custom-active');
    });

    // Flag to check if a matching input was found
    var matched = false;

    // Loop through visible items to find matching input
    items.forEach(function (item) {
      var input = item.querySelector('.wholwseller-input');
      var label = item.querySelector('label');
      if (!input || !label) return;

      var value = input.value.toLowerCase().replace(/\s+/g, '');
      if (value.includes(wholesalerNumber)) {
        input.checked = true;
        label.classList.add('custom-active');
        matched = true;
      }
    });

    // If no match, add custom-active to the first visible label
    if (!matched) {
      var firstLabel = items[0].querySelector('label');
      if (firstLabel) firstLabel.classList.add('custom-active');
    }
  });
</script>
