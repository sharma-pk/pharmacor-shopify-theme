<div class="collections-list-wrapper">
  <div class="collectiion_header">
    {% if section.settings.heading != blank %}
      <div class="title">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% else %}
      <div class="title">
        <h2>{{ collection.title }}</h2>
      </div>
    {% endif %}

    <div class="sort_with_icons">
      {%- render 'product-filters-and-sort-bar',
        product_list: collection,
        without_filter_button: true
      -%}
    </div>
  </div>

  <div class="list_of_collections">
    <div class="grid_data">
    {% for block in section.blocks %}
      {% assign current_collection = collections[block.settings.collection] %}
      {% if current_collection %}
       <div
          class="collection__items js-grid-wrapper custom-collection-page-tabcontent"
          aria-busy="true"
          data-grid-col="3"
          id="dynamic"
        >
          {% for product in current_collection.products limit: 3 %}
            <div class="collection__item">
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
    </div>
    {% comment %}  {% endcomment %}
<div id="custom" class="custom-collection-page-tabcontent">
  <div class="custom-cart-list-main">

    {% for block in section.blocks %}
      {% assign block_collection = collections[block.settings.collection] %}
      {% if block_collection %}
        <div id="custom{{ block.id }}" class="my-collection-list-tabcontent" {% if forloop.index == 3 %}style="display: block"{% endif %}>
          
          <!-- 1️⃣ Collection Name -->
          <h2>
            {% if block.settings.custom_name != blank %}
              {{ block.settings.custom_name }}
            {% else %}
              {{ block_collection.title }}
            {% endif %}
          </h2>
          <div class="custom-product-card-list" style="width: 100%;">
            <div class="custom_labels">
              <div class="custom-list-image">Image</div>
              <div class="custom-list-product-name">Product Name</div>
              <div class="custom-list-wholesaler">
                <div style="width: 50%;">Wholesaler</div>
                <div style="width: 50%;">Strength/Pack Size</div>
              </div>
              <div class="custom-list-price">Price</div>
              <div class="custom-list-product-info">Product Info</div>
            </div>

            <div class="custom-product-card-list-wrap">
              {%- for product in block_collection.products -%}
                {% render 'list-item',
                  product: product,
                  section: section
                %}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

  </div>
</div>

     {% comment %}  {% endcomment %}
      
  <div class="text-center">
    <a href="{{ section.settings.btn_link }}" class="btn">{{ section.settings.btn_text }}</a>
  </div>
  </div>

</div>
<script>
  $('.custom-collection-page-tabcontent').hide();
 $('.list-view-btn').click(function () {
  // Activate only the clicked list view button
  $('.list-view-btn').removeClass('active');
  $('.grid-view-btn').removeClass('active');
  $(this).addClass('active');

  // Toggle views
  $('.grid_data').hide();
  $('.custom-collection-page-tabcontent').show();
});

$('.grid-view-btn').click(function () {
  // Activate only the clicked grid view button
  $('.grid-view-btn').removeClass('active');
  $('.list-view-btn').removeClass('active');
  $(this).addClass('active');

  // Toggle views
  $('.grid_data').show();
  $('.collection__items').show(); // optional: if you use this elsewhere
  $('.custom-collection-page-tabcontent').hide();
});

  </script>