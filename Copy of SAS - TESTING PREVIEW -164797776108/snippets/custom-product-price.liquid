{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: Price
	This snippet output price of the product
	- product: Product object (required, object)
	- price_class: Custom class(es) (optional, string)
	- use_variant: If true, then it will be used - product.selected_or_first_available_variant (optional, boolean)
	- currency_code_enabled: If true, then it will be displayed iso code of the currency (optional, boolean)
	- show_unit_price: If true, then it will be displayed unit price(optional, boolean)
	- hide_from_price: If true, then hide from_price_html
	- show_taxes_included: If true, then it will be displayed message of taxes(optional, boolean)
	- show_pay_installments: If true, then it will be displayed form method pay installments
	- show_discount_percentage: If true, show percentage discount when compare price appear (optional, boolean)

	{%- render 'price', product: product, show_unit_price: show_unit_price, currency_code_enabled: currency_code_enabled -%}
	------------------------------------------------------------------------------
{%- endcomment -%}
<style>
  .price-item.price-item--regular{position: relative;}
  .price-item.price-item--regular::after{content: '';position: absolute;top: 50%; left: 0; width: 100%; height: 2px; background: var(--color-heading);}
  .custom-product-last-price{border-right: 2px solid #a6a6a6;padding-right: 16px;}
  .custom-price-container{display: flex;align-items: center;}
  .custom-sale-price{padding: 0px 16px; flex-wrap: wrap;}
  .custom-discount-price span{color: #89CFF0;}
  .my-custom-list-price{font-size: 14px; position: relative; top: -5px;}
  .custom-your-price{font-size: 14px;}
    @media only screen and (max-width: 767px){
      .custom-sale-price {padding: 0px 8px;}
      .custom-your-price{font-size: 12px;}
      .price-item.price-item--sale{font-size: 14px;}
      .price .price-item.price-item--regular {font-size: 14px;}
      .custom-discount-price span {font-size: 14px;}
      .my-custom-list-price{top: 0px; font-size: 12px;}
      .product-add-to-cart .product-add-to-cart__button {padding-left: 4px; padding-right: 4px; padding-top: 16px; padding-bottom: 16px;}
      .product-quantity .product-quantity__button {width: 32px;height: 32px;}
      .product-quantity .product-quantity__input {margin: 0 2px;}
    }
</style>
{%- if use_variant -%}
	{%- assign target 			= product.selected_or_first_available_variant -%}
	{%- assign compare_at_price	= target.compare_at_price -%}
{%- else -%}
	{%- assign target 			= product -%}
	{%- assign compare_at_price	= target.compare_at_price_max -%}
{%- endif -%}

{%- assign price					= target.price | default: 1999 -%}
{%- assign available				= target.available | default: false -%}
{%- assign money_price				= price | money -%}
{%- assign money_price_min			= product.price_min | money -%}
{%- assign money_price_max			= product.price_max | money -%}
{%- assign unit_price				= product.selected_or_first_available_variant.unit_price -%}
{%- assign unit_price_measurement	= product.selected_or_first_available_variant.unit_price_measurement -%}
{%- assign reference_value			= product.selected_or_first_available_variant.unit_price_measurement.reference_value -%}
{%- assign reference_unit			= product.selected_or_first_available_variant.unit_price_measurement.reference_unit -%}

{% if show_discount_percentage == nil %}
	{% assign show_discount_percentage = true %}
{% endif %}

{%- if currency_code_enabled -%}
	{%- assign money_price 			= price | money_with_currency -%}
	{%- assign money_price_min		= product.price_min | money_with_currency -%}
	{%- assign money_price_max		= product.price_max | money_with_currency -%}
{%- endif -%}

{%- if target == product and product.price_varies and hide_from_price != true -%}
	{%- assign money_price = 'products.product.price.from_price_html' | t: price: money_price -%}
{%- endif -%}

{%- if block -%}
	{%- capture styles -%}
		--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
		--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
		--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
		--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
	{%- endcapture -%}
{%- endif -%}

<div
	class="price{% if price_class %} {{ price_class }}{% endif %}{% if compare_at_price > price %} price--on-sale{% endif %} js-price custom-product-price"
	{% if styles %}
		style="{{ styles }}"
	{% endif %}
	{% if currency_code_enabled %}
		data-currency-code-enabled
	{% endif %}
>
	<div class="price__container custom-price-container">
      <div class="custom-product-last-price data-wpd-hide">
  
				<span class="visually-hidden">
					{{- 'products.product.price.regular_price' | t -}}
				</span>
                <span class="my-custom-list-price" style="">List Price</span>
				<span class="price__old" style="position: relative; top: -8px;">
					<span class="price-item price-item--regular" data-price-old>
						{%- if currency_code_enabled -%}
							{{- compare_at_price | money_with_currency -}}
						{%- else -%}
							{{- compare_at_price | money -}}
						{%- endif -%}
					</span>
				</span>
		
      </div>
		<div class="custom-sale-price data-wpd-hide">
          {% comment %}
			<span class="visually-hidden">
				{{- 'products.product.price.sale_price' | t -}}
			</span>
   {% endcomment %}
            <div class="custom-your-price">Your Price</div>
			<div class="price-item price-item--sale" style="color: #000; padding-top: 1px;" data-product-price data-amount="{{ price }}">
				{{- money_price -}}
			</div>

			

			
		</div>
<div class="custom-discount-price" style="order: 3; background: #2d9f54 !important; font-size: 12px; padding: 2px 6px;margin-left: 10px;margin-top: 10px; border-radius: 10px;">
  {% if show_discount_percentage %}
				{% assign discount_value = price | times: 100 | divided_by: compare_at_price %}
				<span type="hidden" style="color: #fff !important;" class="" data-product-price-discount></span>
			{% endif %}
</div>
      <span class="data-wpd-hide" style="padding-right: 8px;">=</span>
      <div class="custom-discount-price myprrice22" style="text-align: center;">
        <div style="font-size: 12px; opacity: 0;">Profit Per Dispensed</div>
  {% if compare_at_price > price %}
    {% assign discount_amount = compare_at_price | minus: price %}
    <span class="" data-product-price-discount
      data-wpd-product-handle="{{ product.handle }}"         
data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"         
data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"        
data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"        
data-wpd-product-id="{{ product.id }}">
     {{ discount_amount | money }}
    </span>
    
  {% endif %}
</div>

		<div class="price__regular">
			{% if product.quantity_price_breaks_configured? %}
				{%- if product.compare_at_price -%}
					{%- unless product.price_varies == false and product.compare_at_price_varies %}
						<span class="visually-hidden">
							{{- 'products.product.price.regular_price' | t -}}
						</span>

						<span>
							<s class="price-item price-item--regular">
								{% if settings.currency_code_enabled %}
									{{ compare_at_price | money_with_currency }}
								{% else %}
									{{ compare_at_price | money }}
								{% endif %}
							</s>
						</span>
					{%- endunless -%}
				{%- endif -%}
				<span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
				<span class="price-item price-item--regular volume-test">
					{{- 'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max -}}
				</span>
			{% else %}
				<span class="visually-hidden">
					{{- 'products.product.price.regular_price' | t -}}
				</span>

				<span class="price-item price-item--regular" data-product-price data-wpd-product-handle="{{ product.handle }}"         
data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"         
data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"        
data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"        
data-wpd-product-id="{{ product.id }}"
>
					{{- money_price -}}
				</span>
			{% endif %}
		</div>

		{%- if show_unit_price != false and simplified_view == nil -%}
			<div
				class="unit-price{% if unit_price == blank %} is-hidden{% endif %}"
				data-js-unit-price="container"
			>
				<span class="visually-hidden">
					{{- 'products.product.price.unit_price' | t -}}
				</span>

				<span class="price-item price-item--last">
					<span data-js-unit-price="money">
						{{- unit_price | money -}}
					</span>

					<span aria-hidden="true">/</span>

					<span class="visually-hidden">&nbsp;
						{{- 'general.accessibility.unit_price_separator' | t -}}&nbsp;
					</span>

					<span data-js-unit-price="reference">
						{%- if reference_value != 1 -%}
							{{- reference_value }}
						{%- endif -%}

						{{- reference_unit -}}
					</span>
				</span>
			</div>
		{%- endif -%}
	</div>

	{% if show_volume_pricing_info and product.quantity_price_breaks_configured? %}
		<div class="price__volume-pricing-note">
			<span>{{ 'products.product.volume_pricing.note' | t }}</span>
		</div>
	{% endif %}

	{% if cart.taxes_included and show_taxes_included %}
		<div class="price__taxes-included">
			{{- 'products.product.price.taxes_included' | t -}}
			{% if shop.shipping_policy.body != blank %}
				{{- 'products.product.price.shipping_policy_html' | t: link: shop.shipping_policy.url -}}
			{% endif %}
		</div>
	{% endif %}

	{% if show_pay_installments and product != blank %}
		{% assign product_form_installment_id = 'product-form-installment' | append: section.id %}

		{% form
			'product',
			product,
			id: product_form_installment_id,
			class: 'price__installments'
		%}
			<input
				type="hidden"
				name="id"
				value="{{- product.selected_or_first_available_variant.id -}}"
			/>

			{{- form | payment_terms -}}
          
		{% endform %}
	{% endif %}   <div id='wcp_vd_table'></div>
</div>
<ul>
  {% for location in shop.locations %}
    <li>
      {{ location.name }}: {{ location.inventory_level }}
    </li>
  {% endfor %}
</ul>


<style type="text/css">
#wcp_vd_table table {
	font-family: verdana,arial,sans-serif;
	font-size:11px;
	color:#333333;
	border-width: 1px;
	border-color: #666666;
	border-collapse: collapse;
}
#wcp_vd_table table th {
	border-width: 1px;
	padding: 8px;
	border-style: solid;
	border-color: #666666;
	background-color: #DEDEDE;
}
#wcp_vd_table table td {
	border-width: 1px;
	padding: 8px;
	border-style: solid;
	border-color: #666666;
	background-color: #FFFFFF;
}
</style>