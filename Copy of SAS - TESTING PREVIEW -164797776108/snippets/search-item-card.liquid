{%- comment -%}
  ------------------------------------------------------------------------------
  Snippet: Product card
  - product: Product object (required, object)
  - size: desktop image size (optional, default: 300, number)
  - tablet_size: tablet image size (optional, default: size, number)
  - mobile_size: mobile image size (optional, default: tablet_size, number)
  - is_lazy: is lazy load enable (optional, default: true, boolean)
  - big_card: (optional, default: false, boolean)

  {%- render 'product-card', product: product, size: 705, tablet_size: 387, mobile_size: 165, is_lazy: false -%}
  ------------------------------------------------------------------------------
{%- endcomment -%}
<style>
.product-card .js-product-add-to-cart-button-text {
  line-height: 0;
  padding: 10px 0px;
}
    .emptybutton::before {
    background: #98b59b!important;
  }
    #variant-id {
    cursor: pointer;
  }
    #add-to-cart {
    cursor: pointer;
  }
  @media (max-width: 1300px) and (min-width: 991px) {
  .product-card .product-add-to-cart__button {
    padding: 5px;font-size: 12px;
  }
    #add-to-cart .icon{width: 16px;
    margin-right: 6px;}
    }

      .quantity-selector {
              display: inline-flex;
              align-items: center;
              margin-bottom: 10px;
          }

  .product__button {
    width: 100%;
  }

          /* Input field styles */
          .quantity-selector input {
              width: 66px;
              text-align: center;
              border: 1px solid #bdbdbd;
              height: 38px;
              margin: 0 4px;
              appearance: none; /* Remove spinner buttons */
              -moz-appearance: textfield; /* Remove spinner buttons for Firefox */
              min-height: 12px;font-weight: normal;
    font-size: 12px;
  padding :  0 px ;
          }

  .product__custombtn  {
    display :  flex ;

    justify-content :  space-between ;

    align-items :  center ;

    padding-top :  15 px ;

  }
  .quantity__product  {
    width :  200 px ;
    position :  relative ;
    top :  4 px ;
  }
   .custom-variant legend  {
    font-size :  12 px ;
    padding :  10 px  0 px ;
  }
    .custom-variant-wrap  {
    padding-top :  20 px ;
  }
  /* Style the fieldset wrapper */
  .customwrapper  {
    border: none;
    padding: 10px;
  }

  /* Base button style for radio inputs */
  .radio-button-label {
    display: inline-block;
    margin: 5px;
    position: relative;
    cursor: pointer;
  }

  .radio-button-label input[type="radio"] {
    display: none; /* Hide the default radio button */
  }

  .radio-button-label {
    display: inline-block;
    padding: 6px 9px;
    border: 2px solid #ccc;
      border-top-color: rgb(204, 204, 204);
      border-right-color: rgb(204, 204, 204);
      border-bottom-color: rgb(204, 204, 204);
      border-left-color: rgb(204, 204, 204);
    background-color: #fff;
    color: #333;
    text-align: center;
    border-radius: 5px;
    transition: all 0.3s ease;
    font-size: 14px;
  }

  /* Hover effect */
  .radio-button-label:hover{
    border-color: #666;
  }

  /* Checked state */
   input[type="radio"]:checked + .radio-button-label {
    background-color: #333;
    color: #fff;
    border-color: #333;
  }

    .product-card .product-add-to-cart__button{
    padding: 10px;
    margin-top: 14px;
    width: 50%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    top: 11px;
  }
  .product-card  .product-add-to-cart__button {
    padding: 10px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    top: 0;
  }
   .product-card  .js-product-add-to-cart-button-text {
    line-height: 0;
  }
    @media (min-width: 768px) {
    .collection .collection__item {
      height: 100%;
    }
  }
</style>
{%- render 'adastra' with '/src/styles/product-card.scss' -%}
{% assign apiselleritem = '' %}
{% assign sigmaselleritem = '' %}
{% assign symbionselleritem = '' %}
{% assign ch2selleritem = '' %}

{% assign defaulseller = false %}

{% if customer %}
  {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}

  {% for item in coverage_countries %}
    {% assign clean_item = item | downcase | replace: ' ', '' %}

    {% if clean_item contains 'api' %}
      {% assign apiselleritem = clean_item | remove: 'api' %}
      {% assign defaulseller = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% comment %} does this product have a Wholesaler option, and does any value survive coverage filtering? {% endcomment %}
  {% assign has_wholesaler_option = false %}
  {% assign wholesaler_has_visible_value = false %}
  {% for sic_option in product.options_with_values %}
    {% if sic_option.name contains 'Wholesaler' %}
      {% assign has_wholesaler_option = true %}
      {% for sic_value in sic_option.values %}
        {% assign sic_value_up = sic_value | upcase %}
        {% for sic_item in coverage_countries %}
          {% assign sic_item_up = sic_item | upcase %}
          {% if sic_item_up contains sic_value_up %}
            {% assign wholesaler_has_visible_value = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% assign hide_purchase_controls = false %}
  {% if has_wholesaler_option and wholesaler_has_visible_value == false %}
    {% assign hide_purchase_controls = true %}
  {% endif %}

  {% if defaulseller == false %}
    {% for item in coverage_countries %}
      {% assign clean_item = item | downcase | replace: ' ', '' %}

      {% if clean_item contains 'symbion' %}
        {% assign symbionselleritem = clean_item | remove: 'symbion'%}
        {% assign defaulseller = true %}
        {% break %}
      {% elsif clean_item contains 'sigma' %}
        {% assign sigmaselleritem = clean_item | remove: 'sigma' %}
        {% assign defaulseller = true %}
        {% break %}
      {% elsif clean_item contains 'ch2' %}
        {% assign ch2selleritem = clean_item | remove: 'ch2' %}
        {% assign defaulseller = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
{% for variant in product.variants %}
  {% assign variant_saving = '' %}
  {% if variant.compare_at_price > variant.price %}
    {% assign variant_saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round: 2 | append: '%' %}
  {% endif %}
  <input
    type="hidden"
    class="procustom{{ variant.id | handleize }} "
    varienrprice="{{ variant.price | money }}"
    varientquentity="{{ variant.inventory_quantity }}"
    myvarientid="{{ variant.id }}"
    variantprofit="{{ variant_saving }}"
    varienrcompprice="{{ variant.compare_at_price | money }}"
  >
{% endfor %}

{%- assign quick_view_image_fit = settings.quick_view_image_fit -%}
{%- assign aspect_ratio = settings.product_card_img_aspect_ratio -%}
{%- assign swatches_enabled = settings.is_color_swatches_enabled -%}
{%- assign swatch_option = settings.color_swatches_option | default: 'Color' | downcase -%}
{%- assign quick_view_image_fit = settings.quick_view_image_fit -%}
{%- assign labels_enabled = settings.is_labels_enabled -%}
{%- assign show_vendor = settings.is_show_vendor -%}
{%- assign sku = product.selected_or_first_available_variant.sku | strip -%}
{%- assign sku_text = settings.product_card_sku_text | replace: '{SKU}', sku | replace: '{sku}', sku -%}
{%- assign currency_code_enabled = settings.is_currency_code_enabled -%}
{%- assign show_unit_price = settings.is_show_unit_price -%}
{%- assign quick_view_enabled = settings.is_quick_view_enabled -%}
{%- assign image_on_hover_enabled = settings.is_image_on_hover_enabled -%}
{%- assign swatch_option = settings.color_swatches_option | default: 'Color' | downcase -%}
{%- assign swatches = product.options_by_name[swatch_option].values -%}
{%- assign extra_properties = product.metafields.custom.extra_properties -%}

{%- if show_vendor and product.vendor != blank -%}
  {%- assign show_vendor_block = true -%}
{%- endif -%}

{%- if sku != blank and sku_text != blank -%}
  {%- assign show_sku_block = true -%}
{%- endif -%}

{%- assign show_vendor_and_sku = false -%}

{%- if show_vendor_block or show_sku_block -%}
  {% assign show_vendor_and_sku = true -%}
{%- endif -%}

{% assign show_hover_content = false %}

{% if swatches != blank and swatches_enabled and simplified_view == null %}
  {% assign show_hover_content = true %}
{% endif %}

{% if extra_properties.value.size > 0 and simplified_view == null %}
  {% assign show_hover_content = true %}
{% endif %}

{%- if is_lazy == null -%}
  {%- assign is_lazy = true -%}
{%- endif -%}

{%- assign size = size | default: 300 -%}
{%- assign tablet_size = tablet_size | default: size -%}
{%- assign mobile_size = mobile_size | default: tablet_size -%}
{%- assign big_card = big_card | default: false -%}

{%- assign has_swatch = false -%}

{%- assign min = 1 -%}
{%- assign max = 6 -%}
{%- assign diff = max | minus: min -%}

{%- for option in product.options_with_values -%}
  {%- assign swatch_count = option.values | map: 'swatch' | compact | size -%}
  {%- assign option_name = option.name | downcase -%}

  {%- if swatch_count > 0 and swatches_enabled -%}
    {%- assign swatch_pos = option.position | minus: 1 -%}
    {%- assign swatches = product.options_by_name[option_name].values -%}
    {%- assign has_swatch = true -%}

    {%- break -%}
  {%- endif -%}

  {%- if swatches_enabled and option_name == swatch_option -%}
    {%- assign swatch_pos = option.position | minus: 1 -%}
    {%- assign swatches = product.options_by_name[swatch_option].values -%}
    {%- assign has_swatch = true -%}
  {%- endif -%}
{%- endfor -%}

{%- capture labels -%}
	{%- unless product.available -%}
		<li	class="product-card__label product-card__label--sold-out">
			<span class="visually-hidden">
				{{- 'products.product_card.product_label' | t -}}:
			</span>
{% comment %}
  {{- "products.product.sold_out" | t -}}
{% endcomment %}
			Back Order
		</li>
	{%- endunless -%}

	{%- assign tag_index = 1 -%}

	{%- for tag in product.tags -%}
		{%- if tag contains 'label__' -%}
			{%- assign class = 'product-card__label' -%}

			{%- if tag contains ':primary' -%}
				{%- assign class = class | append: " product-card__label--primary" | strip -%}
			{%- elsif tag contains ':secondary' -%}
				{%- assign class = class | append: " product-card__label--secondary" | strip -%}
			{%- endif -%}

			{%- assign clipped_tag = tag | remove: 'label__' | remove: ':primary' | remove: ':secondary' -%}

			<li	class="{{- class -}}">
				<span class="visually-hidden">
					{{- 'products.product_card.product_label' | t -}}:
				</span>

				{{- clipped_tag -}}
			</li>

			{%- assign tag_index = tag_index | plus: 1 -%}

			{%- if tag_index > 3 -%}
				{%- break -%}
			{%- endif -%}
		{%- endif -%}
	{%- endfor -%}
{%- endcapture -%}

{%- capture images -%}
	{%- assign colors				= '' -%}
	{%- assign colors_array			= '' -%}
	{%- assign index				= 1 -%}
	{%- assign colors_without_image = "" %}
	{%- assign colors_without_hover_image = "" %}

	{%- assign all_colors 		= '' -%}
	{%- assign all_colors_array = '' -%}

	{%- for variant in product.variants -%}
		{%- assign already_show = false -%}

		{%- for color in all_colors_array -%}
			{%- if color == variant.options[swatch_pos] -%}
				{%- assign already_show = true -%}
			{%- endif %}
		{%- endfor -%}

		{%- unless already_show -%}
			{%- assign all_colors   	= all_colors | append: ',' | append: variant.options[swatch_pos] -%}
			{%- assign all_colors_array	= all_colors | split: ',' -%}
		{%- endunless -%}
	{%- endfor-%}

	{% if product.selected_variant %}
		{% assign selected_color = product.selected_variant.options[swatch_pos] %}

		{% assign swatches1 = swatches | join: ',' | prepend: ',' | prepend: selected_color %}
		{% assign swatches1_arr = swatches1 | split: ',' %}
		{% assign swatches = swatches1_arr | uniq %}
	{% endif %}

	{%- for color in all_colors_array -%}
		{%- assign has_hover_image = false -%}
		{%- assign has_image = false -%}

		{%- for variant in product.variants -%}
			{%- if color == variant.options[swatch_pos] and variant.featured_image != blank -%}
				{%- assign has_image = true -%}
			{%- endif -%}

			{%- if color == variant.options[swatch_pos] and variant.metafields.product_card.hover_image != blank -%}
				{%- assign has_hover_image = true -%}
			{%- endif -%}
		{%- endfor-%}

		{% unless has_hover_image %}
			{% assign colors_without_hover_image = colors_without_hover_image | append: color | append: "," %}
		{% endunless %}

		{% unless has_image %}
			{% assign colors_without_image = colors_without_image | append: color | append: "," %}
		{% endunless %}
	{%- endfor -%}

	{% assign colors_without_hover_image = colors_without_hover_image |  split: "," |  shift  %}
	{% assign colors_without_image = colors_without_image |  split: "," |  shift  %}

	<a
		href="{{- product.url -}}"
		class="product-card__image-wrapper-link"
		aria-label="{{- product.title | default: "Product preset title" | escape -}}"
	>
		{%- for color in swatches limit: 5 -%}
			{% comment %}
				Make selected variant first in the variant array - to show correct image, when use filters
			{% endcomment %}
			{% assign array_with_current_variant = product.variants | where: 'title', product.selected_or_first_available_variant.title  %}
			{% assign variants = array_with_current_variant | concat: product.variants | uniq  %}

			{%- for variant in variants -%}
				{% if variant.options[swatch_pos] == product.selected_or_first_available_variant.options[swatch_pos] and variant != product.selected_or_first_available_variant  %}
					{% continue %}
				{% endif %}

				{%- assign already_show = false -%}

				{%- for color in colors_array -%}
					{%- if color == variant.options[swatch_pos] -%}
						{%- assign already_show = true -%}
					{%- endif %}
				{%- endfor -%}

				{%- unless already_show -%}
					{%- assign image        	= variant.featured_image | default: product.featured_image | default: settings.product_default_image -%}
					{%- assign hover_image		= variant.metafields.product_card.hover_image | default: product.metafields.product_card.hover_image | default: product.images[1] -%}
					{%- assign no_hover_image = false -%}
					{%- assign no_image = false -%}

					{% if image == hover_image %}
						{% assign hover_image = product.images[2] %}
					{% endif %}

					{%- if colors_without_image contains variant.options[swatch_pos] -%}
						{%- assign no_image = true -%}
					{%-endif -%}

					{%- if colors_without_hover_image contains variant.options[swatch_pos] -%}
						{%- assign no_hover_image = true -%}
					{%-endif -%}

					{%- assign show = false -%}

					{%- if variant.featured_image != blank or no_image or variant == product.selected_or_first_available_variant -%}
						{%- assign show = true -%}
					{%- endif -%}

					{%- if variant.metafields.product_card.hover_image == blank and no_hover_image == false and variant != product.selected_or_first_available_variant  -%}
						{%- assign show = false -%}
					{%- endif -%}

					{% if show and index <= 5 %}
						{%- capture wrapper_classes -%}
							product-card__image-wrapper product-card__image-wrapper--{{ aspect_ratio }} {% if hover_image != blank and image_on_hover_enabled == true %} product-card__image-wrapper--with-hover{% endif %} {% unless product.has_only_default_variant -%}js-product-card-images-wrapper{% endunless %}{% if variant.options[swatch_pos] == product.selected_or_first_available_variant.options[swatch_pos] %} is-active{%- endif -%}
						{%- endcapture -%}

						<div
							class="{{- wrapper_classes | strip_newlines -}}"
							data-image="{{- variant.options[swatch_pos] | escape -}}"
							data-variant="{{- variant.id -}}"
						>
							{%- if product == blank -%}
								{%- assign random_number       = "now" | date: "%N" | modulo: diff | plus: min -%}
								{%- assign placeholer_svg_name = 'product-' | append: random_number -%}

								<div class="product-card__image-picture">
									{{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' -}}
								</div>

								{%- if image_on_hover_enabled == true -%}
									{%- if random_number != 6 -%}
										{%- assign random_number2 = random_number | plus: 1 -%}
									{%- else -%}
										{%- assign random_number2 = 1 -%}
									{%- endif -%}

									{%- assign placeholer_svg_name = 'product-' | append: random_number2 -%}

									<div class="product-card__image-picture product-card__image-picture--hover">
										{{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image product-card__image--placeholder product-card__image--hover' -}}
									</div>
								{%- endif -%}
							{%- else -%}
								{% assign is_swatch_img_lazy = false %}

								{% if is_lazy == false and variant.options[swatch_pos] != product.selected_or_first_available_variant.options[swatch_pos] %}
									{% assign is_swatch_img_lazy = true %}
								{% endif %}

								{% if is_lazy == true %}
									{% assign is_swatch_img_lazy = true %}
								{% endif %}

								{%- render 'product-card-image',
									product: product,
									is_lazy: is_swatch_img_lazy,
									image: image,
									is_hover_image: false,
									size: size,
									tablet_size: tablet_size,
									mobile_size: mobile_size -%}

								{%- if hover_image != blank and image_on_hover_enabled == true and simplified_view != true -%}
									{%- if hover_image.value.media_type == 'video' -%}
										<div class="product-card__image-picture product-card__image-picture--hover">
											<video
												class="product-card__image js-product-card-video"
												loop
												muted
												playsinline
												preload="none"
												tabindex="-1"
												aria-hidden="true"
											>
												{%- for source in hover_image.value.sources -%}
													{%- if source.mime_type == 'video/mp4' -%}
														<source src="{{- source.url -}}" type="{{- source.mime_type -}}">
													{%- endif -%}
												{%- endfor -%}
											</video>
										</div>
									{%- else -%}
										{%- render 'product-card-image',
											product: product,
											is_lazy: true,
											image: hover_image,
											is_hover_image: true,
											size: size,
											tablet_size: tablet_size,
											mobile_size: mobile_size -%}
									{%- endif -%}
								{%- endif -%}
							{%- endif -%}
						</div>

						{%- assign colors   	= colors | append: ',' | append: variant.options[swatch_pos] -%}
						{%- assign colors_array	= colors | split: ',' -%}
						{%- assign index   		= index | plus: 1 -%}
					{% endif %}
				{%- endunless -%}
			{%- endfor -%}
		{%- else -%}
			{%- assign variant 			= product.selected_or_first_available_variant -%}
			{%- assign image        	= variant.featured_image | default: product.featured_image | default: settings.product_default_image -%}
			{%- assign hover_image		= variant.metafields.product_card.hover_image | default: product.metafields.product_card.hover_image | default: product.images[1] -%}

			{%- capture wrapper_classes -%}
				product-card__image-wrapper product-card__image-wrapper--{{ aspect_ratio }} {% if hover_image != blank and image_on_hover_enabled == true %} product-card__image-wrapper--with-hover{% endif %} {% unless product.has_only_default_variant -%}js-product-card-images-wrapper{% endunless %} is-active
			{%- endcapture -%}

			<div
				class="{{- wrapper_classes | strip_newlines }} is-active"
				data-image="{{- variant.options[swatch_pos] | escape -}}"
				data-variant="{{- variant.id -}}"
			>
				{%- if product == blank -%}
					{%- assign random_number       = "now" | date: "%N" | modulo: diff | plus: min -%}
					{%- assign placeholer_svg_name = 'product-' | append: random_number -%}

					<div class="product-card__image-picture">
						{{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' -}}
					</div>

					{%- if image_on_hover_enabled == true -%}
						{%- if random_number != 6 -%}
							{%- assign random_number2 = random_number | plus: 1 -%}
						{%- else -%}
							{%- assign random_number2 = 1 -%}
						{%- endif -%}

						{%- assign placeholer_svg_name = 'product-' | append: random_number2 -%}

						<div class="product-card__image-picture product-card__image-picture--hover">
							{{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image product-card__image--placeholder product-card__image--hover' -}}
						</div>
					{%- endif -%}
				{%- else -%}
					{%- render 'product-card-image',
						product: product,
						is_lazy: is_lazy,
						image: image,
						is_hover_image: false,
						size: size,
						tablet_size: tablet_size,
						mobile_size: mobile_size -%}

					{%- if hover_image != blank and image_on_hover_enabled == true and simplified_view != true -%}
						{%- if hover_image.value.media_type == 'video' -%}
							<div class="product-card__image-picture product-card__image-picture--hover">
								<video
									class="product-card__image js-product-card-video"
									loop
									muted
									playsinline
									preload="none"
									tabindex="-1"
									aria-hidden="true"
								>
									{%- for source in hover_image.value.sources -%}
										{%- if source.mime_type == 'video/mp4' -%}
											<source src="{{- source.url -}}" type="{{- source.mime_type -}}">
										{%- endif -%}
									{%- endfor -%}
								</video>
							</div>
						{%- else -%}
							{%- render 'product-card-image',
								product: product,
								is_lazy: true,
								image: hover_image,
								is_hover_image: true,
								size: size,
								tablet_size: tablet_size,
								mobile_size: mobile_size -%}
						{%- endif -%}
					{%- endif -%}
				{%- endif -%}
			</div>
		{%- endfor -%}
	</a>
{%- endcapture -%}

{%- capture classes -%}
	product-card{% if big_card == true %} product-card--big{% endif %} {% if show_hover_content == false %}product-card--without-hover-content{% endif %} js-product-card
{%- endcapture -%}

<div
  class="{{- classes -}}"
  {%- if product != blank %}
    data-existing-product
  {% endif %}
>
  <div class="product-card__main">
    {% assign badge_labels = product.metafields.custom.badge_images %}
    {% assign is_product_have_labels = false %}

    {% if badge_labels.count > 0 or labels != blank %}
      {% assign is_product_have_labels = true %}
    {% endif %}

    {%- if is_product_have_labels and labels_enabled -%}
      <ul
        class="product-card__labels"
        aria-label="{{- 'products.product_card.product_labels' | t | escape -}}"
      >
        {{- labels -}}

        {% for badge_label in badge_labels.value limit: 3 %}
          <li>
            <span class="visually-hidden">
              {{- 'products.product_card.product_label' | t -}}
              :
            </span>

            <img
              class="product-card__label-logo"
              src="{{ badge_label | image_url: width: 48 }}"
              srcset="{{ badge_label | image_url: width: 48 }} 1x, {{ badge_label | image_url: width: 96 }} 2x"
              alt="{{ badge_label.alt | escape }}"
            >
          </li>
        {% endfor %}
      </ul>
    {%- endif -%}

    {%- if product.variants.size > 1 and has_swatch == true and simplified_view == null -%}
      {{- images -}}
    {%- else -%}
      {%- assign image = product.featured_image
        | default: product.featured_image
        | default: settings.product_default_image
      -%}
      {%- assign hover_image = product.metafields.product_card.hover_image | default: product.images[1] -%}

      {% if image == hover_image %}
        {%- assign hover_image = product.metafields.product_card.hover_image | default: product.images[2] -%}
      {% endif %}

      <a
        href="{{- product.url -}}"
        class="product-card__image-wrapper-link"
        aria-label="{{- product.title | default: "Product preset title" | escape -}}"
      >
        <div
          class="product-card__image-wrapper product-card__image-wrapper--{{ aspect_ratio }} {% if hover_image != blank and image_on_hover_enabled == true and simplified_view != true %} product-card__image-wrapper--with-hover{% endif %} is-active  {% unless product.has_only_default_variant or product.variants.size == 1 -%} js-product-card-images-wrapper {% endunless -%}"
          {%- unless product.has_only_default_variant -%}
            data-variant="{{- product.selected_or_first_available_variant.id -}}"
          {%- endunless -%}
        >
          {%- if product == blank -%}
            {%- assign random_number = 'now' | date: '%N' | modulo: diff | plus: min -%}
            {%- assign placeholer_svg_name = 'product-' | append: random_number -%}

            <div class="product-card__image-picture">
              {{- placeholer_svg_name | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' -}}
            </div>

            {%- if image_on_hover_enabled == true -%}
              {%- if random_number != 6 -%}
                {%- assign random_number2 = random_number | plus: 1 -%}
              {%- else -%}
                {%- assign random_number2 = 1 -%}
              {%- endif -%}

              {%- assign placeholer_svg_name = 'product-' | append: random_number2 -%}

              <div class="product-card__image-picture product-card__image-picture--hover">
                {{-
                  placeholer_svg_name
                  | placeholder_svg_tag: 'product-card__image product-card__image--placeholder product-card__image--hover'
                -}}
              </div>
            {%- endif -%}
          {%- else -%}
            {%- render 'product-card-image',
              product: product,
              is_lazy: is_lazy,
              image: image,
              is_hover_image: false,
              size: size,
              tablet_size: tablet_size,
              mobile_size: mobile_size
            -%}

            {%- if hover_image != blank and image_on_hover_enabled == true and simplified_view != true -%}
              {%- if hover_image.value.media_type == 'video' -%}
                <div class="product-card__image-picture product-card__image-picture--hover">
                  <video
                    class="product-card__image js-product-card-video"
                    loop
                    muted
                    playsinline
                    preload="none"
                    tabindex="-1"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    {%- for source in hover_image.value.sources -%}
                      {%- if source.mime_type == 'video/mp4' -%}
                        <source src="{{- source.url -}}" type="{{- source.mime_type -}}">
                      {%- endif -%}
                    {%- endfor -%}
                  </video>
                </div>
              {%- else -%}
                {%- render 'product-card-image',
                  product: product,
                  is_lazy: is_lazy,
                  image: hover_image,
                  is_hover_image: true,
                  size: size,
                  tablet_size: tablet_size,
                  mobile_size: mobile_size
                -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}

    <div class="product-card__additional-buttons">
      {%- if quick_view_enabled == true -%}
        {%- if product.available -%}
          {%- if settings.product_card_buttons_type == 'icon' -%}
            <button
              class="product-card__quick-view-button js-product-card-quick-view-button"
              data-product-card-handle="{{- product.handle -}}"
              {%- if product.has_only_default_variant == false -%}
                aria-label="{{- 'products.product_card.open_quick_view' | t | escape -}}"
              {%- else -%}
                aria-label="{{- 'products.product_card.add_to_cart' | t | escape -}}"
              {%- endif -%}
              {%- if product.has_only_default_variant or product.variants.size == 1 -%}
                data-variant="{{- product.selected_or_first_available_variant.id -}}"
              {%- endif -%}
              type="button"
            >
              {%- if product.has_only_default_variant or product.variants.size == 1 -%}
                {%- render 'icons', icon: 'cart' -%}
              {%- else -%}
                {%- render 'icons', icon: 'quick-view' -%}
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endif -%}

        {%- if settings.product_card_buttons_type == 'icon' -%}
          <noscript>
            <a
              class="product-card__quick-view-button product-card__quick-view-button--no-js"
              href="{{- product.url -}}"
              aria-label="{{- 'products.product_card.quick_view_no_js' | t | escape -}}"
            >
              {%- render 'icons', icon: 'cart' -%}
            </a>
          </noscript>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.enable_compare_products -%}
        {%- render 'compare-products-button',
          product: product,
          additional_classes: 'product-card__compare-products-button'
        -%}
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__footer">
    <a class="focus-visible-outline product-card__title" myid="{{ product.id  }}" href="{{ product.url }}">
      {%- if product != blank -%}
        {{- product.title -}}
      {%- else -%}
        {{- 'products.product_card.product_title' | t -}}
      {%- endif -%}
    </a>




    {%- if show_vendor_and_sku and simplified_view == null -%}
      <div class="product-card__vendor-sku">
        {% if show_vendor_block %}
          <span class="product-card__vendor">
            <span class="visually-hidden">
              {{- 'products.product_card.product_vendor' | t -}}
            </span>

            {{- product.vendor -}}
          </span>
        {% endif %}

        {% if show_sku_block %}
          <span class="product-card__sku">{{ sku_text }}</span>
        {% endif %}
      </div>
    {%- endif -%}

    <div class="product-card__price">
      {% if settings['product-price-show'] %}
        {% if customer %}
          {%- render 'price',
            product: product,
            show_unit_price: show_unit_price,
            currency_code_enabled: currency_code_enabled,
            simplified_view: simplified_view
          -%}
        {% else %}

        {% endif %}
      {% else %}
        {%- render 'price',
          product: product,
          show_unit_price: show_unit_price,
          currency_code_enabled: currency_code_enabled,
          simplified_view: simplified_view
        -%}
      {% endif %}

      <div class="custom-discount-price myprrice22" style="text-align: center;">
        {% if compare_at_price > price %}
          {% assign discount_amount = compare_at_price | minus: price %}
          <span class="" data-product-price-discount>
            {{ discount_amount | money }}
          </span>
        {% endif %}
      </div>
      
      {%- if quick_view_enabled == true and product.available and settings.product_card_buttons_type == 'text' -%}
        <button
          class="product-card__quick-view-text-button js-product-card-quick-view-button"
          data-product-card-handle="{{- product.handle -}}"
          {%- if product.has_only_default_variant or product.variants.size == 1 -%}
            data-variant="{{- product.selected_or_first_available_variant.id -}}"
          {%- endif -%}
          type="button"
        >
          {% render 'icons', icon: 'cart' %}
        </button>
      {%- endif -%}

      {%- if quick_view_enabled == true and settings.product_card_buttons_type == 'text' -%}
        <noscript>
          <a
            class="button button--secondary product-card__quick-view-text-button product-card__quick-view-button--no-js"
            href="{{- product.url -}}"
          >
            {%- if product.has_only_default_variant -%}
              {{- 'products.product_card.add_to_cart' | t -}}
            {%- else -%}
              {{- 'products.product_card.open_quick_view' | t -}}
            {%- endif -%}
          </a>
        </noscript>
      {%- endif -%}
    </div>
    

    {% if product.quantity_price_breaks_configured? %}
      <div class="product-card__volume-pricing-note">
        <span>{{ 'products.product.volume_pricing.note' | t }}</span>
      </div>
    {% endif %}

    <input
      type="hidden"
      class="js-product-card-min-value"
      value="{{- product.selected_or_first_available_variant.quantity_rule.min -}}"
    >

    {%- if show_hover_content -%}
      <div class="product-card__hover-content">
        {% if extra_properties.value.size > 0 %}
          <ul>
            {% for extra_propertie in extra_properties.value %}
              {% if extra_propertie != blank %}
                <li class="product-cards__extra-info">{{ extra_propertie }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if swatches != blank and swatches_enabled %}
          {%- render 'product-card-swatches',
            swatches: swatches,
            product: product,
            swatch_name: product.options_by_name[swatch_option].name,
            swatch_pos: swatch_pos
          -%}

          {% for option in product.options_with_values %}
            {% assign option_position = option.position | minus: 1 %}
            {% assign base_swatch_to_show = 3 %}

            {% if option_position == swatch_pos %}
              {% continue %}
            {% endif %}

            <div class="product-card__swatches-wrapper">
              <span class="product-card__swatches-label-name">{{ option.name }}:</span>

              <div class="product-card__swatches product-card__swatches--base js-product-card-swatch-base-container">
                {% for value in option.values limit: base_swatch_to_show %}
                  <button class="product-card__swatch-button-base js-product-card-swatch-base {% if option.selected_value == value %}is-active{% endif %}">
                    {{ value }}
                  </button>
                {% endfor %}

                {% if option.values.size > base_swatch_to_show %}
                  {% assign overlimit = option.values.size | minus: base_swatch_to_show %}
                  <span class="product-card__overlimit">+ {{ overlimit }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    {%- endif -%}
  </div>

{% comment %}
  Drop this snippet wherever you render each product result in your
  predictive-search results markup.  It is fully self-contained:
  all variant data is embedded as a data attribute so the JS
  never needs window.productData or any global state.
  Multiple cards on the same page are safe because nothing uses
  a plain id="…" — every selector is scoped to the wrapper.
{% endcomment %}





  <div class="custom-variant" style="text-align: left;">
    <div class="custom-variant-wrap" style="margin-bottom: 14px;">
      {% comment %}
              {% for option in product.options_with_values %}
          {% if option.values.size > 1 %}
            <div class="selector-wrapper js product-form__item {{ option.name | handleize }}">
              <label for="SingleOptionSelector-{{ forloop.index0 }}" style="padding: 6px 0px;font-size: 12px;" class="main-optionname">
                {{ option.name }}
              </label>

                {% for value in option.values %}
                  <input id="custom-var{{ product.id }}{{ section.id }}{{ value }}" class="swatch-options option-value custom-varient-option-button customvariant{{ product.id }}" type="radio" name="{{ product.id }}{{ section.id }}{{ option.name }}" value="{{ value | escape | handleize | downcase}}" {% if forloop.first %}checked{% endif %}>
                  <label for="custom-var{{ product.id }}{{ section.id }}{{ value }}" class="custom-varient-lable custom-fyly{{ forloop.index }}">{{ value }}</label>
                {% endfor %}

            </div>
          {% endif %}
        {% endfor %}
      {% endcomment %}

      <form action="/cart/add" method="post" enctype="multipart/form-data">
        {% assign option_index = 0 %}
        {% assign hidden_value = '' %}
        {% for option in product.options_with_values %}
          {% for value in option.values %}
            {% if value contains 'Wholesaler' %}
              {% assign novariant = true %}
            {% endif %}
          {% endfor %}
          <fieldsets class="customwraper{{ product.id }}">
            {% if novariant %}
            {% else %}
              <legend>{{ option.name }}</legend>
            {% endif %}
            {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value | split: ',' %}

            {% if option.name contains 'Wholesaler' and hide_purchase_controls %}
              <span class="custom-list-wholesaler-placeholder custom_dropdown" style="font-weight:400;color:#8a8a8a;"></span>
            {% else %}
            {% for value in option.values %}
              {%- assign hide_option = false -%}

              {%- if option.name contains 'Wholesaler' -%}
                {%- assign hide_option = true -%}
                {%- for item in coverage_countries -%}
                  {%- assign item_up = item | upcase -%}
                  {%- assign value_up = value | upcase -%}
                  {%- if item_up contains value_up -%}
                    {%- assign hide_option = false -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {% unless hide_option %}
                {% if option.name contains 'Wholesaler' and hidden_value == '' %}
                  {% assign hidden_value = value | handleize %}
                {% endif %}
                <input
                  class="custominput{{ product.id }} {{ value | downcase }} radioinput"
                  type="radio"
                  name="{{ option.name }}"
                  value="{{ value }}"
                  id="custom-var{{ product.id }}{{ section.id }}{{ value | handleize }}"
                  style="position:absolute;visibility:hidden;"
                 {% if forloop.index == 1 %}
                  checked
                 {% endif %}
                  myselected="custom{{ value | handleize }}"
                  
                  onclick="handleVariantChange(this); if(window.updateMoqBadge) updateMoqBadge('{{ product.id }}', this);"
                >

                <label for="custom-var{{ product.id }}{{ section.id }}{{ value | handleize }}"
                      class="radio-button-label {{ value }}"
                        data-wholeseller="{{ value | handleize }}">

                    
                  {{ value }}
                </label>
              {% endunless %}
            {% endfor %}
            {% endif %}
          </fieldsets>
          {% assign option_index = option_index | plus: 1 %}
        {% endfor %}
        {% comment %}
          <input type="hidden" name="id" value="" id="variant-id" class="customvariantid{{ product.id }}">
        {% endcomment %}
        {% if novariant %}
        {% else %}
          {% if customer and hide_purchase_controls %}
            <p style="color:#8a8a8a;font-size:13px;margin:0;text-align:center;width:100%;">{% unless request.page_type == 'search' %}Not available{% endunless %}</p>
          {% endif %}
          {% if customer and hide_purchase_controls == false %}
            <div class="product__custombtn">
              <div class="quantity__product">
                <div class="quantity-selector">
                  <button
                    type="button"
                    onclick="
                      var input = this.nextElementSibling;
                      var value = parseInt(input.value, 10) || 1;
                      if (value > 1) {
                        input.value = value - 1;
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                      }
                    "
                  >
                    -
                  </button>

                  <input
                    type="number"
                    class="quantity"
                    name="quantity"
                    value="1"
                    min="1"
                  >

                  <button
                    type="button"
                    onclick="
                      var input = this.previousElementSibling;
                      var value = parseInt(input.value, 10) || 1;
                      input.value = value + 1;
                      input.dispatchEvent(new Event('change', { bubbles: true }));
                    "
                  >
                    +
                  </button>
                </div>
              </div>

              <div class="product__button">
                <span
                  data-variant-id="{{ product.variants.first.id }}"
                  id="variant-id"
                  class="product-add-to-cart__button add-to-cart button button--block button--secondary custombtn{{ product.id }}"
                  data-inventory_info_block_type="undefined"
                >
                  <svg
                    class="icon"
                    aria-hidden="true"
                    focusable="false"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M15.375 11.1429C15.375 13.0365 13.864 14.5714 12 14.5714C10.136 14.5714 8.62501 13.0365 8.62501 11.1429M3 6.57142H21M3 6.57142V13.4286C3 20.7049 4.26897 22 12 22C19.731 22 21 20.7049 21 13.4286V6.57142M3 6.57142L4.6281 3.2635C5.00924 2.48915 5.78833 2 6.64058 2H17.3594C18.2117 2 18.9908 2.48915 19.3719 3.2635L21 6.57142" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>

                  <span class="js-product-add-to-cart-button-text">Add to cart</span>
                </span>
              </div>
            </div>
          {% else %}

          {% endif %}
        {% endif %}
        {% assign selected_seller_handle = hidden_value | downcase | strip %}
        {% assign seller_account_number = '' %}
        {% if customer %}
          {% for item in coverage_countries %}
            {% assign clean_item = item | strip %}
            {% assign clean_item_down = clean_item | downcase %}
            {% case selected_seller_handle %}
              {% when 'symbion' %}
                {% if clean_item_down contains 'symbion' %}
                  {% assign seller_account_number = clean_item | remove_first: 'Symbion' | remove_first: 'SYMBION' | strip %}
                  {% break %}
                {% endif %}
              {% when 'ch2' %}
                {% if clean_item_down contains 'ch2' %}
                  {% assign seller_account_number = clean_item | remove_first: 'Ch2' | remove_first: 'CH2' | remove_first: 'ch2' | strip %}
                  {% break %}
                {% endif %}
              {% when 'sigma' %}
                {% if clean_item_down contains 'sigma' %}
                  {% assign seller_account_number = clean_item | remove_first: 'Sigma' | remove_first: 'SIGMA' | strip %}
                  {% break %}
                {% endif %}
              {% when 'api' %}
                {% if clean_item_down contains 'api' %}
                  {% assign seller_account_number = clean_item | remove_first: 'Api' | remove_first: 'API' | strip %}
                  {% break %}
                {% endif %}
            {% endcase %}
          {% endfor %}
        {% endif %}
         <input
  type="hidden"
  name="properties[Wholesaler Account No.1]"
  value="{% if selected_seller_handle contains 'api' %}{{ seller_account_number }}{% endif %}"
  class="API"
>

        <input type="hidden" name="properties[Wholesaler Account No.2]" value="{% if selected_seller_handle contains 'sigma' %}{{ seller_account_number }}{% endif %}" class="Sigma">
        <input type="hidden" name="properties[Wholesaler Account No.3]" value="{% if selected_seller_handle contains 'symbion' %}{{ seller_account_number }}{% endif %}" class="Symbion">
        <input type="hidden" name="properties[Wholesaler Account No.4]" value="{% if selected_seller_handle contains 'ch2' %}{{ seller_account_number }}{% endif %}" class="Ch2">
        <input
          id="custom-inline-property"
          type="hidden"
          name="properties[Profit Per Dispensed]"
          value="{% assign sic_variant = product.selected_or_first_available_variant %}{% if sic_variant.compare_at_price > sic_variant.price %}{% assign discount_amount = sic_variant.compare_at_price | minus: sic_variant.price %}          {{ discount_amount | money }}   {% endif %}"
        >
      </form>
      {% for variant in product.variants %}
        {%- assign _vt = variant.metafields.pharmacor_discounts.volume_discount_tiers.value | parse_json -%}
        {%- capture _vtiers_json -%}[{% for tier in _vt %}{%- assign _base = variant.price | money_without_currency -%}{%- assign _disc = _base | times: tier.discountPercent | divided_by: 100 -%}{%- assign _moq_raw = _base | minus: _disc -%}{%- assign _moq_cents = _moq_raw | times: 100 | floor -%}{%- assign _moq_price = _moq_cents | divided_by: 100.0 -%}{"qty":{{ tier.quantityThreshold }},"price":{{ _moq_price }}}{% unless forloop.last %},{% endunless %}{% endfor %}]{%- endcapture -%}
        <input
          type="hidden"
          class="custom{{ variant.title | escape | handleize | downcase | replace: '-', '' }}"
          variant-price="{{ variant.price | money }}"
          inventory="{{ variant.inventory_quantity }}"
          compareprice="{{ variant.compare_at_price | money }}"
          data-index="{{ variant.id }}"
          product-id="{{ variant.id }}"
          value="{{ variant.id }}"
          data-volumetiers='{{ _vtiers_json | strip_newlines }}'
        >
      {% endfor %}
    </div>
  </div>
</div>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js" defer></script>



