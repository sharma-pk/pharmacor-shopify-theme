              style="padding-right: 0px;width: 100%;"
            {% endif %}
            option-name="{{ option.name | handleize }}"
            class="custom_dropdown custom-list-wholesaler custom{{ option.name | handleize }} custom{{ customindex }} customselect customselector{{product.id}}"
          >
            {% for value in option.values %}
              {% assign hide_option = false %}

              {% if option.name contains 'Wholesaler' %}
                {% assign hide_option = true %}
                {% assign value_down = value | downcase %}

                {% for item in coverage_countries %}
                  {% assign item_down = item | downcase %}
                  {% if item_down contains value_down %}
                    {% assign hide_option = false %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% comment %} Update hidden_value only if empty {% endcomment %}
                {% if hidden_value == '' and hide_option == false %}
                  {% assign hidden_value = value | handleize %}
                {% endif %}
              {% else %}
                {% if hidden_value == '' %}
                  {% assign hidden_value = value | handleize %}
                {% endif %}
              {% endif %}

              {% unless hide_option %}
                {% assign value_handle = value | handleize %}
                <option
                  class="custom{{ value_handle }}{% if hidden_value == value_handle %} is-active{% endif %}"
                  value="{{ value_handle }}"
                  {% if option.name contains 'Wholesaler' %}data-brand="{{ value_handle }}"{% endif %}
                  {% if hidden_value == value_handle %}selected{% endif %}
                >
                  {{ value }}
                </option>
              {% endunless %}
            {% endfor %}
          </select>
        {% endif %}


      <input type="hidden"
             id="wholesaler-account-{{ forloop.index }}-{{ product.id }}"
