      <!-- Display the selected wholesaler -->



          <!-- JS to update hidden input when dropdown changes -->
          <script>
          document.addEventListener('DOMContentLoaded', function() {
            const select = document.getElementById('mySelect{{ forloop.index }}-{{ product.id }}');
            const hiddenInput = document.getElementById('wholesaler-account-{{ forloop.index }}-{{ product.id }}');
            if (!select || !hiddenInput) return;

            // Ensure hidden input's data-value-wholesale matches initial selected option
            hiddenInput.dataset.valueWholesale = select.value;

            // Bookkeeping only — custom-style.js's shared `.custom_dropdown` handler now owns applying the live account number; this used to race it with a stale static one
            select.addEventListener('change', function() {
              hiddenInput.dataset.valueWholesale = this.value;
            });
          });
          </script>
     


