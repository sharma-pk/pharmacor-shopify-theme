  <div class="homepage-qty-selector">
    <button
      class="homepage-qty-btn homepage-qty-decrease"
      type="button"
      aria-label="Decrease quantity"
    >
      &minus;
    </button>

    <input
      class="homepage-qty-input custom-class-quantity"
      type="number"
      name="quantity"
      value="1"
      min="1"
      step="1"
      aria-label="Quantity"
    >

    <button
      class="homepage-qty-btn homepage-qty-increase"
      type="button"
      aria-label="Increase quantity"
    >
      &plus;
    </button>
  </div>

  <span
    class="
      custom-btn-boxes product-add-to-cart__button add-to-cart button button--block button--{{- button_type -}}
    "
    {% if product.template_suffix == 'pre-order' %}
      data-preorder
    {% endif %}
  >
    {%- render 'icons', icon: 'cart' -%}

    <span class="js-product-add-to-cart-button-text">
      {% if product.first_available_variant.available %}
        {% if product.template_suffix == 'pre-order' %}
          {{- 'products.product.pre_order' | t -}}
        {% else %}
          {{- 'products.product.add_to_cart' | t -}}
        {% endif %}
      {% else %}
        {{- 'products.product.sold_out' | t -}}
      {% endif %}
    </span>
  </span>
</div>
{% comment %}
  <button
  	type="submit"
  	class="custom-btn-boxes product-add-to-cart__button add-to-cart button button--block button--{{- button_type -}}
  			{% unless product.first_available_variant.available %}
  				disabled
  			{% endunless %}
  		"
  	{% unless product.first_available_variant.available %}
  		disabled
  	{% endunless %}
  	{% if product.template_suffix == 'pre-order' %}
  		data-preorder
  	{% endif %}
  >
  	{%- render 'icons', icon: 'cart' -%}

  	<span class="js-product-add-to-cart-button-text">
  		{% if product.first_available_variant.available %}
  			{% if product.template_suffix == 'pre-order' %}
  				{{- 'products.product.pre_order' | t -}}
  			{% else %}
  				{{- 'products.product.add_to_cart' | t -}}
  			{% endif %}
  		{% else %}
  			{{- 'products.product.sold_out' | t -}}
  		{% endif %}
  	</span>
  </button>
{% endcomment %}
{% comment %}
  {% render 'custom-product-quantity', block: block, product: product, show_label: true %}
{% endcomment %}
{% if block.settings.show_additional_buttons and hide_purchase_controls == false %}
  <div class="product-add-to-cart__additional-buttons">
    {{- form | payment_button -}}
  </div>
{% endif %}
{% if customer %}
  {% for address in customer.addresses %}
    <!-- <p style="" class="custom-address-1">{{ customer.tags | join: ', ' }}</p> -->
    <div class="my-cusotm-tag-main">
      {% for tag in customer.tags %}
        <span class="customer-tag custom-address-1" style="position: absolute; opacity: 0;">{{ tag | handleize }}</span>
      {% endfor %}
    </div>
  {% endfor %}
  <style>
    {% if template.name == 'product' %}
    /* .product-inventory-status{display: none;} */
      {% endif %}
  </style>
{% endif %}




        </form>
      </div>
    {% endif %}
    {% if customer %}
      <form method="post" action="{{ routes.cart_add_url }} " style="width:0%;display: none;">
        <input
          type="hidden"
          name="properties[Wholesaler Account No.1]"
          value="{% if selected_seller_handle contains 'api' %}{{ seller_account_number }}{% endif %}"
          class="API"
        >

        <input
          type="hidden"
          name="properties[Wholesaler Account No.2]"
          value="{% if selected_seller_handle contains 'sigma' %}{{ seller_account_number }}{% endif %}"
          class="Sigma"
        >
        <input
          type="hidden"
          name="properties[Wholesaler Account No.3]"
          value="{% if selected_seller_handle contains 'symbion' %}{{ seller_account_number }}{% endif %}"
          class="Symbion"
        >
        <input
          type="hidden"
          name="properties[Wholesaler Account No.4]"
          value="{% if selected_seller_handle contains 'ch2' %}{{ seller_account_number }}{% endif %}"
          class="Ch2"
        >
        <input id="my-variant-profit" type="hidden" name="properties[Saving Per Item]" class="itemperdiscount" value="">
        <input type="hidden" name="id" class="my-add-to-cart-value custom-idd" value="{{ product.variants.first.id }}">
        <input min="1" type="hidden" class="add-to-card-input custom-quantity" id="quantity" name="quantity" value="1">
      </form>
    {% else %}
      <div class="more_info">More Info</div>
    {% endif %}
    {% comment %}
      <div class="custom_more-info custom-list-product-info" style="color: #000;">More info</div>
    {% endcomment %}
  </div>
</div>
