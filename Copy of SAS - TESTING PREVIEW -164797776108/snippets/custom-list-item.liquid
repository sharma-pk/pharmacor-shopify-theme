     {%- assign sas_subscribed = false -%}
{%- if customer -%}
  {%- assign sas_orders_raw = customer.metafields.membership.subscription_orders.value -%}
  {%- unless sas_orders_raw == blank -%}
    {%- assign sas_orders = sas_orders_raw | json_parse -%}
    {%- for sas_item in sas_orders -%}
      {%- assign sas_status = sas_item.status | downcase -%}
      {%- if sas_status == 'active' -%}
        {%- assign sas_parts = sas_item.title | split: '-' -%}
        {%- assign sas_variant_id = sas_parts[2] | plus: 0 -%}
        {%- for variant in product.variants -%}
          {%- if variant.id == sas_variant_id -%}
            {%- assign sas_subscribed = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
{%- endif -%}

{% comment %} apiselleritem/sigmaselleritem/symbionselleritem/ch2selleritem/defaulseller used to be computed here but never read anywhere in this file — removed; coverage_countries below is what's actually used {% endcomment %}
{% if customer %}
  {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
{% endif %}

<div
  class="custom-main-inner-wrap collection__item customitem product-item custom-list-{{ forloop.index }}"
  style="width: 100%;"
  data-title="{{ product.title }}"
  data-product-id="{{ product.id }}"
  data-price="{{ product.price | money_without_currency | replace: ',', '' }}"
  myvarientid="{{ variant.id }}"
  data-created="{{ product.created_at }}"
>
  {% comment %}
     {% assign customer_tier = customer.metafields.pharmacor_discounts.pricing_tier.value | strip %}

    {% for variant in product.variants %}

      {%- comment -%} === Wholesale Price === {%- endcomment -%}
      {% assign raw_prices = variant.metafields.pharmacor_discounts.custom_wholesale_price.value %}
      {% assign wholesale_prices = raw_prices | parse_json %}
      {% assign tier_price = blank %}

      {% if customer_tier and wholesale_prices %}
        {% assign tier_price = wholesale_prices[customer_tier] %}
      {% endif %}

      {%- comment -%} === Volume Discount Tiers === {%- endcomment -%}
      {% assign volume_raw = variant.metafields.pharmacor_discounts.volume_discount_tiers.value %}
      {% assign volume_tiers = volume_raw | parse_json %}

      {% assign volume_qty = blank %}
      {% assign volume_discount = blank %}
      {% assign volume_discount_price = blank %}

      {% if volume_tiers and volume_tiers.size > 0 %}
        {% assign first_tier = volume_tiers[0] %}

        {%- comment -%} FORCE numeric values {%- endcomment -%}
        {% assign volume_qty = first_tier.quantityThreshold | plus: 0 %}
        {% assign volume_discount = first_tier.discountPercent | plus: 0 %}
        {% assign clean_tier_price = tier_price | plus: 0 %}

        {% if clean_tier_price > 0 %}
          {% assign base_price = clean_tier_price | times: 100 %}
        {% else %}
          {% assign base_price = variant.price | plus: 0 %}
        {% endif %}

        {% assign discount_amount = base_price | times: volume_discount | divided_by: 100 %}
        {% assign volume_discount_price = base_price | minus: discount_amount %}
      {% endif %}

      {%- comment -%} === First Tier Input === {%- endcomment -%}
      <input
        type="hidden"
        class="procustom{{ variant.id | handleize }} {{ variant.title | handleize }}"
        compareprice="{{ variant.compare_at_price | money }}"
        varienrprice="{{ variant.price | money }}"
        varientquentity="{{ variant.inventory_quantity }}"
        myvarientid="{{ variant.id }}"
        varienrcompprice="{{ variant.compare_at_price | money }}"
        customwholesaleprice="{{ tier_price }}"
        variantprofit="
          {% if variant.compare_at_price > variant.price %}
            {% assign price_difference = variant.compare_at_price | minus: variant.price %}
            {% assign profit_percentage = price_difference | times: 100.0 | divided_by: variant.compare_at_price %}
            {{ profit_percentage | round: 2 }}%
          {% endif %}
        "
        volumeqty="{{ volume_qty }}"
        volumediscount="{{ volume_discount }}"
        volumediscountprice="{{ volume_discount_price | money }}"
      >

      {%- comment -%} === Additional Tier Inputs === {%- endcomment -%}
      {% if volume_tiers and volume_tiers.size > 1 %}
        {% for tier in volume_tiers offset:1 %}

          {% assign volume_qty = tier.quantityThreshold | plus: 0 %}
          {% assign volume_discount = tier.discountPercent | plus: 0 %}
          {% assign clean_tier_price = tier_price | plus: 0 %}

          {% if clean_tier_price > 0 %}
            {% assign base_price = clean_tier_price | times: 100 %}
          {% else %}
            {% assign base_price = variant.price | plus: 0 %}
          {% endif %}

          {% assign discount_amount = base_price | times: volume_discount | divided_by: 100 %}
          {% assign volume_discount_price = base_price | minus: discount_amount %}

          <input
            type="hidden"
            class="procustom{{ variant.id | handleize }} {{ variant.title | handleize }}"
            compareprice="{{ variant.compare_at_price | money }}"
            varienrprice="{{ variant.price | money }}"
            varientquentity="{{ variant.inventory_quantity }}"
            myvarientid="{{ variant.id }}"
            varienrcompprice="{{ variant.compare_at_price | money }}"
            customwholesaleprice="{{ tier_price }}"
            variantprofit="
              {% if variant.compare_at_price > variant.price %}
                {% assign price_difference = variant.compare_at_price | minus: variant.price %}
                {% assign profit_percentage = price_difference | times: 100.0 | divided_by: variant.compare_at_price %}
                {{ profit_percentage | round: 2 }}%
              {% endif %}
            "
            volumeqty="{{ volume_qty }}"
            volumediscount="{{ volume_discount }}"
            volumediscountprice="{{ volume_discount_price | money }}"
          >
        {% endfor %}
      {% endif %}

    {% endfor %}
  {% endcomment %}
