            {% for item in coverage_countries %}
              {% assign item_down = item | downcase %}
              {% if item_down contains value_down %}
                {% assign wholesaler_has_visible_value = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}

          {% assign option_values_down = option.values | join: ',' | downcase %}
          {% if hidden_value == '' and option_values_down contains 'api' and coverage_data contains 'api' %}
            {% assign hidden_value = 'api' %}
          {% elsif hidden_value == '' and option_values_down contains 'sigma' and coverage_data contains 'sigma' %}
            {% assign hidden_value = 'sigma' %}
          {% elsif hidden_value == '' and option_values_down contains 'symbion' and coverage_data contains 'symbion' %}
            {% assign hidden_value = 'symbion' %}
          {% elsif hidden_value == '' and option_values_down contains 'ch2' and coverage_data contains 'ch2' %}
            {% assign hidden_value = 'ch2' %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% assign hide_purchase_controls = false %}
      {% if has_wholesaler_option and wholesaler_has_visible_value == false %}
        {% assign hide_purchase_controls = true %}
      {% endif %}

