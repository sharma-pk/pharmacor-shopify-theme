  <input
  class="API"
  type="hidden"
  name="properties[Wholesaler Account No.1]"
  value="{% if selected_seller_handle contains 'api' %}{{ seller_account_number }}{% endif %}"
>
<input class="Sigma" type="hidden" name="properties[Wholesaler Account No.2]" value="{% if selected_seller_handle contains 'sigma' %}{{ seller_account_number }}{% endif %}">
<input class="Symbion" type="hidden" name="properties[Wholesaler Account No.3]" value="{% if selected_seller_handle contains 'symbion' %}{{ seller_account_number }}{% endif %}">
<input class="Ch2" type="hidden" name="properties[Wholesaler Account No.4]" value="{% if selected_seller_handle contains 'ch2' %}{{ seller_account_number }}{% endif %}">
  <input id="" type="hidden" name="properties[Wholesaler Account No.]" value="">

