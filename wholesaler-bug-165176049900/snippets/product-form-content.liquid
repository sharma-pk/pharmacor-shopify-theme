  {% endcomment %}
  <!-- Add the delivery date picker -->
    {% comment %}
 <div id="variant-volume-discount" class="volume-discount-container" style="display:none;">
  <p class="volume-discount-title">BUY MORE, SAVE MORE</p>
  <div id="volume-discount-tiers"></div>
  </div>
{% endcomment %}

  {% assign selected_seller_handle = '' %}
  {% assign seller_account_number = '' %}
  {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}

  {% comment %} does this product have a Wholesaler option, and which brands does it actually offer? {% endcomment %}
  {% assign has_wholesaler_option = false %}
  {% assign wholesaler_has_visible_value = false %}
  {% assign product_offers_api = false %}
  {% assign product_offers_sigma = false %}
  {% assign product_offers_symbion = false %}
  {% assign product_offers_ch2 = false %}
  {% for pfc_option in product.options_with_values %}
    {% if pfc_option.name contains 'Wholesaler' %}
      {% assign has_wholesaler_option = true %}
      {% for pfc_value in pfc_option.values %}
        {% assign pfc_value_down = pfc_value | downcase %}
        {% if pfc_value_down contains 'api' %}{% assign product_offers_api = true %}{% endif %}
        {% if pfc_value_down contains 'sigma' %}{% assign product_offers_sigma = true %}{% endif %}
        {% if pfc_value_down contains 'symbion' %}{% assign product_offers_symbion = true %}{% endif %}
        {% if pfc_value_down contains 'ch2' %}{% assign product_offers_ch2 = true %}{% endif %}
        {% for pfc_item in coverage_countries %}
          {% assign pfc_item_down = pfc_item | downcase %}
          {% if pfc_item_down contains pfc_value_down %}
            {% assign wholesaler_has_visible_value = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% assign hide_purchase_controls = false %}
  {% if has_wholesaler_option and wholesaler_has_visible_value == false %}
    {% assign hide_purchase_controls = true %}
  {% endif %}

  {% if customer %}
    {% for item in coverage_countries %}
      {% assign clean_item = item | strip %}
      {% assign clean_item_down = clean_item | downcase %}

      {% comment %}
        When this product has its own Wholesaler option, only default to a
        brand it actually offers — otherwise this just falls back to whichever
        brand happens to be listed first in the customer's overall coverage,
        which could put a completely unrelated (and unused) brand's real
        account number into a hidden field the product never even exposes.
        Built from separate single-condition ifs (not "and"/"or" chained on
        one line) since Liquid's boolean operators don't follow normal
        precedence rules and can evaluate in surprising ways when mixed.
      {% endcomment %}
      {% assign api_eligible = false %}
      {% assign sigma_eligible = false %}
      {% assign symbion_eligible = false %}
      {% assign ch2_eligible = false %}
      {% if clean_item_down contains 'api' %}
        {% if has_wholesaler_option == false %}{% assign api_eligible = true %}{% endif %}
        {% if product_offers_api %}{% assign api_eligible = true %}{% endif %}
      {% elsif clean_item_down contains 'sigma' %}
        {% if has_wholesaler_option == false %}{% assign sigma_eligible = true %}{% endif %}
        {% if product_offers_sigma %}{% assign sigma_eligible = true %}{% endif %}
      {% elsif clean_item_down contains 'symbion' %}
        {% if has_wholesaler_option == false %}{% assign symbion_eligible = true %}{% endif %}
        {% if product_offers_symbion %}{% assign symbion_eligible = true %}{% endif %}
      {% elsif clean_item_down contains 'ch2' %}
        {% if has_wholesaler_option == false %}{% assign ch2_eligible = true %}{% endif %}
        {% if product_offers_ch2 %}{% assign ch2_eligible = true %}{% endif %}
      {% endif %}

      {% if api_eligible %}
        {% assign selected_seller_handle = 'api' %}
        {% assign seller_account_number = clean_item | remove_first: 'Api' | remove_first: 'API' | remove_first: 'api' | strip %}
        {% break %}
      {% elsif sigma_eligible %}
        {% assign selected_seller_handle = 'sigma' %}
        {% assign seller_account_number = clean_item | remove_first: 'Sigma' | remove_first: 'SIGMA' | remove_first: 'sigma' | strip %}
        {% break %}
      {% elsif symbion_eligible %}
        {% assign selected_seller_handle = 'symbion' %}
        {% assign seller_account_number = clean_item | remove_first: 'Symbion' | remove_first: 'SYMBION' | remove_first: 'symbion' | strip %}
        {% break %}
      {% elsif ch2_eligible %}
        {% assign selected_seller_handle = 'ch2' %}
        {% assign seller_account_number = clean_item | remove_first: 'Ch2' | remove_first: 'CH2' | remove_first: 'ch2' | strip %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}


  {% liquid
    assign section_contains_quantity_block = false
    assign gift_card_recipient_feature_active = false

    if product.gift_card? and block.settings.show_gift_card_recipient
      assign gift_card_recipient_feature_active = true
    endif

    assign button_type = block.settings.button_type
  %}

  {% if gift_card_recipient_feature_active %}
    {%- assign gift_card_recipient_control_flag = 'properties[__shopify_send_gift_card_to_recipient]' -%}

    <div class="recipient-form">
      <div class="recipient-form__checkbox-field">
        <input
          id="Recipient-checkbox-{{ section.id }}"
          class="checkbox recipient-form__checkbox js-recipient-form-checkbox"
          type="checkbox"
          name="{{ gift_card_recipient_control_flag }}"
          disabled
        >

        <label for="Recipient-checkbox-{{ section.id }}" class="checkbox-label">
          <span class="checkbox-label__box "></span>
          {{ 'products.product.recipient.form.checkbox' | t }}
        </label>
      </div>

      <div class="recipient-form__fields is-hidden js-recipient-form-fields">
        <div class="recipient-form__field">
          <label class="label-input" for="Recipient-email-{{ section.id }}">
            <span class="recipient-form__label-normal">{{ 'products.product.recipient.form.email_label' | t }}</span>
            <span class="recipient-form__label-no-js">
              {{- 'products.product.recipient.form.email_label_optional_for_no_js_behavior' | t -}}
            </span>
          </label>

          <input
            class="input js-recipient-form-field"
            id="Recipient-email-{{ section.id }}"
            type="email"
            placeholder="Recipient email"
            name="properties[Recipient email]"
            value="{{ form.email }}"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-email-error-{{ section.id }}"
            {% endif %}
          >

          <div
            id="RecipientForm-email-error-{{ section.id }}"
            class="error js-form-error{% unless form.errors contains 'email' %} is-hidden{% endunless %}"
          >
            {%- if form.errors contains 'email' -%}
              {{ form.errors.messages.email }}.
            {%- endif -%}
          </div>
        </div>

        <div class="recipient-form__field">
          <label class="label-input" for="Recipient-name-{{ section.id }}">
            {{- 'products.product.recipient.form.name_label' | t -}}
          </label>

          <input
            class="input js-recipient-form-field"
            autocomplete="name"
            type="text"
            id="Recipient-name-{{ section.id }}"
            name="properties[Recipient name]"
            placeholder="{{ 'products.product.recipient.form.name' | t }}"
            value="{{ form.name }}"
            {% if form.errors contains 'name' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-name-error-{{ section.id }}"
            {% endif %}
          >

          <div
            id="RecipientForm-name-error-{{ section.id }}"
            class="error js-form-error {% unless form.errors contains 'name' %} is-hidden{% endunless %}"
          >
            {%- if form.errors contains 'name' -%}
              {{ form.errors.messages.name }}.
            {%- endif -%}
          </div>
        </div>

        <div class="recipient-form__field">
          {%- assign max_chars_message = 200 -%}
          {%- assign max_chars_message_rendered = 'products.product.recipient.form.max_characters'
            | t: max_chars: max_chars_message
          -%}
          {%- assign message_label_rendered = 'products.product.recipient.form.message_label' | t -%}

          <label class="label-input" for="Recipient-message-{{ section.id }}">
            {{ message_label_rendered }}
          </label>

          <textarea
            rows="10"
            id="Recipient-message-{{ section.id }}"
            class="recipient-form__textarea input js-recipient-form-field"
            name="properties[Message]"
            maxlength="{{ max_chars_message }}"
            placeholder="{{ 'products.product.recipient.form.message' | t }}"
            aria-label="Max characters 200"
            {% if form.errors contains 'message' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-message-error-{{ section.id }}"
            {% endif %}
          >{{- form.message -}}</textarea>

          <div class="recipient-form__input-info">{{ max_chars_message_rendered }}</div>

          <div
            id="RecipientForm-message-error-{{ section.id }}"
            class="error js-form-error{% unless form.errors contains 'message' %} is-hidden{% endunless %}"
          >
            {%- if form.errors contains 'message' -%}
              {{ form.errors.messages.message }}.
            {%- endif -%}
          </div>
        </div>

        <div class="recipient-form__field">
          <label class="label-input" for="Recipient-send_on-{{ section.id }}">
            {{ 'products.product.recipient.form.send_on_label' | t }}
          </label>

          <input
            class="input js-recipient-form-field"
            autocomplete="off"
            type="date"
            id="Recipient-send_on-{{ section.id }}"
            name="properties[Send on]"
            pattern="\d{4}-\d{2}-\d{2}"
            value="{{ form.send_on }}"
            {% if form.errors contains 'send_on' %}
              aria-invalid="true"
              aria-describedby="RecipientForm-send_on-error-{{ section.id }}"
            {% endif %}
          >

          <div
            id="RecipientForm-send_on-error-{{ section.id }}"
            class="error js-form-error {% unless form.errors contains 'send_on' %} is-hidden{% endunless %}"
          >
            {%- if form.errors contains 'send_on' -%}
              {{ form.errors.messages.send_on }}.
            {%- endif -%}
          </div>
        </div>
      </div>

      <input
        type="hidden"
        name="{{ gift_card_recipient_control_flag }}"
        value="if_present"
        id="Recipient-control-{{ section.id }}"
        class="js-recipient-form-no-js-control"
      >

      <input
        type="hidden"
        name="properties[__shopify_offset]"
        value=""
        id="Recipient-timezone-offset-{{ section.id }}"
        class="js-recipient-form-timezone-offset"
      >
    </div>
  {% endif %}
  {% comment %}
     {% if product.template_suffix == 'pre-order' %}
