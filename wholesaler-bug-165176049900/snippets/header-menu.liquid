</style>
{%- assign burger_menu_button_class = '' -%}
{%- assign item_text_class = '' -%}
{%- assign item_class = '' -%}
{%- assign list_class = '' -%}

{%- if menu_style_type == 'secondary' %}
  {%- assign burger_menu_button_class = 'header-burger-menu-button--secondary' -%}
  {%- assign item_text_class = 'header-menu__item-text--secondary' -%}
  {%- assign item_class = 'header-menu__item--secondary' -%}
{%- endif -%}

{%- if menu_position == 'middle' -%}
  {%- assign list_class = 'header-menu__list--middle' -%}
{%- endif -%}

<nav
  class="header-menu"
  aria-label="{{- "layout.navigation.main_menu" | t | escape -}}"
>
  <ul class="header-menu__list header-menu__list--main {{ list_class -}}">
    {%- if enable_burger_menu == true -%}
      <li>
        <button
          class="header-burger-menu-button {{ burger_menu_button_class -}}"
          aria-label="{{ "layout.navigation.open_drawer_menu" | t | escape }}"
          data-multi-drawer-toggle="HeaderBurgerMenu"
          data-drawer-level="1"
          aria-expanded="false"
          aria-controls="HeaderBurgerMenuMain"
        >
          {%- render 'icons', icon: 'burger-menu-main' -%}

          <span class="header-burger-menu-button__label">
            {{ 'layout.navigation.main_drawer_menu_button_label' | t }}
          </span>
        </button>
      </li>
    {%- endif -%}

    {%- for first_level_link in menu.links -%}
      {%- assign has_megamenu = false -%}
      {%- assign megamenu_object = '' -%}
      {%- assign item_class_highlighted = '' -%}
      {%- assign item_text_class_highlighted = '' -%}

      {%- if first_level_link.title == menu_highlighted_link_name -%}
        {%- assign item_class_highlighted = 'header-menu__item--highlighted' -%}
        {%- assign item_text_class_highlighted = 'header-menu__item-text--highlighted' -%}
      {%- endif -%}

      {%- for block in blocks -%}
        {%- if block.type != 'megamenu-brands-logo' -%}
          {%- assign menu_handle = block.settings.menu_handle | handleize -%}

          {%- if first_level_link.handle == menu_handle -%}
            {% if block.type == 'megamenu' or block.type == 'megamenu-row-menus' or block.type == 'megamenu-brands' %}
              {%- if first_level_link.links != blank -%}
                {%- assign has_megamenu = true -%}
                {%- assign megamenu_object = block -%}

                {%- break -%}
              {%- endif -%}
            {%- else -%}
              {%- assign has_megamenu = true -%}
              {%- assign megamenu_object = block -%}

              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <li
        {% if has_megamenu == true or first_level_link.links != blank %}
          class="js-header-dropdown-menu-element"
        {% endif %}
      >
        {%- capture megamenu -%}

					{%- if megamenu_object.type == 'megamenu' and has_megamenu == true -%}
						{%- render 'header-mega-menu', menu: first_level_link, megamenu_object: megamenu_object, enable_rounded_header: enable_rounded_header -%}
					{%- endif -%}

					{%- if megamenu_object.type == 'megamenu-images' and has_megamenu == true -%}
						{%- render 'header-mega-menu-images', menu: first_level_link, megamenu_object: megamenu_object, enable_rounded_header: enable_rounded_header -%}
					{%- endif -%}

					{%- if megamenu_object.type == 'megamenu-row-menus' and has_megamenu == true -%}
						{%- render 'header-mega-menu-row-menus', menu: first_level_link, megamenu_object: megamenu_object, enable_rounded_header: enable_rounded_header -%}
					{%- endif -%}

					{%- if megamenu_object.type == 'megamenu-brands' and has_megamenu == true -%}
						{%- assign brands_logos_blocks = section.blocks | where: 'type', 'megamenu-brands-logo' -%}

						{%- render 'header-mega-menu-brands', menu: first_level_link, megamenu_object: megamenu_object, blocks: brands_logos_blocks, enable_rounded_header: enable_rounded_header -%}
					{%- endif -%}

					{%- if megamenu_object.type == 'megamenu-half-to-half' and has_megamenu == true -%}
						{%- if megamenu_object.settings.heading == blank and megamenu_object.settings.subheading == blank and megamenu_object.settings.image == blank -%}
							{%- assign has_megamenu = false -%}
						{%- else -%}
							{%- render 'header-mega-menu-half-to-half', menu: first_level_link, megamenu_object: megamenu_object, enable_rounded_header: enable_rounded_header -%}
						{%- endif -%}
					{%- endif -%}
				{%- endcapture -%}

        {%- if megamenu != blank and menu_type_desktop == 'megamenu' or menu_type_desktop == 'both' -%}
          <a
            class="header-menu__item  custombb {{ item_class }} {{ item_class_highlighted }} {%- if first_level_link.active %} header-menu__item--active{% endif %} no-js"
            href="{{- first_level_link.url -}}"
            {% if first_level_link.current %}
              aria-current="page"
            {% endif %}
          >
            <span class="header-menu__item-text {{ item_text_class }} {{ item_text_class_highlighted }}">
              {{ first_level_link.title | escape }}
            </span>
          </a>

          <button
            class="header-menu__item {{ item_class }} {{ item_class_highlighted }} {% if first_level_link.child_active %} header-menu__item--active{% endif %} js-header-mega-menu-toggler"
            type="button"
            data-target="headerMegaMenu:{{- first_level_link.title | handleize -}}"
            aria-controls="headerMegaMenu:{{- first_level_link.title | handleize -}}"
            aria-expanded="false"
            {% if megamenu_object.type == 'megamenu-brands' %}
              data-brands-drawer
            {%- endif -%}
          >
            <span class="header-menu__item-text {{ item_text_class }} {{ item_text_class_highlighted }}">
              {{ first_level_link.title | escape }}
            </span>

            {% assign badge_text = megamenu_object.settings.badge_text %}
            {% assign badge_text_color = megamenu_object.settings.badge_text_color %}
            {% assign badge_background_color = megamenu_object.settings.badge_background_color %}

            {%- if badge_text != blank -%}
              <span
                class="header-menu__item-badge"
                style="--header-background: {{ header_bg -}}; --badge-text-color: {{ badge_text_color }}; --badge-background-color: {{ badge_background_color }};"
              >
                {{- badge_text -}}
              </span>
            {%- endif -%}

            <span class="header-menu__item-toggle-icon">
              {%- render 'icons', icon: 'arrow-down' -%}
            </span>
          </button>

          {{- megamenu -}}
        {%- elsif first_level_link.links != blank and menu_type_desktop == 'dropdown' or menu_type_desktop == 'both' -%}
          <a
            class="header-menu__item customdd {{ item_class }} {{ item_class_highlighted }} {%- if first_level_link.active %} header-menu__item--active{% endif %} no-js"
            href="{{- first_level_link.url -}}"
            {% if first_level_link.current %}
              aria-current="page"
            {% endif %}
          >
            <span class="header-menu__item-text  {{ item_text_class }} {{ item_text_class_highlighted }}">
              {{ first_level_link.title | escape }}
            </span>
          </a>

          <button
            class="header-menu__item {{ item_class }} {{ item_class_highlighted }} {% if first_level_link.child_active %} header-menu__item--active{% endif %} js-header-dropdown-menu-toggler"
            type="button"
            data-target="headerDesktopMenu:{{- first_level_link.title | handleize -}}"
            aria-controls="headerDesktopMenu:{{- first_level_link.title | handleize -}}"
            aria-expanded="false"
          >
            <span class="header-menu__item-text  {{ item_text_class }} {{ item_text_class_highlighted }}">
              {{ first_level_link.title | escape }}
            </span>

            <span class="header-menu__item-toggle-icon">
              {%- render 'icons', icon: 'arrow-down' -%}
            </span>
          </button>

          <ul
            id="headerDesktopMenu:{{- first_level_link.title | handleize -}}"
            class="header-menu__list header-menu__list--nested js-header-dropdown-menu {% if first_level_link.levels == 2 %}js-accordion-container{% endif %}"
          >
            {%- for second_level_link in first_level_link.links -%}
              <li class="accordion__item {% if second_level_link.links != blank %}js-accordion-item{%- endif -%}">
                {%- if second_level_link.links != blank -%}
                  <button class="header-menu__item js-accordion-control {%- if second_level_link.child_active %} header-menu__item--active{%- endif -%}">
                    {{- second_level_link.title | escape -}}

                    <span class="header-menu__item-toggle-icon">
                      {%- render 'icons', icon: 'arrow-down' -%}
                    </span>
                  </button>

                  <div class="accordion__content accordion__content--animate js-accordion-content">
                    <ul class="header-menu__list header-menu__list--collapsible js-accordion-inner">
                      {%- for third_level_link in second_level_link.links -%}
                        <li>
                          <a
                            class="header-menu__item"
                            href="{{- third_level_link.url -}}"
                            {% if third_level_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- third_level_link.title -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- else -%}
                  <a
                    class="header-menu__item customreee"
                    href="{{- second_level_link.url -}}"
                    {% if second_level_link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- second_level_link.title -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <a
            class="header-menu__item custom-title{{ first_level_link.title | handleize }} {{ item_class }} {{ item_class_highlighted }} {%- if first_level_link.active %} header-menu__item--active{% endif %}"
            href="{{- first_level_link.url -}}"
            {% if first_level_link.current %}
              aria-current="page"
            {% endif %}
          >
            <span class="header-menu__item-text  {{ item_text_class }} {{ item_text_class_highlighted }}">
              {{ first_level_link.title | escape }}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}

    {% if customer %}
      <li class="js-header-dropdown-menu-element wholesellercontainer">
        <button
          class="header-menu__item js-header-mega-menu-toggler"
          type="button"
          data-target="headerMegaMenu:shop-Wholsale"
          aria-expanded="false"
        >
          <span class="header-menu__item-text">My Wholesaler</span>
          <span class="header-menu__item-toggle-icon">
            {%- render 'icons', icon: 'arrow-down' -%}
          </span>
        </button>

        <div id="headerMegaMenu:shop-Wholsale" class="header-mega-menu js-header-mega-menu is-hidden">
          <div class="header-mega-menu__container js-header-mega-menu-content" style="--megamenu-background: #ffffff;">
            <div class="header-mega-menu__content-container">
              <div class="header-mega-menu__block header-mega-menu__block--menu">
                {% comment %}
                  <ul id="myUlSelect1" class="header-mega-menu__menu">
                    <li data-value="1" id="api" value="api"{% if firstwholeseller %} selected{% endif %} class="header-mega-menu__menu-item header-mega-menu__menu-item--parent customapi q header-mega-menu__menu-item-wrapper">api</li>
                    <li data-value="2" id="sigma" value="sigma"{% if firstwholeseller2 %} selected{% endif %} class="header-mega-menu__menu-item header-mega-menu__menu-item--parent customsigma q header-mega-menu__menu-item-wrapper">sigma</li>
                    <li data-value="3" id="symbion" value="symbion"{% if firstwholeseller3 %} selected{% endif %} class="header-mega-menu__menu-item header-mega-menu__menu-item--parent customsymbion q header-mega-menu__menu-item-wrapper">symbion</li>
                    <li data-value="4" id="ch2" value="ch2" {% if firstwholeseller4 %} selected{% endif %} class="header-mega-menu__menu-item header-mega-menu__menu-item--parent customch2 q header-mega-menu__menu-item-wrapper">
                      ch2

                    </li>
                  </ul>
                {% endcomment %}
                <div class="main-wraper">
                  <ul class="wholeseller-wraper">
                    {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
                    {% assign coverage_data = coverage_countries | join: ',' | downcase %}

                    {% comment %} was referenced but never assigned, so nothing was ever checked before JS ran — now uses cart-reconciliation's API>Sigma>Symbion>CH2 priority {% endcomment %}
                    {% assign firstwholeseller = false %}
                    {% assign firstwholeseller2 = false %}
                    {% assign firstwholeseller3 = false %}
                    {% assign firstwholeseller4 = false %}
                    {% if coverage_data contains 'api' %}
                      {% assign firstwholeseller = true %}
                    {% elsif coverage_data contains 'sigma' %}
                      {% assign firstwholeseller2 = true %}
                    {% elsif coverage_data contains 'symbion' %}
                      {% assign firstwholeseller3 = true %}
                    {% elsif coverage_data contains 'ch2' %}
                      {% assign firstwholeseller4 = true %}
                    {% endif %}

                    {% if coverage_data contains 'api' %}
                      <li>
                        <input
                          type="radio"
                          id="api"
                          name="wholeseller"
                          value="api"
                          {% if firstwholeseller %}
                            checked
                          {% endif %}
                          class="radio-input"
                        >
                        <label for="api" class="customwdata">API</label>
                      </li>
                    {% endif %}

                    {% if coverage_data contains 'sigma' %}
                      <li>
                        <input
                          type="radio"
                          id="sigma"
                          name="wholeseller"
                          value="sigma"
                          {% if firstwholeseller2 %}
                            checked
                          {% endif %}
                          class="radio-input"
                        >
                        <label for="sigma" class="customwdata">Sigma</label>
                      </li>
                    {% endif %}

                    {% if coverage_data contains 'symbion' %}
                      <li>
                        <input
                          type="radio"
                          id="symbion"
                          name="wholeseller"
                          value="symbion"
                          {% if firstwholeseller3 %}
                            checked
                          {% endif %}
                          class="radio-input"
                        >
                        <label for="symbion" class="customwdata custom__symbion">Symbion</label>
                      </li>
                    {% endif %}

                    {% if coverage_data contains 'ch2' %}
                      <li>
                        <input
                          type="radio"
                          id="ch2"
                          name="wholeseller"
                          value="ch2"
                          {% if firstwholeseller4 %}
                            checked
                          {% endif %}
                          class="radio-input"
                        >
                        <label for="ch2" class="customwdata">CH2</label>
                      </li>
                    {% endif %}
                  </ul>

                  <div class="wholeseller desktopseller">
                    {% if customer %}
                      {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
                      <ul class="header-mega-menu__menu">
                        {% for item in coverage_countries %}
                    
                          {% assign selleritem = item | downcase | replace: ' ', '' %}

                          <li class="wholwseller-item" data-value="{{ selleritem }}">
                            <input
                              type="radio"
                              id="country-{{ forloop.index }}"
                              name="{%if selleritem contains 'api' %} api{%endif%}{%if selleritem contains 'sigma'%}sigma {% endif %}{%if selleritem contains 'symbion'%}symbion{% endif %}{%if  selleritem contains 'ch2'%}ch2{% endif %}"
                              value="{{ selleritem  }}"
                              class="wholwseller-input {%if selleritem contains 'api' %} customapi{%endif%}{%if selleritem contains 'sigma'%}customsigma {% endif %}{%if selleritem contains 'symbion'%}customsymbion{% endif %}{%if  selleritem contains 'ch2'%}customch2{% endif %}"
                              itemnumber="
                                {% assign cleaned_item = selleritem
                                  | remove: 'api'
                                  | remove: 'sigma'
                                  | remove: 'symbion'
                                  | remove: 'ch2'
                                  | remove: 'API'
                                  | remove: 'Sima'
                                  | remove: 'Symbion'
                                  | remove: 'CH2'
                                %}
                                {{ cleaned_item }}
                              "
                            >
                            <label for="country-{{ forloop.index }}" class="wholwseller-label {{selleritem }}">
                              {% assign cleaned_item = selleritem
                                | remove: 'api'
                                | remove: 'sigma'
                                | remove: 'symbion'
                                | remove: 'ch2'
                                | remove: 'API'
                                | remove: 'Sima'
                                | remove: 'Symbion'
                                | remove: 'CH2'
                              %}
                              {{ cleaned_item }}
                            </label>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>

                <style>
                  .wholwseller-item { display: none; } /* hide all by default */
                  .wholwseller-item.active { display: list-item; }
                </style>

                <script>
                  document.addEventListener('DOMContentLoaded', function () {
                    const radios = document.querySelectorAll('input[name="wholeseller"]');
                    const items = document.querySelectorAll('.wholwseller-item');

                    // restore last saved selection from localStorage
                    const saved = localStorage.getItem('selected_wholeseller');
                    if (saved) {
                      const savedRadio = document.querySelector(`input[name="wholeseller"][value="${saved}"]`);
                      if (savedRadio) {
                        savedRadio.checked = true;
                      }
                    }

                    function updateVisible() {
                      let selected = document.querySelector('input[name="wholeseller"]:checked')?.value;
                      if (selected) {
                        // save current selected in localStorage
                        localStorage.setItem('selected_wholeseller', selected);
                      }

                      items.forEach((item) => {
                        if (selected && item.dataset.value.includes(selected)) {
                          item.classList.add('active');
                        } else {
                          item.classList.remove('active');
                        }
                      });

                      // brand click alone only reveals matching numbers — make sure one is actually selected too
                      if (selected) {
                        const checkedInput = document.querySelector('.wholwseller-input:checked');
                        const checkedMatchesBrand = checkedInput && checkedInput.closest('.wholwseller-item')?.dataset.value.includes(selected);
                        if (!checkedMatchesBrand) {
                          // prefer this brand's own remembered number over just the first one, so switching brands and back doesn't lose a previous pick
                          const rememberedNumber = (typeof getLiveWholesalerNumberForBrand === 'function') ? getLiveWholesalerNumberForBrand(selected) : '';
                          // scoped to .wholwseller-item.active only (this brand's own visible numbers), so a number that happens to match a different brand's number can't be picked instead
                          const activeCandidates = document.querySelectorAll('.wholwseller-item.active .wholwseller-input');
                          let target = (rememberedNumber && typeof findWholesellerInputByNumber === 'function')
                            ? findWholesellerInputByNumber(rememberedNumber, activeCandidates)
                            : null;
                          target = target || document.querySelector('.wholwseller-item.active .wholwseller-input');
                          if (target) {
                            target.checked = true;
                            target.dispatchEvent(new Event('change', { bubbles: true }));
                          }
                        }
                      }
                    }

                    radios.forEach((radio) => {
                      radio.addEventListener('change', updateVisible);
                    });

                    updateVisible(); // run on page load
                  });
                  const saved = localStorage.getItem('selected_wholeseller');

                  if (saved) {
                    const savedRadio = document.querySelector(`input[name="wholeseller"][value="${saved}"]`);
                    if (savedRadio) {
                      savedRadio.checked = true;
                    }
                  }
                </script>
              </div>
            </div>
          </div>
        </div>
      </li>
    {% endif %}
  </ul>
</nav>

{% assign wholesaler_coverage = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
<script>
  // Live coverage for the CURRENT company, recomputed on every page load —
  // never trust a cached wholesaler value that isn't in this list, so a
  // wholesaler-account change on the company takes effect immediately.
  window.__wholesalerCoverage = [
    {%- for item in wholesaler_coverage -%}
      "{{ item | downcase | escape }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  // isWholesalerCovered() itself lives in assets/wholesaler-shared.js, loaded in <head>.
</script>
<script>
 document.addEventListener('DOMContentLoaded', function () {
  // Function to handle storage for a specific class
  function handleWholesellerStorage(className, storageKey) {
    const inputs = document.querySelectorAll(`.${className}`);

    inputs.forEach((input) => {
      input.addEventListener('change', function () {
        if (this.checked) {
          localStorage.setItem(storageKey, this.value);
        }
      });
    });

    // Restore on page load
    const savedValue = localStorage.getItem(storageKey);

    if (savedValue && !isWholesalerCovered(savedValue)) {
      // Cached value no longer matches this company's current wholesaler
      // accounts (e.g. account was switched from Sigma to Symbion) — clear
      // it instead of restoring stale/invalid data.
      localStorage.removeItem(storageKey);
    } else if (savedValue) { // <-- check if not null
      if (savedValue.includes('api')) {
        const inputEl = document.querySelector('.api');
        if (inputEl) inputEl.value = savedValue;
      }

      if (savedValue.includes('sigma')) {
        const sigmaElements = document.querySelectorAll('.custom_product-section .sigma');
        sigmaElements.forEach(el => el.value = savedValue); // NodeList needs forEach
      }

      if (savedValue.includes('symbion')) {
        const inputEl = document.querySelector('.symbion');
        if (inputEl) inputEl.value = savedValue;
      }

      if (savedValue.includes('ch2')) {
        const inputEl = document.querySelector('.ch2');
        if (inputEl) inputEl.value = savedValue;
      }

      // Restore checked state (CSS.escape guards against values with raw newlines/whitespace)
      const savedInput = document.querySelector(`.${className}[value="${CSS.escape(savedValue)}"]`);
      if (savedInput) savedInput.checked = true;
    }
  }

  // Call for each wholeseller type
  handleWholesellerStorage('customapi', 'selected_api');
  handleWholesellerStorage('customsigma', 'selected_sigma');
  handleWholesellerStorage('customsymbion', 'selected_symbion');
  handleWholesellerStorage('customch2', 'selected_ch2');
});


