{%- comment -%}
  ------------------------------------------------------------------------------
  Snippet: Header menu
  Render header menu
  - menu: menu object;
  - menu_type_desktop: type of rendered menu, dropdown menu or mega menu;
  - blocks: transfer block object;
  - menu_style_type: type of rendered menu (secondary);
  - menu_position: position of rendered menu (center);
  - enable_rounded_header: enable rounded header;
  - menu_highlighted_link_name: menu highlighted link name;
  - enable_burger_menu: enable burger menu (true/false).
  - enable_roundwholeselerinfoed_header: enable rounded header (true/false).

  Usage:
  {%- render 'header-menu' -%}
  ------------------------------------------------------------------------------
{%- endcomment -%}
<style>
  .wholeseller-wraper {
    height: fit-content;
  }
    /* Hide number input arrows for Chrome, Safari, Edge, Opera */
    .product-quantity__input2::-webkit-outer-spin-button,
    .product-quantity__input2::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    /* Hide number input arrows for Firefox */
    .product-quantity__input2[type=number] {
      -moz-appearance: textfield;
    }

      .wholwseller-input:checked + label {
                     border-color: #599d61;
                     background-color: #599d61;
                 color: #fff;
                   }
      .wholwseller-input{
                       visibility: hidden;
                       position: absolute;
                     }

                     .radio-input:checked + label {
                     border-color: #599d61;
                     background-color: #599d61;
                 color: #fff;
                   }
