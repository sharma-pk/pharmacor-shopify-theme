  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const runCookieName = 'wholesaler_script_ran'; // cookie that prevents re-running after user click
      const selectedCookieName = 'wholesaler_selected_number';
      const defaultNumber = '{{ wholesaler_number | escape }}';
      const cookieDays = 365;

      // --- Cookie helpers ---
      function setCookie(name, value, days) {
        let expires = '';
        if (days) {
          const date = new Date();
          date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
          expires = '; expires=' + date.toUTCString();
        }
        document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/';
      }

      function getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
          let c = ca[i].trim();
          if (c.indexOf(nameEQ) === 0) return decodeURIComponent(c.substring(nameEQ.length));
        }
        return null;
      }

      function deleteCookie(name) {
        document.cookie = name + '=; Max-Age=0; path=/';
      }

      // --- Helper: which brand a per-number input belongs to (from its custom{brand} class) ---
      function getBrandFromWholesellerInput(inputEl) {
        if (inputEl.classList.contains('customapi')) return 'api';
        if (inputEl.classList.contains('customsigma')) return 'sigma';
        if (inputEl.classList.contains('customsymbion')) return 'symbion';
        if (inputEl.classList.contains('customch2')) return 'ch2';
        return null;
      }

      // --- Helper: activate input + item (uncheck-all-first, so a stale browser-restored checked state can't linger) ---
      // note: visibility (.active) is owned by updateVisible() based on brand match, covering every same-brand
      // number — this only marks which specific number is the checked/highlighted one among those shown.
      function activateInput(inputEl) {
        if (!inputEl) return;
        document.querySelectorAll('.wholwseller-input').forEach((el) => { el.checked = false; });
        inputEl.checked = true;
        document.querySelectorAll('.wholwseller-item').forEach((li) => li.classList.remove('wholwseller-selected'));
        const li = inputEl.closest('.wholwseller-item');
        if (li) li.classList.add('wholwseller-selected');

        // keep the brand-level radio (and its number-pill visibility filter) in sync with this pick —
        // always dispatch, even if already checked, so updateVisible() re-shows every number for this brand
        const brand = getBrandFromWholesellerInput(inputEl);
        const brandRadio = brand && document.querySelector('input[name="wholeseller"][value="' + brand + '"]');
        if (brandRadio) {
          brandRadio.checked = true;
          brandRadio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      // --- Move checked item to top (works on load and after change) ---
      function moveCheckedToTop() {
        const checkedInput = document.querySelector('.wholwseller-input:checked');
        if (checkedInput) {
          const li = checkedInput.closest('.wholwseller-item');
          const parent = li?.parentElement;
          if (li && parent && parent.firstElementChild !== li) {
            parent.insertBefore(li, parent.firstElementChild);
          }
        }
      }

      // findWholesellerInputByNumber lives in assets/wholesaler-shared.js (loaded before this script) — single definition, used both here and in the remembered-number restore above

      // --- Determine active number and activate corresponding input (re-validated every load, not just once) ---
      const savedNumber = (getCookie(selectedCookieName) || '').trim() || null;
      const activeNumber = savedNumber || defaultNumber;

      let input = activeNumber ? findWholesellerInputByNumber(activeNumber) : null;

      if (!input) {
        // nothing resolvable from cookie/default (stale, cleared, or blank) — clear any stale cookie and fall back,
        // preferring another number under the same brand before jumping to a different brand entirely
        if (savedNumber) deleteCookie(selectedCookieName);
        const lastBrand = localStorage.getItem('selected_wholeseller');
        input = (defaultNumber && findWholesellerInputByNumber(defaultNumber))
          || (lastBrand && document.querySelector('.wholwseller-input.custom' + lastBrand))
          || document.querySelector('.wholwseller-input');
      }

      if (input) {
        activateInput(input);
        const freshNumber = input.getAttribute('itemnumber');
        if (freshNumber) setCookie(selectedCookieName, freshNumber.trim(), cookieDays);
      }

      // --- Ensure UI puts checked item first on load (covers dynamic checking) ---
      moveCheckedToTop();
      setTimeout(moveCheckedToTop, 300);

      // --- When user clicks a different option ---
      document.querySelectorAll('.wholwseller-input').forEach((inp) => {
        inp.addEventListener('change', function () {
          // activate visually
          activateInput(this);
          // no moveCheckedToTop() here — it moves the clicked <li> in the DOM, which drops :hover on a hover-opened menu and closes it mid-interaction; still runs on page load above, before the menu is open

          // store chosen number cookie
          const selectedNumber = (this.getAttribute('itemnumber') || '').trim();
          if (selectedNumber) setCookie(selectedCookieName, selectedNumber, cookieDays);

          // set run cookie so this initialization doesn't run again on reload
          // (use long expiry so it persists across sessions)
          setCookie(runCookieName, '1', cookieDays);

          if (typeof applyWholesalerNumberOverride === 'function') applyWholesalerNumberOverride();
        });
      });
    });

    // --- Optional: helper available even if above early-return happened ---
    function moveCheckedToTop() {
      const checkedInput = document.querySelector('.wholwseller-input:checked');
      if (checkedInput) {
        const li = checkedInput.closest('.wholwseller-item');
        const parent = li?.parentElement;
        if (li && parent && parent.firstElementChild !== li) {
          parent.insertBefore(li, parent.firstElementChild);
        }
      }
    }
  </script>
