                padding: 2px 30px;
                border-radius: 20px;
                margin: 2px 0px;
                width: 100%;
          cursor: pointer;
              }
        .wholwseller-item.active.whoelactive {
               background-color: #599d61;
        }
                       .wholeseller-wraper{width: 100%;margin-right: 16px;}
                         .main-wraper {
                           display: flex;
                         }
                           .wholeselerinfo {
                             width: 100%;
                             text-align: center;
                             display: none;
                             color: #e60202;
                             animation: blink 3s ease-in-out infinite;
                           }

                           @keyframes blink {
                             0%, 100% { opacity: 1; }
                             50% { opacity: 0; }
