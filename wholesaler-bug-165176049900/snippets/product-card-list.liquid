<div class="custom-main-inner-wrap collection__item customitem{{ indxlast }}" style="width: 100%;" itemidex="{{ lastIndex }}">
{% for variant in product.variants %} 
  <input type="hidden" class="procustom{{ variant.id | handleize }} {{ variant.title | handleize }}" compareprice="{{ variant.compare_at_price | money }}" varienrprice="{{ variant.price | money }}" varientquentity="{{ variant.inventory_quantity }}" myvarientid="{{ variant.id }}" varienrcompprice="{{ variant.compare_at_price | money }}"
     variantprofit=" {% if variant.compare_at_price > variant.price %}
  {% assign price_difference = variant.compare_at_price | minus: variant.price %}
  {% assign profit_percentage = price_difference | times: 100.0 | divided_by: variant.compare_at_price %}
  {{ profit_percentage | round: 2 }}%
{% endif %}">
{% endfor %}

<div class="custom_product-section">
  <div class="custom-list-image">
    <a href="{{ product.url }}">
    <img src="{{ product.featured_image | img_url: 'large' }}" alt="Product Image" style="width: 100%; padding: 10px;">
    </a>
  </div>
    <div class="custom-list-product-name">
      <a href="{{ product.url }}">
        <span class="custom_badge" style="gap: 10px; display: flex;">
      {%- for tag in product.tags -%}
		{%- if tag contains 'label__' -%}
			{%- assign class = 'product-card__label' -%}

			{%- if tag contains ':primary' -%}
				{%- assign class = class | append: " product-card__label--primary" | strip -%}
			{%- elsif tag contains ':secondary' -%}
				{%- assign class = class | append: " product-card__label--secondary" | strip -%}
			{%- endif -%}

			{%- assign clipped_tag = tag | remove: 'label__' | remove: ':primary' | remove: ':secondary' -%}
 {% if clipped_tag != blank %}
			<li	class="{{- class -}}" style="background-color: #4caf50; padding: 4px 6px;  border-radius: 5px;margin-bottom: 2px; list-style: none;">
				<span class="visually-hidden">
					{{- 'products.product_card.product_label' | t -}}:
				</span>

				{{- clipped_tag -}}
			</li>
{% endif %}
			{%- assign tag_index = tag_index | plus: 1 -%}

			{%- if tag_index > 3 -%}
				{%- break -%}
			{%- endif -%}
		{%- endif -%}
	{%- endfor -%}
        </span>
        <div class="product-name">{{ product.title }}</div>
        
    </a>
        <div class="customquickview" prohandle="{{ product.handle }}" data-product-card-handle="{{ product.handle }}">
<svg xmlns="http://www.w3.org/2000/svg" 
     width="24" height="24" viewBox="0 0 24 24" 
     fill="none" stroke="#5a9d62" stroke-width="2" 
     stroke-linecap="round" stroke-linejoin="round" 
     class="feather feather-eye">
  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
  <circle cx="12" cy="12" r="3"></circle>
</svg>

  </div>
    </div>
  {% assign hidden_value = '' %}
  {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
  {% comment %} does this product have a Wholesaler option, and does any value survive coverage filtering? {% endcomment %}
  {% assign has_wholesaler_option = false %}
  {% assign wholesaler_has_visible_value = false %}
  {% for pcl_option in product.options_with_values %}
    {% if pcl_option.name contains 'Wholesaler' %}
      {% assign has_wholesaler_option = true %}
      {% for pcl_value in pcl_option.values %}
        {% assign pcl_value_up = pcl_value | upcase %}
        {% for pcl_item in coverage_countries %}
          {% assign pcl_item_up = pcl_item | upcase %}
          {% if pcl_item_up contains pcl_value_up %}
            {% assign wholesaler_has_visible_value = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {% assign hide_purchase_controls = false %}
  {% if has_wholesaler_option and wholesaler_has_visible_value == false %}
    {% assign hide_purchase_controls = true %}
  {% endif %}
  <div class="custom-list-wholesaler">
      {% for option in product.options_with_values %}
        {% if option.name contains 'Wholesaler' and hide_purchase_controls %}
          <span class="custom-list-wholesaler-placeholder custom_dropdown" style="font-weight:400;color:#8a8a8a;">No wholesaler available</span>
        {% else %}
              <select id="mySelect{{ forloop.index }}" class="custom_dropdown custom-list-wholesaler custom{{ option.name | handleize }} custom{{ customindex }} customselect">
                  {% for value in option.values %}
                        {%- assign hide_option = false -%}
                        {%- if option.name contains 'Wholesaler' -%}
                          {%- assign hide_option = true -%}
                          {%- for item in coverage_countries -%}
                            {%- assign item_up = item | upcase -%}
                            {%- assign value_up = value | upcase -%}
                            {%- if item_up contains value_up -%}
                              {%- assign hide_option = false -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                        {% unless hide_option %}
                          {% if hidden_value == '' %}
                            {% assign hidden_value = value | handleize %}
                          {% endif %}
                          <option class="custom{{ value | handleize }}"  value="{{ value | handleize }}">{{ value }}</option>
                        {% endunless %}
                  {% endfor %}
              </select>
        {% endif %}
      {% endfor %}
  </div>

  {% assign selected_seller_handle = hidden_value | downcase | strip %}
  {% assign seller_account_number = '' %}
  {% if customer %}
    {% for item in coverage_countries %}
      {% assign clean_item = item | strip %}
      {% assign clean_item_down = clean_item | downcase %}
      {% case selected_seller_handle %}
        {% when 'symbion' %}
          {% if clean_item_down contains 'symbion' %}
            {% assign seller_account_number = clean_item | remove_first: 'Symbion' | remove_first: 'SYMBION' | strip %}
            {% break %}
          {% endif %}
        {% when 'ch2' %}
          {% if clean_item_down contains 'ch2' %}
            {% assign seller_account_number = clean_item | remove_first: 'Ch2' | remove_first: 'CH2' | remove_first: 'ch2' | strip %}
            {% break %}
          {% endif %}
        {% when 'sigma' %}
          {% if clean_item_down contains 'sigma' %}
            {% assign seller_account_number = clean_item | remove_first: 'Sigma' | remove_first: 'SIGMA' | strip %}
            {% break %}
          {% endif %}
        {% when 'api' %}
          {% if clean_item_down contains 'api' %}
            {% assign seller_account_number = clean_item | remove_first: 'Api' | remove_first: 'API' | strip %}
            {% break %}
          {% endif %}
      {% endcase %}
    {% endfor %}
  {% endif %}
 {% if customer %}
     <div class="custom_price-section custom-list-price">
        
         	<div class="custom_wapper">
                <div class="custom_list-price">{{  product.variants.first.compare_at_price | money }}</div>
                <div class="custom_your-price">{{  product.variants.first.price | money }}</div>
                <div class="custom_profit">
                {% if  product.variants.first.compare_at_price >  product.variants.first.price %}
                    {% assign profit =  product.variants.first.compare_at_price | minus:  product.variants.first.price %}
                      {% if profit != blank %}
                          <div class="custom_profit">Saving: {{ profit | money }}</div>
                      {% endif %}
                {% endif %}
                </div>
          </div>
        
    </div>
     {% else %}
       {% endif %}
   {% if customer and hide_purchase_controls %}
<div class="custom_quantity custom-list-quantity wholesaler-unavailable-notice">
  <p style="color:#8a8a8a;font-weight:normal;margin:0;white-space:nowrap;text-align:center;width:100%;">Not available</p>
</div>
{% endif %}
   {% if customer and hide_purchase_controls == false %}
