{% if customer %}
{% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}


{%endif%}
{% comment %} does this product have a Wholesaler option, and does any value survive coverage filtering? {% endcomment %}
{% assign has_wholesaler_option = false %}
{% assign wholesaler_has_visible_value = false %}
{% for li_option in product.options_with_values %}
  {% if li_option.name contains 'Wholesaler' %}
    {% assign has_wholesaler_option = true %}
    {% for li_value in li_option.values %}
      {% assign li_value_down = li_value | downcase %}
      {% for li_item in coverage_countries %}
        {% assign li_item_down = li_item | downcase %}
        {% if li_item_down contains li_value_down %}
          {% assign wholesaler_has_visible_value = true %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endfor %}
{% assign hide_purchase_controls = false %}
{% if has_wholesaler_option and wholesaler_has_visible_value == false %}
  {% assign hide_purchase_controls = true %}
{% endif %}
{% if customer %}
  {% assign coverage_countries = customer.current_company.metafields.custom.wholesale_account_numbers.value %}
  {% for item in coverage_countries %}
    {% if item contains 'API' %}
      {% assign selleritem = item | downcase | replace: ' ', '' %}
    {% endif %}
    <input
      type="hidden"
      id=""
      name=""
      value="
        {%if selleritem contains 'api' %}
        {% assign defaulseller = true %}
        {{selleritem}}

        {%endif%}
      "
      class="customapi"
    >
  {% endfor %}
{% endif %}
<div
  class="custom-main-inner-wrap collection__item customitem product-item custom-list-{{ forloop.index }}"
  style="width: 100%;"
  data-title="{{ product.title }}"
  data-price="{{ product.price | money_without_currency | replace: ',', '' }}"
  data-created="{{ product.created_at }}"
>

  {% for variant in product.variants %}
    <input
      type="hidden"
      class="procustom{{ variant.id | handleize }} {{ variant.title | handleize }}"
      compareprice="{{ variant.compare_at_price | money }}"
      varienrprice="{{ variant.price | money }}"
      varientquentity="{{ variant.inventory_quantity }}"
      myvarientid="{{ variant.id }}"
      varienrcompprice="{{ variant.compare_at_price | money }}"
      variantprofit="
        {% if variant.compare_at_price > variant.price %}
          {% assign price_difference = variant.compare_at_price | minus: variant.price %}
          {% assign profit_percentage = price_difference | times: 100.0 | divided_by: variant.compare_at_price %}
          {{ profit_percentage | round: 2 }}%
        {% endif %}
      "
    >
  {% endfor %}

  <div class="custom_product-section">
    <div class="custom-list-image">
      {% assign discount_value = product.price | times: 100 | divided_by: product.compare_at_price %}
      <span
        class="price__discount data-wpd-hide discount-item{{ product.id }}"
        style="display: flex!important; order: 3;"
        data-product-price-discount
      >
        {{ 100 | minus: discount_value }}%
        {% if template.name == 'collection' %}
          <span class="off_text">Off</span>
        {% endif %}
      </span>

      <a href="{{ product.url }}">
        <img
          src="{{ product.featured_image | img_url: 'large' }}"
          alt="Product Image"
          style="width: 100%; padding: 10px;"
        >
      </a>
      <div
        class="th_wl_col_btn"
        data-product_id="{{product.id}}"
        data-variant_id="{{product.selected_or_first_available_variant.id}}"
      ></div>
    </div>
    <div class="custom-list-product-name">
      <a href="{{ product.url }}">
        {% if product.metafields.custom.bundle_deal != blank %}
          <span class="my-metafields">{{ product.metafields.custom.bundle_deal }}</span>
        {% endif %}
        <div class="product-name">{{ product.title }}</div>
{% if customer %}
  {% assign target_variant = product.selected_or_first_available_variant %}
  {% assign target_sku = target_variant.sku %}
  {% assign last_order_date = '' %}
  {% assign last_order_qty = 0 %}
  {% assign found_order = false %}

  {% for order in customer.orders %}
    {% for item in order.line_items %}
      {% if item.sku == target_sku %}
        {% if last_order_date == '' or order.created_at > last_order_date %}
          {% assign last_order_date = order.created_at %}
          {% assign last_order_qty = item.quantity %}
          {% assign found_order = true %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% if found_order %}
    <div class="last-order-details">
      {% comment %}<p><strong>SKU:</strong> {{ target_sku }}</p>{% endcomment %}
      <p><span>Last Ordered Quantity:</span> {{ last_order_qty }}</p>
      <p><span>Last Ordered Date:</span> {{ last_order_date | date: "%B %d, %Y" }}</p>
    </div>
  {% else %}

  {% endif %}
{% else %}

{% endif %}

      </a>

      {% comment %}<div class="customquickview" prohandle="{{ product.handle }}" data-product-card-handle="{{ product.handle }}">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#5a9d62"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="feather feather-eye"
        >
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </div>{% endcomment %}
    </div>

    <div class="custom-list-wholesaler">

      {% assign hidden_value = '' %}
      {% for option in product.options_with_values %}

        {% if option.name contains 'Wholesaler' and hide_purchase_controls %}
          <span class="custom-list-wholesaler-placeholder custom_dropdown" style="font-weight:400;color:#8a8a8a;">No wholesaler available</span>
        {% else %}
        <select
          id="mySelect{{ forloop.index }} "
{%if forloop.index == 1 %}style="padding-right: 0px;width: 100%;"{%endif%}
          class="custom_dropdown custom-list-wholesaler custom{{ option.name | handleize }} custom{{ customindex }} customselect customselector{{product.id}}"
        >
          {% for value in option.values %}

  {%- assign hide_option = false -%}

  {%- if option.name contains 'Wholesaler' -%}
    {%- assign hide_option = true -%}
    {%- for item in coverage_countries -%}
    {%- assign item_up = item | upcase -%}
      {%- if item contains value -%}
        {%- assign hide_option = false -%}
        {%- break -%}
{%elsif item_up contains value -%}
     {%- assign hide_option = false -%}
{%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{% if hide_option %}
{%else%}
  {% if hidden_value == '' %}
    {% assign hidden_value = value | handleize %}
  {% endif %}
  <option class="custom{{ value | handleize }}"
          value="{{ value | handleize }}">
      {{ value }}
  </option>
{% endif %}
{% endfor %}

        </select>
        {% endif %}

      {% endfor %}
<div style="text-align: center;" class="custom-quantity-items"></div>
    </div>

    {% assign selected_seller_handle = hidden_value | downcase | strip %}
    {% assign seller_account_number = '' %}
    {% if customer %}
      {% for item in coverage_countries %}
        {% assign clean_item = item | strip %}
        {% assign clean_item_down = clean_item | downcase %}
        {% case selected_seller_handle %}
          {% when 'symbion' %}
            {% if clean_item_down contains 'symbion' %}
              {% assign seller_account_number = clean_item | remove_first: 'Symbion' | remove_first: 'SYMBION' | strip %}
              {% break %}
            {% endif %}
          {% when 'ch2' %}
            {% if clean_item_down contains 'ch2' %}
              {% assign seller_account_number = clean_item | remove_first: 'Ch2' | remove_first: 'CH2' | remove_first: 'ch2' | strip %}
              {% break %}
            {% endif %}
          {% when 'sigma' %}
            {% if clean_item_down contains 'sigma' %}
              {% assign seller_account_number = clean_item | remove_first: 'Sigma' | remove_first: 'SIGMA' | strip %}
              {% break %}
            {% endif %}
          {% when 'api' %}
            {% if clean_item_down contains 'api' %}
              {% assign seller_account_number = clean_item | remove_first: 'Api' | remove_first: 'API' | strip %}
              {% break %}
            {% endif %}
        {% endcase %}
      {% endfor %}
    {% endif %}

    {% if customer %}
      <div class="custom_price-section custom-list-price">
        {% if settings['product-price-show'] %}
          {% if customer %}
            {%- render 'price',
              product: product,
              show_unit_price: show_unit_price,
              currency_code_enabled: currency_code_enabled,
              simplified_view: simplified_view
            -%}
          {% else %}

          {% endif %}
        {% else %}
          {%- render 'price',
            product: product,
            show_unit_price: show_unit_price,
            currency_code_enabled: currency_code_enabled,
            simplified_view: simplified_view
          -%}
        {% endif %}
      </div>
    {% else %}

    {% endif %}
    {% if customer and hide_purchase_controls %}
      <div class="product-quantity__wrapper custom-wraoer-22 wholesaler-unavailable-notice">
        <p style="color:#8a8a8a;font-weight:normal;margin:0;white-space:nowrap;text-align:center;width:100%;">Not available</p>
      </div>
    {% endif %}
    {% if customer and hide_purchase_controls == false %}
      <div class="product-quantity__wrapper custom-wraoer-22">
        {% comment %}<div class="product-quantity__container text">
          <button
            class="product-quantity__button"
            type="button"
            data-quantity-decrease
            aria-label="{{ 'products.quantity.decrease' | t: product: product.title | escape }}"
          >
            {% render 'icons', icon: 'minus' %}
          </button>
          {% comment %} {% assign form_id = 'product_form_' | append: product.id | append: '_section_' | append: section.id %} {% endcomment %}

          <input
            form="{{- form_id -}}"
            type="number"
            {% unless additional %}
              name="quantity"
            {% endunless %}
            id="Product_{{- product.id -}}-Quantity{%- if additional -%}-additional{%- endif -%}"
            class="product-quantity__input2"
            value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
            min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
            max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
            step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
            data-quantity-input
            {% if additional %}
              data-quantity-input-additional
            {%- endif -%}
          >

          <button
            class="product-quantity__button"
            type="button"
            data-quantity-increase
            aria-label="{{ 'products.quantity.increase' | t: product: product.title | escape }}"
          >
            {% render 'icons', icon: 'plus' %}
          </button>
        </div>{% endcomment %}
{%render 'quick-add2',product:product%}
        {{- extra_buttons -}}
        <form method="post" action="{{ routes.cart_add_url }} " style="width:100%;">
          {% render 'product-form-content', section: section, product: product, block: block, form: form %}
        </form>
       
      </div>
    {% endif %}
    {% if customer %}
      <form method="post" action="{{ routes.cart_add_url }} " style="width:0%;display: none;">
     <input
          type="hidden"
          name="properties[Wholesaler Account No.1]"
          value="{% if selected_seller_handle contains 'api' %}{{ seller_account_number }}{% endif %}"
          class="API"
        >
        <input type="hidden" name="properties[Wholesaler Account No.2]" value="{% if selected_seller_handle contains 'sigma' %}{{ seller_account_number }}{% endif %}" class="Sigma">
        <input type="hidden" name="properties[Wholesaler Account No.3]" value="{% if selected_seller_handle contains 'symbion' %}{{ seller_account_number }}{% endif %}" class="Symbion">
        <input type="hidden" name="properties[Wholesaler Account No.4]" value="{% if selected_seller_handle contains 'ch2' %}{{ seller_account_number }}{% endif %}" class="Ch2">
        <input id="my-variant-profit" type="hidden" name="properties[Saving Per Item]" class="itemperdiscount" value="">
        <input type="hidden" name="id" class="my-add-to-cart-value custom-idd" value="{{ product.variants.first.id }}">
        <input min="1" type="hidden" class="add-to-card-input custom-quantity" id="quantity" name="quantity" value="1">

       
        {% comment %}
          <span class="product-sold-out" style="width: 100px; padding: 10px 10px; background: #8cce93; color: #fff; border-radius: 10px;">Sold Out</span>
        {% endcomment %}

        {% comment %}
          <span class="product-sold-out" style="width: 100px; padding: 10px 10px; background: #8cce93; color: #fff; border-radius: 10px;">Sold Out</span>
        {% endcomment %}
        {% comment %}
          {% if product.variants.first.inventory_quantity > 0 %}
                {%else %}
            <span value="Add to cart" class="custom_add_to-Cart_button" disabled>Add to cart</span>
          {% endif %}
        {% endcomment %}
      </form>
    {% else %}
      <div class="more_info">More Info</div>
    {% endif %}
    {% comment %}
      <div class="custom_more-info custom-list-product-info" style="color: #000;">More info</div>
    {% endcomment %}
  </div>
</div>
