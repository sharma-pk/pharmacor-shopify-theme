<script>
function customCollectionPageOpenTab(evt, cityName) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("custom-collection-page-tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("custom-collection-page-tablinks");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].className = tablinks[i].className.replace(" active", "");
  }
  document.getElementById(cityName).style.display = "flex";
  evt.currentTarget.className += " active";
}
</script>
<script>
function openMyCollectionList(evt, cityName2) {
  var i, tabcontent2, tablinks;
  tabcontent2 = document.getElementsByClassName("my-collection-list-tabcontent");
  for (i = 0; i < tabcontent2.length; i++) {
    tabcontent2[i].style.display = "none";
  }
  tablinks = document.getElementsByClassName("my-collection-list-tablinks");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].className = tablinks[i].className.replace(" active2", "");
  }
  document.getElementById(cityName2).style.display = "block";
  evt.currentTarget.className += " active2";
}
</script>
<script>
    $(document).ready(function () {
        // Attach event listeners to all quantity selectors
        $(".custom-main-inner-wrap").each(function () {
            var container = $(this); // Target the main container
            
            // Decrease button click
            container.find(".decrease").on("click", function () {
                var input = container.find("input[type='number']"); // Target input in the same container
                var currentValue = parseInt(input.val());
                var minValue = parseInt(input.attr("min")) || 1; // Default to 1 if no min is defined
                
                if (currentValue > minValue) {
                    input.val(currentValue - 1);
                    // Update the value of .add-to-card-input (even if it's elsewhere on the page)
                    var input2 = container.find('.add-to-card-input');
                    if (input2.length) {
                        input2.val(input.val()); // Set the value of add-to-card-input
                    }
                }
            });

            // Increase button click
            container.find(".increase").on("click", function () {
                var input = container.find("input[type='number']"); // Target input in the same container
                var currentValue = parseInt(input.val());
                input.val(currentValue + 1);
                // Update the value of .add-to-card-input (even if it's elsewhere on the page)
                var input2 = container.find('.add-to-card-input');
                if (input2.length) {
                    input2.val(input.val()); // Set the value of add-to-card-input
                }
            });

            // Listen for changes in the .add-to-card-input field
            container.find('.myinputt').on('change', function () {
                var input3 = $(this).val(); // Get the changed .add-to-card-input
              //alert(input3);
              $(".add-to-card-input").val(input3)
                // var quantity = parseInt(input3.val()); // Get the new value of .add-to-card-input
                // // Update the quantity input accordingly
                // container.find("input[type='number']").val(quantity);
            });
        });
    });
</script>
<script>
$(document).ready(function () {
    // Function to handle dropdown changes
    function handleDropdownChange(dropdown) {
        var myparent = dropdown.closest('.custom-main-inner-wrap'); 
        var selectedValues = [];
        myparent.find('.custom_dropdown').each(function () {
            var customval = $(this).val();
            if (!customval) return;
            selectedValues.push(customval);
        });
        var combinedValue = selectedValues.join("-").toLowerCase().replace(/\s+/g, "-").replace(/[/\.]/g, "-");
        if (!combinedValue) return;
        setTimeout(function () {
            var variantElement = myparent.find("." + combinedValue);
            if (variantElement.length) {
                var myvariantid = variantElement.attr("myvarientid");
                var myvariantprice = variantElement.attr("varienrprice");
                var myvariantcompareprice = variantElement.attr("varienrcompprice");
                var myvariantprofit = variantElement.attr("variantprofit");
                var myvariantquantity = variantElement.attr("varientquentity");
            console.log(myvariantprice);
                myparent.find(".my-add-to-cart-value").val(myvariantid);
                myparent.find(".custom_your-price").html(myvariantprice);
                myparent.find(".custom_list-price").html(myvariantcompareprice);
                myparent.find(".custom_profit").html("Saving:" + myvariantprofit);
                myparent.find("#my-variant-profit").val(myvariantprofit);
                myparent.find(".-stock").html("Stock" + ":" + " " + myvariantquantity);
                  if (myvariantquantity > 0) {
                    //myparent.find('.custom_add_to-Cart_button').show();
                    //myparent.find('.product-sold-out').hide();
                  myparent.find('.backorder-order').css('display', 'none');
                } else {
                    //myparent.find('.custom_add_to-Cart_button').hide();
                    //myparent.find('.product-sold-out').show();
                    myparent.find('.backorder-order').css('display', 'inline-block');
            
                }
            } else {
               // alert('No matching variant found for: ' + combinedValue);
            }
        }, 50);
    }

    // Attach change event listener
    $(document).on('change', '.custom_dropdown', function () {

        handleDropdownChange($(this));
    });

    // Apply logic on page reload
    $('.custom_dropdown').each(function () {
        handleDropdownChange($(this));
    });
});
</script>

<script>
$(document).ready(function(){
  $(".custom-list-product-info").click(function(){
   var mysecondparent = $(this).parent().parent().next();
    $(mysecondparent).removeClass("custom-hidden-class");
  });
    $(".custom-close-pop").click(function(){
   $(this).parent().parent().addClass("custom-hidden-class");
  });
  
    $(".mysimple-close").click(function(){
   $(this).parent().addClass("custom-hidden-class");
  });

});
</script>
<script>
  $(document).ready(function() {
function handleDropdownChange() {
  const selectedValue = $('#mySelect').val(); 
  $('.custom-list-wholesaler option').prop('selected', false); // Deselect all options
  
  $('.custom-list-wholesaler option').each(function() {
    const optionValue = $(this).val();
    if (selectedValue === optionValue) {
      // Find the parent container of the matching option
      const parentContainer = $(this).closest('.custom-list-wholesaler');
      // Select the matching option
    var custmvalue =   $(parentContainer).parent().find('option').val();
      //console.log(custmvalue);
      parentContainer.val(optionValue);
    }
  });
  
  setTimeout(function() {
    $('.custom-list-wholesaler').trigger('change');
  }, 100); 
}

    $(document).on('change', '#mySelect', function () {
      handleDropdownChange();
    });
    handleDropdownChange();
  });
</script>



