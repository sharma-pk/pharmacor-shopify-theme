{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What our customers say"
    },
    {
      "type": "url",
      "id": "heading_link",
      "label": "Heading Link"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "quote_heading",
          "label": "Quote Heading",
          "default": "Lorem ipsum dolor sit amet"
        },
        {
          "type": "textarea",
          "id": "quote_text",
          "label": "Quote Text",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Jane Doe"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author Role",
          "default": "Testimonial Giver"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials Section",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}

<div class="custom-testimonials">
  <div class="testimonials-heading">
    {% if section.settings.heading != blank %}
    <h2>
      {{ section.settings.heading }}
      
<svg width="32" height="31" viewBox="0 0 32 31" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1 29.75L30.1667 1" stroke="#B2E78A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1 1H30.1667V29.75" stroke="#B2E78A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

    </h2>
  {% endif %}
  </div>
  <div class="testimonials-grid">
    {% for block in section.blocks %}
      <div class="testimonial-card">
        <h3>{{ block.settings.quote_heading }}</h3>
        <p>{{ block.settings.quote_text }}</p>
        <div class="testimonial-footer">
          {% if block.settings.author_image %}
            <img src="{{ block.settings.author_image | image_url: width: 60 }}" alt="{{ block.settings.author_name }}" class="testimonial-img">
          {% else %}
            <div class="testimonial-placeholder"></div>
          {% endif %}
          <div class="testimonial-author">
            <strong>{{ block.settings.author_name }}</strong><br>
            <span>{{ block.settings.author_role }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
.custom-testimonials {
  padding: 60px 0px 100px;
max-width: 1320px;
    margin: 0 auto;
    display: grid;
    align-items: center;
    grid-template-columns: 25% 75%;
}
.testimonials-heading h2 {
    color: #30623D;
    font-family: Neutrif Studio;
    font-weight: 500;
    font-size: 55px;
    line-height: normal;
    letter-spacing: 0;
    width: 90%;
}
.testimonials-heading .heading-link {
  color: #63c362;
  margin-left: 5px;
  text-decoration: none;
}
.testimonials-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 30px;
}
.testimonial-card {
  background-color: #B2E78A;
  padding: 40px 30px;
  border-radius: 20px;
      flex: 1 1 31.8%;
    max-width: 31.8%;
}
.testimonial-card h3 {
      color: #30623D;
    font-family: Neutrif Studio;
    font-weight: 500;
    font-size: 35px;
    line-height: normal;
    letter-spacing: 0;
    vertical-align: middle;
}
.testimonial-card p {
color: #30623D;
    margin: 10px 0;
    font-family: Neutrif Studio;
    font-weight: 400;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 0;
    vertical-align: middle;
  margin:30px 0 60px;
}
.testimonial-footer {
    display: grid;
    align-items: center;
    margin-top: 15px;
    grid-template-columns: 35% 65%;
}
.testimonial-img {
  width: 80px;
  height: 80px;
  border-radius: 50px;
}
.testimonial-placeholder {
  width: 80px;
  height: 80px;
  border-radius: 50px;
  background-color: white;
}
  .testimonial-author br{
    display:none;
  }
.testimonial-author {
    font-family: Neutrif Studio;
    font-weight: 500;
    font-size: 25px;
    line-height: normal;
    letter-spacing: 0;
    vertical-align: middle;
    margin-left: 20px;
  display:flex;
  flex-direction:column;
}
  .testimonial-author span{
   font-size: 14px; 
    color:#30623D
  }
</style>
