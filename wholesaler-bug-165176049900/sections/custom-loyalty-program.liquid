<style>
  #{{ section.id }} .wrapper_{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    padding: 50px 12px;
    background: #fff;
  }
 #{{ section.id }} .card_{{ section.id }} h3 {font-size: 25px;
  line-height: 1.5;
  color: #30623D;
  margin: 30px 0 0px;
  text-transform: uppercase;
  font-weight: 400;}
#{{ section.id }} .wrapper_dataa_{{ section.id }} h3 {
  font-size: 18px;
  line-height: 1.4;
  color: #30623D;
  margin: 0 0 10px;
  text-transform: uppercase;
  font-weight: 500;
  letter-spacing: 1px;
}

#{{ section.id }} .wrapper_dataa_{{ section.id }} h2 {
  font-size: 40px;
  line-height: 1.3;
  color: #30623D;
  margin: 0 0 20px;
  font-weight: 700;
}

#{{ section.id }} .wrapper_dataa_{{ section.id }} p {
  font-size: 16px;
  line-height: 1.6;
  color: #444;
  margin: 0 auto 30px;
  max-width: 550px;
}


  #{{ section.id }} .layout_{{ section.id }} {
    display: grid;
    gap: 30px;
    grid-template-columns: repeat(3, 1fr);
  }

  #{{ section.id }} .card_{{ section.id }} {
    padding: 30px;
    border-radius: 20px;
    transition: all 0.3s ease;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0px;
    cursor: pointer;
  }
{% comment %} 
  #{{ section.id }} .card_{{ section.id }}:hover {
    background-color: #30623D !important;fill: #B2E78A;
  } 

  #{{ section.id }} .card_{{ section.id }}:hover h3,
  #{{ section.id }} .card_{{ section.id }}:hover h2,
  #{{ section.id }} .card_{{ section.id }}:hover p,
  #{{ section.id }} .card_{{ section.id }}:hover a {
    color: #B2E78A;
    transition: .3s all ease-in-out;
  }
{% endcomment %}
  #{{ section.id }} .card_{{ section.id }}:hover .main_img_{{ section.id }} {
    display: none;
  }

  #{{ section.id }} .card_{{ section.id }}:hover .hover_img_{{ section.id }} {
    display: block;
  }

  #{{ section.id }} .card_{{ section.id }} img {
    height: 80px;width: 80px;
  }

  #{{ section.id }} .card_{{ section.id }} h2 {
    font-family: Neutrif Studio;
    font-weight: 500;
    font-size: 25px;
    line-height: 1.5;
    color: #30623D;margin: 0;
  }

  #{{ section.id }} .card_{{ section.id }} p {
    font-family: Neutrif Studio;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.5;
    color: #30623D;
    margin: 0 0 30px;
  }

  #{{ section.id }} .card_{{ section.id }} a {
    text-decoration: none;
    font-weight: 600;
    color: #2f6f4e;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  #{{ section.id }} .hover_img_{{ section.id }} {
    display: none;
  }


#{{ section.id }} .card_{{ section.id }} a svg path {
  stroke: #30623D;
  transition: stroke 0.3s ease-in-out;
}

{% comment %} #{{ section.id }} .card_{{ section.id }}:hover a svg path {
  stroke: #B2E78A;
} {% endcomment %}



   @media only screen and (max-width: 767px) {
       #{{ section.id }} .layout_{{ section.id }} {grid-template-columns: repeat(1, 1fr); gap: 20px;}
        #{{ section.id }} .wrapper_{{ section.id }} { padding: 30px 12px;}
    }
</style>

<div id="{{ section.id }}" class="section_benefits_{{ section.id }}">
  <div class="wrapper_{{ section.id }}">
    <div class="wrapper_dataa_{{ section.id }}">
    <h3>{{ section.settings.sub_heading}}</h3>
     <h2>{{ section.settings.main_heading }}</h2>
      <p>{{ section.settings.decoration }}</p>
      </div>

    <div class="layout_{{ section.id }}">
      {% for block in section.blocks %}
        <div class="card_{{ section.id }}" style="background-color: {{ block.settings.bg_color }};">
          {% if block.settings.icon %}
            <img src="{{ block.settings.icon | img_url: 'master' }}" alt="icon" class="main_img_{{ section.id }}">
            <img src="{{ block.settings.icons | img_url: 'master' }}" alt="hover icon" class="hover_img_{{ section.id }}">
          {% endif %}
          <h3>{{ block.settings.sub-title }}</h3>
           <h2>{{ block.settings.title }}</h2>
          <p>{{ block.settings.description }}</p>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">
              {{ block.settings.link_text }}
             <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M1.71704 7.8103H15.0541" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M8.38556 1.1416L15.0541 7.81013L8.38556 14.4786" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Loyalty Program",
"settings": [
  {
    "type": "text",
    "id": "sub_heading",
    "label": "Sub Heading",
    "default": "FROM MATE TO BEST MATE"
  },
  {
    "type": "text",
    "id": "main_heading",
    "label": "Main Heading",
    "default": "PharMate Loyalty Program"
  },
  {
    "type": "textarea",
    "id": "decoration",
    "label": "Description",
    "default": "This program rewards your purchases with points, free stock, merchandise, and exclusive perks. Advance through Mate, Good Mate, and Best Mate tiers for even greater benefits."
  }
],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "sub-title",
          "label": "Sub Title",
          "default": "Tier 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bulk Buy & Save"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Get more for less with competitive volume discounts."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "See Offers"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icons",
          "label": "Hover Icon"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#B2E78A"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Loyalty Program"
    }
  ]
}
{% endschema %}
