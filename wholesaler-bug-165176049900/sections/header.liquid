          $('.product-stock-grater10, .product-sold-out').hide();
          $('.product-stock-less10').show();
        } else if (myee > 10) {
          $('.product-stock-less10, .product-sold-out').hide();
          $('.product-stock-grater10').show();
        }
      }, 1500);
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function setVariantId(radio) {
      var parentForm = radio.closest('.quick-view__form');
      if (!parentForm) return;

      var link = parentForm.querySelector('.js-quick-view-link');
      var hiddenInput = parentForm.querySelector('.cusotm-cart-id');

      if (!link || !hiddenInput) return;

      setTimeout(function () {
        var href = link.getAttribute('href') || '';
        var match = href.match(/variant=(\d+)/);
        if (match) {
          hiddenInput.value = match[1];
        }

        // discount span ka text thoda delay k baad hidden input me set karo
        setTimeout(function () {
          var discountSpan = parentForm.querySelector('.price__discount');
          var savingInput = parentForm.querySelector('#custom-inline-property');
          if (discountSpan && savingInput) {
            let discountText = discountSpan.innerText.trim();
            // "-" hatado
            discountText = discountText.replace('-', '');
            savingInput.value = discountText;
            // alert(discountText); // <- ab sirf comment me
          }
        }, 800);
      }, 200);
    }

    // quick view open hone pr already checked radio handle karo
    setTimeout(function () {
      document.querySelectorAll('.quick-view-form__option input[type="radio"]:checked').forEach(function (radio) {
        setVariantId(radio);
      });
    }, 300);

    // radio change hone pr
    document.addEventListener('change', function (e) {
      if (e.target.matches('.quick-view-form__option input[type="radio"]')) {
