<script>
  document.addEventListener('DOMContentLoaded', function () {
    const target = document.querySelector('.js-header-cart-item-count');

    if (target) {
      let previousValue = target.textContent.trim();

      const observer = new MutationObserver(function () {
        const newValue = target.textContent.trim();

        if (newValue !== previousValue) {
          const $target = $('.js-header-cart-item-count');
          const $nextOfGrandParent = $target.parent().parent().next();

          $nextOfGrandParent.addClass('blue-activeted');
          setTimeout(function () {
            $nextOfGrandParent.removeClass('blue-activeted');
          }, 6000);

          previousValue = newValue;
        }
      });

      observer.observe(target, {
        childList: true,
        subtree: true,
        characterData: true,
      });
    }
  });
</script>

