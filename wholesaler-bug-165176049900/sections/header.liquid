  <script>
    (function ($) {
      // Wait for both DOM ready and jQuery ready
      $(function () {
        // Handle click with proper delegation

        // Nuclear option for stubborn cases (shadow DOM, iframes)
        const nuclearInterval = setInterval(() => {
          const $closeBtn = $('.ast-cart__close');
          if ($closeBtn.length) {
            $closeBtn.off('click.cartClose').on('click.cartClose', function (e) {
              e.preventDefault();
              $('.ast-cart').removeClass('ast-open new-dr');
            });
            clearInterval(nuclearInterval);
          }
        }, 300);
      });
    })(jQuery);
