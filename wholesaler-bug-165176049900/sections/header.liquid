<script>
  // ── AJAX Add-to-Cart for .custom_add_to-Cart_button ──
  // Uses CLICK handler (same proven pattern as .product-add-to-cart__button
  // and .custom-carttt handlers already working in this theme).
  (function($){
    var _toastTimer = null;

    // ---- Toast ----
    function showToast(){
      var $t = $('#atc-toast');
      if(!$t.length) return;
      clearTimeout(_toastTimer);
      $t.addClass('is-visible');
      _toastTimer = setTimeout(function(){ $t.removeClass('is-visible'); }, 3500);
    }

    // ---- Cart count (lightweight /cart.js call) ----
    function refreshCartCount(){
      $.getJSON('/cart.js', function(cart){
        var c = cart.item_count;
        var label = c > 99 ? '99+' : c;
        $('.js-header-cart-item-count').text(label);
        $('.js-header-cart-item-count-wrapper').attr('data-cart-count', c);
      });
    }

    // ---- Click handler (delegated, fires once) ----
    $(document).on('click', '.custom_add_to-Cart_button', function(e){
      e.preventDefault();
      e.stopImmediatePropagation();   // stop other click handlers from firing

      var $btn = $(this);
      if($btn.prop('disabled') || $btn.hasClass('atc-loading')) return;

      // Find parent wrappers
      var $section = $btn.closest('.custom_product-section').length
                   ? $btn.closest('.custom_product-section')
                   : $btn.closest('.custom-main-inner-wrap');
      var $form    = $btn.closest('form');

      // Read variant ID
      var variantId = $form.find('.my-add-to-cart-value').val();
      if(!variantId) return;

      // Read quantity from visible input (.myinputt) or hidden field
      var quantity = parseInt($section.find('.myinputt').val() || $form.find('.add-to-card-input').val() || 1, 10);
      // Sync hidden qty so it stays consistent
      $form.find('.add-to-card-input').val(quantity);

      // Read wholesaler properties
      var wholesaler1 = $form.find('.API').val()     || '';
      var wholesaler2 = $form.find('.Sigma').val()   || '';
      var wholesaler3 = $form.find('.Symbion').val() || '';
      var wholesaler4 = $form.find('.Ch2').val()     || '';
      var saving      = $form.find('.itemperdiscount').val() || '';

      // ── Show loader immediately ──
      var origHTML = $btn.html();
      $btn.addClass('atc-loading').prop('disabled', true)
          .html('<span class="atc-spinner"></span> Adding\u2026');

      // ── AJAX POST (same pattern as working .custom-carttt handler) ──
      $.ajax({
        type: 'POST',
        url: '/cart/add.js',
        data: {
          id: variantId,
          quantity: quantity,
          properties: {
            'Wholesaler Account No.1': wholesaler1,
            'Wholesaler Account No.2': wholesaler2,
            'Wholesaler Account No.3': wholesaler3,
            'Wholesaler Account No.4': wholesaler4,
            'Saving Per Item': saving
          }
        },
        dataType: 'json',
        success: function(){
          // 1) Fast cart-count refresh
          refreshCartCount();
          // 2) Show "Product added to cart!" toast
          showToast();
          // 3) Restore button
          $btn.removeClass('atc-loading').prop('disabled', false).html(origHTML);
        },
        error: function(xhr){
          var msg = 'Could not add to cart. Please try again.';
          try { msg = JSON.parse(xhr.responseText).description || msg; } catch(ex){}
          alert(msg);
          $btn.removeClass('atc-loading').prop('disabled', false).html(origHTML);
        }
      });

      return false;   // belt-and-suspenders: also prevents native form submit
    });

  })(jQuery);
</script>
