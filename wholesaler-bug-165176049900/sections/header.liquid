<script>
  (function(){
    document.addEventListener("click", function(e){
      var btn = e.target.closest(".product-add-to-cart__button");
      if(!btn) return;
      e.preventDefault();

      // parent custom-variant find karo
      var parent = btn.closest(".custom-variant");
      if(!parent) return;

      var qtyInput   = parent.querySelector(".quantity");
      var quantity   = parseInt(qtyInput?.value || 1, 10);

      var variantId  = btn.getAttribute("data-variant-id");

      // wholesaler values — live-resolved the same way every other add-to-cart path does
      var variantinput = parent.querySelector(".radioinput:checked");
      var checkval     = variantinput ? variantinput.value : "";

      // was reading localStorage directly, ignoring the header widget's active override cookie that every other handler already respects
      function liveNumberFor(brand){
        if (typeof getLiveWholesalerNumberForBrand === "function") return getLiveWholesalerNumberForBrand(brand);
        var raw = (localStorage.getItem("selected_" + brand) || "").replace(new RegExp(brand, "gi"), "");
        return (typeof isWholesalerCovered === "function" && !isWholesalerCovered(raw)) ? "" : raw;
      }

      var apivalue="", sigmavale="", symbionvale="", ch2="";
      if(checkval.includes("API")){
        apivalue = liveNumberFor("api");
      }else if(checkval.includes("Sigma")){
        sigmavale = liveNumberFor("sigma");
      }else if(checkval.includes("Symbion")){
        symbionvale = liveNumberFor("symbion");
      }else if(checkval.includes("CH2")){
        ch2 = liveNumberFor("ch2");
      }

      // Saving Per Item — same myvarientid/variantprofit lookup pattern used
      // elsewhere (wholesaler-shared.js), so this card family stays consistent
      // with the rest of the site instead of always sending it blank.
      var savingPerItem = "";
      if (variantId) {
        var variantProfitEls = document.querySelectorAll('[myvarientid="' + variantId + '"]');
        for (var i = 0; i < variantProfitEls.length; i++) {
          var profitAttr = variantProfitEls[i].getAttribute('variantprofit');
          if (profitAttr !== null) { savingPerItem = profitAttr.trim(); break; }
        }
      }

      // add to cart
      $.ajax({
        type: "POST",
        url: "/cart/add.js",
        data: {
          id: variantId,
          quantity: quantity,
          properties: {
            "Wholesaler Account No.1": apivalue,
            "Wholesaler Account No.2": sigmavale,
            "Wholesaler Account No.3": symbionvale,
            "Wholesaler Account No.4": ch2,
            "Saving Per Item": savingPerItem
          }
        },
        dataType: "json",
        success: function() {
          // bubble refresh
          $('#cart-icon-bubble').load(window.location.href + " #cart-icon-bubble > *");


          refreshCartDrawer(function(){
  			{% if settings.header-search-drawer %}
  			$(".header__icon--cart").trigger("click");
  			$("body").addClass("cart-open");
  		    {% endif %}
          });

        },
        error: function(xhr, status, error) {
          console.log("add to cart error:", error);
        }
      });
    });

    // -------- Drawer Refresh (Section Rendering API) ----------
    function refreshCartDrawer(done){
      var $drawer = $("#CartDrawer");
      var sectionKey = $drawer.data("section-id");

      $.ajax({
        type: "GET",
        url: "/?sections=" + encodeURIComponent(sectionKey) + "&_=" + Date.now(),
        dataType: "json",
        success: function(res){
          var html = res && res[sectionKey];
          if(html) {
            swapDrawerHTML(html);
            if(typeof done==="function") done();
          } else {
            fallbackHTML(done);
          }
        },
        error: function(){
          fallbackHTML(done);
        }
      });

      function fallbackHTML(cb){
        $.ajax({
          type: "GET",
          url: "/?section_id=cart-drawer&_=" + Date.now(),
          dataType: "html",
          success: function(html){
            swapDrawerHTML(html);
            if(typeof cb==="function") cb();
          }
        });
      }

      function swapDrawerHTML(newHtml){
        var $tmp = $(newHtml);
        var $newContainer = $tmp.find(".js-cart-container");
        if($newContainer.length){
          $drawer.find(".js-cart-container").html($newContainer.html());
        }
        var $newFooter = $tmp.find(".cart-drawer__footer");
        if($newFooter.length){
          $drawer.find(".cart-drawer__footer").html($newFooter.html());
        }
      }
    }
  })();
</script>
