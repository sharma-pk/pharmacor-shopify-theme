{% comment %}
  Pharmacor Rewards Section
  Shopify Liquid Section
{% endcomment %}

<section class="pharmacor-rewards" id="pharmacor-rewards-{{ section.id }}">
  <div class="pharmacor-rewards__inner">

    <!-- Header -->
    <div class="pharmacor-rewards__header">
      <h2 class="pharmacor-rewards__title">{{ section.settings.title }}</h2>
      <p class="pharmacor-rewards__subtitle">{{ section.settings.subtitle }}</p>
      <p class="pharmacor-rewards__description">{{ section.settings.description }}</p>
    </div>

    <!-- Greeting Card -->
    <div class="pharmacor-rewards__card">
      <div class="pharmacor-rewards__pill-logo">
        {% if section.settings.pill_logo != blank %}
          <img src="{{ section.settings.pill_logo | img_url: 'master' }}" alt="{{ section.settings.pill_logo_alt }}" class="pill-logo__img">
        {% else %}
          <img src="{{ 'placeholder.svg' | asset_url }}" alt="Pharmacor Rewards Logo" class="pill-logo__img">
        {% endif %}
      </div>
      <div class="pharmacor-rewards__greeting">
        <p class="greeting__name">Hi {% if customer %}{{customer.first_name}}{% endif %}</p>
        <p class="greeting__message">{{ section.settings.greeting_message }}</p>
      </div>
    </div>

    <!-- Tier Progress Bar -->
    <div class="pharmacor-rewards__tiers">
      <div class="tiers__bar-wrapper">
        <div class="tiers__indicator"></div>
        <div class="tiers__bar">
          <div class="tiers__tier tiers__tier--silver">
            <span class="tiers__tier-label">{{ section.settings.tier_1_name }}</span>
          </div>
          <div class="tiers__tier tiers__tier--gold">
            <span class="tiers__tier-label">{{ section.settings.tier_2_name }}</span>
          </div>
          <div class="tiers__tier tiers__tier--platinum">
            <span class="tiers__tier-label">{{ section.settings.tier_3_name }}</span>
          </div>
        </div>
      </div>
      <div class="tiers__ranges">
        <span class="tiers__range">{{ section.settings.tier_1_range }}</span>
        <span class="tiers__range">{{ section.settings.tier_2_range }}</span>
        <span class="tiers__range">{{ section.settings.tier_3_range }}</span>
      </div>
    </div>

  </div>
</section>

<style>
  #pharmacor-rewards-{{ section.id }} {
    --color-black: #0f0f0f;
    --color-white: #ffffff;
    --color-text: #1a1a1a;
    --color-muted: #555555;
    background-color: #f3f8f8;
    padding: 0 15px 10px;
    box-sizing: border-box;
  }

  .pharmacor-rewards__inner {
    max-width: 1170px;
    margin: 0 auto;
    background: #fff;
    border-radius: 39px;
    {% comment %} border: 1px solid #d6dbd7; {% endcomment %}
    padding:20px;
  }

  /* Header */
  .pharmacor-rewards__header {
    text-align: center;
    margin-bottom: 30px;
  }

  .pharmacor-rewards__title {
    font-family: 'Neutrif Studio', sans-serif;
    font-weight: bold;
    font-size: 40px;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    color: #30623D;
    margin: 0 0 20px;
  }

  .pharmacor-rewards__subtitle {
    font-size: 20px;
    font-weight: 700;
    color: #30623D;
    margin: 0 0 10px;
    letter-spacing: 0;
  }

  .pharmacor-rewards__description {
    font-family: 'Neutrif Studio', sans-serif;
    font-size: 16px;
    color: #444;
    margin: 0;
    line-height: 1.6;
    position: relative;
    padding-right: 20px;
  }

  /* Greeting Card */
.pharmacor-rewards__card {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 0 10px;
    max-width: 620px;
    margin: 0 auto 30px;
}

  /* Pill Logo */
  .pharmacor-rewards__pill-logo {
    flex-shrink: 0;
  }

  .pill-logo__img {
    display: block;
    width: 280px;
    height: auto;
  }

  /* Greeting Text */
  .pharmacor-rewards__greeting {
    flex: 1;
  }

  .greeting__name {
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 700;
    color: var(--color-black);
    margin: 0 0 8px;
  }

  .greeting__message {
    font-size: clamp(14px, 1.8vw, 17px);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Tier Bar */
.pharmacor-rewards__tiers {
    padding: 0 10px;
    max-width: 630px;
    margin: 0 auto;
}
  .tiers__bar-wrapper {
    position: relative;
    margin-bottom: 12px;
  }

  .tiers__indicator {
    position: absolute;
    top: -14px;
    left: 2px;
    width: 2px;
    height: 14px;
    background: var(--color-black);
    display:none;
  }

  .tiers__bar {
    display: flex;
    border-radius: 100px;
    overflow: hidden;
    height: 52px;
  }

  .tiers__tier {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tiers__tier-label {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0;
  }

  .tiers__tier--silver {
    background: linear-gradient(90deg, #d4d4d4, #e8e8e8, #c8c8c8);
  }

  .tiers__tier--silver .tiers__tier-label {
    color: #6c6c6b;
  }

  .tiers__tier--gold {
    background: linear-gradient(90deg, #d4b896, #e8d5b0, #c9a97a);
  }

  .tiers__tier--gold .tiers__tier-label {
    color: #a57258;
  }

  .tiers__tier--platinum {
    {% comment %} background: linear-gradient(90deg, #5a5a5a, var(--color-platinum-bg)); {% endcomment %}
     background: linear-gradient(90deg, #6b6b6b, #4a4a4a, #2d2d2d);
  }

  .tiers__tier--platinum .tiers__tier-label {
    color: #fff;
  }

  .tiers__ranges {
    display: flex;
  }

  .tiers__range {
    flex: 1;
    text-align: center;
    font-size: 16px;
    color: var(--color-muted);
  }

  /* Responsive */
  @media (max-width: 600px) {
    .pharmacor-rewards__card {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
.pharmacor-rewards__title {
    font-size: 34px;
    line-height: 1;
}
.pharmacor-rewards__greeting {
    text-align: center;
}
    .pharmacor-rewards__pill-logo .pill-logo__img {
      width: 200px;
    }

    .tiers__tier-label {
      font-size: 14px;
    }
.pharmacor-rewards__header {
    margin-bottom: 30px;
}
    .tiers__range {
      font-size: 14px;
    }
    .pharmacor-rewards__tiers {
    padding: 0;
}
  }
</style>

{% schema %}
{
  "name": "Pharmacor Rewards",
  "tag": "section",
  "class": "section-pharmacor-rewards",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "PHARMACOR REWARDS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Loyalty Program"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Earn pill points with every purchase, unlock free stock, exclusive prices, merch and more."
    },
    {
      "type": "header",
      "content": "Greeting Card"
    },
    {
      "type": "image_picker",
      "id": "pill_logo",
      "label": "Pill Logo Image"
    },
    {
      "type": "text",
      "id": "pill_logo_alt",
      "label": "Pill Logo Alt Text",
      "default": "Pharmacor Rewards Logo"
    },
    {
      "type": "text",
      "id": "greeting_name",
      "label": "Greeting Name",
      "default": "Hi Grove Plaza,"
    },
    {
      "type": "text",
      "id": "greeting_message",
      "label": "Greeting Message",
      "default": "Make every purchase count — your Pill Points are already stacking up."
    },
    {
      "type": "header",
      "content": "Tier Settings"
    },
    {
      "type": "text",
      "id": "tier_1_name",
      "label": "Tier 1 Name",
      "default": "Silver"
    },
    {
      "type": "text",
      "id": "tier_1_range",
      "label": "Tier 1 Range",
      "default": "$0 - $4,999"
    },
    {
      "type": "text",
      "id": "tier_2_name",
      "label": "Tier 2 Name",
      "default": "Gold"
    },
    {
      "type": "text",
      "id": "tier_2_range",
      "label": "Tier 2 Range",
      "default": "$5000 - $14,999"
    },
    {
      "type": "text",
      "id": "tier_3_name",
      "label": "Tier 3 Name",
      "default": "Platinum"
    },
    {
      "type": "text",
      "id": "tier_3_range",
      "label": "Tier 3 Range",
      "default": "$15000 or more"
    }
  ],
  "presets": [
    {
      "name": "Pharmacor Rewards"
    }
  ]
}
{% endschema %}
