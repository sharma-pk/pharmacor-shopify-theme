

<div class="loyality_pro_outer" id="loyality-collection">
<div class="welcome-box">
 

  <div class="collections-list-wrapper">
    <div class="collectiion_header">
      <div class="title">
        <h2>{{ section.settings.heading | default: collection.title }}</h2>
      </div>
    </div>

    <div class="filters_home">
      {%- assign active_filters_size = 0 -%}
      {%- assign filters_type = section.settings.filters_type -%}
      {%- for filter in collection.filters -%}
        {%- case filter.type -%}
          {%- when 'list', 'boolean' -%}
            {%- assign active_filters_size = active_filters_size | plus: filter.active_values.size -%}
          {%- when 'price_range' -%}
            {%- if filter.min_value.value > 0 or filter.max_value.value < filter.range_max -%}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                {%- assign active_filters_size = active_filters_size | plus: 1 -%}
              {%- endif -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
      {% endfor %}

      {% comment %} <div class="collection__header-row sort_with_icons">
        {%- render 'product-filters-and-sort-bar', product_list: collection, without_filter_button: true -%}
        <div class="sort_with_icons">
          <div class="grid-lists-iconss">
            <div class="list-view-btn active iocns" style="display:none">
              <span>
                <svg width="37" height="29" viewBox="0 0 37 29" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="7.70667" y="0.480713" width="28.992" height="4.40385" fill="#30623D"/>
                  <circle cx="2.20193" cy="2.68264" r="2.20193" fill="#30623D"/>
                  <rect x="7.70667" y="12.2243" width="28.992" height="4.40385" fill="#30623D"/>
                  <circle cx="2.20193" cy="14.4263" r="2.20193" fill="#30623D"/>
                  <rect x="7.70667" y="23.9679" width="28.992" height="4.40385" fill="#30623D"/>
                  <circle cx="2.20193" cy="26.1698" r="2.20193" fill="#30623D"/>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div> {% endcomment %}
    </div>

    <div class="list_of_collections">
      <div id="custom" class="custom-collection-page-tabcontent">

        <style>
          /* ── Collection Tabs ── */
          .nav-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
          .nav-tabs button {
            background: transparent;
            border: 2px solid #30623d;
            border-radius: 30px;
            cursor: pointer;
            padding: 10px 30px;
            font-size: 16px;
            font-weight: 500;
            transition: background 0.2s, color 0.2s;
          }
          .nav-tabs button:hover { background: #30623d; color: #fff; }
          .nav-tabs button.active-tab { background: #30623d; color: #fff; }
          .tab-section { display: none; }

          .custom-btn-boxes {
            border: 2px solid #30623d !important;
            padding-top: 20px !important;
            padding-bottom: 20px !important;
            cursor: pointer !important;
          }

          @media only screen and (max-width: 767px) {
            .wrapper_welcome { padding: 12px !important; }
            .nav-tabs button { padding: 8px 16px; font-size: 14px; }
          }
        </style>

        {%- comment -%} ── COLLECTION TABS ── {%- endcomment -%}
        {% comment %} <div class="nav-tabs">
          {% for block in section.blocks %}
            {% assign block_collection = collections[block.settings.collection] %}
            <button
              class="tab-btn {% if forloop.first %}active-tab{% endif %}"
              data-tab="tab-{{ block.id }}"
            >
              {%- if block.settings.custom_name != blank -%}
                {{- block.settings.custom_name -}}
              {%- else -%}
                {{- block_collection.title -}}
              {%- endif -%}
            </button>
          {% endfor %}
        </div> {% endcomment %}

        <div class="custom-cart-list-main">
          <div class="custom_labels">
            <div class="custom-list-image">Image</div>
            <div class="custom-list-product-name">Product Name</div>
            <div class="custom-list-wholesaler">
              <div style="width:50%;text-align:center;">Wholesaler</div>
              <div style="width:44%;">Strength/Pack Size</div>
            </div>
            {% if customer %}
              <div class="custom-list-price">Price</div>
              <div class="custom-list-quantity">Quantity</div>
            {% else %}
              <div class="custom-list-product-info">Product Info</div>
            {% endif %}
          </div>

          {%- comment -%} ── ONE TAB PANEL PER BLOCK ── {%- endcomment -%}
          {% for block in section.blocks %}
            {% assign block_collection = collections[block.settings.collection] %}
            {% if block_collection %}
              <div
                id="tab-{{ block.id }}"
                class="tab-section my-collection-list-tabcontent"
                {% if forloop.first %}style="display:block"{% endif %}
              >

                <div class="custom-product-card-list custom-product-parent" style="width:100%;">
                  <div class="custom-product-card-list-wrap" id="products-tab-{{ block.id }}">
                    {% paginate block_collection.products by 1000 %}
                      {% for product in block_collection.products %}
                     
                       
                          {% render 'loyality-grid-item', product: product, section: section, title: block_collection %}
                    
                      {% endfor %}
                    {% endpaginate %}
                  </div>
                </div>

                <div class="text-center">
                  <button class="loadMore btn">{{ section.settings['load-more'] }}</button>
                </div>
              </div>
            {% endif %}
          {% endfor %}

        </div>
      </div>
    </div>
  </div>
</div>
</div>
<style>
  .custom-collection-list .customitem { display: none; }
  .allproductss .customitem { display: block !important; }
  .custom-home-content .collection__item { display: none; }
</style>

<!-- ==============================
     HOMEPAGE PRODUCT IDS
================================= -->
<script>
window.HOMEPAGE_PRODUCT_IDS = [];
{% for block in section.blocks %}
  {% assign block_collection = collections[block.settings.collection] %}
  {% if block_collection %}
    {% paginate block_collection.products by 1000 %}
      {% for product in block_collection.products %}
        window.HOMEPAGE_PRODUCT_IDS.push("{{ product.id }}");
      {% endfor %}
    {% endpaginate %}
  {% endif %}
{% endfor %}
</script>

<script>
(function () {
  var ITEMS_PER_PAGE = 10;
  var tabState = {}; // per-tab: { visibleCount }

  function getItems(panel) {
    var wrap = panel.querySelector('.custom-product-card-list-wrap');
    return wrap ? Array.prototype.slice.call(wrap.children) : [];
  }

  function showFirstPage(panel) {
    var items = getItems(panel);
    var showCount = Math.min(ITEMS_PER_PAGE, items.length);
    items.forEach(function (item, i) { item.style.display = i < showCount ? '' : 'none'; });
    tabState[panel.id] = { visibleCount: showCount };
    var loadMoreBtn = panel.querySelector('.loadMore');
    if (loadMoreBtn) loadMoreBtn.style.display = items.length > ITEMS_PER_PAGE ? '' : 'none';
  }

  function loadMore(panel) {
    var state = tabState[panel.id];
    if (!state) return;
    var items = getItems(panel);
    var end = Math.min(state.visibleCount + ITEMS_PER_PAGE, items.length);
    for (var i = state.visibleCount; i < end; i++) { items[i].style.display = ''; }
    state.visibleCount = end;
    if (state.visibleCount >= items.length) {
      var loadMoreBtn = panel.querySelector('.loadMore');
      if (loadMoreBtn) loadMoreBtn.style.display = 'none';
    }
  }

  // ── 1. Collection Tab switching ──
  document.querySelectorAll('.nav-tabs .tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.nav-tabs .tab-btn').forEach(function (b) { b.classList.remove('active-tab'); });
      document.querySelectorAll('.tab-section').forEach(function (p) { p.style.display = 'none'; });
      btn.classList.add('active-tab');
      var panel = document.getElementById(btn.getAttribute('data-tab'));
      if (!panel) return;
      panel.style.display = 'block';
      showFirstPage(panel);
    });
  });

  // ── 2. Load More ──
  document.querySelectorAll('.tab-section .loadMore').forEach(function (btn) {
    btn.style.display = 'none';
    btn.addEventListener('click', function () { loadMore(btn.closest('.tab-section')); });
  });

  // ── 3. Search ──
  var searchBtn = document.querySelector('.serach_btn');
  if (searchBtn) {
    searchBtn.addEventListener('click', function () {
      var val = (document.getElementById('searchInput').value || '').trim().toLowerCase();
      document.querySelectorAll('.collection__item').forEach(function (el) {
        var t = el.querySelector('.product-card__title');
        el.style.display = (t && t.textContent.toLowerCase().includes(val)) ? '' : 'none';
      });
      document.querySelectorAll('.custom_product-section, .custom-main-inner-wrap').forEach(function (el) {
        var t = el.querySelector('.product-name');
        el.style.display = (t && t.textContent.toLowerCase().includes(val)) ? '' : 'none';
      });
    });
  }

  // ── 4. Custom select menu ──
  var optionMenu = document.querySelector('.select-menu');
  if (optionMenu) {
    var selectBtn = optionMenu.querySelector('.select-btn');
    var sBtnText  = optionMenu.querySelector('.sBtn-text');
    selectBtn.addEventListener('click', function () { optionMenu.classList.toggle('active'); });
    optionMenu.querySelectorAll('.option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        sBtnText.innerText = opt.querySelector('.option-text').innerText;
        optionMenu.classList.remove('active');
      });
    });
  }

  // ── 5. Init: show the first page of products in the active tab on load ──
  var firstPanel = document.querySelector('.tab-section[style*="display:block"], .tab-section[style*="display: block"]');
  if (firstPanel) showFirstPage(firstPanel);

})();
</script>



