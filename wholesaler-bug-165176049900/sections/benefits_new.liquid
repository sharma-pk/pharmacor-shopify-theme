{% schema %}
{
  "name": "Benefits Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Maximise Your Benefits Today"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bulk Buy & Save"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Get more for less with competitive volume discounts."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "See Offers"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icons",
          "label": "Hover Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<style>
    .benefits-layout {
      display: grid;
      gap: 20px;
      grid-template-columns: none;
    }
  .right-col {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(5,1fr);
  }
        .wrapper_benefits{
          max-width:1320px;
          margin:0 auto;
        }
      .benefits-wrapper {
        text-align: center;
        padding: 50px 20px;
        background: #fff;
      }
      .benefits-wrapper h2 {
        font-size: 2rem;
        margin-bottom: 30px;
        color: #1e3a2e;
      }
      .benefits-grid {
        display: flex;
        gap: 0px;
      }
      .benefit-card {
        background-color: #B2E78A;
        padding: 40px;
        border-radius: 20px;
        transition: all 0.3s ease;
            text-align: left;
            flex-direction: column;
          gap: 10px;
          align-items: center;
        cursor:pointer;
      }
       .right-col .benefit-card:hover {
          background-color: #30623D;
      }
        .left-col:hover  .benefit-card {
          background-color: #30623D;
      }
        .left-col:hover   .benefit-card h3,  .left-col:hover  .benefit-card p,.left-col:hover  .benefit-card a{
        color:#B2E78A;
          transition:.3s all ease-in-out
      }
        .left-col:hover .image_with_heading {
          border-right: 2px solid #B2E78A;
      }
          .left-col:hover .benefit-card:nth-child(1) {
          border-bottom: 2px solid #B2E78A;
      }
          .left-col:hover .benefit-card:nth-child(2) {
          border-top: 1px solid #B2E78A;
      }
       .left-col:hover  .benefit-cardsvg [stroke-linejoin="round"]{
           fill:#B2E78A;
          transition:.3s all ease-in-out
        }
      .left-col:hover  .benefit-card svg  [stroke-linejoin="round"]{
           stroke:#B2E78A;
          transition:.3s all ease-in-out
        }
       .right-col .benefit-card:hover h3, .right-col  .benefit-card:hover p, .right-col  .benefit-card:hover a{
        color:#B2E78A;
          transition:.3s all ease-in-out
      }
        .right-col  .benefit-card:hoversvg [stroke-linejoin="round"]{
           fill:#B2E78A;
          transition:.3s all ease-in-out
        }
       .right-col .benefit-card:hover svg  [stroke-linejoin="round"]{
           stroke:#B2E78A;
          transition:.3s all ease-in-out
        }
       .right-col  .benefit-card:hover .main_image{
          display:none;
        }
         .right-col  .benefit-card:hover .hover_image{
          display:block;
        }
       .right-col   .benefit-card .hover_image{
          display:none;
        }
       .left-col .benefit-card .hover_image{
          display:none;
        }
        .left-col  .benefit-card .main_image{
          display:block;
        }
        .left-col:hover  .benefit-card .hover_image{
          display:block;
        }
        .left-col:hover   .benefit-card .main_image{
          display:none;
        }
      .benefit-card img {
        height: 80px;
        /* margin-bottom: 10px; */
      }
      .benefit-card h3 {
          margin-bottom: 10px;
          font-family: Neutrif Studio;
          font-weight: 500;
          font-size: 25px;
          line-height: 1.5;
          letter-spacing: 0;
          color: #30623D;
        margin: 30px 0;
      }
      .benefit-card p {
      margin-bottom: 15px;
          font-family: Neutrif Studio;
          font-weight: 400;
          font-size: 15px;
          line-height: 1.5;
          letter-spacing: 0;
          vertical-align: middle;
        color:#30623D;
            margin: 30px 0 50px;
      }
      .benefit-card a {
        text-decoration: none;
        font-weight: 600;
        color: #2f6f4e;
        display:flex;
        align-items:center;
        justify-content:space-between;
        width:100%;
      }
</style>

