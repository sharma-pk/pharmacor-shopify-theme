<div class="benefits-section">
  <div class="wrapper_benefits">
    <h2>{{ section.settings.heading }}</h2>

    <div class="benefits-layout">
   
      <div class="right-col">
        {% for block in section.blocks %}
          <div class="benefit-card">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | img_url: 'master' }}" alt="icon" class="main_image">
              <img src="{{ block.settings.icons | img_url: 'master' }}" alt="icon" class="hover_image">
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            <a href="{{ block.settings.link }}"
              >See Offers
              <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.71704 7.8103H15.0541" stroke="#30623D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M8.38556 1.1416L15.0541 7.81013L8.38556 14.4786" stroke="#30623D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
