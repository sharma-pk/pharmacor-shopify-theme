<script>
  // recalculates fresh from the variant instead of relying on a hidden field that
  // only updates when a radio's change event fires (was left blank otherwise)
  function computeSavingPercentFromVariant(variantId) {
    var variants = (window.product && window.product.variants) || [];
    var variant = variants.find(function (v) { return v.id === Number(variantId); });
    if (!variant) return '';
    var price = variant.price / 100;
    var compare = (variant.compare_at_price || 0) / 100;
    if (compare > price) {
      return (((compare - price) / compare) * 100).toFixed(2) + '%';
    }
    return '';
  }

  document.querySelectorAll(".custom-btn-boxes.proo.product-add-to-cart__button.add-to-cart").forEach(function(el) {
    el.addEventListener("click", function(e) {
      e.preventDefault();

      var parentForm = $(this).closest("form"); // parent form pakdo

      var idimp = parentForm.find(".cusotm-cart-id").val();
      var customquantity = parentForm.find(".custom-class-quantity").val();

      // ab properties collect karte hain

      var kachingProperties   = parentForm.find('[name="properties[__kaching_bundles]"]').val();

      var deliveryDate   = parentForm.find("#delivery_date").val();
      var savingPerItem  = computeSavingPercentFromVariant(idimp);
      var wholesaler1    = parentForm.find(".API").val();
      var wholesaler2    = parentForm.find(".Sigma").val();
      var wholesaler3    = parentForm.find(".Symbion").val();
      var wholesaler4    = parentForm.find(".Ch2").val();
      var subscription    = parentForm.find('[name="properties[subscription]"]').val();
      var pickup_location    = $('[name="properties[Shipping Option]"]:checked').val();
      {% comment %} var pickup_location = parentform {% endcomment %}

      var properties = {
        "Wholesaler Account No.1": wholesaler1,
        "Wholesaler Account No.2": wholesaler2,
        "Wholesaler Account No.3": wholesaler3,
        "Wholesaler Account No.4": wholesaler4,
        "Delivery Date": deliveryDate,
        "Saving Per Item": savingPerItem,
        "subscription": subscription,
        "Shipping Option": pickup_location
      };

      // normalized + deterministic regardless of merge state — same variant+wholesaler always gets the same value
      var wholesalerBrand = wholesaler1 ? 'API' : wholesaler2 ? 'SIGMA' : wholesaler3 ? 'SYMBION' : wholesaler4 ? 'CH2' : '';
      var wholesalerValue = wholesaler1 || wholesaler2 || wholesaler3 || wholesaler4 || '';
      properties = normalizeLineProperties(properties);
      properties["_line_uid"] = computeLineUid(idimp, wholesalerBrand, wholesalerValue);

      let formobj = {
        quantity: customquantity,
        id: idimp,
        properties: properties
      };

      if (kachingProperties) {
        formobj.properties["__kaching_bundles"] = kachingProperties;
      }

      $.ajax({
        type: "POST",
        url: "/cart/add.js",
        cache: false,
        data: formobj,
        dataType: "json",
        success: function() {

          // cart bubble update
          $('#cart-icon-bubble').load(window.location.href + " #cart-icon-bubble > *");

          // drawer refresh using Section Rendering API
          refreshCartDrawer(function(){
            {% if settings.product-page-drawer %}
              $(".header__icon--cart").trigger("click");
              $("body").addClass("cart-open");
            {% endif %}
          });
        },
        error: function(xhr, status, error) {
          console.log('error: ' + error);
        }
      });
    });
  });



  // -------- Drawer Refresh (Section Rendering API) ----------
  function refreshCartDrawer(done){
    var $drawer = $("#CartDrawer");
    var sectionKey = $drawer.data("section-id");

    $.ajax({
      type: "GET",
      url: "/?sections=" + encodeURIComponent(sectionKey) + "&_=" + Date.now(),
      dataType: "json",
      success: function(res){
        var html = res && res[sectionKey];
        if(html) {
          swapDrawerHTML(html);
          if(typeof done === "function") done();
        } else {
          fallbackHTML(done);
        }
      },
      error: function(){
        fallbackHTML(done);
      }
    });

    function fallbackHTML(cb){
      $.ajax({
        type: "GET",
        url: "/?section_id=cart-drawer&_=" + Date.now(),
        dataType: "html",
        success: function(html){
          swapDrawerHTML(html);
          if(typeof cb === "function") cb();
        }
      });
    }

    function swapDrawerHTML(newHtml){
      var $tmp = $(newHtml);

      // container content replace
      var $newContainer = $tmp.find(".js-cart-container");
      if($newContainer.length){
        $drawer.find(".js-cart-container").html($newContainer.html());
      } else {
        var $alt = $tmp.filter(".drawer").find(".js-cart-container");
        if($alt.length){
          $drawer.find(".js-cart-container").html($alt.html());
        }
      }

      // footer replace
      var $newFooter = $tmp.find(".cart-drawer__footer");
      if($newFooter.length){
        $drawer.find(".cart-drawer__footer").html($newFooter.html());
      }
    }
  }
</script>
{% if template.name == 'product' %}
  <script>
    window.product = {{ product | json }};
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.radio-input').forEach(function (input) {
        input.addEventListener('change', function () {
          let option1 = document.querySelector('input[name="option1"]:checked')?.value;
          let option2 = document.querySelector('input[name="option2"]:checked')?.value;

          let variants = window?.product?.variants || [];

          let matchedVariant = variants.find((v) => v.option1 === option1 && v.option2 === option2);

          if (matchedVariant) {
            let price = matchedVariant.price / 100;
            let compare = matchedVariant.compare_at_price / 100;
            let savingPercent = '';

            if (compare > price) {
              savingPercent = (((compare - price) / compare) * 100).toFixed(2) + '%';
            }

            document.getElementById('custom-inline-property').value = savingPercent;

            $('.wpd-ext-compare-at-price').html('$' + compare);
          }
        });
      });
    });
  </script>
{% endif %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.product-quantity__input').forEach(function (input) {
      const container = input.closest('.product-quantity__container');
      if (!container) return;

      const btnDecrease = container.querySelector('[data-quantity-decrease]');
      const btnIncrease = container.querySelector('[data-quantity-increase]');
      const addToCartInput = container.querySelector('.add-to-card-input');
      const min = parseInt(input.min) || 1;
      const max = parseInt(input.max) || Infinity;

      function syncValue() {
        if (addToCartInput) addToCartInput.value = input.value;
      }

      {% comment %} // Decrease button
      if (btnDecrease) {
        btnDecrease.addEventListener('click', function () {
          let value = parseInt(input.value);
          if (isNaN(value)) value = min;
          if (value > min) {
            input.value = value - 1;
          } else {
            input.value = ''; // allow empty instead of min
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
          syncValue();
        });
      }

      // Increase button
      if (btnIncrease) {
        btnIncrease.addEventListener('click', function () {
          let value = parseInt(input.value);
          if (isNaN(value)) value = 0;
          if (value < max) {
            input.value = value + 1;
          } else {
            input.value = max;
          }
          input.dispatchEvent(new Event('change', { bubbles: true }));
          syncValue();
        });
      } {% endcomment %}

      // Allow clearing with Backspace/Delete
      input.addEventListener('keydown', function (e) {
        if ((e.key === 'Backspace' || e.key === 'Delete') && input.value.length === 1) {
          input.value = '';
          e.preventDefault();
          syncValue();
        }
      });

      // Manual typing (only digits)
      input.addEventListener('input', function () {
        if (input.value === '') {
          syncValue();
          return;
        }
        input.value = input.value.replace(/[^\d]/g, '');
        let value = parseInt(input.value);
        if (!isNaN(value)) {
          if (value > max) value = max;
          input.value = value;
        }
        syncValue();
      });

      input.addEventListener('blur', syncValue);
      syncValue();
    });
  });
</script>
