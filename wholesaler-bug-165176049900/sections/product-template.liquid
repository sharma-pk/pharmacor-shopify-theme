<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js" defer></script>

<script>
  function checkAndClickSelection() {
    const selectElement = document.getElementById('mySelect');
    const selectedValue = $(selectElement).val();
    if (selectedValue) {
      setTimeout(function () {
        document.addEventListener(
          'DOMContentLoaded',
          function () {
            // Use jQuery to find the element
            const $element = $('.custom-option').find('.' + selectedValue);

            if ($element.length) {
              // Simulate a realistic click (better than .click())
              const clickEvent = new MouseEvent('click', {
                bubbles: true,
                cancelable: true,
                view: window,
              });

              // Dispatch the event on the raw DOM element
              $element[0].dispatchEvent(clickEvent);

              console.log('Realistic click triggered on:', $element);
            } else {
              console.error('Element not found with selector: .' + selectedValue);
            }
          },
          2000
        ); // 2-second delay (adjust as needed)
      });
    }
  }

  // Check and click the selected option on page load

  // Listen for change events
  document.addEventListener('DOMContentLoaded', function () {
    const selectElement = document.getElementById('mySelect');
    if (selectElement) {
      selectElement.addEventListener('change', function () {
        checkAndClickSelection();
      });
    }
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const selectElement = document.getElementById('mySelect');

    // Check if there's a saved value in localStorage
    const savedValue = localStorage.getItem('selectedOption');

    // If a value is saved, set it as the selected option
    if (savedValue) {
      selectElement.value = savedValue;
    }
    setTimeout(function () {
      checkAndClickSelection();
    }, 300);
    // Add an event listener to save the selected value when the option is changed
    selectElement.addEventListener('change', function () {
      localStorage.setItem('selectedOption', selectElement.value);
    });
    $('.radio-input').click(function () {
      // First disable all inputs with the 'customdisable' class

      // Iterate through all radio inputs
      $('.radio-input').each(function () {
        if ($(this).is(':checked')) {
          var customval = $(this).val();

          if (customval) {
            if (customval.includes('CH2')) {
              $('.product-inventory-status').css('display', 'none');
              $('#inventoryLocationInformation').css('display', 'none');
            } else {
              $('.product-inventory-status').css('display', 'block');
              $('#inventoryLocationInformation').css('display', 'block');
            }

            $('#' + customval).prop('disabled', false);
          }
        }
      });
    });
  });
</script>

