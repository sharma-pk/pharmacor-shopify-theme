{%- comment -%}
  ------------------------------------------------------------------------------
    Section: Product template
  ------------------------------------------------------------------------------
{%- endcomment -%}
 {%  if customer %}

{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/product.scss' -%}

{%- assign container = section.settings.container_width -%}
{%- assign ui_button_color = section.settings.ui_button_color -%}
{%- assign ui_button_background_color = section.settings.ui_button_background_color -%}
{%- assign ui_button_border_color = section.settings.ui_button_border_color -%}

{% if container == 'inherit' %}
  {% assign container_width = settings.container_width %}
{% else %}
  {% assign container_width = container %}
{% endif %}

{%- style -%}
  {%if template.name == 'product' %}
    .product-form{padding-left: 30px!important; padding-right: 30px!important;}
    .price__container .price__regular{display: none!important;}
  .product-add-to-cart__button.add-to-cart{border: 2px solid #30623d!important;padding: 10px 32px!important;cursor: pointer;}
  kaching-bundle, kaching-bundle-deals {width: 75%!important;}
  .product-media {width: calc(40% - 8px);}
  .product.product--two_columns{max-width: 1620px;}
  .product-quantity__input{text-align: center; padding-left: 5px; padding-right: 5px; min-width: 80px;}
  .kaching-bundles .kaching-bundles__block.kaching-bundles__block--loaded {margin-top: 0px!important;}

  kaching-bundle:empty {
    display: none;
  }
  @media only screen and (max-width: 1200px){
    .product.product--two_columns {max-width: 800px;}
    .product-media {width: calc(100% - 8px);}
    kaching-bundle, kaching-bundle-deals {width: 100%!important;}
    .product-quantity__wrapper.cusotm-wrapper-qiantity.custom-wraperr{position: relative;
    left: 20%;}
  }
  {%endif %}
  .cart-drawer__section.cart-drawer__section--shipping{display: none;}
    .price-item.price-item--regular {
      text-decoration: line-through!important;
    }
        .product-drawers{display: flex; justify-content: center; gap: 20px;}
        .product-drawers .product-drawers__item:first-child {
        border-top: none;
      }
      .product-drawers .product-drawers__item {
        border-bottom: none;border-bottom: 2px solid #000;
      }
        @media (min-width: 768px) {
        .product-drawers .product-drawers__item-toggle {padding: 2px;}
        }
        .threeimagescustom img{width: 40px;}
        .my-share-media {display: flex; flex-direction: column; justify-content: center; align-items: center;}
        .threeimagescustom{display: none;flex-direction: column;gap: 10px;margin-top: 15px;}
      #shopify-section-{{- section.id -}} {
      		padding-top: {{- section.settings.offset_top_mobile -}}px;
      		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
      	}

      	@media screen and (min-width: 768px) {
      		#shopify-section-{{- section.id -}} {
      			padding-top: {{- section.settings.offset_top_desktop -}}px;
      			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
      		}
      	}
{%- endstyle -%}

{%- capture section_styles -%}
	--container-width: {{ container_width }};
	--ui-button-color: {{ ui_button_color }};
	--ui-button-background-color: {{ ui_button_background_color }};
	--ui-button-border-color: {{ ui_button_border_color }};
	--ui-model-view-button-background-color: {{ ui_button_background_color | color_darken: 5 }};
{%- endcapture -%}

{%- capture size_guide -%}
	{%- if section.settings.show_size_guide -%}
		{%- assign size_guide_page = product.metafields.size_guide.page.value -%}

		{%- if size_guide_page != blank and size_guide_page.content != blank -%}
			{% assign toggle_id = 'productSizeGuideDrawer-' | append: section.id %}
			{% assign size_guide_page_content = size_guide_page.content | replace: '<img', '<img loading="lazy"'%}

			{% render 'product-size-guide-popup',
				product: product,
				title: section.settings.size_guide_drawer_title,
				content: size_guide_page_content,
				toggle_id: toggle_id,
				tab_general_name: section.settings.size_guide_tab_general_name,
				tab_model_name: section.settings.size_guide_tab_model_name
			%}
		{%- endif -%}
	{%- endif -%}
{%- endcapture -%}

<div class="man-class-cont">
  {% for variant in product.variants %}
    <input
      type="hidden"
      class="custom-checking-datas {{ variant.title | handleize }}"
      varienrprice="{{ variant.price | money }}"
      varientquentity="{{ variant.inventory_quantity }}"
      myvarientid="{{ variant.id }}"
      varienrcompprice="{{ variant.compare_at_price | money }}"
      varientimage="{{ variant.image|img_url:"original"}}"
      varientimagealt="{{ variant.image.alt | handleize }}"
    >
  {% endfor %}
</div>
<section
  class="product-section"
  style="{{ section_styles }}"
  data-section-type="product"
  data-section-id="{{- section.id -}}"
  data-product-handle="{{- product.handle -}}"
  data-js-product-container
>
  {% include 'product-json' %}

  <div class="product product--{{ section.settings.product_layout }}">
    {%- case section.settings.product_layout -%}
      {%- when 'two_columns' -%}
        {%- include 'product-media', media_height: section.settings.media_height -%}
        {%- include 'product-single-col',
          blocks: section.blocks,
          product: product,
          enable_history_state: true,
          product_template: true
        -%}
      {%- when 'three_columns' -%}
        {%- render 'product-block-column',
          col: 'first_column',
          product: product,
          section: section,
          blocks: section.blocks,
          enable_history_state: true
        -%}
        {%- include 'product-media', media_height: section.settings.media_height -%}
        {%- render 'product-block-column',
          col: 'third_column',
          product: product,
          section: section,
          blocks: section.blocks,
          enable_history_state: true
        -%}
    {%- endcase -%}
  </div>

  {{- size_guide -}}

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {% when 'drawers' %}
        {%- render 'product-drawers-content', block: block, product: product, section_id: section.id -%}
      {% when 'notify_me' -%}
        {%- render 'product-notify-me-popup', block: block, section_id: section.id -%}
      {% when 'ask_question' %}
        {%- render 'product-ask-question-popup', block: block, section_id: section.id -%}
    {%- endcase -%}
  {%- endfor -%}
</section>

{%- render 'adastra' with '/src/scripts/section-product.js' -%}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
       "url": {{ request.origin | append: product.url | json }},
  {% if seo_media -%}
         "image": [
           {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
         ],
       {%- endif %}
  "description": {{ product.description | strip_html | json }},
  {% if product.selected_or_first_available_variant.sku != blank -%}
         "sku": {{ product.selected_or_first_available_variant.sku | json }},
       {%- endif %}
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "offers": [
  {%- for variant in product.variants -%}
           {
             "@type" : "Offer",
             {%- if variant.sku != blank -%}
               "sku": {{ variant.sku | json }},
             {%- endif -%}
  	{%- if variant.barcode.size == 12 -%}
               "gtin12": {{ variant.barcode }},
             {%- endif -%}
  	{%- if variant.barcode.size == 13 -%}
               "gtin13": {{ variant.barcode }},
             {%- endif -%}
  	{%- if variant.barcode.size == 14 -%}
               "gtin14": {{ variant.barcode }},
             {%- endif -%}
             "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
             "price" : {{ variant.price | divided_by: 100.00 | json }},
             "priceCurrency" : {{ cart.currency.iso_code | json }},
             "url" : {{ request.origin | append: variant.url | json }}
           }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]
   }
</script>

